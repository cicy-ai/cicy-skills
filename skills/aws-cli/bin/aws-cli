#!/usr/bin/env node
// aws-cli — run the official AWS CLI as one of the AWS accounts stored in
// cicy-code's account matrix (~/cicy-ai/db/aws.json, managed in 账户 → AWS).
//
// The secret access key never reaches stdout: `exec`/`whoami` fetch it from the
// local cicy-code API and hand it to the child `aws` process via environment
// variables only. Zero npm dependencies, Node 18+, works on Linux/macOS/Windows.

import { readFileSync, existsSync } from 'node:fs';
import { homedir, platform, arch, tmpdir } from 'node:os';
import { join, delimiter } from 'node:path';
import { spawnSync, execFileSync } from 'node:child_process';

const NAME = 'aws-cli';
const argv = process.argv.slice(2);

function cicyApi() {
  const base = (process.env.CICY_API_BASE || 'http://127.0.0.1:' + (process.env.CICY_API_PORT || '8008')).replace(/\/+$/, '');
  let token = process.env.CICY_API_TOKEN || '';
  if (!token) {
    try { token = JSON.parse(readFileSync(process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json'), 'utf8')).api_token || ''; } catch {}
  }
  if (!token) bail('no cicy-code token (set CICY_API_TOKEN or log in)', 3);
  return { base, headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' } };
}

function bail(msg, code = 1) {
  process.stderr.write(`${NAME}: ${msg}\n`);
  process.exit(code);
}

function flag(name) {
  const i = argv.indexOf(name);
  if (i < 0) return '';
  const v = argv[i + 1];
  if (!v || v.startsWith('--')) bail(`${name} needs a value`, 2);
  return v;
}

async function api(method, path, body) {
  const { base, headers } = cicyApi();
  let res;
  try {
    res = await fetch(base + path, { method, headers, body: body ? JSON.stringify(body) : undefined });
  } catch (e) {
    bail(`cannot reach cicy-code at ${base}: ${e.message}`, 3);
  }
  const text = await res.text();
  let data = {};
  try { data = text ? JSON.parse(text) : {}; } catch { data = { detail: text }; }
  if (!res.ok) bail(`${method} ${path} → ${res.status} ${data.detail || data.error || ''}`.trim(), res.status === 404 ? 4 : 1);
  return data;
}

function awsBin() {
  const exe = platform() === 'win32' ? ['aws.exe', 'aws.cmd'] : ['aws'];
  const dirs = (process.env.PATH || '').split(delimiter).filter(Boolean);
  dirs.push(join(homedir(), '.local', 'bin'));
  for (const d of dirs) for (const e of exe) { const p = join(d, e); if (existsSync(p)) return p; }
  return '';
}

function maskId(id) {
  return id && id.length > 8 ? id.slice(0, 4) + '…' + id.slice(-4) : (id || '');
}

// Credentials for one account → env for the child aws process. AWS_PROFILE and
// friends are cleared so ~/.aws/credentials can't silently win over them.
async function accountEnv(name) {
  if (!name) bail('--account <name> is required (see: aws-cli accounts)', 2);
  const s = await api('GET', '/api/aws/accounts?reveal_token=' + encodeURIComponent(name));
  if (!s.access_key_id || !s.secret_access_key) bail(`account ${name} has no access key`, 4);
  const env = { ...process.env };
  for (const k of ['AWS_PROFILE', 'AWS_DEFAULT_PROFILE', 'AWS_SESSION_TOKEN', 'AWS_SECURITY_TOKEN']) delete env[k];
  env.AWS_ACCESS_KEY_ID = s.access_key_id;
  env.AWS_SECRET_ACCESS_KEY = s.secret_access_key;
  const region = flag('--region') || s.region || 'us-east-1';
  env.AWS_REGION = region;
  env.AWS_DEFAULT_REGION = region;
  return env;
}

function runAws(env, args) {
  const bin = awsBin();
  if (!bin) bail('official aws CLI not found — run: aws-cli install', 5);
  const r = spawnSync(bin, args, { env, stdio: 'inherit' });
  if (r.error) bail(r.error.message);
  process.exit(r.status ?? 1);
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdAccounts() {
  const { accounts = [] } = await api('GET', '/api/aws/accounts');
  if (argv.includes('--json')) {
    // Same shape as the API: never contains the secret.
    process.stdout.write(JSON.stringify(accounts, null, 2) + '\n');
    return;
  }
  if (!accounts.length) { console.log('no AWS accounts yet — add one in cicy-code 账户 → AWS'); return; }
  for (const a of accounts) {
    console.log(`${a.name}\t${maskId(a.access_key_id)}\t${a.region || '-'}\t${a.note || ''}`);
  }
}

async function cmdWhoami() {
  const env = await accountEnv(flag('--account'));
  runAws(env, ['sts', 'get-caller-identity', '--output', 'json']);
}

async function cmdExec() {
  const sep = argv.indexOf('--');
  if (sep < 0 || sep === argv.length - 1) bail('usage: aws-cli exec --account <name> [--region r] -- <aws args…>', 2);
  const env = await accountEnv(flag('--account'));
  runAws(env, argv.slice(sep + 1));
}

async function cmdUse() {
  const name = argv[1] && !argv[1].startsWith('--') ? argv[1] : flag('--account');
  if (!name) bail('usage: aws-cli use <name>', 2);
  const r = await api('POST', '/api/aws/accounts/bind', { name });
  console.log(`✓ ${name} is now this machine's [default] and [${r.profile}] profile (${r.region})`);
  console.log(`  credentials: ${r.credentials}`);
}

async function cmdTest() {
  const name = argv[1] && !argv[1].startsWith('--') ? argv[1] : flag('--account');
  if (!name) bail('usage: aws-cli test <name>', 2);
  const r = await api('POST', '/api/aws/accounts/test', { name });
  process.stdout.write(JSON.stringify({ name, account_id: r.account_id, arn: r.arn, region: r.region }, null, 2) + '\n');
}

async function cmdStatus() {
  const bin = awsBin();
  let version = '';
  if (bin) { try { version = execFileSync(bin, ['--version'], { encoding: 'utf8' }).trim(); } catch {} }
  let count = null; let apiError = '';
  try {
    const { base, headers } = cicyApi();
    const res = await fetch(base + '/api/aws/accounts', { headers });
    if (res.ok) count = ((await res.json()).accounts || []).length; else apiError = `HTTP ${res.status}`;
  } catch (e) { apiError = e.message; }
  const out = { aws_cli: bin || null, aws_cli_version: version || null, accounts: count, api_error: apiError || undefined };
  if (argv.includes('--json')) { process.stdout.write(JSON.stringify(out) + '\n'); return; }
  console.log(`aws CLI : ${bin ? `${bin} (${version})` : 'not installed — run: aws-cli install'}`);
  console.log(`accounts: ${count == null ? `unavailable (${apiError})` : count}`);
}

function cmdInstall() {
  const bin = awsBin();
  if (bin && !argv.includes('--force')) { console.log(`✓ aws CLI already installed: ${bin}`); return; }
  const os = platform();
  if (os !== 'linux') {
    console.log(os === 'darwin'
      ? 'Install the official AWS CLI: curl -o AWSCLIV2.pkg https://awscli.amazonaws.com/AWSCLIV2.pkg && sudo installer -pkg AWSCLIV2.pkg -target /'
      : 'Install the official AWS CLI: msiexec.exe /i https://awscli.amazonaws.com/AWSCLIV2.msi');
    return;
  }
  const zip = arch() === 'arm64' ? 'awscli-exe-linux-aarch64.zip' : 'awscli-exe-linux-x86_64.zip';
  const dir = join(tmpdir(), `aws-cli-${process.pid}`);
  const home = homedir();
  try {
    execFileSync('mkdir', ['-p', dir]);
    execFileSync('curl', ['-fsSL', '-o', join(dir, 'awscliv2.zip'), `https://awscli.amazonaws.com/${zip}`], { stdio: 'inherit' });
    execFileSync('unzip', ['-q', '-o', join(dir, 'awscliv2.zip'), '-d', dir], { stdio: 'inherit' });
    // User-local install: no sudo needed.
    execFileSync(join(dir, 'aws', 'install'), ['-i', join(home, '.local', 'aws-cli'), '-b', join(home, '.local', 'bin'), '--update'], { stdio: 'inherit' });
  } catch (e) {
    bail(`install failed: ${e.message}`, 4);
  } finally {
    try { execFileSync('rm', ['-rf', dir]); } catch {}
  }
  console.log(`✓ installed aws CLI into ${join(home, '.local', 'bin')}`);
}

function printHelp() {
  try {
    process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8'));
  } catch {
    process.stdout.write(`Usage: aws-cli <command>
  accounts [--json]                          list stored AWS accounts (name, key id, region, note)
  whoami --account <name>                    aws sts get-caller-identity as that account
  exec --account <name> [--region r] -- …    run any aws command as that account
  use <name>                                 write the account into ~/.aws/credentials as [default]
  test <name>                                verify the key via cicy-code (STS)
  status [--json]                            aws CLI + accounts state
  install [--force]                          install the official aws CLI (Linux user-local)
`);
  }
}

// ── main ────────────────────────────────────────────────────────────────

const cmd = argv[0];
if (!cmd || cmd === '--help' || cmd === '-h' || cmd === 'help') { printHelp(); process.exit(0); }

const commands = { accounts: cmdAccounts, whoami: cmdWhoami, exec: cmdExec, use: cmdUse, test: cmdTest, status: cmdStatus, install: cmdInstall };
if (!commands[cmd]) bail(`unknown command: ${cmd}. Try ${NAME} --help.`, 2);
try {
  await commands[cmd]();
} catch (e) {
  bail(e.message, e.exitCode || 1);
}
