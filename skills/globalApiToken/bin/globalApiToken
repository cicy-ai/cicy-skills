#!/usr/bin/env node
// globalApiToken — show / refresh ~/cicy-ai/global.json api_token.
// Zero npm dependencies. Pure ESM. Node 18+.

import { readFileSync, writeFileSync, existsSync, chmodSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { randomBytes } from 'node:crypto';
import { spawnSync } from 'node:child_process';

const PATH = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');

const argv = process.argv.slice(2);
const json = argv.includes('--json');

// help flags must short-circuit before we try to read any files
if (argv.includes('--help') || argv.includes('-h') || argv[0] === 'help') {
  try {
    process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8'));
  } catch {
    process.stdout.write('globalApiToken <show|refresh> [--json]\n');
  }
  process.exit(0);
}

const cmd = argv.find((a) => !a.startsWith('--')) || 'show';

function emit(obj, ok = true) {
  if (json) {
    process.stdout.write(JSON.stringify({ ok, data: obj }) + '\n');
  } else {
    process.stdout.write((typeof obj === 'string' ? obj : JSON.stringify(obj)) + '\n');
  }
}

function bail(code, message, exit = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message } }) + '\n');
  else process.stderr.write(`globalApiToken: ${message}\n`);
  process.exit(exit);
}

function readGlobal() {
  if (!existsSync(PATH)) return null;
  try {
    return JSON.parse(readFileSync(PATH, 'utf8'));
  } catch (e) {
    bail('CORRUPT', `cannot parse ${PATH}: ${e.message}`, 1);
  }
}

function writeGlobal(obj) {
  writeFileSync(PATH, JSON.stringify(obj, null, 2) + '\n', { mode: 0o600 });
  try { chmodSync(PATH, 0o600); } catch {}
}

function newToken() {
  return randomBytes(32).toString('base64url');
}

function flagValue(name) {
  const i = argv.indexOf(name);
  return i >= 0 && argv[i + 1] && !argv[i + 1].startsWith('--') ? argv[i + 1] : null;
}

// Delivery of a rotated token goes through the `email` skill (SMTP). We never
// store the user's token server-side — it only lives in this VM's global.json —
// so after a refresh the only way the user (e.g. on a remote UI) learns the new
// token is this out-of-band email. Hence refresh REQUIRES email to be configured
// unless --no-email is passed.
function emailStatus() {
  const r = spawnSync('email', ['status', '--json'], { encoding: 'utf8' });
  if (r.error || r.status !== 0) return null;
  try { const j = JSON.parse(r.stdout); return j && j.ok ? j.data : null; } catch { return null; }
}

function emailSend(to, token) {
  const subject = 'CiCy API token rotated';
  const body = [
    'Your CiCy api_token on this host was just rotated.',
    '',
    'New token: ' + token,
    '',
    'Stored at ' + PATH + ' (mode 0600). The previous token is now invalid.',
    'Keep this private — anyone with this token can control this host’s API.',
  ].join('\n');
  const r = spawnSync('email', ['send', '--to', to, '--subject', subject, '--body', body], { encoding: 'utf8' });
  if (r.error) return { ok: false, error: r.error.code === 'ENOENT' ? 'email skill not found' : r.error.message };
  if (r.status !== 0) return { ok: false, error: (r.stderr || '').trim() || ('exit ' + r.status) };
  return { ok: true };
}

switch (cmd) {
  case 'show': {
    const g = readGlobal();
    if (!g) bail('NOT_FOUND', `${PATH} does not exist`, 3);
    if (!g.api_token) bail('MISSING_FIELD', `api_token missing in ${PATH}`, 3);
    emit(g.api_token);
    break;
  }
  case 'refresh': {
    const g = readGlobal() || {};
    const noEmail = argv.includes('--no-email') || argv.includes('--local');

    if (noEmail) {
      // Explicit opt-out: rotate without delivering. The caller accepts that a
      // remote client without the new token will be locked out.
      g.api_token = newToken();
      writeGlobal(g);
      emit({ api_token: g.api_token, path: PATH, refreshed_at: new Date().toISOString(), emailed_to: null });
      break;
    }

    // Require email delivery so the user actually receives the new token.
    const st = emailStatus();
    if (!st) {
      bail('EMAIL_NOT_INSTALLED', "email skill not available — install + configure it before rotating (the new token can only reach you by email). Run: cicy-code skill install email && email config. Or pass --no-email to rotate anyway (you may lock yourself out).", 3);
    }
    if (!st.send_ready) {
      bail('EMAIL_NOT_CONFIGURED', "email skill has no working SMTP config — run 'email config' first. Refusing to rotate so the new token can be delivered and you aren't locked out. (--no-email to override.)", 3);
    }
    const to = flagValue('--to') || st.default_to;
    if (!to) {
      bail('NO_RECIPIENT', "no recipient address — pass --to <addr>, or set default_to via 'email config'.", 2);
    }

    // Generate, EMAIL FIRST, then persist only on a successful send. If the email
    // fails we do NOT write the new token, so the current token keeps working.
    const tok = newToken();
    const sent = emailSend(to, tok);
    if (!sent.ok) {
      bail('EMAIL_SEND_FAILED', `failed to email the new token (${sent.error}); NOT rotating, your current token still works.`, 4);
    }
    g.api_token = tok;
    writeGlobal(g);
    emit({ api_token: g.api_token, path: PATH, refreshed_at: new Date().toISOString(), emailed_to: to });
    break;
  }
  case '--help':
  case '-h':
  case 'help': {
    // already handled above; this branch is unreachable but kept for clarity
    break;
  }
  default:
    bail('INVALID_COMMAND', `unknown command: ${cmd}. Try --help.`, 2);
}
