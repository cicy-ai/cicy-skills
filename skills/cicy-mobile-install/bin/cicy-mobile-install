#!/usr/bin/env node
// cicy-mobile-install — install the latest cicy-mobile build onto a USB-connected
// phone through the Mac build host. The phone plugs into the Mac; this runs on
// the host and drives the Mac over ssh.
//   Android → pull the APK and `adb install` (zero account).
//   iOS     → re-sign with a free Apple ID (unsigned IPA).
// Distribution (no R2): global → GitHub Releases (bare apk/ipa); CN → Aliyun OSS
// Shanghai (bare .ipa; .apk is zip-wrapped since OSS forbids bare .apk, so the
// CN Android path unzips before adb install). Region auto-detected on the Mac,
// overridable via CICY_INSTALL_REGION / cfg.region = cn|global.
// Zero deps, Node 18+.
import { execFileSync } from 'node:child_process';
import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const CFG_PATH = join(homedir(), 'cicy-ai', 'db', 'cicy-mobile-install.json');
const cfg = existsSync(CFG_PATH) ? JSON.parse(readFileSync(CFG_PATH, 'utf8')) : {};
const SSH_HOST = process.env.CICY_INSTALL_SSH_HOST || cfg.ssh_host || 'mac';
// Distribution endpoints (R2 dropped). global = GitHub Releases; CN = Aliyun OSS.
const GH_LATEST = 'https://github.com/cicy-ai/cicy-mobile/releases/latest/download'; // stable alias
const GH_TAG = 'https://github.com/cicy-ai/cicy-mobile/releases/download';           // versioned: /v<ver>/cicy-<ver>.<ext>
const OSS_BASE = (cfg.oss_base || 'https://cicy-1372193042-cn.oss-cn-shanghai.aliyuncs.com/cicy-mobile').replace(/\/+$/, '');
const VERSION_URL = cfg.version_url || 'https://m.cicy-ai.com/version.json';         // geo-agnostic latest-version manifest
const IOS_SOURCE_DIR = cfg.ios_source_dir || '~/Downloads/cicy-mobile'; // Xcode method: clone target
const DL_DIR = cfg.download_dir || '~/Downloads'; // where the IPA is downloaded

const die = (m) => { process.stderr.write(`✗ ${m}\n`); process.exit(1); };
const log = (m) => process.stdout.write(`${m}\n`);

function ssh(remote, { stream = false } = {}) {
  try {
    const out = execFileSync('ssh', ['-o', 'ConnectTimeout=12', SSH_HOST, remote],
      { encoding: 'utf8', stdio: stream ? 'inherit' : ['ignore', 'pipe', 'pipe'], timeout: 600000 });
    return { ok: true, out: (out || '').trim() };
  } catch (e) {
    return { ok: false, out: (e.stdout || '').toString().trim(), err: (e.stderr || e.message || '').toString().trim() };
  }
}

// Which mirror to pull from. The download runs ON THE MAC (over ssh), so region
// reflects the Mac's egress: cn → Aliyun OSS Shanghai, global → GitHub Releases.
// Explicit override wins; otherwise probe GitHub reachability from the Mac once.
let _region = null;
function region() {
  if (_region) return _region;
  const forced = (process.env.CICY_INSTALL_REGION || cfg.region || '').toLowerCase();
  if (forced === 'cn' || forced === 'global') return (_region = forced);
  // auto: can the Mac reach GitHub's release CDN quickly? yes → global, else cn.
  const r = ssh(`curl -fsS -m 6 -o /dev/null -w '%{http_code}' -I "https://github.com/cicy-ai/cicy-mobile/releases/latest" 2>/dev/null || echo 000`);
  const code = (r.out || '').trim().slice(-3);
  return (_region = (code === '200' || code === '301' || code === '302') ? 'global' : 'cn');
}

// Android download URL. CN is zip-wrapped (OSS forbids bare .apk); global is a
// bare apk off GitHub. Returns { url, zip }.
function androidUrl(version) {
  if (region() === 'cn') {
    return { url: `${OSS_BASE}/${version ? `cicy-${version}.zip` : 'cicy-latest.zip'}`, zip: true };
  }
  return { url: version ? `${GH_TAG}/v${version}/cicy-${version}.apk` : `${GH_LATEST}/cicy-latest.apk`, zip: false };
}

// iOS download URL — bare .ipa both sides (OSS allows .ipa; no unzip).
function iosUrl(version) {
  if (region() === 'cn') return `${OSS_BASE}/${version ? `cicy-${version}.ipa` : 'cicy-latest.ipa'}`;
  return version ? `${GH_TAG}/v${version}/cicy-${version}.ipa` : `${GH_LATEST}/cicy-latest.ipa`;
}

// One round-trip probe: connected devices + which tools the Mac has.
function detect() {
  const remote =
    'echo "IOS:$(idevice_id -l 2>/dev/null | tr \'\\n\' \',\')"; ' +
    'echo "AND:$(adb devices 2>/dev/null | sed -n \'2,$p\' | grep -w device | cut -f1 | tr \'\\n\' \',\')"; ' +
    'echo "UNAUTH:$(adb devices 2>/dev/null | sed -n \'2,$p\' | grep -w unauthorized | cut -f1 | tr \'\\n\' \',\')"; ' +
    'echo "TOOLS:adb=$(command -v adb >/dev/null && echo 1 || echo 0),' +
    'altserver=$([ -d /Applications/AltServer.app ] && echo 1 || echo 0),' +
    'sideloadly=$([ -d /Applications/Sideloadly.app ] && echo 1 || echo 0),' +
    'xcode=$(xcode-select -p >/dev/null 2>&1 && echo 1 || echo 0),' +
    `src=$([ -d ${IOS_SOURCE_DIR} ] && echo 1 || echo 0),` +
    'idev=$(command -v ideviceinstaller >/dev/null && echo 1 || echo 0)"';
  const r = ssh(remote);
  const grab = (k) => (r.out.match(new RegExp(`${k}:([^\\n]*)`))?.[1] || '');
  return {
    reachable: r.ok,
    ios: grab('IOS').split(',').filter(Boolean),
    android: grab('AND').split(',').filter(Boolean),
    androidUnauth: grab('UNAUTH').split(',').filter(Boolean),
    tools: Object.fromEntries(grab('TOOLS').split(',').filter(Boolean).map((kv) => kv.split('='))),
    err: r.err,
  };
}

function requireReachable(d) {
  if (!d.reachable) die(`cannot reach Mac host '${SSH_HOST}' over ssh${d.err ? ` — ${d.err}` : ''}`);
}

function installAndroid(version) {
  const d = detect();
  requireReachable(d);
  if (d.tools.adb !== '1') die(`adb is not installed on ${SSH_HOST} (brew install android-platform-tools)`);
  if (!d.android.length) {
    if (d.androidUnauth.length) die(`Android device ${d.androidUnauth[0]} is unauthorized — on the phone, accept the "Allow USB debugging?" prompt (tick "Always allow from this computer"), then re-run.`);
    die(`no Android device connected to ${SSH_HOST}. Enable Developer options → USB debugging, plug in, accept the prompt.`);
  }
  const { url, zip } = androidUrl(version);
  const serial = d.android[0];
  log(`▶ Android → ${serial} [${region()}]: ${url}`);
  // CN: the OSS asset is a zip (bare .apk is blocked on OSS) — download, unzip,
  // grab the .apk at the zip root, then adb install. global: bare apk, install direct.
  const remote = zip
    ? `set -e; TMP=$(mktemp -d); ` +
      `curl -fsSL "${url}" -o "$TMP/pkg.zip"; ` +
      `unzip -o -q "$TMP/pkg.zip" -d "$TMP"; ` +
      `APK=$(ls "$TMP"/*.apk 2>/dev/null | head -1); ` +
      `[ -n "$APK" ] || { echo "no .apk found inside $(basename "${url}")"; exit 1; }; ` +
      `adb -s ${serial} install -r -d "$APK"; rm -rf "$TMP"`
    : `set -e; curl -fsSL "${url}" -o /tmp/cicy-mobile-install.apk && adb -s ${serial} install -r -d /tmp/cicy-mobile-install.apk`;
  const r = ssh(remote, { stream: true });
  if (!r.ok) die('adb install failed (see output above)');
  log('✓ installed on Android');
}

// The iOS IPA is built UNSIGNED, so installing it needs a re-sign with YOUR
// Apple ID. Two guided methods — the agent walks the user through whichever they
// pick, doing the Mac-side automatable steps and teaching the interactive ones
// (Apple ID login / 2FA / trusting the cert can only be done by the user).
function installIos(method, version) {
  const d = detect();
  requireReachable(d);
  if (!d.ios.length) die(`没有连接的 iPhone(${SSH_HOST})。插上 iPhone,在手机上点“信任此电脑”,再重试。`);
  const udid = d.ios[0];
  if (method === 'sideloadly') return iosSideloadly(d, udid, version);
  if (method === 'xcode') return iosXcode(d, udid);
  return iosChooser(d, udid);
}

function iosChooser(d, udid) {
  log(`▶ 已连接 iPhone: ${udid}`);
  log('');
  log('未签名的 IPA 装到 iPhone 需用你自己的 Apple ID 重签。两种方式,挑一种重跑:');
  log('');
  log('  ① Sideloadly 重签 IPA(推荐,快)');
  log('       cicy-mobile-install ios --method sideloadly');
  log(`       需要: Sideloadly(${d.tools.sideloadly === '1' ? '已装 ✓' : '未装 — 会教你下载'}) + 一个 Apple ID`);
  log('  ② Xcode 源码构建安装(不用 Sideloadly)');
  log('       cicy-mobile-install ios --method xcode');
  log(`       需要: Xcode(${d.tools.xcode === '1' ? '✓' : '✗'}) + 源码(${d.tools.src === '1' ? '✓ ' + IOS_SOURCE_DIR : '缺 — 会教你 clone'}) + 开发者账号`);
  log('');
  log('两种都会一步步带你走,并教你最后怎么信任开发者证书。');
}

// ① Sideloadly: download the IPA + open it in Sideloadly, then guide login/2FA/trust.
function iosSideloadly(d, udid, version) {
  const file = version ? `cicy-${version}.ipa` : 'cicy-latest.ipa';
  const url = iosUrl(version);
  log(`▶ iOS · Sideloadly 方式 (设备 ${udid}) [${region()}]`);
  if (d.tools.sideloadly !== '1') {
    log('');
    log('① Mac 上没装 Sideloadly,先装:');
    log('   • 打开 https://sideloadly.io/ 下载 macOS 版 → 拖进“应用程序” → 打开一次');
    ssh('open https://sideloadly.io/ >/dev/null 2>&1 || true');
    log('   • 我已帮你打开下载页。装好后重跑: cicy-mobile-install ios --method sideloadly');
    return;
  }
  const dst = `${DL_DIR}/${file}`;
  log('');
  log(`① 下载 IPA 到 ${dst}: ${url}`);
  const r = ssh(`mkdir -p ${DL_DIR} && curl -fsSL "${url}" -o ${dst} && ls -lh ${dst} | awk '{print $5}'`);
  if (!r.ok) die(`下载 IPA 失败: ${r.err || r.out}`);
  log(`   ✓ ${dst} (${r.out})`);
  ssh(`open -a Sideloadly ${dst} >/dev/null 2>&1 || true`);
  log('   ✓ 已用 Sideloadly 打开该 IPA');
  log('');
  log('② 在 Mac 的 Sideloadly 窗口里手动完成(登录和验证码我没法替你做):');
  log(`   • 顶部 device 选你的 iPhone(${udid})`);
  log('   • Apple ID 填你自己的(免费 ID 也行,签出来 7 天有效)');
  log('   • 点 Start → 输 Apple ID 密码 → 输发到你设备上的 2FA 验证码');
  log('   • 等 Sideloadly 自动建 App ID/描述文件、重签、装到手机');
  log('');
  log('③ 第一次打开提示“未受信任的开发者”,去信任:');
  log('   iPhone → 设置 → 通用 → VPN 与设备管理 → 点你的 Apple ID → 信任');
  log('');
  log('④ 验证: cicy-mobile-install status  (或手机上直接打开 CiCy)');
}

// ② Xcode from source: guide prebuild + automatic-signing build + install + trust.
function iosXcode(d, udid) {
  log(`▶ iOS · Xcode 源码方式 (设备 ${udid})`);
  if (d.tools.xcode !== '1') {
    log('✗ 未检测到 Xcode。请从 App Store 装 Xcode,打开一次(同意许可、装组件),再重跑。');
    return;
  }
  if (d.tools.src !== '1') {
    log('');
    log(`① 源码不在 ${IOS_SOURCE_DIR},先克隆:`);
    log(`   git clone https://github.com/cicy-ai/cicy-mobile.git ${IOS_SOURCE_DIR}`);
    log('   装好后重跑: cicy-mobile-install ios --method xcode');
    return;
  }
  log('');
  log(`① 准备工程(Mac, ${IOS_SOURCE_DIR}):`);
  log(`   cd ${IOS_SOURCE_DIR} && npm install && npx expo prebuild -p ios --no-install && (cd ios && pod install)`);
  log('');
  log('② 自动签名构建并安装(开发者账号需已在 Xcode 登录):');
  log(`   cd ${IOS_SOURCE_DIR}/ios`);
  log("   xcodebuild -workspace CiCy.xcworkspace -scheme CiCy -configuration Release \\");
  log(`     -destination 'id=${udid}' -derivedDataPath build -allowProvisioningUpdates \\`);
  log("     DEVELOPMENT_TEAM=<你的TeamID> CODE_SIGN_STYLE=Automatic clean build");
  log("   APP=$(ls -d build/Build/Products/Release-iphoneos/*.app | head -1)");
  log(`   ios-deploy --id ${udid} --bundle "$APP"`);
  log('   （或直接在 Xcode 打开 CiCy.xcworkspace,选这台设备点 ▶ 运行)');
  log('');
  log('③ 第一次打开,信任开发者证书:');
  log('   iPhone → 设置 → 通用 → VPN 与设备管理 → 点开发者 App → 信任');
  log('');
  log('提示:让 cicy agent 替你跑 ①②③ 也行 — 它会自动注册设备、构建、安装并盯进度。');
}

function status() {
  const d = detect();
  if (!d.reachable) die(`Mac host '${SSH_HOST}' unreachable${d.err ? ` — ${d.err}` : ''}`);
  log(`host:    ${SSH_HOST}`);
  const reg = region();
  log(`region:  ${reg}  (${reg === 'cn' ? 'Aliyun OSS Shanghai' : 'GitHub Releases'})`);
  // latest available version, from the geo-agnostic manifest (best-effort).
  const vr = ssh(`curl -fsS -m 6 "${VERSION_URL}" 2>/dev/null || true`);
  try { const j = JSON.parse(vr.out); if (j.version) log(`latest:  ${j.version}`); } catch { /* manifest unavailable */ }
  const t = d.tools;
  log(`tools:   adb=${t.adb === '1' ? '✓' : '✗'}  ideviceinstaller=${t.idev === '1' ? '✓' : '✗'}  Sideloadly=${t.sideloadly === '1' ? '✓' : '✗'}  Xcode=${t.xcode === '1' ? '✓' : '✗'}  src=${t.src === '1' ? '✓' : '✗'}`);
  log(`android: ${d.android.length ? d.android.join(', ') : '(none connected)'}`);
  log(`ios:     ${d.ios.length ? d.ios.join(', ') : '(none connected)'}`);
}

function auto(method, version) {
  const d = detect();
  requireReachable(d);
  if (d.android.length) return installAndroid(version);
  if (d.ios.length) return installIos(method, version);
  die(`no device connected to ${SSH_HOST} (plug an Android with USB-debugging, or an iPhone)`);
}

const HELP = `cicy-mobile-install — install the latest cicy-mobile build onto a USB-connected phone via the Mac host.

usage:
  cicy-mobile-install auto                      auto-detect the connected device and install latest
  cicy-mobile-install android [ver]             pull APK (GitHub global / OSS-zip CN) and adb install (ver defaults to latest)
  cicy-mobile-install ios [--method M] [ver]    iOS install — guided. M = sideloadly | xcode
                                                  (no --method → prints the two options to choose from)
  cicy-mobile-install status                    show host reachability, tools, connected devices
  cicy-mobile-install help

iOS notes: the IPA is unsigned, so it must be re-signed with YOUR Apple ID.
  • sideloadly — download the IPA + open it in Sideloadly; you do Apple ID login / 2FA / Start.
  • xcode      — build from source with automatic signing + ios-deploy. Both methods walk you
                 through trusting the developer cert at the end.

distribution: global → GitHub Releases (bare apk/ipa); CN → Aliyun OSS Shanghai
  (bare .ipa; .apk is zip-wrapped and unzipped before install). Region is
  auto-detected on the Mac; force it with CICY_INSTALL_REGION or cfg.region.

config (optional): ${CFG_PATH}
  { "ssh_host": "mac", "region": "auto",
    "download_dir": "~/Downloads", "ios_source_dir": "~/Downloads/cicy-mobile" }
env: CICY_INSTALL_SSH_HOST overrides ssh_host; CICY_INSTALL_REGION = cn|global.`;

// flags: --method/-m <sideloadly|xcode>; remaining positionals = [cmd, version]
const argv = process.argv.slice(2);
let method = '';
const pos = [];
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === '--method' || argv[i] === '-m') { method = (argv[++i] || '').toLowerCase(); continue; }
  pos.push(argv[i]);
}
const cmd = pos[0];
const arg = pos[1]; // version
switch (cmd) {
  case undefined: case 'help': case '--help': case '-h': log(HELP); break;
  case 'auto': auto(method, arg); break;
  case 'android': installAndroid(arg); break;
  case 'ios': installIos(method, arg); break;
  case 'status': status(); break;
  default: die(`unknown command '${cmd}'\n\n${HELP}`);
}
