#!/usr/bin/env node
// cicy-audit-policy — thin client for the audit-policy admin skill.
//
// Talks to cicy-code on $PORT (default 8008), authenticated with
// ~/cicy-ai/global.json#api_token. Same backend the UI Audit dashboard
// uses; this just gives the 审计策略专员 a stable command surface for BOTH
// jobs: configuring policy AND analysing the audit log.
//
// Policy:   show summary patch set unset
// Logs:     events event stats snapshot agents recent history
// FP/allow: allowlist allowlist-add allowlist-remove
import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { spawnSync } from 'node:child_process';

const HOME = homedir();
const GLOBAL_JSON = join(HOME, 'cicy-ai', 'global.json');
const AUDIT_DIR = join(HOME, 'cicy-ai', 'audit');

function die(msg) {
  process.stderr.write(`error: ${msg}\n`);
  process.exit(1);
}

function loadToken() {
  try {
    const tok = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')).api_token;
    if (tok) return tok;
  } catch { /* fall through */ }
  die(`api_token not found in ${GLOBAL_JSON}`);
}

function baseURL() {
  return `http://127.0.0.1:${process.env.PORT || '8008'}`;
}

// Single HTTP call to the audit backend, Bearer-authed, 15s timeout.
async function api(method, path, body) {
  const url = baseURL() + path;
  const headers = { Authorization: `Bearer ${loadToken()}` };
  const opts = { method, headers };
  if (body !== undefined) {
    headers['Content-Type'] = 'application/json';
    opts.body = JSON.stringify(body);
  }
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 15000);
  opts.signal = ctrl.signal;
  let resp;
  try {
    resp = await fetch(url, opts);
  } catch (e) {
    die(`cannot reach ${url}: ${e.name === 'AbortError' ? 'timed out' : e.message}`);
  } finally {
    clearTimeout(timer);
  }
  if (!resp.ok) {
    const txt = (await resp.text().catch(() => '')).slice(0, 400);
    die(`HTTP ${resp.status} on ${path}: ${txt}`);
  }
  const txt = await resp.text();
  return txt ? JSON.parse(txt) : {};
}

// Merge src into dst. Lists are *replaced*, not appended — caller passes the
// full intended list. Plain objects merge key-by-key.
function deepMerge(dst, src) {
  const isObj = (x) => x && typeof x === 'object' && !Array.isArray(x);
  for (const k of Object.keys(src)) {
    const v = src[k];
    if (isObj(v) && isObj(dst[k])) deepMerge(dst[k], v);
    else dst[k] = v;
  }
  return dst;
}

// Parse a CLI value as JSON if possible, otherwise keep it as a string.
function parseValue(v) {
  try { return JSON.parse(v); } catch { return v; }
}

// ───────────────────────── policy ─────────────────────────

async function cmdShow() {
  const policy = await api('GET', '/api/audit/policy');
  console.log(JSON.stringify(policy, null, 2));
}

async function cmdSummary() {
  const p = await api('GET', '/api/audit/policy');
  const ov = p.rules_override || [];
  const cr = p.custom_rules || [];
  const al = p.allow_list || {};
  const pv = p.preventive || {};
  const ir = p.incident_response || {};
  console.log(`enabled:        ${p.enabled ?? true}`);
  console.log(`fail_mode:      ${p.fail_mode ?? 'open'}`);
  console.log(`rules_override: ${ov.length} rule(s)`);
  for (const r of ov) {
    const bits = [];
    if (r.disabled) bits.push('DISABLED');
    if (r.severity) bits.push(`severity=${r.severity}`);
    if (r.default_action) bits.push(`action=${r.default_action}`);
    console.log(`  - ${r.id}  ${bits.join(' ')}`);
  }
  console.log(`custom_rules:   ${cr.length} rule(s)`);
  for (const r of cr) {
    const m = r.match || {};
    const pat = m.pattern || '';
    const patShort = pat.length > 40 ? pat.slice(0, 40) + '…' : pat;
    console.log(`  - ${r.id}  severity=${r.severity} action=${r.default_action || '-'} match=${m.type || '?'}(${patShort})`);
  }
  console.log(`allow_list:     paths=${(al.paths || []).length} hashes=${(al.content_hashes || []).length} agents=${JSON.stringify(al.agents || [])}`);
  console.log(`preventive:     enabled=${pv.enabled ?? false} fail_mode=${pv.fail_mode || 'open'}`);
  console.log(`incident_email: enabled=${ir.enabled ?? false} min=${ir.trigger_min_severity || 'high'} cooldown=${ir.cooldown_seconds ?? 1800}s`);
}

async function applyMerge(patch) {
  if (typeof patch !== 'object' || patch === null || Array.isArray(patch)) {
    die('patch must be a JSON object');
  }
  const current = await api('GET', '/api/audit/policy');
  const merged = deepMerge(current, patch);
  const res = await api('POST', '/api/audit/policy', merged);
  console.log(`ok  hash=${res.policy_hash || '?'}`);
}

async function cmdPatch(patchJson) {
  let patch;
  try { patch = JSON.parse(patchJson); } catch (e) { die(`invalid JSON: ${e.message}`); }
  await applyMerge(patch);
}

async function cmdSet(key, rawValue) {
  const parts = key.split('.');
  const val = parseValue(rawValue);
  const patch = {};
  let cur = patch;
  for (const p of parts.slice(0, -1)) { cur[p] = {}; cur = cur[p]; }
  cur[parts[parts.length - 1]] = val;
  await applyMerge(patch);
}

async function cmdUnset(key) {
  const parts = key.split('.');
  const current = await api('GET', '/api/audit/policy');
  let cur = current;
  for (const p of parts.slice(0, -1)) {
    if (!cur || typeof cur !== 'object' || !(p in cur)) die(`key ${JSON.stringify(key)} not present`);
    cur = cur[p];
  }
  const last = parts[parts.length - 1];
  if (!cur || typeof cur !== 'object' || !(last in cur)) die(`key ${JSON.stringify(key)} not present`);
  delete cur[last];
  const res = await api('POST', '/api/audit/policy', current);
  console.log(`ok  hash=${res.policy_hash || '?'}`);
}

// rule-test — dry-run a matcher before you add it (regex or js), against a
// sample text. Returns whether it matches. Always test before shipping a rule.
async function cmdRuleTest(matchType, pattern, text) {
  if (matchType !== 'regex' && matchType !== 'js') die('match_type must be regex|js');
  const res = await api('POST', '/api/audit/rules/test', { match_type: matchType, pattern, text });
  console.log(JSON.stringify(res, null, 2));
}

// effective — the merged policy actually in force for one agent (global ⊕
// per-agent override). Use it to see what a given agent is really subject to.
async function cmdEffective(agent) {
  const p = await api('GET', `/api/audit/policy/effective/${encodeURIComponent(agent)}`);
  console.log(JSON.stringify(p, null, 2));
}

// ───────────────────────── logs / analysis ─────────────────────────

// Flag parser shared by events/recent: --severity --agent --direction --rule
// --limit --json plus a bare positional treated as a raw query string.
function parseEventFlags(args) {
  const out = { limit: 20, json: false, raw: '' };
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--limit') out.limit = parseInt(args[++i] || '20', 10) || 20;
    else if (a === '--severity') out.severity = args[++i] || '';
    else if (a === '--agent') out.agent = args[++i] || '';
    else if (a === '--direction') out.direction = args[++i] || '';
    else if (a === '--rule') out.rule = args[++i] || '';
    else if (a === '--json') out.json = true;
    else if (!a.startsWith('--') && !out.raw) out.raw = a; // bare raw query string
  }
  return out;
}

function buildEventsQS(o) {
  if (o.raw) {
    // Raw query string passed verbatim (e.g. "severity=high,critical&direction=outbound").
    return o.raw + (/(^|&)limit=/.test(o.raw) ? '' : `&limit=${o.limit}`);
  }
  const parts = [`limit=${o.limit}`];
  if (o.severity) parts.push(`severity=${encodeURIComponent(o.severity)}`);
  if (o.agent) parts.push(`agent_id=${encodeURIComponent(o.agent)}`);
  if (o.direction) parts.push(`direction=${encodeURIComponent(o.direction)}`);
  if (o.rule) parts.push(`rule=${encodeURIComponent(o.rule)}`);
  return parts.join('&');
}

function printEventLine(e) {
  const ident = e.identity || {};
  const findings = e.findings || [];
  const sev = findings.map((f) => f.severity).filter(Boolean);
  const worst = ['critical', 'high', 'medium', 'low'].find((s) => sev.includes(s)) || '-';
  console.log(
    `${e.id || e.event_id || ''}  ${e.ts || ''}  agent=${ident.agent_id || ''}  dir=${e.direction || '-'}  sev=${worst}  rules=${JSON.stringify(findings.map((f) => f.rule_id))}`,
  );
}

async function cmdEvents(args) {
  const o = parseEventFlags(args);
  const data = await api('GET', `/api/audit/events?${buildEventsQS(o)}`);
  if (o.json) { console.log(JSON.stringify(data, null, 2)); return; }
  const events = data.events || [];
  if (events.length === 0) { console.log('(no matching events)'); return; }
  for (const e of events) printEventLine(e);
}

async function cmdEvent(id) {
  const e = await api('GET', `/api/audit/events/${encodeURIComponent(id)}`);
  console.log(JSON.stringify(e, null, 2));
}

async function cmdStats() {
  const s = await api('GET', '/api/audit/stats');
  console.log(JSON.stringify(s, null, 2));
}

async function cmdSnapshot(ref) {
  const s = await api('GET', `/api/audit/snapshot?ref=${encodeURIComponent(ref)}`);
  console.log(JSON.stringify(s, null, 2));
}

async function cmdAgents() {
  const data = await api('GET', '/api/audit/agents');
  console.log(JSON.stringify(data, null, 2));
}

// recent — kept for back-compat: a compact event list filtered by rule/agent.
function parseRecentFlags(args) {
  const out = { limit: 10, rule: '', agent: '' };
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--rule') out.rule = args[++i] || '';
    else if (args[i] === '--agent') out.agent = args[++i] || '';
    else if (args[i] === '--limit') out.limit = parseInt(args[++i] || '10', 10) || 10;
  }
  return out;
}

async function cmdRecent(args) {
  const o = parseRecentFlags(args);
  let qs = `limit=${o.limit}`;
  if (o.rule) qs += `&rule=${encodeURIComponent(o.rule)}`;
  if (o.agent) qs += `&agent_id=${encodeURIComponent(o.agent)}`;
  const data = await api('GET', `/api/audit/events?${qs}`);
  const events = data.events || [];
  if (events.length === 0) { console.log('(no matching events)'); return; }
  for (const e of events) printEventLine(e);
}

function cmdHistory() {
  if (!existsSync(join(AUDIT_DIR, '.git'))) {
    console.log("(no git history in ~/cicy-ai/audit — autonomy hasn't auto-committed yet)");
    return;
  }
  const r = spawnSync('git', ['-C', AUDIT_DIR, 'log', '--oneline', '-n', '20'], { stdio: 'inherit' });
  if (r.error) die(`git not on PATH: ${r.error.message}`);
}

// ───────────────────────── false positives / allow-list ─────────────────────────

async function cmdAllowlist() {
  const al = await api('GET', '/api/audit/allowlist');
  console.log(`content_hashes: ${(al.content_hashes || []).length}`);
  for (const h of al.content_hashes || []) console.log(`  - ${typeof h === 'string' ? h : JSON.stringify(h)}`);
  console.log(`paths:          ${JSON.stringify(al.paths || [])}`);
  console.log(`agents:         ${JSON.stringify(al.agents || [])}`);
}

async function cmdAllowlistAdd(sha256, reasonParts) {
  let sha = sha256;
  if (!sha.startsWith('sha256:')) sha = `sha256:${sha}`;
  const reason = (reasonParts || []).join(' ');
  await api('POST', '/api/audit/allowlist/content', { sha256: sha, reason });
  console.log(`ok  allow-listed ${sha}${reason ? `  (${reason})` : ''}`);
}

async function cmdAllowlistRemove(category, value) {
  await api('DELETE', '/api/audit/allowlist', { category, value });
  console.log(`ok  removed ${category}=${value}`);
}

// ───────────────────────── help / dispatch ─────────────────────────

function printHelp() {
  try {
    process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8'));
  } catch {
    process.stdout.write(
      'Usage: cicy-audit-policy <command>\n' +
      '  policy: show | summary | patch <json> | set <k.path> <v> | unset <k.path>\n' +
      '          rule-test <regex|js> <pattern> <text> | effective <agent>\n' +
      '  logs:   events [--severity S] [--agent A] [--direction outbound|inbound] [--rule R] [--limit N] [--json]\n' +
      '          event <id> | stats | snapshot <ref> | agents | recent | history\n' +
      '  allow:  allowlist | allowlist-add <sha256> <reason...> | allowlist-remove <content_hash|path|agent> <value>\n',
    );
  }
}

async function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];
  switch (cmd) {
    // policy
    case 'show': return cmdShow();
    case 'summary': return cmdSummary();
    case 'patch':
      if (!argv[1]) die('patch requires a JSON argument');
      return cmdPatch(argv[1]);
    case 'set':
      if (argv.length < 3) die('set requires <key.path> <value>');
      return cmdSet(argv[1], argv[2]);
    case 'unset':
      if (!argv[1]) die('unset requires <key.path>');
      return cmdUnset(argv[1]);
    case 'rule-test':
      if (argv.length < 4) die('rule-test requires <regex|js> <pattern> <text>');
      return cmdRuleTest(argv[1], argv[2], argv[3]);
    case 'effective':
      if (!argv[1]) die('effective requires an <agent>');
      return cmdEffective(argv[1]);
    // logs / analysis
    case 'events': return cmdEvents(argv.slice(1));
    case 'event':
      if (!argv[1]) die('event requires an <id>');
      return cmdEvent(argv[1]);
    case 'stats': return cmdStats();
    case 'snapshot':
      if (!argv[1]) die('snapshot requires a <ref>');
      return cmdSnapshot(argv[1]);
    case 'agents': return cmdAgents();
    case 'recent': return cmdRecent(argv.slice(1));
    case 'history': return cmdHistory();
    // allow-list
    case 'allowlist': return cmdAllowlist();
    case 'allowlist-add':
      if (!argv[1]) die('allowlist-add requires <sha256> [reason...]');
      return cmdAllowlistAdd(argv[1], argv.slice(2));
    case 'allowlist-remove':
      if (argv.length < 3) die('allowlist-remove requires <category> <value>');
      return cmdAllowlistRemove(argv[1], argv[2]);
    case '-h': case '--help': case 'help': case undefined:
      printHelp();
      return;
    default:
      die(`unknown command: ${cmd}. try: show summary patch set unset rule-test effective events event stats snapshot agents recent history allowlist allowlist-add allowlist-remove`);
  }
}

main().catch((e) => die(e && e.message ? e.message : String(e)));
