#!/usr/bin/env node
// agent-chrome — control system Chrome on a connected cicy-desktop host.
// Each subcommand maps to a `chrome_*` electronRPC tool, dispatched as a
// desktop_event over the chat WebSocket. Requires Node 22+.

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { randomBytes, createHmac } from 'node:crypto';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

if (typeof globalThis.WebSocket !== 'function') {
  process.stderr.write('agent-chrome: native WebSocket missing — Node 22+ required\n');
  process.exit(1);
}

let clientID = '';
const args = [];
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === '--client' || argv[i] === '-c') { clientID = argv[++i] || ''; continue; }
  args.push(argv[i]);
}

const json = args.includes('--json');
const cmd = args[0];
const rest = args.slice(1).filter((a) => a !== '--json');

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const HTTP_BASE = `http://127.0.0.1:${API_PORT}`;
const WS_BASE   = `ws://127.0.0.1:${API_PORT}`;
const RPC_TIMEOUT_MS = Number(process.env.CICY_AGENT_TIMEOUT_MS || 60000); // Chrome ops can take longer

(async () => {
  try {
    switch (cmd) {
      case 'tools':     printTools(); return;
      case 'list':      await cmdProfiles(rest); return;
      case 'profiles':  await cmdProfiles(rest); return;
      case 'profile':   await cmdProfile(rest); return;
      case 'add':       await cmdAdd(rest); return;
      case 'proxy':     await cmdProxy(rest); return;
      case 'note':      await cmdNote(rest); return;
      case 'account':   await cmdAccount(rest); return;
      case 'password':  await cmdField(rest, 'password'); return;
      case '2fa':       await cmdField(rest, 'totp'); return;
      case 'otp':       await cmdOtp(rest); return;
      case 'accounts':  await cmdAccounts(rest); return;
      case 'ip':        await cmdIp(rest); return;
      case 'launch':    await cmdLaunch(rest); return;
      case 'close':     await cmdClose(rest); return;
      case 'targets':   await cmdTargets(rest); return;
      case 'cdp':       await cmdCDP(rest); return;
      case 'gmails':    await cmdSimpleRPC('chrome_list_gmails'); return;
      case 'github':    await cmdSimpleRPC('chrome_list_github_accounts'); return;
      case 'detect-logins': await cmdDetectLogins(rest); return;
      case 'probe-ip':  await cmdProbeIp(rest); return;
      case 'login':     await cmdLogin(rest); return;
      case 'logins':    await cmdLoginsList(rest); return;
      default: bail(`unknown command: ${cmd}. Try agent-chrome --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers (shared with agent-desktop pattern) ─────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`agent-chrome: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: agent-chrome <profiles|profile|add|proxy|note|account|password|2fa|otp|accounts|ip|launch|close|targets|cdp|gmails|github> [...] [--client ID]\n'); }
}
function printTools() {
  try { process.stdout.write(readFileSync(new URL('../references/tools.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('# agent-chrome tools\n'); }
}

function loadToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON}`), { exitCode: 3 });
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

function randomID(prefix) { return `${prefix}-${Date.now()}-${randomBytes(4).toString('hex')}`; }

async function api(method, path, payload) {
  const token = loadToken();
  const headers = { 'Authorization': `Bearer ${token}` };
  const init = { method, headers };
  if (payload !== undefined) { headers['Content-Type'] = 'application/json'; init.body = JSON.stringify(payload); }
  let res;
  try { res = await fetch(HTTP_BASE + path, init); }
  catch (e) { throw Object.assign(new Error(`cannot reach cicy-code at ${HTTP_BASE} (${e.message})`), { exitCode: 3 }); }
  const text = await res.text();
  if (res.status === 401 || res.status === 403) throw Object.assign(new Error(`auth failed (${res.status})`), { exitCode: 3 });
  if (res.status >= 400) {
    let body; try { body = JSON.parse(text); } catch { body = { error: text }; }
    throw Object.assign(new Error(`api error (${res.status}): ${body?.error || body?.message || text}`), { exitCode: 4 });
  }
  try { return JSON.parse(text); } catch { return text; }
}

async function chatClients() {
  const data = await api('GET', '/api/chat/clients');
  // Server returns an array of client records: { client_id, isElectron,
  // platform, user_agent, ..., non_routing_*_agent_id_display_only }.
  // Older payloads returned a nested { agentID: { clientID: info } } shape —
  // flatten that into the array form so the rest of the code treats one
  // shape only. Note: the non_routing_*_agent_id_display_only fields are
  // metadata; routing is by client_id alone.
  let raw = data?.clients || data?.data?.clients || data?.data || data || [];
  if (!Array.isArray(raw)) {
    const flat = [];
    for (const [aid, m] of Object.entries(raw)) {
      for (const [cid, info] of Object.entries(m || {})) {
        flat.push({ client_id: cid, non_routing_master_agent_id_display_only: aid, ...info });
      }
    }
    raw = flat;
  }
  return raw.filter((c) => c?.client_id);
}

async function resolveDesktop() {
  const clients = await chatClients();
  if (clientID) {
    const c = clients.find((x) => x?.client_id === clientID);
    if (!c) throw Object.assign(new Error(`client_id ${clientID} not found`), { exitCode: 4 });
    return { clientID: c.client_id };
  }
  const matches = clients.filter((c) => {
    const ua = String(c?.user_agent || '').toLowerCase();
    return c?.isElectron === true || ua.includes('electronmcp') || ua.includes('cicydesktop');
  });
  if (matches.length === 0) throw Object.assign(new Error('no cicy-desktop client connected'), { exitCode: 3 });
  if (matches.length > 1)  throw Object.assign(new Error('multiple cicy-desktop clients connected; pass --client <id>'), { exitCode: 2 });
  return { clientID: matches[0].client_id };
}

async function rpc(tool, toolArgs) {
  const target = await resolveDesktop();
  // wait_ack sync mode keys solely on client_id — no agent_id needed.
  // The server injects its own requestId (overriding ours), registers a
  // waiter, sendToClient(client_id), and replies on the HTTP response when
  // the client writes back any message with that requestId.
  const rid = randomID('crpc');
  const resp = await api('POST', '/api/chat/push', {
    client_id: target.clientID,
    type: 'desktop_event',
    wait_ack: true,
    timeout_ms: RPC_TIMEOUT_MS,
    data: { type: 'rpc_call', tool, args: toolArgs ?? {}, requestId: rid },
  });
  const data = resp?.data || {};
  if (data.error) throw Object.assign(new Error(String(data.error)), { exitCode: 4 });
  return data.result;
}

function emit(result) {
  if (json) return ok(result);
  if (typeof result === 'string') console.log(result);
  else console.log(JSON.stringify(result, null, 2));
}

function intArg(s, name) {
  const n = parseInt(s, 10);
  if (Number.isNaN(n)) throw Object.assign(new Error(`${name} must be a number, got: ${s}`), { exitCode: 2 });
  return n;
}

// Accept the unified profile id ("chrome-3") or a bare accountIdx ("3").
function profileIdx(s) {
  const m = /^chrome-(\d+)$/.exec(String(s || '').trim());
  return intArg(m ? m[1] : s, 'profileId');
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdProfiles(args) {
  const includeHidden = args.includes('--all');
  // `--with <service>` filters to profiles tagged with (or signed into) that
  // service, e.g. `profiles --with github`. Matches the per-profile `accounts`
  // tags AND any non-empty `platform.<service>` (gmail/github/kiro signed-in
  // detection), case-insensitive.
  let withSvc = null;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--with') { withSvc = String(args[++i] || '').trim().toLowerCase(); }
  }
  const res = await rpc('chrome_list_profiles', { includeHidden });
  if (!withSvc) return emit(res);

  const list = Array.isArray(res) ? res : (res?.profiles || res?.entries || []);
  const has = (p) => {
    // accounts is a { service: accountId } map; a non-empty value means the
    // profile holds an account for that service.
    const accts = p?.accounts && typeof p.accounts === 'object' && !Array.isArray(p.accounts) ? p.accounts : {};
    const a = accts[withSvc];
    if (typeof a === 'string' ? a : (a && typeof a === 'object' && Object.keys(a).length)) return true;
    const plat = p?.platform && typeof p.platform === 'object' ? p.platform : {};
    const v = plat[withSvc];
    if (v && (typeof v !== 'object' || Object.keys(v).length)) return true;
    if (withSvc === 'gmail' && p?.gmail) return true; // gmail lives at top level
    return false;
  };
  const filtered = Array.isArray(list) ? list.filter(has) : list;
  emit(Array.isArray(res) ? filtered : { ...res, profiles: filtered, filteredBy: withSvc, count: filtered.length });
}

async function cmdProfile(args) {
  if (args.length === 0) throw Object.assign(new Error('usage: agent-chrome profile <accountIdx>'), { exitCode: 2 });
  const idx = intArg(args[0], 'accountIdx');
  emit(await rpc('chrome_get_profile', { accountIdx: idx }));
}

async function cmdAdd(args) {
  const params = {};
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--gmail') { params.gmail = args[++i]; continue; }
    if (args[i] === '--org-path') { params.orgPath = args[++i]; continue; }
    if (args[i] === '--launch') { params.launchAfterCreate = true; continue; }
  }
  emit(await rpc('chrome_add_profile', params));
}

async function cmdProxy(args) {
  if (args.length < 2) throw Object.assign(new Error('usage: agent-chrome proxy <id> <url|"">'), { exitCode: 2 });
  emit(await rpc('chrome_set_profile_proxy', { accountIdx: profileIdx(args[0]), proxy: args[1] }));
}

// note <idx> <text...> — set a free-form note on the profile (chrome.json).
async function cmdNote(args) {
  if (args.length < 1) throw Object.assign(new Error('usage: agent-chrome note <accountIdx> <text>   (empty text clears)'), { exitCode: 2 });
  const idx = intArg(args[0], 'accountIdx');
  const note = args.slice(1).join(' ');
  emit(await rpc('chrome_set_profile_meta', { accountIdx: idx, note }));
}

// account <idx> <service> <accountId...> — record the login id for a service,
// e.g. `account 3 github octocat`. Empty accountId clears the id field.
async function cmdAccount(args) {
  if (args.length < 2) throw Object.assign(new Error('usage: agent-chrome account <accountIdx> <service> <accountId>   (empty clears the id)'), { exitCode: 2 });
  await setAccountField(intArg(args[0], 'accountIdx'), args[1], 'account', args.slice(2).join(' '));
}

// password / 2fa setters share one path: `<cmd> <idx> <service> <value>`.
// `2fa` stores a TOTP secret (base32) under `totp`. Empty value clears the field.
async function cmdField(args, field) {
  if (args.length < 2) throw Object.assign(new Error(`usage: agent-chrome ${cmd} <accountIdx> <service> <value>   (empty clears it)`), { exitCode: 2 });
  await setAccountField(intArg(args[0], 'accountIdx'), args[1], field, args.slice(2).join(' '));
}

async function setAccountField(idx, serviceRaw, field, valueRaw) {
  const service = String(serviceRaw).trim().toLowerCase();
  const value = String(valueRaw).trim();
  const res = await rpc('chrome_set_profile_meta', { accountIdx: idx, accounts: { [service]: { [field]: value } } });
  // The RPC echoes the full entry (incl. secrets) — mask before printing.
  const accounts = maskAccounts(res?.privateConfig?.accounts ?? res?.accounts);
  emit({ success: res?.success !== false, accountIdx: idx, service, set: value === '' ? `${field} cleared` : field, accounts });
}

// accounts <idx> [--show] — list the service→{account,password,totp} map.
// Secrets (password/totp) are masked unless --show is passed.
async function cmdAccounts(args) {
  if (args.length < 1) throw Object.assign(new Error('usage: agent-chrome accounts <accountIdx> [--show]'), { exitCode: 2 });
  const idx = intArg(args[0], 'accountIdx');
  const show = args.includes('--show');
  const p = await rpc('chrome_get_profile', { accountIdx: idx });
  const accounts = maskAccounts(p?.accounts, show);
  emit({ accountIdx: idx, note: p?.note || '', accounts });
}

// detect-logins <idx> — infer which sites this profile's LIVE session is logged
// into, from its cookies (vs. `logins`, which is the manual rich ledger).
async function cmdDetectLogins(args) {
  if (args.length < 1) throw Object.assign(new Error('usage: agent-chrome detect-logins <accountIdx>'), { exitCode: 2 });
  emit(await rpc('chrome_detect_logins', { accountIdx: intArg(args[0], 'accountIdx') }));
}

// probe-ip <idx> — probe egress IP + area through the profile's proxy and STORE
// to config (vs `ip`, which is a live read from a running Chrome and doesn't persist).
async function cmdProbeIp(args) {
  if (args.length < 1) throw Object.assign(new Error('usage: agent-chrome probe-ip <accountIdx>'), { exitCode: 2 });
  emit(await rpc('chrome_probe_ip', { accountIdx: intArg(args[0], 'accountIdx') }));
}

// parse `--name x --url y --2fa z ...` into a rich-login payload object.
function parseLoginFlags(args, base = {}) {
  const MAP = { '--name': 'name', '--url': 'url', '--username': 'username', '--email': 'email',
    '--mobile': 'mobile', '--2fa': 'twofa', '--second-email': 'secondEmail', '--note': 'note', '--login-at': 'loginAt' };
  const out = { ...base };
  for (let i = 0; i < args.length; i++) { const k = MAP[args[i]]; if (k) out[k] = args[++i] || ''; }
  return out;
}

// login set/rm — manage this profile's rich login ledger (地址/名称/用户名/邮箱/手机/2FA/备用邮箱/备注).
async function cmdLogin(args) {
  const sub = args[0];
  if (sub === 'set') {
    if (args.length < 2) throw Object.assign(new Error('usage: agent-chrome login set <idx> --name <名称> [--url --username --email --mobile --2fa --second-email --note]'), { exitCode: 2 });
    const payload = parseLoginFlags(args.slice(2), { accountIdx: intArg(args[1], 'accountIdx') });
    if (!payload.name) throw Object.assign(new Error('login set 需要 --name <名称>'), { exitCode: 2 });
    emit(await rpc('chrome_profile_login_set', payload));
  } else if (sub === 'rm') {
    if (args.length < 3) throw Object.assign(new Error('usage: agent-chrome login rm <idx> <name>'), { exitCode: 2 });
    emit(await rpc('chrome_profile_login_rm', { accountIdx: intArg(args[1], 'accountIdx'), platform: args[2] }));
  } else {
    throw Object.assign(new Error('usage: agent-chrome login <set|rm> ...'), { exitCode: 2 });
  }
}

async function cmdLoginsList(args) {
  if (args.length < 1) throw Object.assign(new Error('usage: agent-chrome logins <accountIdx>'), { exitCode: 2 });
  emit(await rpc('chrome_profile_logins', { accountIdx: intArg(args[0], 'accountIdx') }));
}

// otp <idx> <service> — generate the current TOTP (2FA) code from the stored
// secret for that service. Prints just the 6-digit code (and seconds left).
async function cmdOtp(args) {
  if (args.length < 2) throw Object.assign(new Error('usage: agent-chrome otp <accountIdx> <service>'), { exitCode: 2 });
  const idx = intArg(args[0], 'accountIdx');
  const service = String(args[1]).trim().toLowerCase();
  const p = await rpc('chrome_get_profile', { accountIdx: idx });
  const info = p?.accounts?.[service];
  const secret = (info && typeof info === 'object') ? info.totp : null;
  if (!secret) throw Object.assign(new Error(`no 2FA secret stored for ${service} on profile_${idx} (set one: agent-chrome 2fa ${idx} ${service} <base32-secret>)`), { exitCode: 4 });
  const step = 30;
  const code = totp(secret, { step });
  const secondsLeft = step - (Math.floor(Date.now() / 1000) % step);
  emit(json ? { service, code, secondsLeft } : `${code}  (${secondsLeft}s left)`);
}

// ── account-meta helpers ──────────────────────────────────────────────────
// Mask password/totp for display; show the account id plainly. With show=true,
// reveal everything (e.g. for explicit `--show`).
function maskAccounts(accounts, show = false) {
  if (!accounts || typeof accounts !== 'object') return {};
  const out = {};
  for (const [svc, raw] of Object.entries(accounts)) {
    const info = typeof raw === 'string' ? { account: raw } : (raw && typeof raw === 'object' ? raw : {});
    const o = {};
    if (info.account !== undefined && info.account !== '') o.account = info.account;
    if (info.password) o.password = show ? info.password : '✓ set';
    if (info.totp) o.totp = show ? info.totp : '✓ set';
    out[svc] = o;
  }
  return out;
}

// ── TOTP (RFC 6238, HMAC-SHA1, 6 digits, 30s) ──────────────────────────────
function base32Decode(input) {
  const A = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
  const s = String(input).replace(/=+$/g, '').replace(/\s+/g, '').toUpperCase();
  let bits = '';
  for (const c of s) { const i = A.indexOf(c); if (i < 0) continue; bits += i.toString(2).padStart(5, '0'); }
  const bytes = [];
  for (let i = 0; i + 8 <= bits.length; i += 8) bytes.push(parseInt(bits.slice(i, i + 8), 2));
  return Buffer.from(bytes);
}
function totp(secret, { step = 30, digits = 6, t = Date.now() } = {}) {
  const key = base32Decode(secret);
  if (!key.length) throw Object.assign(new Error('invalid TOTP secret (expected base32)'), { exitCode: 2 });
  let counter = Math.floor(t / 1000 / step);
  const buf = Buffer.alloc(8);
  for (let i = 7; i >= 0; i--) { buf[i] = counter & 0xff; counter = Math.floor(counter / 256); }
  const h = createHmac('sha1', key).update(buf).digest();
  const off = h[h.length - 1] & 0x0f;
  const bin = ((h[off] & 0x7f) << 24) | ((h[off + 1] & 0xff) << 16) | ((h[off + 2] & 0xff) << 8) | (h[off + 3] & 0xff);
  return String(bin % (10 ** digits)).padStart(digits, '0');
}

// ip <idx> [--url <ipApi>] — report the profile's egress IP + country by
// fetching an IP-info API from inside that profile's Chrome (so it goes through
// that profile's proxy). Defaults to api.myip.com ({ip,country,cc}); the
// profile must be launched (have a live page target).
async function cmdIp(args) {
  if (args.length < 1) throw Object.assign(new Error('usage: agent-chrome ip <accountIdx> [--url <ipApi>]'), { exitCode: 2 });
  const idx = intArg(args[0], 'accountIdx');
  let url = 'https://api.myip.com';
  for (let i = 1; i < args.length; i++) { if (args[i] === '--url') url = args[++i]; }
  const expression = `fetch(${JSON.stringify(url)}, { cache: 'no-store' }).then(r => r.json()).catch(e => ({ error: String(e && e.message || e) }))`;
  const res = await rpc('chrome_cdp_call', {
    accountIdx: idx,
    method: 'Runtime.evaluate',
    params: { expression, awaitPromise: true, returnByValue: true },
  });
  // chrome_cdp_call → { debuggerPort, result }, result = CDP Runtime.evaluate
  // result: { result: { type, value }, exceptionDetails? }.
  const cdp = res?.result ?? res;
  if (cdp?.exceptionDetails) {
    throw Object.assign(new Error(`page eval failed: ${cdp.exceptionDetails.text || 'exception'} (is the profile launched with an open tab?)`), { exitCode: 4 });
  }
  const value = cdp?.result?.value ?? cdp?.value ?? cdp;
  emit(value);
}

async function cmdLaunch(args) {
  if (args.length === 0) throw Object.assign(new Error('usage: agent-chrome launch <accountIdx> [--url <url>] [--no-activate]'), { exitCode: 2 });
  const idx = intArg(args[0], 'accountIdx');
  const params = { accountIdx: idx };
  for (let i = 1; i < args.length; i++) {
    if (args[i] === '--url') { params.url = args[++i]; continue; }
    if (args[i] === '--no-activate') { params.activateIfRunning = false; continue; }
  }
  emit(await rpc('chrome_launch_profile', params));
}

async function cmdClose(args) {
  if (args.length === 0) throw Object.assign(new Error('usage: agent-chrome close <accountIdx>'), { exitCode: 2 });
  const idx = intArg(args[0], 'accountIdx');
  emit(await rpc('chrome_close_profile', { accountIdx: idx }));
}

async function cmdTargets(args) {
  const params = {};
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--idx') { params.accountIdx = intArg(args[++i], 'accountIdx'); continue; }
  }
  emit(await rpc('chrome_get_targets', params));
}

async function cmdCDP(args) {
  if (args.length < 1) throw Object.assign(new Error('usage: agent-chrome cdp <method> [json_params] [--idx N]'), { exitCode: 2 });
  const params = { method: args[0] };
  if (args[1] && !args[1].startsWith('--')) {
    try { params.params = JSON.parse(args[1]); }
    catch (e) { throw Object.assign(new Error(`invalid json_params: ${e.message}`), { exitCode: 2 }); }
  }
  for (let i = 1; i < args.length; i++) {
    if (args[i] === '--idx') { params.accountIdx = intArg(args[++i], 'accountIdx'); continue; }
  }
  emit(await rpc('chrome_cdp_call', params));
}

async function cmdSimpleRPC(tool) {
  emit(await rpc(tool, {}));
}
