#!/usr/bin/env node
// cping — quick reachability/latency check to a domain or IP.
// Zero npm dependencies. Pure ESM. Node 18+.

import { lookup } from 'node:dns/promises';
import { performance } from 'node:perf_hooks';
import { readFileSync } from 'node:fs';
import { connect } from 'node:net';

// ── arg parsing ────────────────────────────────────────────────────────────

const argv = process.argv.slice(2);

const flags = {
  json: false,
  dnsOnly: false,
  tcpOnly: false,
  timeout: 10,
  port: null,
};

const positional = [];
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--json') flags.json = true;
  else if (a === '--dns-only') flags.dnsOnly = true;
  else if (a === '--tcp-only') flags.tcpOnly = true;
  else if (a === '--timeout') flags.timeout = parseFloat(argv[++i]);
  else if (a === '--port') flags.port = parseInt(argv[++i], 10);
  else if (a === '--help' || a === '-h') showHelp();
  else if (a.startsWith('--')) bail(`unknown flag: ${a}`, 2);
  else positional.push(a);
}

const target = positional[0];
if (!target) {
  process.stderr.write('usage: cping <host>[:port] [--dns-only|--tcp-only] [--port N] [--timeout S] [--json]\n');
  process.exit(2);
}

// allow host:port shorthand
let host = target;
let portFromTarget = flags.port;
const m = target.match(/^([^:]+):(\d+)$/);
if (m) {
  host = m[1];
  portFromTarget = parseInt(m[2], 10);
}

const port = portFromTarget ?? 443;

// ── helpers ────────────────────────────────────────────────────────────────

function bail(message, code = 1, extra = {}) {
  if (flags.json) {
    process.stdout.write(
      JSON.stringify({ ok: false, host, error: { code: errCode(code), message }, ...extra }) + '\n',
    );
  } else {
    process.stderr.write(`cping: ${message}\n`);
  }
  process.exit(code);
}

function errCode(c) {
  return { 1: 'GENERIC', 2: 'INVALID_ARGS', 3: 'TIMEOUT', 4: 'NETWORK' }[c] || 'INTERNAL';
}

function showHelp() {
  try {
    const help = readFileSync(new URL('../help.md', import.meta.url), 'utf8');
    process.stdout.write(help);
  } catch {
    process.stdout.write('cping <host> [--dns-only|--tcp-only] [--port N] [--timeout S] [--json]\n');
  }
  process.exit(0);
}

function withTimeout(promise, ms, label) {
  return Promise.race([
    promise,
    new Promise((_, reject) =>
      setTimeout(() => reject(new Error(`timeout after ${ms}ms (${label})`)), ms),
    ),
  ]);
}

// ── DNS probe ──────────────────────────────────────────────────────────────

async function probeDNS(host, timeoutMs) {
  const t0 = performance.now();
  try {
    const { address, family } = await withTimeout(lookup(host), timeoutMs, 'dns');
    return {
      ok: true,
      address,
      family,
      ms: +(performance.now() - t0).toFixed(2),
    };
  } catch (e) {
    return {
      ok: false,
      error: e.message,
      ms: +(performance.now() - t0).toFixed(2),
    };
  }
}

// ── TCP probe ──────────────────────────────────────────────────────────────

function probeTCP(host, port, timeoutMs) {
  return new Promise((resolve) => {
    const t0 = performance.now();
    const socket = connect({ host, port, timeout: timeoutMs });
    let settled = false;
    const finish = (out) => {
      if (settled) return;
      settled = true;
      try { socket.destroy(); } catch {}
      resolve(out);
    };
    socket.once('connect', () => finish({
      ok: true,
      ms: +(performance.now() - t0).toFixed(2),
    }));
    socket.once('timeout', () => finish({
      ok: false,
      error: `timeout after ${timeoutMs}ms`,
      ms: +(performance.now() - t0).toFixed(2),
    }));
    socket.once('error', (e) => finish({
      ok: false,
      error: e.message,
      ms: +(performance.now() - t0).toFixed(2),
    }));
  });
}

// ── HTTP probe ─────────────────────────────────────────────────────────────

async function probeHTTP(host, port, timeoutMs) {
  const url = port === 80 ? `http://${host}/` : `https://${host}:${port === 443 ? '' : port}/`;
  const t0 = performance.now();
  try {
    const ac = new AbortController();
    const tid = setTimeout(() => ac.abort(), timeoutMs);
    const res = await fetch(url.replace(/:\/$/, '/'), {
      method: 'HEAD',
      signal: ac.signal,
      redirect: 'manual',
    });
    clearTimeout(tid);
    return {
      ok: true,
      status: res.status,
      ms: +(performance.now() - t0).toFixed(2),
    };
  } catch (e) {
    return {
      ok: false,
      error: e.name === 'AbortError' ? `timeout after ${timeoutMs}ms` : e.message,
      ms: +(performance.now() - t0).toFixed(2),
    };
  }
}

// ── main ───────────────────────────────────────────────────────────────────

const totalTimeoutMs = flags.timeout * 1000;
const perStepMs = Math.max(1000, Math.floor(totalTimeoutMs / 2));

const dns = await probeDNS(host, perStepMs);
const result = { host, port, dns };

if (!dns.ok) {
  bail(`dns lookup failed: ${dns.error}`, 4, { dns });
}

if (flags.dnsOnly) {
  result.ok = true;
} else if (flags.tcpOnly) {
  const tcp = await probeTCP(dns.address, port, perStepMs);
  result.tcp = tcp;
  result.ok = tcp.ok;
} else {
  // default: DNS + HTTP
  const http = await probeHTTP(host, port, perStepMs);
  result.http = http;
  result.ok = http.ok;
}

// ── output ─────────────────────────────────────────────────────────────────

if (flags.json) {
  process.stdout.write(JSON.stringify(result) + '\n');
} else {
  const parts = [`${host}`];
  if (dns.address) parts.push(`→ ${dns.address}`);
  parts.push(`dns=${dns.ms}ms`);
  if (result.http) {
    if (result.http.ok) parts.push(`http=${result.http.ms}ms status=${result.http.status}`);
    else parts.push(`http=FAIL (${result.http.error})`);
  }
  if (result.tcp) {
    if (result.tcp.ok) parts.push(`tcp=${result.tcp.ms}ms`);
    else parts.push(`tcp=FAIL (${result.tcp.error})`);
  }
  process.stdout.write(parts.join('  ') + '\n');
}

process.exit(result.ok ? 0 : 4);
