{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "cping",
  "version": "1.0.3",
  "title": "China-side Reachability",
  "description": "Check network latency and reachability to a domain or IP from this host, with emphasis on China-side reachability.",
  "category": "network",
  "tags": [
    "network",
    "ping",
    "latency",
    "china"
  ],
  "author": "cicy-ai",
  "homepage": "https://github.com/cicy-ai/cicy-skills/tree/main/skills/cping",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": [],
  "npm_dependencies": false,
  "entry": "bin/cping",
  "permissions": [
    "network"
  ],
  "compatible_agents": [
    "*"
  ],
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "help.md",
    "tools_md": "tools.md",
    "readme": "README.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "cping 网络探测",
      "description": "快速检测域名或 IP 的网络延迟和可达性，支持 DNS / HTTP / TCP 多种方式。"
    }
  },
  "tools": [
    {
      "name": "cping",
      "example": "cping example.com",
      "description": "Check DNS + HTTPS reachability and latency to a host"
    },
    {
      "name": "cping --json",
      "example": "cping example.com --json",
      "description": "Machine-readable JSON output"
    },
    {
      "name": "cping --dns-only",
      "example": "cping example.com --dns-only",
      "description": "DNS resolution only, skip HTTP probe"
    },
    {
      "name": "cping --tcp-only",
      "example": "cping host:22 --tcp-only --port 22",
      "description": "TCP connect probe only"
    }
  ]
}
