#!/usr/bin/env node
// cicy-mihomo — manage local Cicy Mihomo (mihomo / clash-meta fork) proxy.
// Subcommands: install / template / gen-config / show-config / status /
//              start / stop / restart / reload / logs / test

import { readFileSync, writeFileSync, existsSync, mkdirSync, statSync, unlinkSync, openSync, closeSync, chmodSync, readdirSync } from 'node:fs';
import { homedir, platform, arch, tmpdir } from 'node:os';
import { join, dirname } from 'node:path';
import { spawn, execFileSync } from 'node:child_process';
import { randomBytes } from 'node:crypto';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const json = argv.includes('--json');
const cmd = argv[0];
const rest = argv.slice(1).filter((a) => a !== '--json');

const HOME = homedir();
const CONFIG_PATH = process.env.MIHOMO_CONFIG || join(HOME, 'cicy-ai', 'db', 'mihomo.yaml');
const BINARY_PATH = process.env.MIHOMO_BIN    || join(HOME, '.local', 'bin', platform() === 'win32' ? 'mihomo.exe' : 'mihomo');
const STATE_DIR   = join(HOME, '.local', 'state', 'cicy-skills', 'mihomo');
const PID_FILE    = join(STATE_DIR, 'pid');
const LOG_FILE    = process.env.MIHOMO_LOG    || join(HOME, 'logs', 'mihomo.log');
const CTRL_BASE   = process.env.MIHOMO_CTRL   || 'http://127.0.0.1:19001';

const MIHOMO_VERSION = process.env.CICY_MIHOMO_VERSION || 'v1.10.4';
const GH_PROXY = process.env.GITHUB_PROXY || 'https://gh-proxy.com/';

const TEMPLATE = `# cicy-mihomo config (mihomo / clash-meta)
# Edit this file then run: cicy-mihomo reload (or restart)

mixed-port: 9001
allow-lan: true
bind-address: "*"
mode: rule
log-level: info

external-controller: 127.0.0.1:19001
external-ui: ""

dns:
  enable: true
  listen: 127.0.0.1:53
  enhanced-mode: fake-ip
  nameserver:
    - 119.29.29.29
    - 223.5.5.5

# globalPassword: any non-empty username + this password authenticates
authentication: []
# Uncomment + set per-user when needed:
# - "alice:password"

# Localhost callers skip auth so local Chrome / curl can use 127.0.0.1:9001
skip-auth-prefixes:
  - 127.0.0.1/32
  - ::1/128

# ── per-Chrome-profile listeners ────────────────────────────────────────
# Chrome does not support proxies with username/password (Basic Auth in the
# proxy URL is rejected, and SwitchyOmega is needed otherwise). The clean
# workaround is to expose one listener per Chrome profile on a distinct
# local port, then route each listener to its own proxy-group via IN-NAME.
#
# Convention: chrome-profile listeners start at port 18000 (chrome-profile-1 =
# 18000, each new profile takes the next free port). Each listener needs an
# IN-NAME rule at the TOP of the rules list (before any IN-USER / IN-USER-PREFIX
# rules — listener rules fire first; reaching auth-user rules is irreversible).
listeners:
  - name: chrome-profile-1
    type: mixed
    port: 18000
    listen: 127.0.0.1
  # - name: chrome-profile-2
  #   type: mixed
  #   port: 18001
  #   listen: 127.0.0.1

proxies:
  # default_proxy is the default egress node — a 'direct' proxy, so out of the
  # box all routed traffic exits DIRECT (the box's own public IP). Fail-open:
  # nothing breaks before a real upstream is configured (so MITM-on agents like
  # codex/claude work on first install even with global egress already enabled).
  # To change the exit IP, replace this with a real node (ss/vmess/socks5/...)
  # keeping the name 'default_proxy' — every rule routes through it, no flag flip.
  - { name: default_proxy, type: direct }
  # - { name: 'node-1', type: ss, server: 1.2.3.4, port: 8388, cipher: aes-256-gcm, password: '...' }

proxy-groups:
  # default_proxy_group is the routing target for all rules; it selects the
  # default_proxy node (swap the selection to switch the whole egress at once).
  - name: default_proxy_group
    type: select
    proxies:
      - default_proxy
  # Per-profile groups. Pin a single upstream or a select between several:
  # - name: chrome-profile-1-group
  #   type: select
  #   proxies: [DIRECT]
  # - name: chrome-profile-2-group
  #   type: select
  #   proxies: [DIRECT]

rules:
  # IN-NAME rules MUST be first — listener-named connections never reach
  # IN-USER / IN-USER-PREFIX once IN-NAME matches.
  - IN-NAME,chrome-profile-1,default_proxy_group
  # Localhost is trusted: in-container agents and the MITM egress (which dials
  # mihomo anonymously, no w- username) are routed to the egress group here.
  - SRC-IP-CIDR,127.0.0.1/32,default_proxy_group
  - SRC-IP-CIDR,::1/128,default_proxy_group
  # Authenticated w- users (e.g. LAN clients via allow-lan) are also allowed.
  - IN-USER-PREFIX,w-,default_proxy_group
  # Default-deny: anything not matched above is rejected.
  - MATCH,REJECT
`;

(async () => {
  try {
    switch (cmd) {
      case 'tools':       printTools(); return;
      case 'install':     await cmdInstall(); return;
      case 'template':    cmdTemplate(); return;
      case 'gen-config':  cmdGenConfig(); return;
      case 'show-config': cmdShowConfig(); return;
      case 'status':      await cmdStatus(); return;
      case 'start':       await cmdStart(); return;
      case 'stop':        cmdStop(); return;
      case 'restart':     await cmdRestart(); return;
      case 'reload':      await cmdReload(); return;
      case 'logs': case 'log': cmdLogs(rest); return;
      case 'test':        await cmdTest(); return;
      case 'listeners':   await cmdListeners(); return;
      case 'add-chrome-profile':    await cmdAddChromeProfile(rest); return;
      case 'remove-chrome-profile': await cmdRemoveChromeProfile(rest); return;
      case 'addProxy': case 'add-proxy': cmdAddProxy(rest); return;
      case 'addGroup': case 'add-group': cmdAddGroup(rest); return;
      case 'addUser': case 'add-user': cmdAddUser(rest); return;
      default: bail(`unknown command: ${cmd}. Try cicy-mihomo --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`cicy-mihomo: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: cicy-mihomo <install|template|gen-config|show-config|status|start|stop|restart|reload|logs|test>\n'); }
}
function printTools() {
  try { process.stdout.write(readFileSync(new URL('../references/tools.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('# cicy-mihomo tools\n'); }
}

function readPID() {
  if (!existsSync(PID_FILE)) return 0;
  const raw = readFileSync(PID_FILE, 'utf8').trim();
  const pid = parseInt(raw, 10);
  if (!pid) return 0;
  // verify process is alive
  try { process.kill(pid, 0); return pid; }
  catch { return 0; }
}

function ensureDir(p) { if (!existsSync(p)) mkdirSync(p, { recursive: true }); }

// Portable synchronous sleep — `execSync('sleep …')` breaks on Windows (cmd.exe
// has no sleep, and execSync never uses bash there).
function msleep(ms) { Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms); }

// ── install ─────────────────────────────────────────────────────────────

async function cmdInstall() {
  if (existsSync(BINARY_PATH) && !rest.includes('--force')) {
    let v = '?';
    try { v = execFileSync(BINARY_PATH, ['-v'], { encoding: 'utf8' }).split('\n')[0].trim(); } catch {}
    console.log(`✓ already installed: ${BINARY_PATH} (${v})`);
    console.log('  use --force to reinstall');
    return;
  }

  const url = process.env.CICY_MIHOMO_RELEASE_URL || resolveDownloadURL();
  console.log(`→ downloading ${url} ...`);
  ensureDir(dirname(BINARY_PATH));
  // OS temp dir, not hardcoded /tmp (msys /tmp ≠ %TEMP% under native Windows node)
  const tmp = join(tmpdir(), `cicy-mihomo-${process.pid}`);
  ensureDir(tmp);
  // Classify the asset by URL suffix. cicy-ai/cicy-mihomo ships a RAW binary
  // (mihomo-<os>-<arch>, no compression), while upstream MetaCubeX ships .gz /
  // .tar.gz. Handle all three — the old code assumed a tarball for anything not
  // ending in .gz and ran `tar -xzf` on the raw binary ("not in gzip format" →
  // install always failed against our own releases).
  const isTarball = /\.(tar\.gz|tgz)$/i.test(url);
  const isGz = !isTarball && /\.gz$/i.test(url);
  const archive = join(tmp, isTarball ? 'mihomo.tgz' : (isGz ? 'mihomo.gz' : 'mihomo.bin'));
  execFileSync('curl', ['-fsSL', '-o', archive, url], { stdio: 'inherit' });
  if (isTarball) {
    execFileSync('tar', ['-xzf', archive, '-C', tmp], { stdio: 'inherit' });
    // find the mihomo file inside tmp (native walk — `find` via execSync hits
    // cmd.exe on Windows, where C:\Windows\System32\find.exe is a string filter)
    const out = (function walk(dir) {
      for (const ent of readdirSync(dir, { withFileTypes: true })) {
        const p = join(dir, ent.name);
        if (ent.isDirectory()) { const r = walk(p); if (r) return r; }
        else if (/^mihomo/i.test(ent.name) && !/\.(gz|tgz|tar)/i.test(ent.name)) return p;
      }
      return '';
    })(tmp);
    if (!out) throw Object.assign(new Error('mihomo binary not found in archive'), { exitCode: 4 });
    writeFileSync(BINARY_PATH, readFileSync(out), { mode: 0o755 });
  } else if (isGz) {
    // single-file gzip: gunzip in place
    execFileSync('gunzip', ['-f', archive], { stdio: 'inherit' });
    const extracted = archive.replace(/\.gz$/i, '');
    writeFileSync(BINARY_PATH, readFileSync(extracted), { mode: 0o755 });
  } else {
    // raw binary (cicy-ai/cicy-mihomo): install directly, no extraction
    writeFileSync(BINARY_PATH, readFileSync(archive), { mode: 0o755 });
  }
  console.log(`✓ installed mihomo → ${BINARY_PATH}`);
}

function resolveDownloadURL() {
  // cicy-ai/cicy-mihomo release naming: mihomo-<os>-<arch> (no version in filename, no .gz)
  const v = MIHOMO_VERSION;
  const a = arch();
  const isArm64 = a === 'arm64';
  const os = platform();
  const archStr = isArm64 ? 'arm64' : (a === 'x64' ? 'amd64' : a);
  // node reports 'win32' but the release assets are named mihomo-windows-*.exe
  const osStr = os === 'darwin' ? 'darwin' : os === 'linux' ? 'linux' : os === 'win32' ? 'windows' : os;
  const ext = os === 'win32' ? '.exe' : '';
  const file = 'mihomo-' + osStr + '-' + archStr + ext;
  return GH_PROXY + 'https://github.com/cicy-ai/cicy-mihomo/releases/download/' + v + '/' + file;
}

// ── template / gen-config / show-config ─────────────────────────────────

function cmdTemplate() { process.stdout.write(TEMPLATE); }

function cmdGenConfig() {
  if (existsSync(CONFIG_PATH) && !rest.includes('--force')) {
    bail(`config exists at ${CONFIG_PATH}; pass --force to overwrite`, 4);
  }
  ensureDir(dirname(CONFIG_PATH));
  writeFileSync(CONFIG_PATH, TEMPLATE, { mode: 0o600 });
  try { chmodSync(CONFIG_PATH, 0o600); } catch {}
  console.log(`✓ wrote ${CONFIG_PATH}`);
  console.log(`  edit the file then: cicy-mihomo start (or reload if running)`);
}

function cmdShowConfig() {
  if (!existsSync(CONFIG_PATH)) bail(`config not found at ${CONFIG_PATH} — run cicy-mihomo gen-config`, 3);
  process.stdout.write(readFileSync(CONFIG_PATH, 'utf8'));
}

// ── status / start / stop / restart / reload ────────────────────────────

async function cmdStatus() {
  const pid = readPID();
  const out = {
    pid, running: pid > 0,
    binary: BINARY_PATH, binary_installed: existsSync(BINARY_PATH),
    config: CONFIG_PATH, config_exists: existsSync(CONFIG_PATH),
    log: LOG_FILE,
    controller: CTRL_BASE,
  };
  if (pid > 0) {
    // try to fetch /version from controller
    try {
      const r = await fetch(CTRL_BASE + '/version', { signal: AbortSignal.timeout(2000) });
      if (r.ok) out.controller_version = (await r.json())?.version;
    } catch {}
  }
  if (json) return ok(out);
  console.log(`pid:        ${out.pid || '(not running)'}`);
  console.log(`binary:     ${out.binary} ${out.binary_installed ? '✓' : '(not installed)'}`);
  console.log(`config:     ${out.config} ${out.config_exists ? '✓' : '(missing)'}`);
  console.log(`log:        ${out.log}`);
  console.log(`controller: ${out.controller}${out.controller_version ? ' (v' + out.controller_version + ')' : ''}`);
}

async function cmdStart() {
  if (readPID() > 0) bail(`already running (pid=${readPID()})`, 4);
  if (!existsSync(BINARY_PATH)) bail(`binary missing: ${BINARY_PATH} — run cicy-mihomo install`, 3);
  if (!existsSync(CONFIG_PATH)) bail(`config missing: ${CONFIG_PATH} — run cicy-mihomo gen-config`, 3);
  ensureDir(STATE_DIR);
  ensureDir(dirname(LOG_FILE));
  const fd = openSync(LOG_FILE, 'a');
  const child = spawn(BINARY_PATH, ['-f', CONFIG_PATH], {
    detached: true,
    stdio: ['ignore', fd, fd],
  });
  child.unref();
  closeSync(fd);
  // wait briefly for the process to either die or settle
  await new Promise((r) => setTimeout(r, 400));
  try { process.kill(child.pid, 0); }
  catch { bail(`process died on launch — see ${LOG_FILE}`, 4); }
  writeFileSync(PID_FILE, String(child.pid));
  if (json) return ok({ pid: child.pid });
  console.log(`✓ started mihomo pid=${child.pid}`);
  console.log(`  log:      ${LOG_FILE}`);
  console.log(`  endpoint: 127.0.0.1:9001 (mixed)`);
}

function cmdStop() {
  const pid = readPID();
  if (!pid) bail('not running', 4);
  try { process.kill(pid, 'SIGTERM'); } catch (e) { bail(`kill failed: ${e.message}`, 4); }
  // wait for it to actually die, max 5s
  const deadline = Date.now() + 5000;
  while (Date.now() < deadline) {
    try { process.kill(pid, 0); }
    catch { try { unlinkSync(PID_FILE); } catch {}; if (json) return ok({ stopped: pid }); console.log(`✓ stopped pid=${pid}`); return; }
    msleep(100);
  }
  // force kill
  try { process.kill(pid, 'SIGKILL'); } catch {}
  try { unlinkSync(PID_FILE); } catch {}
  if (json) return ok({ killed: pid });
  console.log(`! force-killed pid=${pid}`);
}

async function cmdRestart() {
  if (readPID() > 0) cmdStop();
  await cmdStart();
}

async function cmdReload() {
  if (readPID() === 0) bail('not running — start first', 4);
  // Reload the SAME config the process was launched with (`-f CONFIG_PATH`).
  // We send an empty path on purpose: mihomo then reloads C.Path.Config() (the
  // launched config) and skips its safe-path check, which only fires for an
  // explicit, different path. Sending CONFIG_PATH explicitly would trip
  // "path is not subpath of home directory or SAFE_PATHS" because the config
  // lives at ~/cicy-ai/db/mihomo.yaml, outside mihomo's ~/.config/mihomo home.
  let r;
  try {
    r = await fetch(CTRL_BASE + '/configs?force=true', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({}),
    });
  } catch (e) {
    bail(`controller unreachable at ${CTRL_BASE}: ${e.message}`, 4);
  }
  if (!r.ok) {
    const txt = await r.text();
    bail(`controller error (${r.status}): ${txt}`, 4);
  }
  if (json) return ok({ reloaded: true, controller: CTRL_BASE });
  console.log(`✓ reloaded via ${CTRL_BASE}`);
}

function cmdLogs(args) {
  let lines = 100;
  let follow = false;
  for (const a of args) {
    if (a === '-f' || a === '--follow') follow = true;
    else if (/^\d+$/.test(a)) lines = parseInt(a, 10);
  }
  if (!existsSync(LOG_FILE)) bail(`no log file at ${LOG_FILE}`, 3);
  const flags = ['-n', String(lines)];
  if (follow) flags.push('-f');
  flags.push(LOG_FILE);
  const child = spawn('tail', flags, { stdio: 'inherit' });
  child.on('exit', (code) => process.exit(code ?? 0));
}

// ── test (speed test via controller) ────────────────────────────────────

const TEST_TARGETS = {
  anthropic: 'https://api.anthropic.com/',
  google:    'https://www.google.com/generate_204',
  github:    'https://github.com/',
  cf:        'https://www.cloudflare.com/cdn-cgi/trace',
};

async function cmdTest() {
  if (readPID() === 0) bail('not running — start first', 4);
  // Get all proxies via controller
  let proxiesData;
  try {
    const r = await fetch(CTRL_BASE + '/proxies', { signal: AbortSignal.timeout(3000) });
    if (!r.ok) bail(`controller error (${r.status})`, 4);
    proxiesData = await r.json();
  } catch (e) {
    bail(`controller unreachable: ${e.message}`, 4);
  }
  const all = proxiesData?.proxies || {};
  // Pick selectable / non-group proxies
  const nodes = Object.entries(all)
    .filter(([n, p]) => p && !['Selector', 'Fallback', 'URLTest', 'LoadBalance', 'Compatible', 'Direct', 'Reject', 'Pass'].includes(p.type))
    .map(([n]) => n)
    .slice(0, 50); // safety cap

  const results = [];
  for (const node of nodes) {
    const r = { node };
    for (const [name, url] of Object.entries(TEST_TARGETS)) {
      try {
        const probe = await fetch(`${CTRL_BASE}/proxies/${encodeURIComponent(node)}/delay?url=${encodeURIComponent(url)}&timeout=3000`, { signal: AbortSignal.timeout(5000) });
        if (probe.ok) {
          const j = await probe.json();
          r[name] = j.delay;
        } else {
          r[name] = -1;
        }
      } catch {
        r[name] = -1;
      }
    }
    results.push(r);
  }

  if (json) return ok(results);
  if (results.length === 0) {
    console.log('(no testable proxy nodes found)');
    return;
  }
  console.log(`${'NODE'.padEnd(30)}  ${'anthropic'.padEnd(9)}  ${'google'.padEnd(7)}  ${'github'.padEnd(7)}  ${'cf'.padEnd(5)}`);
  console.log('-'.repeat(70));
  for (const r of results) {
    const fmt = (v) => v < 0 ? 'fail' : `${v}ms`;
    console.log(`${r.node.slice(0, 30).padEnd(30)}  ${fmt(r.anthropic).padEnd(9)}  ${fmt(r.google).padEnd(7)}  ${fmt(r.github).padEnd(7)}  ${fmt(r.cf).padEnd(5)}`);
  }
}


// ── listeners (read-only) ───────────────────────────────────────────────

async function cmdListeners() {
  // Pull live listeners from controller; cross-reference IN-NAME rules from yaml.
  const live = readPID() > 0;
  const out = {
    base_mixed_port: null,
    listeners: [],
    in_name_rules: [],
    proxy_groups: [],
  };

  // 1) parse yaml for the static listener / rule view (single source of truth)
  if (existsSync(CONFIG_PATH)) {
    const yaml = readFileSync(CONFIG_PATH, 'utf8');
    out.base_mixed_port = matchScalar(yaml, /^mixed-port:\s*(\d+)/m);
    out.listeners = parseListenersBlock(yaml);
    out.in_name_rules = parseInNameRules(yaml);
    out.proxy_groups = parseProxyGroupNames(yaml);
  }

  // 2) when running, augment with controller view (gives runtime status)
  if (live) {
    try {
      const r = await fetch(CTRL_BASE + '/version', { signal: AbortSignal.timeout(2000) });
      if (r.ok) out.controller_reachable = true;
    } catch {}
  }

  if (json) return ok(out);
  if (out.base_mixed_port) console.log(`base mixed-port: ${out.base_mixed_port}`);
  console.log('');
  if (out.listeners.length === 0) {
    console.log('(no listeners configured — see `cicy-mihomo template` for the listeners: block)');
  } else {
    console.log(`LISTENER NAME              PORT   TYPE   LISTEN          → IN-NAME GROUP`);
    console.log('-'.repeat(80));
    const ruleByName = Object.fromEntries(out.in_name_rules.map((r) => [r.listener, r.group]));
    for (const l of out.listeners) {
      const grp = ruleByName[l.name] || '(no IN-NAME rule)';
      console.log(`${l.name.padEnd(26)} ${String(l.port).padEnd(6)} ${(l.type || '').padEnd(6)} ${(l.listen || '').padEnd(15)} → ${grp}`);
    }
  }
  if (out.in_name_rules.length === 0) {
    console.log('');
    console.log('(no IN-NAME rules in rules: — listeners would fall through to IN-USER / MATCH)');
  }
  if (out.proxy_groups.length > 0) {
    console.log('');
    console.log(`proxy-groups: ${out.proxy_groups.join(', ')}`);
  }
}

// ── chrome-profile add / remove ─────────────────────────────────────────

// Convention: chrome-profile listeners start at port 18000 (auto-pick next free from 18000).
function cmdAddChromeProfile(args) {
  // cicy-mihomo add-chrome-profile <name> [--port N] [--upstream <proxy_or_group>] [--listen 127.0.0.1]
  if (args.length < 1) bail('Usage: cicy-mihomo add-chrome-profile <name> [--port N] [--upstream <proxy_or_group>] [--listen ADDR]', 2);
  if (!existsSync(CONFIG_PATH)) bail(`config missing: ${CONFIG_PATH} — run cicy-mihomo gen-config`, 3);

  const name = args[0];
  if (!/^[a-zA-Z][\w-]*$/.test(name)) bail(`invalid profile name: ${name} (must match [a-zA-Z][\\w-]*)`, 2);
  const opts = parseProfileFlags(args.slice(1));
  const upstream = opts.upstream || 'DIRECT';
  const listen = opts.listen || '127.0.0.1';

  const text = readFileSync(CONFIG_PATH, 'utf8');
  const existing = parseListenersBlock(text);
  const groupNames = parseProxyGroupNames(text);
  const groupName = `${name}-group`;

  if (existing.some((l) => l.name === name)) bail(`listener '${name}' already exists`, 4);
  if (groupNames.includes(groupName)) bail(`proxy-group '${groupName}' already exists`, 4);

  // pick port: explicit, else next available 18000+
  let port;
  if (opts.port) {
    port = parseInt(opts.port, 10);
    if (!port || port < 1 || port > 65535) bail(`invalid --port: ${opts.port}`, 2);
    if (existing.some((l) => l.port === port)) bail(`port ${port} already used by listener '${existing.find((l) => l.port === port).name}'`, 4);
  } else {
    const used = new Set(existing.map((l) => l.port));
    port = 18000;
    while (used.has(port)) port++;
  }

  // edits — three append/insert operations on the yaml text:
  //   1. insert listener block under listeners:
  //   2. insert proxy-group block under proxy-groups:
  //   3. insert IN-NAME rule at the TOP of rules:
  let updated = appendUnderTopKey(text, 'listeners', `  - name: ${name}\n    type: mixed\n    port: ${port}\n    listen: ${listen}\n`);
  updated = appendUnderTopKey(updated, 'proxy-groups', `  - name: ${groupName}\n    type: select\n    proxies:\n      - ${upstream}\n`);
  updated = insertFirstRuleEntry(updated, `  - IN-NAME,${name},${groupName}\n`);

  if (updated === text) bail('failed to update yaml — no listeners: / proxy-groups: / rules: top-level keys found', 4);

  writeFileSync(CONFIG_PATH, updated, { mode: 0o600 });

  const result = { name, port, listen, upstream, group: groupName, config: CONFIG_PATH };
  if (json) return ok(result);
  console.log(`✓ added chrome profile '${name}'`);
  console.log(`  listener:    ${listen}:${port} (mixed)`);
  console.log(`  proxy-group: ${groupName}`);
  console.log(`  rule:        IN-NAME,${name},${groupName}`);
  console.log(`  upstream:    ${upstream}${upstream === 'DIRECT' ? ' (no proxy — change with --upstream or edit yaml)' : ''}`);
  console.log('');
  console.log(`Reload mihomo to pick up the new listener:`);
  console.log(`  cicy-mihomo reload`);
  console.log('');
  console.log(`Then point that Chrome profile at:  ${listen}:${port}  (no auth)`);
}

function cmdRemoveChromeProfile(args) {
  if (args.length < 1) bail('Usage: cicy-mihomo remove-chrome-profile <name>', 2);
  if (!existsSync(CONFIG_PATH)) bail(`config missing: ${CONFIG_PATH}`, 3);
  const name = args[0];
  const groupName = `${name}-group`;

  let text = readFileSync(CONFIG_PATH, 'utf8');
  const before = text;

  text = removeListenerEntry(text, name);
  text = removeProxyGroupEntry(text, groupName);
  text = removeRuleLineMatching(text, new RegExp(`^\\s*-\\s*IN-NAME,${escapeRe(name)},`));

  if (text === before) bail(`profile '${name}' not found in ${CONFIG_PATH}`, 4);
  writeFileSync(CONFIG_PATH, text, { mode: 0o600 });

  if (json) return ok({ removed: name, group: groupName });
  console.log(`✓ removed chrome profile '${name}'`);
  console.log(`  Reload mihomo to release the port:  cicy-mihomo reload`);
}

// ── addProxy ────────────────────────────────────────────────────────────

// Sensitive keys whose values must never be echoed back to the terminal
// (unless they are obvious <PLACEHOLDER> values the user still has to fill).
// Plain function (hoisted) — the top-level IIFE dispatches before module
// consts below it would initialize.
function isSensitiveProxyKey(key) {
  return ['password', 'uuid', 'token', 'psk', 'private-key', 'pre-shared-key', 'auth-str', 'auth_str'].includes(key.toLowerCase());
}

function cmdAddProxy(args) {
  // cicy-mihomo addProxy name=<id> type=<adapter> server=<host> port=<n> [k=v ...] [--group G | --no-group]
  // Writes a node into `proxies:` (canonical block style) and appends it to a
  // proxy-group's `proxies:` selection (default_proxy_group unless --group /
  // --no-group). Flat k=v pairs only — nested opts (ws-opts etc.) are out of
  // scope for the wrapper.
  if (args.length === 0) bail('Usage: cicy-mihomo addProxy name=<id> type=<adapter> server=<host> port=<n> [k=v ...] [--group <group>|--no-group]', 2);
  if (!existsSync(CONFIG_PATH)) bail(`config missing: ${CONFIG_PATH} — run cicy-mihomo gen-config`, 3);

  // split flags from k=v fields
  let group = 'default_proxy_group';
  let noGroup = false;
  const fields = [];           // [key, value] in argument order (name/type pulled out below)
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--group') { group = args[++i]; if (!group) bail('--group needs a value', 2); continue; }
    if (a === '--no-group') { noGroup = true; continue; }
    const eq = a.indexOf('=');
    if (eq <= 0) bail(`expected k=v pair or flag, got: ${a}`, 2);
    const k = a.slice(0, eq).trim();
    const v = a.slice(eq + 1);
    if (!/^[A-Za-z_][\w-]*$/.test(k)) bail(`invalid field name: ${k}`, 2);
    fields.push([k, v]);
  }

  const get = (k) => (fields.find(([fk]) => fk === k) || [])[1];
  const name = get('name');
  const type = get('type');
  if (!name) bail('missing required field: name=<id>', 2);
  if (!/^[A-Za-z][\w-]*$/.test(name)) bail(`invalid node name: ${name} (must match [a-zA-Z][\\w-]*)`, 2);
  if (!type) bail('missing required field: type=<adapter> (http/socks5/ss/vmess/trojan/...)', 2);
  if (type !== 'direct') {
    if (!get('server')) bail(`type=${type} requires server=<host>`, 2);
    if (!get('port')) bail(`type=${type} requires port=<n>`, 2);
  }
  const portV = get('port');
  if (portV !== undefined && !/^\d+$/.test(portV)) bail(`invalid port: ${portV}`, 2);

  const text = readFileSync(CONFIG_PATH, 'utf8');
  if (parseProxyNames(text).includes(name)) bail(`proxy '${name}' already exists in ${CONFIG_PATH}`, 4);
  if (!noGroup && !parseProxyGroupNames(text).includes(group)) bail(`proxy-group '${group}' not found (use --group <existing> or --no-group)`, 4);

  // build the canonical block-style entry; name/type first, rest in given order
  const ordered = [['name', name], ['type', type], ...fields.filter(([k]) => k !== 'name' && k !== 'type')];
  let block = '';
  for (const [k, v] of ordered) {
    block += block === '' ? `  - ${k}: ${yamlScalar(v)}\n` : `    ${k}: ${yamlScalar(v)}\n`;
  }

  let updated = appendUnderTopKey(text, 'proxies', block);
  if (updated === text) bail('failed to update yaml — no `proxies:` top-level key found', 4);
  if (!noGroup) {
    const withGroup = appendToGroupProxies(updated, group, name);
    if (withGroup === updated) bail(`failed to append '${name}' to proxy-group '${group}' — group has no proxies: list?`, 4);
    updated = withGroup;
  }

  writeFileSync(CONFIG_PATH, updated, { mode: 0o600 });

  const masked = ordered.map(([k, v]) => [k, maskSensitive(k, v)]);
  const result = { name, type, group: noGroup ? null : group, config: CONFIG_PATH, fields: Object.fromEntries(masked) };
  if (json) return ok(result);
  console.log(`✓ added proxy '${name}' (${type})`);
  for (const [k, v] of masked) {
    if (k === 'name' || k === 'type') continue;
    console.log(`  ${k}: ${v}`);
  }
  console.log(noGroup ? `  group:  (none — add it to a proxy-group to route through it)` : `  group:  ${group}`);
  console.log(`  config: ${CONFIG_PATH}`);
  console.log('');
  console.log('Reload mihomo to pick up the node:');
  console.log('  cicy-mihomo reload');
}

// Render a k=v value as a yaml scalar: bare numbers / booleans stay bare,
// everything else is single-quoted (with '' escaping).
function yamlScalar(v) {
  if (/^\d+$/.test(v) || v === 'true' || v === 'false') return v;
  return `'${String(v).replace(/'/g, "''")}'`;
}

// Mask sensitive values in terminal/JSON output — except obvious
// <PLACEHOLDER> values, which the user still needs to see and replace.
function maskSensitive(key, value) {
  if (!isSensitiveProxyKey(key)) return value;
  if (/^<[^<>]+>$/.test(value)) return value;
  return '***';
}

// Names of nodes under the top-level `proxies:` key. Handles both canonical
// block style (`- name: foo`) and inline flow (`- { name: foo, ... }`).
function parseProxyNames(text) {
  const lines = text.split('\n');
  const names = [];
  let inBlock = false;
  for (const raw of lines) {
    if (/^[A-Za-z][\w-]*:/.test(raw)) {
      inBlock = raw.startsWith('proxies:');
      continue;
    }
    if (!inBlock) continue;
    const noComment = raw.replace(/#.*/, '');
    let m = /^\s*-\s+name:\s*(.+?)\s*$/.exec(noComment);
    if (m) { names.push(stripQuotes(m[1])); continue; }
    m = /^\s*-\s*\{.*?name:\s*([^,}]+)/.exec(noComment);
    if (m) names.push(stripQuotes(m[1]));
  }
  return names;
}

// Append `      - <node>` to the `proxies:` list of a named proxy-group.
// Returns text unchanged when the group or its proxies: subkey isn't found.
function appendToGroupProxies(text, groupName, nodeName) {
  const lines = text.split('\n');
  let inGroups = false;
  let inTarget = false;
  for (let i = 0; i < lines.length; i++) {
    const raw = lines[i];
    if (/^[A-Za-z][\w-]*:/.test(raw)) { inGroups = raw.startsWith('proxy-groups:'); inTarget = false; continue; }
    if (!inGroups) continue;
    const nameM = /^\s*-\s+name:\s*(.+?)\s*(?:#.*)?$/.exec(raw);
    if (nameM) { inTarget = stripQuotes(nameM[1]) === groupName; continue; }
    if (inTarget && /^\s+proxies:\s*(?:#.*)?$/.test(raw)) {
      // walk past existing list items (strictly deeper-indented than the
      // proxies: subkey — a sibling group's `- name:` is shallower), insert
      // after the last one
      const keyIndent = /^(\s*)/.exec(raw)[1].length;
      let j = i + 1;
      while (j < lines.length) {
        const m = /^(\s*)-\s+/.exec(lines[j]);
        if (!m || m[1].length <= keyIndent) break;
        j++;
      }
      const indent = j > i + 1 ? /^(\s*)/.exec(lines[i + 1])[1] : ' '.repeat(keyIndent + 2);
      lines.splice(j, 0, `${indent}- ${nodeName}`);
      return lines.join('\n');
    }
  }
  return text;
}

// ── addGroup ────────────────────────────────────────────────────────────

function cmdAddGroup(args) {
  // cicy-mihomo addGroup <name> <member1> [member2 ...]
  // Writes a `select` group into proxy-groups:. Same name overwrites (upsert).
  // Members may be proxy nodes, other groups, or DIRECT/REJECT/PASS;
  // comma- and space-separated both accepted.
  if (args.length < 2) bail('Usage: cicy-mihomo addGroup <name> <member1> [member2 ...]', 2);
  if (!existsSync(CONFIG_PATH)) bail(`config missing: ${CONFIG_PATH} — run cicy-mihomo gen-config`, 3);

  const name = args[0];
  if (!/^[A-Za-z][\w-]*$/.test(name)) bail(`invalid group name: ${name} (must match [a-zA-Z][\\w-]*)`, 2);
  const members = args.slice(1).flatMap((a) => a.split(',')).map((s) => s.trim()).filter(Boolean);
  if (members.length === 0) bail('at least one member is required', 2);
  if (members.includes(name)) bail(`group '${name}' cannot contain itself`, 2);
  const dup = members.find((m, i) => members.indexOf(m) !== i);
  if (dup) bail(`duplicate member: ${dup}`, 2);

  const text = readFileSync(CONFIG_PATH, 'utf8');
  const known = new Set([...parseProxyNames(text), ...parseProxyGroupNames(text), 'DIRECT', 'REJECT', 'PASS']);
  for (const m of members) {
    if (!known.has(m)) bail(`unknown member: ${m} (not a proxy, proxy-group, or DIRECT/REJECT/PASS)`, 4);
  }

  const existed = parseProxyGroupNames(text).includes(name);
  let updated = existed ? removeProxyGroupEntry(text, name) : text;
  const block = `  - name: ${name}\n    type: select\n    proxies:\n${members.map((m) => `      - ${m}`).join('\n')}\n`;
  const next = appendUnderTopKey(updated, 'proxy-groups', block);
  if (next === updated) bail('failed to update yaml — no `proxy-groups:` top-level key found', 4);

  writeFileSync(CONFIG_PATH, next, { mode: 0o600 });

  if (json) return ok({ name, type: 'select', members, overwrote: existed, config: CONFIG_PATH });
  console.log(`✓ ${existed ? 'updated' : 'added'} proxy-group '${name}' (select)`);
  for (const m of members) console.log(`  - ${m}`);
  console.log(`  config: ${CONFIG_PATH}`);
  console.log('');
  console.log('Reload mihomo to pick up the group:');
  console.log('  cicy-mihomo reload');
}

// ── addUser ─────────────────────────────────────────────────────────────

function cmdAddUser(args) {
  // cicy-mihomo addUser <username> <target> [<password>]
  // Upsert: replaces any existing authentication entry + IN-USER rule for the
  // user. Without <password>, generates one and prints it (the only moment
  // it's visible). The IN-USER rule is inserted ABOVE the first
  // IN-USER-PREFIX (or MATCH) line so it actually wins the route.
  if (args.length < 2 || args.length > 3) bail('Usage: cicy-mihomo addUser <username> <target> [<password>]', 2);
  if (!existsSync(CONFIG_PATH)) bail(`config missing: ${CONFIG_PATH} — run cicy-mihomo gen-config`, 3);

  const [username, target] = args;
  if (!/^[A-Za-z][\w.-]*$/.test(username)) bail(`invalid username: ${username} (must match [a-zA-Z][\\w.-]*)`, 2);
  const generated = args.length < 3;
  const password = generated ? randomBytes(12).toString('base64url') : args[2];
  if (!password) bail('password must not be empty', 2);
  if (password.includes('"') || password.includes(':')) bail('password must not contain `"` or `:`', 2);

  const text = readFileSync(CONFIG_PATH, 'utf8');
  const known = new Set([...parseProxyNames(text), ...parseProxyGroupNames(text), 'DIRECT', 'REJECT']);
  if (!known.has(target)) bail(`unknown target: ${target} (not a proxy, proxy-group, or DIRECT/REJECT)`, 4);

  const hadAuth = new RegExp(`^\\s*-\\s*["']?${escapeRe(username)}:`, 'm').test(text);
  const prevRule = parseInUserRules(text).find((r) => r.user === username);

  // upsert authentication entry
  let updated = removeRuleLineMatching(text, new RegExp(`^\\s*-\\s*["']?${escapeRe(username)}:`));
  // `authentication: []` (template inline-empty) can't take list items — open it up
  updated = updated.replace(/^authentication:\s*\[\s*\]\s*(?:#.*)?$/m, 'authentication:');
  const next = appendUnderTopKey(updated, 'authentication', `  - "${username}:${password}"\n`);
  if (next === updated) bail('failed to update yaml — no `authentication:` top-level key found', 4);
  updated = next;

  // upsert IN-USER rule (above IN-USER-PREFIX / MATCH so it takes precedence)
  updated = removeRuleLineMatching(updated, new RegExp(`^\\s*-\\s*IN-USER,${escapeRe(username)},`));
  const withRule = insertRuleAbovePrefix(updated, `  - IN-USER,${username},${target}`);
  if (withRule === updated) bail('failed to update yaml — no `rules:` top-level key found', 4);

  writeFileSync(CONFIG_PATH, withRule, { mode: 0o600 });

  const result = {
    username, target,
    rule: `IN-USER,${username},${target}`,
    password: generated ? password : '***',
    password_generated: generated,
    overwrote: { authentication: hadAuth, rule: !!prevRule, previous_target: prevRule ? prevRule.target : null },
    config: CONFIG_PATH,
  };
  if (json) return ok(result);
  console.log(`✓ ${hadAuth || prevRule ? 'updated' : 'added'} user '${username}'`);
  console.log(`  auth:     ${username}:${generated ? password : '*** (yours, not echoed)'}`);
  if (generated) console.log('            ^ generated password — save it now, it is not shown again');
  console.log(`  rule:     IN-USER,${username},${target}${prevRule && prevRule.target !== target ? `  (was → ${prevRule.target})` : ''}`);
  console.log(`  config:   ${CONFIG_PATH}`);
  console.log('');
  console.log('Reload mihomo to apply:');
  console.log('  cicy-mihomo reload');
}

// Parse `- IN-USER,<user>,<target>` rule lines.
function parseInUserRules(text) {
  const out = [];
  for (const raw of text.split('\n')) {
    const line = raw.replace(/#.*/, '').trim();
    const m = /^-\s*IN-USER\s*,\s*([^,\s]+)\s*,\s*([^,\s]+)/.exec(line);
    if (m) out.push({ user: m[1], target: m[2] });
  }
  return out;
}

// Insert a rule line inside the rules: block, above the first IN-USER-PREFIX
// line (specific-user rules must precede the prefix catch-all to win), else
// above the first MATCH line, else at the end of the block.
function insertRuleAbovePrefix(text, ruleLine) {
  const lines = text.split('\n');
  let rulesIdx = -1;
  for (let i = 0; i < lines.length; i++) {
    if (/^rules:\s*(?:#.*)?$/.test(lines[i])) { rulesIdx = i; break; }
  }
  if (rulesIdx === -1) return text;
  let endIdx = lines.length;
  let insertAt = -1;
  for (let i = rulesIdx + 1; i < lines.length; i++) {
    if (/^[A-Za-z]/.test(lines[i])) { endIdx = i; break; }
    const item = lines[i].replace(/#.*/, '').trim();
    if (insertAt === -1 && /^-\s*IN-USER-PREFIX\s*,/.test(item)) insertAt = i;
    if (insertAt === -1 && /^-\s*MATCH\s*,/.test(item)) insertAt = i;
  }
  if (insertAt === -1) {
    insertAt = endIdx;
    while (insertAt > rulesIdx + 1 && lines[insertAt - 1].trim() === '') insertAt--;
  }
  lines.splice(insertAt, 0, ruleLine);
  return lines.join('\n');
}

// ── yaml mini-helpers (top-level block append / list-item remove) ──────

function matchScalar(text, re) {
  const m = re.exec(text);
  return m ? m[1].trim() : null;
}

// Parse `listeners:` block. Recognizes BOTH the canonical style:
//   listeners:
//     - name: chrome-profile-1
//       type: mixed
//       port: 18000
//       listen: 127.0.0.1
// and inline-flow style { name: ..., port: ..., ... } (best-effort).
// Skips comment-only entries.
function parseListenersBlock(text) {
  const lines = text.split('\n');
  const out = [];
  let inBlock = false;
  let current = null;
  for (let i = 0; i < lines.length; i++) {
    const raw = lines[i];
    if (/^[A-Za-z][\w-]*:/.test(raw)) {
      // top-level key
      if (raw.startsWith('listeners:')) { inBlock = true; current = null; continue; }
      if (inBlock) break;
    }
    if (!inBlock) continue;
    const itemStart = /^\s*-\s+(.*)$/.exec(raw);
    if (itemStart) {
      if (current) out.push(current);
      current = {};
      const after = itemStart[1].trim();
      // first line could be "name: foo" or fully inline { ... }
      const kv = /^([A-Za-z_][\w-]*):\s*(.*)$/.exec(after);
      if (kv) current[kv[1]] = stripQuotes(kv[2]);
      continue;
    }
    if (current) {
      const kv = /^\s+([A-Za-z_][\w-]*):\s*(.*)$/.exec(raw);
      if (kv) {
        const v = stripQuotes(kv[2]);
        current[kv[1]] = /^\d+$/.test(v) ? parseInt(v, 10) : v;
      }
    }
  }
  if (current) out.push(current);
  return out.filter((l) => l.name);
}

function parseInNameRules(text) {
  const out = [];
  for (const raw of text.split('\n')) {
    const line = raw.replace(/#.*/, '').trim();
    const m = /^-\s*IN-NAME\s*,\s*([^,\s]+)\s*,\s*([^,\s]+)/.exec(line);
    if (m) out.push({ listener: m[1], group: m[2] });
  }
  return out;
}

function parseProxyGroupNames(text) {
  const lines = text.split('\n');
  const names = [];
  let inBlock = false;
  for (const raw of lines) {
    if (/^[A-Za-z][\w-]*:/.test(raw)) {
      inBlock = raw.startsWith('proxy-groups:');
      continue;
    }
    if (!inBlock) continue;
    const m = /^\s*-\s+name:\s*(.+?)\s*(?:#.*)?$/.exec(raw);
    if (m) names.push(stripQuotes(m[1]));
  }
  return names;
}

function stripQuotes(s) {
  s = s.trim();
  if ((s.startsWith('"') && s.endsWith('"')) || (s.startsWith("'") && s.endsWith("'"))) return s.slice(1, -1);
  return s;
}

function escapeRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

function parseProfileFlags(args) {
  const out = {};
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--port') { out.port = args[++i]; continue; }
    if (args[i] === '--upstream') { out.upstream = args[++i]; continue; }
    if (args[i] === '--listen') { out.listen = args[++i]; continue; }
    bail(`unknown flag: ${args[i]}`, 2);
  }
  return out;
}

// Append `block` (already 2-space-indented for list items) under a
// top-level mapping key. If the key is missing or only commented,
// returns text unchanged.
function appendUnderTopKey(text, key, block) {
  const lines = text.split('\n');
  let keyIdx = -1;
  for (let i = 0; i < lines.length; i++) {
    if (new RegExp(`^${escapeRe(key)}:\\s*(?:#.*)?$`).test(lines[i])) { keyIdx = i; break; }
  }
  if (keyIdx === -1) return text;
  // find end of block: next line starting at column 0 with [A-Za-z] (next top-level key)
  let endIdx = lines.length;
  for (let i = keyIdx + 1; i < lines.length; i++) {
    if (/^[A-Za-z]/.test(lines[i])) { endIdx = i; break; }
  }
  // strip a trailing blank line in the block so we insert immediately above it
  while (endIdx > keyIdx + 1 && lines[endIdx - 1].trim() === '') endIdx--;
  const blockLines = block.replace(/\n+$/, '').split('\n');
  lines.splice(endIdx, 0, ...blockLines);
  return lines.join('\n');
}

// Insert a single rule line as the FIRST item under rules:.
function insertFirstRuleEntry(text, ruleLine) {
  const lines = text.split('\n');
  for (let i = 0; i < lines.length; i++) {
    if (/^rules:\s*(?:#.*)?$/.test(lines[i])) {
      const stripped = ruleLine.replace(/\n+$/, '');
      lines.splice(i + 1, 0, stripped);
      return lines.join('\n');
    }
  }
  return text;
}

// Remove a single - name: <name> list item (and its indented continuation
// lines) from a top-level block.
function removeNamedListItem(text, topKey, name) {
  const lines = text.split('\n');
  let inBlock = false;
  let removeStart = -1;
  let removeEnd = -1;
  for (let i = 0; i < lines.length; i++) {
    if (/^[A-Za-z][\w-]*:/.test(lines[i])) {
      inBlock = new RegExp(`^${escapeRe(topKey)}:`).test(lines[i]);
      if (removeStart !== -1 && removeEnd === -1) removeEnd = i;
      if (!inBlock && removeStart !== -1) break;
      continue;
    }
    if (!inBlock) continue;
    const startMatch = /^(\s*)-\s+name:\s*(.+?)\s*(?:#.*)?$/.exec(lines[i]);
    if (startMatch && stripQuotes(startMatch[2]) === name) {
      removeStart = i;
      // find next "- " at same indent OR end-of-block
      const indent = startMatch[1].length;
      for (let j = i + 1; j < lines.length; j++) {
        if (/^[A-Za-z]/.test(lines[j])) { removeEnd = j; break; }
        const next = /^(\s*)-\s+/.exec(lines[j]);
        if (next && next[1].length === indent) { removeEnd = j; break; }
      }
      if (removeEnd === -1) removeEnd = lines.length;
      break;
    }
  }
  if (removeStart === -1) return text;
  lines.splice(removeStart, removeEnd - removeStart);
  return lines.join('\n');
}

function removeListenerEntry(text, name)   { return removeNamedListItem(text, 'listeners',    name); }
function removeProxyGroupEntry(text, name) { return removeNamedListItem(text, 'proxy-groups', name); }

function removeRuleLineMatching(text, re) {
  return text.split('\n').filter((l) => !re.test(l)).join('\n');
}
