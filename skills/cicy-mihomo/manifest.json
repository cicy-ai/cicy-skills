  "license": "MIT",
  "runtime": { "node": ">=18" },
  "system_requirements": ["curl", "tar"],
  "npm_dependencies": false,
  "entry": "bin/cicy-mihomo",
  "permissions": ["network", "filesystem:home", "process:spawn"],
  "compatible_agents": ["*"],
  "config": {
    "path": "~/cicy-ai/db/mihomo.yaml",
    "secret_fields": []
  },
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md"
