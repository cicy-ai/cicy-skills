{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "cicy-mihomo",
  "version": "1.0.0",
  "title": "Cicy Mihomo Proxy",
  "description": "Manage the local Cicy Mihomo (mihomo / clash-meta fork) proxy on this host with start/stop/reload/status/logs and node speed-testing.",
  "category": "network",
  "tags": ["mihomo", "clash", "proxy", "process-manager"],
  "author": "cicy-ai",
