{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "cicy-mihomo",
  "version": "1.4.3",
  "title": "Cicy Mihomo Proxy",
  "description": "Manage the local Cicy Mihomo proxy with start/stop/reload/status/logs, node speed-testing, and per-Chrome-profile listeners (multi-port + IN-NAME rules).",
  "category": "network",
  "tags": [
    "mihomo",
    "clash",
    "proxy",
    "process-manager"
  ],
  "author": "cicy-ai",
  "homepage": "https://github.com/cicy-ai/cicy-skills/tree/main/skills/cicy-mihomo",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": [
    "curl",
    "tar"
  ],
  "npm_dependencies": false,
  "entry": "bin/cicy-mihomo",
  "permissions": [
    "network",
    "filesystem:home",
    "process:spawn"
  ],
  "compatible_agents": [
    "*"
  ],
  "config": {
    "path": "~/cicy-ai/db/mihomo.yaml",
    "secret_fields": []
  },
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "Cicy Mihomo \u4ee3\u7406",
      "description": "\u7ba1\u7406\u672c\u5730 Cicy Mihomo (mihomo / clash-meta fork) \u4ee3\u7406\uff0c\u5305\u542b start/stop/reload/status/logs\u3001\u8282\u70b9\u6d4b\u901f\u548c\u6bcf Chrome Profile \u72ec\u7acb\u76d1\u542c\u7aef\u53e3\uff08\u591a\u7aef\u53e3 + IN-NAME \u89c4\u5219\uff09\u3002"
    }
  },
  "tools": [
    {
      "name": "start",
      "example": "cicy-mihomo start",
      "description": "Start the mihomo proxy daemon"
    },
    {
      "name": "stop",
      "example": "cicy-mihomo stop",
      "description": "Stop the mihomo proxy daemon"
    },
    {
      "name": "status",
      "example": "cicy-mihomo status",
      "description": "Show mihomo proxy status and active proxies"
    },
    {
      "name": "reload",
      "example": "cicy-mihomo reload",
      "description": "Reload config without restarting"
    },
    {
      "name": "add-chrome-profile",
      "example": "cicy-mihomo add-chrome-profile work --port 7891",
      "description": "Add a per-Chrome-profile proxy listener with IN-NAME rule"
    },
    {
      "name": "listeners",
      "example": "cicy-mihomo listeners",
      "description": "List all active per-profile listeners and their rule mappings"
    }
  ]
}