{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "eng",
  "version": "1.0.3",
  "title": "English Correction",
  "description": "One-shot English correction wrapper. POSTs the input text to cicy-code's /api/ai/correct endpoint and prints the corrected version.",
  "category": "productivity",
  "tags": [
    "english",
    "correction",
    "ai",
    "writing"
  ],
  "author": "cicy-ai",
  "homepage": "https://github.com/cicy-ai/cicy-skills/tree/main/skills/eng",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": [],
  "npm_dependencies": false,
  "entry": "bin/eng",
  "permissions": [
    "network",
    "filesystem:home"
  ],
  "compatible_agents": [
    "*"
  ],
  "config": {
    "path": "~/cicy-ai/global.json",
    "secret_fields": [
      "api_token"
    ]
  },
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "英文校对",
      "description": "一键英文语法校正包装器。将输入文本 POST 到 cicy-code 的 /api/ai/correct 并输出修正结果。"
    }
  },
  "tools": [
    {
      "name": "eng",
      "example": "eng '翻译这段话'",
      "description": "Translate text to English"
    }
  ]
}
