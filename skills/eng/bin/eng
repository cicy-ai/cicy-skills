#!/usr/bin/env node
// eng — one-shot English correction. POST /api/ai/correct on cicy-code.

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const json = argv.includes('--json');
const rest = argv.filter((a) => a !== '--json');

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const API_BASE = `http://127.0.0.1:${API_PORT}`;

(async () => {
  try {
    const text = readInput(rest);
    if (!text.trim()) bail('empty input', 2);

    const token = loadToken();
    let res;
    try {
      res = await fetch(API_BASE + '/api/ai/correct', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });
    } catch (e) {
      bail(`cannot reach cicy-code at ${API_BASE} (${e.message})`, 3);
    }
    const body = await res.text();
    if (res.status === 401 || res.status === 403) bail(`auth failed (${res.status})`, 3);
    if (res.status >= 400) bail(`api error (${res.status}): ${body.slice(0, 200)}`, 4);

    let parsed; try { parsed = JSON.parse(body); } catch { parsed = null; }
    const result = (parsed?.result || parsed?.data?.result || '').toString().trim() || body;
    if (json) console.log(JSON.stringify({ ok: true, data: { result, input: text } }));
    else process.stdout.write(result + '\n');
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`eng: ${msg}\n`);
  process.exit(code);
}

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: eng <text>   (or pipe text on stdin)\n'); }
}

function readInput(args) {
  // If args present, join them. Otherwise read stdin (when not a TTY).
  if (args.length > 0) return args.join(' ');
  if (process.stdin.isTTY) return '';
  return readFileSync(0, 'utf8');  // stdin
}

function loadToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON}`), { exitCode: 3 });
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}
