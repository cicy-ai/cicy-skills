#!/usr/bin/env node
// cicy-knowledge — team knowledge Layer 2 store CLI. Talks to cicy-code's
// /api/knowledge endpoints (token-authed). Zero deps, pure ESM, Node 18+.
// Subcommands: add / list / get / recall / promote / reject / supersede

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const json = argv.includes('--json');
const cmd = argv[0];
const rest = argv.slice(1).filter((a) => a !== '--json');

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const API_BASE = `http://127.0.0.1:${API_PORT}`;
const SELF = (process.env.X_AGENT_SHORT_ID || '').trim();

(async () => {
  try {
    switch (cmd) {
      case 'add':       await cmdAdd(rest); break;
      case 'list':      await cmdList(rest); break;
      case 'get':       await cmdGet(rest); break;
      case 'recall':    await cmdRecall(rest); break;
      case 'promote':   await cmdTransition(rest, 'promote'); break;
      case 'reject':    await cmdTransition(rest, 'reject'); break;
      case 'supersede': await cmdSupersede(rest); break;
      default: bail(`unknown command: ${cmd}. Try cicy-knowledge --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`cicy-knowledge: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: cicy-knowledge <add|list|get|recall|promote|reject|supersede> [args...]\n'); }
}

function loadToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) {
    throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON}`), { exitCode: 3 });
  }
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

async function api(method, path, payload) {
  const headers = { 'Authorization': `Bearer ${loadToken()}` };
  const init = { method, headers };
  if (payload !== undefined) {
    headers['Content-Type'] = 'application/json';
    init.body = JSON.stringify(payload);
  }
  let res;
  try { res = await fetch(API_BASE + path, init); }
  catch (e) { throw Object.assign(new Error(`cannot reach cicy-code at ${API_BASE} — is it running? (${e.message})`), { exitCode: 3 }); }
  const text = await res.text();
  if (res.status === 401 || res.status === 403) throw Object.assign(new Error(`auth failed (${res.status})`), { exitCode: 3 });
  if (res.status >= 400) {
    let body; try { body = JSON.parse(text); } catch { body = { error: text }; }
    throw Object.assign(new Error(`api error (${res.status}): ${body?.detail || body?.error || body?.message || text}`), { exitCode: 4 });
  }
  try { return JSON.parse(text); } catch { return text; }
}

// pull a flag value out of args: --key val  (returns '' when absent)
function flag(args, name) {
  const i = args.indexOf(name);
  return i >= 0 && i + 1 < args.length ? args[i + 1] : '';
}
// positional args = everything that isn't a --flag or its value
function positionals(args, valueFlags = []) {
  const out = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a.startsWith('--') || a === '-q') { if (valueFlags.includes(a)) i++; continue; }
    out.push(a);
  }
  return out;
}

function readStdin() {
  try { return readFileSync(0, 'utf8'); } catch { return ''; }
}

// ── commands ────────────────────────────────────────────────────────────

// cicy-knowledge add "<title>" [--body <md> | --body-file <f> | stdin]
//                              [--tags "a b"] [--source <kind>]
//                              [--source-pane <pane>] [--origin <ref>]
async function cmdAdd(args) {
  const valueFlags = ['--body', '--body-file', '--tags', '--source', '--source-pane', '--origin'];
  const pos = positionals(args, valueFlags);
  const title = pos[0];
  if (!title) throw Object.assign(new Error('Usage: cicy-knowledge add "<title>" [--body <md>|--body-file f|stdin] [--tags] [--source]'), { exitCode: 2 });

  let body = flag(args, '--body');
  const bodyFile = flag(args, '--body-file');
  if (!body && bodyFile) {
    if (!existsSync(bodyFile)) throw Object.assign(new Error(`--body-file not found: ${bodyFile}`), { exitCode: 2 });
    body = readFileSync(bodyFile, 'utf8');
  }
  if (!body) body = readStdin();
  body = (body || '').trim();
  if (!body) throw Object.assign(new Error('body required (use --body, --body-file, or pipe via stdin)'), { exitCode: 2 });

  const payload = {
    title,
    body,
    tags: flag(args, '--tags'),
    source_kind: flag(args, '--source') || 'manual',
    source_pane: flag(args, '--source-pane') || SELF,
    origin_ref: flag(args, '--origin'),
  };
  const data = await api('POST', '/api/knowledge', payload);
  if (json) return ok(data);
  console.log(`added pending knowledge: id=${data?.id}`);
}

// cicy-knowledge list [--status S] [--tag T] [-q kw]
async function cmdList(args) {
  const q = new URLSearchParams();
  const status = flag(args, '--status');
  const tag = flag(args, '--tag');
  const kw = flag(args, '-q') || flag(args, '--q');
  if (status) q.set('status', status);
  if (tag) q.set('tag', tag);
  if (kw) q.set('q', kw);
  const path = '/api/knowledge' + (q.toString() ? `?${q.toString()}` : '');
  const data = await api('GET', path);
  if (json) return ok(data);
  printRows(data?.knowledge || []);
}

// cicy-knowledge recall <kw> [--tag T]  — keyword/tag search over CANON only.
async function cmdRecall(args) {
  const pos = positionals(args, ['--tag']);
  const kw = pos[0] || '';
  const tag = flag(args, '--tag');
  if (!kw && !tag) throw Object.assign(new Error('Usage: cicy-knowledge recall <kw> [--tag T]'), { exitCode: 2 });
  const q = new URLSearchParams({ status: 'canon' });
  if (kw) q.set('q', kw);
  if (tag) q.set('tag', tag);
  const data = await api('GET', `/api/knowledge?${q.toString()}`);
  if (json) return ok(data);
  const rows = data?.knowledge || [];
  if (!rows.length) { console.log('(no canon knowledge matched)'); return; }
  printRows(rows);
}

// cicy-knowledge get <id>
async function cmdGet(args) {
  const id = positionals(args)[0];
  if (!id) throw Object.assign(new Error('Usage: cicy-knowledge get <id>'), { exitCode: 2 });
  const data = await api('GET', `/api/knowledge/${encodeURIComponent(id)}`);
  if (json) return ok(data);
  printOne(data);
}

// cicy-knowledge promote <id> [--domain <d>]  |  reject <id>
// promote moves the entry into a canon domain folder (default "general").
async function cmdTransition(args, action) {
  const id = positionals(args, ['--domain'])[0];
  if (!id) throw Object.assign(new Error(`Usage: cicy-knowledge ${action} <id>${action === 'promote' ? ' [--domain <d>]' : ''}`), { exitCode: 2 });
  const payload = { action, verified_by: SELF };
  if (action === 'promote') {
    const domain = flag(args, '--domain');
    if (domain) payload.domain = domain;
  }
  const data = await api('PATCH', `/api/knowledge/${encodeURIComponent(id)}`, payload);
  if (json) return ok(data);
  const where = action === 'promote' ? ` (${payload.domain || 'general'}/)` : '';
  console.log(`${id} → ${data?.status}${where}`);
}

// cicy-knowledge supersede <oldId> <newId>
async function cmdSupersede(args) {
  const pos = positionals(args);
  const [oldId, newId] = pos;
  if (!oldId || !newId) throw Object.assign(new Error('Usage: cicy-knowledge supersede <oldId> <newId>'), { exitCode: 2 });
  const data = await api('PATCH', `/api/knowledge/${encodeURIComponent(oldId)}`, { action: 'supersede', superseded_by: newId, verified_by: SELF });
  if (json) return ok(data);
  console.log(`${oldId} → superseded by ${newId}`);
}

// ── rendering ───────────────────────────────────────────────────────────

const trunc = (s, n) => String(s || '').replace(/\s+/g, ' ').trim().slice(0, n);

function printRows(rows) {
  if (!rows.length) { console.log('(no knowledge)'); return; }
  for (const k of rows) {
    const where = k.status === 'canon' && k.domain ? `canon:${k.domain}` : k.status;
    const tags = k.tags ? `  #${String(k.tags).trim().replace(/[,\s]+/g, ' #')}` : '';
    console.log(`${k.id}  [${where}]  ${trunc(k.title, 60)}${tags}`);
  }
}

function printOne(k) {
  if (!k || !k.id) { console.log('(not found)'); return; }
  console.log(`id:        ${k.id}`);
  console.log(`title:     ${k.title}`);
  console.log(`status:    ${k.status}${k.domain ? `  (domain: ${k.domain})` : ''}`);
  if (k.tags) console.log(`tags:      ${k.tags}`);
  if (k.source_kind) console.log(`source:    ${k.source_kind}${k.source_pane ? ` (${k.source_pane})` : ''}`);
  if (k.origin_ref) console.log(`origin:    ${k.origin_ref}`);
  if (k.verified_by) console.log(`verified:  ${k.verified_by}`);
  if (k.superseded_by) console.log(`superseded_by: ${k.superseded_by}`);
  if (k.created_at) console.log(`created:   ${k.created_at}`);
  console.log('---');
  console.log(k.body || '');
}
