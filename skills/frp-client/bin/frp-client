#!/usr/bin/env node
// frp-client — manage a local frpc process. Subcommands:
//   install / start / stop / restart / status / reload / logs / connections / raw
//   service <install|enable|disable|status>

import { readFileSync, writeFileSync, existsSync, mkdirSync, unlinkSync, openSync, closeSync } from 'node:fs';
import { homedir, platform, arch } from 'node:os';
import { join, dirname } from 'node:path';
import { spawn, execSync, execFileSync } from 'node:child_process';
import { createWriteStream } from 'node:fs';
import { pipeline } from 'node:stream/promises';

const KIND = 'client';
const NAME = 'frp-client';
const BINARY_NAME = 'frpc';
const ROLE_LABEL = 'FRP client';
const BIN_ENV = 'FRP_CLIENT_BIN';
const LOG_ENV = 'FRP_CLIENT_LOG';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const json = argv.includes('--json');
const cmd = argv[0];
const rest = argv.slice(1).filter((a) => a !== '--json');

const HOME = homedir();
const CONFIG_PATH = process.env.FRP_CONFIG || join(HOME, 'cicy-ai', 'db', BINARY_NAME + '.toml');
const STATE_DIR = join(HOME, '.local', 'state', 'cicy-skills', 'frp', KIND);
const PID_FILE = join(STATE_DIR, 'pid');
const STATE_FILE = join(STATE_DIR, 'state.json');
const DEFAULT_LOG = process.env[LOG_ENV] || join(HOME, 'logs', BINARY_NAME + '.log');
const INSTALL_BIN_DIR = join(HOME, '.frp-tunnel', 'bin');
const INSTALL_BIN = join(INSTALL_BIN_DIR, BINARY_NAME);

const BINARY_CANDIDATES = [
  process.env[BIN_ENV],
  INSTALL_BIN,
  join(HOME, '.local', 'bin', BINARY_NAME),
  join(HOME, 'bin', BINARY_NAME),
].filter(Boolean);

(async () => {
  try {
    switch (cmd) {
      case 'tools':       printTools(); return;
      case 'install':     await cmdInstall(rest); return;
      case 'service':     await cmdService(rest); return;
      case 'start':       await cmdStart(rest); return;
      case 'stop':        cmdStop(); return;
      case 'restart':     await cmdRestart(rest); return;
      case 'status':      await cmdStatus(); return;
      case 'reload':      await cmdReload(); return;
      case 'logs': case 'log': cmdLogs(rest); return;
      case 'connections': case 'conns': await cmdConnections(); return;
      case 'raw':         await cmdRaw(rest); return;
      default: bail(`unknown command: ${cmd}. Try ${NAME} --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`${NAME}: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write(`Usage: ${NAME} <start|stop|restart|status|reload|logs|connections|clients|raw>\n`); }
}
function printTools() {
  try { process.stdout.write(readFileSync(new URL('../references/tools.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write(`# ${NAME} tools\n`); }
}

function ensureDir(p) { if (!existsSync(p)) mkdirSync(p, { recursive: true }); }

function findBinary() {
  for (const c of BINARY_CANDIDATES) {
    if (c && existsSync(c)) return c;
  }
  return null;
}

function readPID() {
  if (!existsSync(PID_FILE)) return 0;
  const raw = readFileSync(PID_FILE, 'utf8').trim();
  const pid = parseInt(raw, 10);
  if (!pid) return 0;
  try { process.kill(pid, 0); return pid; }
  catch { return 0; }
}

function loadState() {
  if (!existsSync(STATE_FILE)) return {};
  try { return JSON.parse(readFileSync(STATE_FILE, 'utf8')); } catch { return {}; }
}
function saveState(s) {
  ensureDir(STATE_DIR);
  writeFileSync(STATE_FILE, JSON.stringify(s, null, 2));
}

function shQuote(s) { return `'${String(s).replace(/'/g, `'\\''`)}'`; }

// Find a running frps/frpc that uses OUR config but isn't tracked in PID_FILE —
// e.g. an orphan whose parent (a previous shell/session) died and got reparented
// to init. Without this, start() can't see it and spawns a duplicate that
// instantly dies on the already-bound port ("process died on launch"). Returns
// pid or 0. Works on Linux and macOS (pgrep + ps, no /proc dependency).
function findOrphanPid() {
  let out = '';
  try { out = execSync(`pgrep -f ${shQuote(CONFIG_PATH)} 2>/dev/null || true`, { encoding: 'utf8' }); }
  catch { return 0; }
  for (const tok of out.split(/\s+/)) {
    const pid = parseInt(tok, 10);
    if (!pid || pid === process.pid) continue;
    let comm = '';
    try { comm = execSync(`ps -p ${pid} -o comm= 2>/dev/null || true`, { encoding: 'utf8' }).trim(); }
    catch { continue; }
    if (comm === BINARY_NAME || comm.endsWith('/' + BINARY_NAME)) return pid;
  }
  return 0;
}

// Authoritative running-pid check: prefer the tracked PID file, else adopt an
// orphan frpc on our config (and persist it to PID_FILE so it's managed from
// now on). This is what makes start/stop/restart/status agree with reality.
function runningPid() {
  const tracked = readPID();
  if (tracked > 0) return tracked;
  const orphan = findOrphanPid();
  if (orphan > 0) {
    try { ensureDir(STATE_DIR); writeFileSync(PID_FILE, String(orphan)); } catch {}
    return orphan;
  }
  return 0;
}

// Pull the most relevant line out of the tail of the log so a failed launch
// reports WHY (e.g. "address already in use") instead of a bare "died".
function lastLogError() {
  let txt = '';
  try { txt = readFileSync(DEFAULT_LOG, 'utf8'); } catch { return ''; }
  const lines = txt.split('\n')
    .map((l) => l.replace(/\x1b\[[0-9;]*m/g, '').trim()) // strip ANSI colour codes
    .filter(Boolean)
    .slice(-25);
  for (let i = lines.length - 1; i >= 0; i--) {
    if (/address already in use|bind:|listen tcp|\berror\b|fail|panic/i.test(lines[i])) return lines[i];
  }
  return lines[lines.length - 1] || '';
}

// crude TOML key reader for `webServer.{addr,port,user,password}` and
// `bindAddr / bindPort` — frps native config syntax. Top-level only.
function readConfigHints() {
  if (!existsSync(CONFIG_PATH)) return {};
  const text = readFileSync(CONFIG_PATH, 'utf8');
  const hints = {};
  const re = /^([A-Za-z_][\w]*(?:\.[\w]+)*)\s*=\s*"?([^"#\n]+?)"?\s*(?:#.*)?$/gm;
  let m;
  while ((m = re.exec(text))) {
    hints[m[1]] = m[2].trim();
  }
  return hints;
}

function webServerURL() {
  const h = readConfigHints();
  const addr = h['webServer.addr'] || '127.0.0.1';
  const port = h['webServer.port'] || '7400';
  const user = h['webServer.user'] || '';
  const pass = h['webServer.password'] || '';
  const auth = (user || pass) ? `${encodeURIComponent(user)}:${encodeURIComponent(pass)}@` : '';
  return `http://${auth}${addr}:${port}`;
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdStart(args) {
  const existing = runningPid();
  if (existing > 0) {
    // Idempotent: already running (incl. an adopted orphan) is success, not an
    // error — so the UI shows "running" instead of a scary failure.
    if (json) return ok({ pid: existing, already_running: true });
    console.log(`already running (pid=${existing})`);
    return;
  }
  const bin = findBinary();
  if (!bin) bail(`${BINARY_NAME} binary not found. Install it and put on PATH or set ${BIN_ENV}.`, 3);
  if (!existsSync(CONFIG_PATH)) bail(`config missing: ${CONFIG_PATH}`, 3);

  // optional extra args after `--`: cicy-skills/frp-server start -- --foo bar
  let extra = [];
  const sep = args.indexOf('--');
  if (sep !== -1) extra = args.slice(sep + 1);

  ensureDir(STATE_DIR);
  ensureDir(dirname(DEFAULT_LOG));
  const fd = openSync(DEFAULT_LOG, 'a');
  const finalArgs = ['-c', CONFIG_PATH, ...extra];
  const child = spawn(bin, finalArgs, { detached: true, stdio: ['ignore', fd, fd] });
  child.unref();
  closeSync(fd);
  await new Promise((r) => setTimeout(r, 500));
  try { process.kill(child.pid, 0); }
  catch {
    const reason = lastLogError();
    bail(`process died on launch${reason ? `: ${reason}` : ''} — see ${DEFAULT_LOG}`, 4);
  }
  writeFileSync(PID_FILE, String(child.pid));
  saveState({ pid: child.pid, binary: bin, config: CONFIG_PATH, log: DEFAULT_LOG, started_at: new Date().toISOString(), extra_args: extra });
  if (json) return ok({ pid: child.pid, binary: bin, config: CONFIG_PATH, log: DEFAULT_LOG });
  console.log(`✓ started ${ROLE_LABEL} pid=${child.pid}`);
  console.log(`  binary: ${bin}`);
  console.log(`  config: ${CONFIG_PATH}`);
  console.log(`  log:    ${DEFAULT_LOG}`);
}

function cmdStop() {
  const pid = runningPid();
  if (!pid) bail('not running', 4);
  try { process.kill(pid, 'SIGTERM'); } catch (e) { bail(`kill failed: ${e.message}`, 4); }
  const deadline = Date.now() + 5000;
  while (Date.now() < deadline) {
    try { process.kill(pid, 0); }
    catch { try { unlinkSync(PID_FILE); } catch {}; if (json) return ok({ stopped: pid }); console.log(`✓ stopped pid=${pid}`); return; }
    execSync('sleep 0.1');
  }
  try { process.kill(pid, 'SIGKILL'); } catch {}
  try { unlinkSync(PID_FILE); } catch {}
  if (json) return ok({ killed: pid });
  console.log(`! force-killed pid=${pid}`);
}

async function cmdRestart(args) {
  if (runningPid() > 0) cmdStop();
  await cmdStart(args);
}

async function cmdStatus() {
  const pid = runningPid();
  const bin = findBinary();
  const out = {
    role: ROLE_LABEL, pid, running: pid > 0,
    binary: bin || `(not found in ${BINARY_CANDIDATES.join(', ')})`,
    binary_installed: !!bin,
    config: CONFIG_PATH, config_exists: existsSync(CONFIG_PATH),
    log: DEFAULT_LOG,
    web_dashboard: '',
  };
  if (pid > 0) {
    const u = webServerURL();
    out.web_dashboard = u;
    try {
      const r = await fetch(u + '/api/status', { signal: AbortSignal.timeout(2000) });
      if (r.ok) out.serverinfo = await r.json();
    } catch (e) { out.api_error = e.message; }
  }
  if (json) return ok(out);
  console.log(`role:    ${out.role}`);
  console.log(`state:   ${out.running ? 'running' : 'stopped'}`);
  console.log(`pid:     ${out.pid || '(not running)'}`);
  console.log(`binary:  ${out.binary}`);
  console.log(`config:  ${out.config} ${out.config_exists ? '✓' : '(missing)'}`);
  console.log(`log:     ${out.log}`);
  if (out.web_dashboard) console.log(`webapi:  ${out.web_dashboard}`);
  if (out.serverinfo)    console.log(`server:  v${out.serverinfo.version || '?'} ${out.serverinfo.bindPort ? '(:' + out.serverinfo.bindPort + ')' : ''}`);
}

async function cmdReload() {
  const pid = runningPid();
  if (!pid) bail('not running', 4);
  // frps does NOT support reload via web api in all versions; use SIGHUP if frps supports it
  // (since frp v0.50 hot-reload by sending SIGHUP works)
  try { process.kill(pid, 'SIGHUP'); }
  catch (e) { bail(`SIGHUP failed: ${e.message}`, 4); }
  if (json) return ok({ reloaded: true, pid, signal: 'SIGHUP' });
  console.log(`✓ sent SIGHUP to pid=${pid} (frps v0.50+ hot-reloads)`);
}

function cmdLogs(args) {
  let lines = 100;
  let follow = false;
  for (const a of args) {
    if (a === '-f' || a === '--follow') follow = true;
    else if (/^\d+$/.test(a)) lines = parseInt(a, 10);
  }
  if (!existsSync(DEFAULT_LOG)) bail(`no log at ${DEFAULT_LOG}`, 3);
  const flags = ['-n', String(lines)];
  if (follow) flags.push('-f');
  flags.push(DEFAULT_LOG);
  const child = spawn('tail', flags, { stdio: 'inherit' });
  child.on('exit', (code) => process.exit(code ?? 0));
}

async function cmdConnections() {
  if (runningPid() === 0) bail('not running', 4);
  const u = webServerURL();
  let r; try { r = await fetch(u + '/api/status', { signal: AbortSignal.timeout(3000) }); } catch (e) { bail(`web api unreachable at ${u}: ${e.message}`, 4); }
  if (!r.ok) bail(`web api error (${r.status})`, 4);
  const data = await r.json();
  if (json) return ok(data);
  console.log(JSON.stringify(data, null, 2));
}

async function cmdRaw(args) {
  if (args.length < 1) bail(`Usage: ${NAME} raw -- <real ${BINARY_NAME} args...>`, 2);
  const sep = args.indexOf('--');
  const realArgs = sep === -1 ? args : args.slice(sep + 1);
  const bin = findBinary();
  if (!bin) bail(`${BINARY_NAME} binary not found`, 3);
  const child = spawn(bin, realArgs, { stdio: 'inherit' });
  child.on('exit', (code) => process.exit(code ?? 0));
}

// ── install ──────────────────────────────────────────────────────────────
// frp-client install [options]
//   Downloads frpc, writes ~/cicy-ai/db/frpc.toml, installs systemd/launchd.
//
// Options:
//   --server <HOST>        FRP server address (required on first install)
//   --token <TOKEN>        FRP auth token (required on first install)
//   --server-port <PORT>   default 9500
//   --remote-port <PORT>   default 9502
//   --local-port <PORT>    default 22
//   --local-ip <IP>        default 127.0.0.1
//   --name <NAME>          default auto
//   --admin-port <PORT>    default 7400
//   --frp-version <VER>    default 0.68.1
//   --service <auto|systemd|launchd|none>  default auto
//   --github-proxy <URL>   default https://gh-proxy.com/

async function cmdInstall(args) {
  const opt = {
    server: process.env.FRP_SERVER || '',
    token: process.env.FRP_TOKEN || '',
    serverPort: '9500',
    remotePort: '9502',
    localPort: '22',
    localIp: '127.0.0.1',
    name: '',
    adminPort: '7400',
    frpVersion: '0.68.1',
    service: 'auto',
    githubProxy: process.env.GITHUB_PROXY || 'https://gh-proxy.com/',
  };
  let configArgsProvided = false;
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    const v = () => { configArgsProvided = true; return args[++i] || ''; };
    if (a === '--server') { opt.server = v(); }
    else if (a === '--token') { opt.token = v(); }
    else if (a === '--server-port') { opt.serverPort = v(); }
    else if (a === '--remote-port') { opt.remotePort = v(); }
    else if (a === '--local-port') { opt.localPort = v(); }
    else if (a === '--local-ip') { opt.localIp = v(); }
    else if (a === '--name') { opt.name = v(); }
    else if (a === '--admin-port') { opt.adminPort = v(); }
    else if (a === '--frp-version') { opt.frpVersion = args[++i] || opt.frpVersion; }
    else if (a === '--service') { opt.service = args[++i] || opt.service; }
    else if (a === '--github-proxy') { opt.githubProxy = args[++i] || opt.githubProxy; }
    else bail(`unknown install option: ${a}`, 2);
  }

  const os = platform(); // 'linux' | 'darwin'
  const cpuArch = arch(); // 'x64' | 'arm64'
  let frpPlatform;
  if (os === 'linux') {
    frpPlatform = cpuArch === 'arm64' ? 'linux_arm64' : 'linux_amd64';
    if (!opt.name) opt.name = 'linux-ssh';
  } else if (os === 'darwin') {
    frpPlatform = cpuArch === 'arm64' ? 'darwin_arm64' : 'darwin_amd64';
    if (!opt.name) opt.name = 'mac-ssh';
  } else {
    bail(`unsupported OS: ${os}. Windows not yet supported.`, 2);
  }

  // ── 1. download frpc ───────────────────────────────────────────────────
  process.stderr.write(`[1/4] downloading frpc ${opt.frpVersion} (${frpPlatform})\n`);
  const archive = `frp_${opt.frpVersion}_${frpPlatform}.tar.gz`;
  const sourceURL = `https://github.com/fatedier/frp/releases/download/v${opt.frpVersion}/${archive}`;
  const tmpDir = join(HOME, '.local', 'state', 'cicy-skills', 'frp', 'install-tmp');
  mkdirSync(tmpDir, { recursive: true });
  const archivePath = join(tmpDir, archive);

  const proxies = [opt.githubProxy, 'https://ghfast.top/', 'https://ghproxy.net/', ''];
  let downloaded = false;
  for (const proxy of proxies) {
    const url = proxy ? proxy + sourceURL : sourceURL;
    process.stderr.write(`  trying ${url}\n`);
    try {
      const res = await fetch(url, { redirect: 'follow', signal: AbortSignal.timeout(30000) });
      if (!res.ok) { process.stderr.write(`  HTTP ${res.status}\n`); continue; }
      const ws = createWriteStream(archivePath);
      await pipeline(res.body, ws);
      downloaded = true;
      break;
    } catch (e) { process.stderr.write(`  failed: ${e.message}\n`); }
  }
  if (!downloaded) bail('frpc download failed. Check network or set GITHUB_PROXY.', 3);

  mkdirSync(INSTALL_BIN_DIR, { recursive: true });
  execFileSync('tar', ['-xzf', archivePath, '-C', tmpDir]);
  const frpcSrc = join(tmpDir, `frp_${opt.frpVersion}_${frpPlatform}`, 'frpc');
  execFileSync('install', ['-m', '0755', frpcSrc, INSTALL_BIN]);
  process.stderr.write(`  installed: ${INSTALL_BIN}\n`);

  // ── 2. config ─────────────────────────────────────────────────────────
  process.stderr.write('[2/4] config\n');
  let configReused = false;
  if (existsSync(CONFIG_PATH)) {
    configReused = true;
    process.stderr.write(`  reusing existing config: ${CONFIG_PATH}\n`);
    if (configArgsProvided) process.stderr.write('  note: --server/--token/--port flags ignored (config already exists)\n');
  } else {
    if (!opt.server) bail('--server <HOST> required on first install (or set FRP_SERVER)', 2);
    if (!opt.token) bail('--token <TOKEN> required on first install (or set FRP_TOKEN)', 2);
    mkdirSync(dirname(CONFIG_PATH), { recursive: true });
    writeFileSync(CONFIG_PATH, [
      `serverAddr = "${opt.server}"`,
      `serverPort = ${opt.serverPort}`,
      '',
      `auth.method = "token"`,
      `auth.token = "${opt.token}"`,
      '',
      `webServer.addr = "127.0.0.1"`,
      `webServer.port = ${opt.adminPort}`,
      '',
      `[[proxies]]`,
      `name = "${opt.name}"`,
      `type = "tcp"`,
      `localIP = "${opt.localIp}"`,
      `localPort = ${opt.localPort}`,
      `remotePort = ${opt.remotePort}`,
    ].join('\n') + '\n');
    process.stderr.write(`  wrote config: ${CONFIG_PATH}\n`);
  }

  // ── 3. service ────────────────────────────────────────────────────────
  process.stderr.write('[3/4] service\n');
  const svcMode = resolveServiceMode(opt.service, os);
  if (svcMode === 'systemd') {
    installSystemd();
  } else if (svcMode === 'launchd') {
    installLaunchd();
  } else {
    process.stderr.write('  service=none; use "frp-client start" to run manually\n');
  }

  // ── 4. verify ─────────────────────────────────────────────────────────
  process.stderr.write('[4/4] verify\n');
  await new Promise((r) => setTimeout(r, 2000));
  let verifyOut = '';
  try { verifyOut = execFileSync(INSTALL_BIN, ['status', '-c', CONFIG_PATH], { encoding: 'utf8', timeout: 5000 }); } catch {}
  if (verifyOut) process.stderr.write(verifyOut);

  const summary = {
    binary: INSTALL_BIN,
    config: CONFIG_PATH,
    config_reused: configReused,
    log: DEFAULT_LOG,
    service: svcMode,
  };
  if (json) return ok(summary);
  console.log(`\n✓ frp-client installed`);
  console.log(`  binary:  ${INSTALL_BIN}`);
  console.log(`  config:  ${CONFIG_PATH}`);
  console.log(`  service: ${svcMode}`);
  console.log(`  log:     ${DEFAULT_LOG}`);
}

// ── service subcommand ───────────────────────────────────────────────────
// frp-client service <install|enable|disable|status>

async function cmdService(args) {
  const sub = args[0];
  if (!sub) bail('usage: frp-client service <install|enable|disable|status>', 2);
  const os = platform();
  const svcMode = resolveServiceMode('auto', os);
  switch (sub) {
    case 'install':
      if (svcMode === 'systemd') installSystemd();
      else if (svcMode === 'launchd') installLaunchd();
      else bail('no service manager available (systemd or launchd required)', 3);
      if (json) return ok({ service: svcMode, installed: true });
      console.log(`✓ service installed (${svcMode})`);
      break;
    case 'enable':
      if (svcMode === 'systemd') {
        execSync(`sudo systemctl enable "${systemdServiceName()}"`, { stdio: 'inherit' });
      } else if (svcMode === 'launchd') {
        execSync(`launchctl enable "gui/$(id -u)/${launchdLabel()}"`, { stdio: 'inherit' });
      } else bail('no service manager', 3);
      break;
    case 'disable':
      if (svcMode === 'systemd') {
        try { execSync(`sudo systemctl stop "${systemdServiceName()}" 2>/dev/null || true`); } catch {}
        execSync(`sudo systemctl disable "${systemdServiceName()}"`, { stdio: 'inherit' });
      } else if (svcMode === 'launchd') {
        try { execSync(`launchctl bootout "gui/$(id -u)/${launchdLabel()}" 2>/dev/null || true`); } catch {}
      } else bail('no service manager', 3);
      break;
    case 'status':
      if (svcMode === 'systemd') {
        execSync(`systemctl status "${systemdServiceName()}" --no-pager 2>&1 || true`, { stdio: 'inherit' });
      } else if (svcMode === 'launchd') {
        execSync(`launchctl print "gui/$(id -u)/${launchdLabel()}" 2>&1 || true`, { stdio: 'inherit' });
      } else {
        await cmdStatus();
      }
      break;
    default:
      bail(`unknown service subcommand: ${sub}. Use install|enable|disable|status.`, 2);
  }
}

// ── service helpers ──────────────────────────────────────────────────────

function resolveServiceMode(requested, os) {
  if (requested === 'auto') {
    if (os === 'darwin') return 'launchd';
    if (os === 'linux') {
      try { execFileSync('which', ['systemctl'], { stdio: 'ignore' }); return 'systemd'; } catch {}
      return 'none';
    }
    return 'none';
  }
  if (requested === 'systemd') return 'systemd';
  if (requested === 'launchd') return 'launchd';
  return 'none';
}

function systemdServiceName() {
  const user = process.env.USER || process.env.LOGNAME || 'cicy';
  return `frpc-cicy-${user}.service`;
}

function launchdLabel() { return 'com.cicy.frpc'; }

function installSystemd() {
  const svcName = systemdServiceName();
  const svcPath = `/etc/systemd/system/${svcName}`;
  const unit = [
    '[Unit]',
    'Description=FRP Client for CiCy',
    'After=network-online.target',
    'Wants=network-online.target',
    '',
    '[Service]',
    'Type=simple',
    `User=${process.env.USER || process.env.LOGNAME || 'cicy'}`,
    `Environment=HOME=${HOME}`,
    `WorkingDirectory=${HOME}`,
    `ExecStart=${INSTALL_BIN} -c ${CONFIG_PATH}`,
    'Restart=always',
    'RestartSec=5',
    '',
    '[Install]',
    'WantedBy=multi-user.target',
  ].join('\n') + '\n';
  execSync(`echo ${JSON.stringify(unit)} | sudo tee ${svcPath} > /dev/null`);
  execSync('sudo systemctl daemon-reload');
  execSync(`sudo systemctl enable --now "${svcName}"`, { stdio: 'inherit' });
  process.stderr.write(`  systemd service: ${svcName}\n`);
}

function installLaunchd() {
  const label = launchdLabel();
  const plistPath = join(HOME, 'Library', 'LaunchAgents', `${label}.plist`);
  mkdirSync(dirname(plistPath), { recursive: true });
  const logDir = dirname(DEFAULT_LOG);
  mkdirSync(logDir, { recursive: true });
  const plist = `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>${label}</string>
    <key>ProgramArguments</key>
    <array>
      <string>${INSTALL_BIN}</string>
      <string>-c</string>
      <string>${CONFIG_PATH}</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>${DEFAULT_LOG}</string>
    <key>StandardErrorPath</key><string>${DEFAULT_LOG}</string>
  </dict>
</plist>
`;
  writeFileSync(plistPath, plist);
  execSync(`launchctl bootout "gui/$(id -u)/${label}" 2>/dev/null || launchctl unload "${plistPath}" 2>/dev/null || true`);
  execSync(`launchctl bootstrap "gui/$(id -u)/${label}" "${plistPath}" 2>/dev/null || launchctl load -w "${plistPath}"`);
  process.stderr.write(`  launchd plist: ${plistPath}\n`);
}
