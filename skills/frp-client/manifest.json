{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "frp-client",
  "version": "1.0.4",
  "title": "FRP Client",
  "description": "Manage a local frpc process on this host with background start, status, proxy connections, hot reload, and stop/start controls. Remote machines via ssh.",
  "category": "network",
  "tags": [
    "frp",
    "frpc",
    "tunneling",
    "process-manager"
  ],
  "author": "cicy-ai",
  "homepage": "https://github.com/cicy-ai/cicy-skills/tree/main/skills/frp-client",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": [],
  "npm_dependencies": false,
  "entry": "bin/frp-client",
  "permissions": [
    "network",
    "filesystem:home",
    "process:spawn"
  ],
  "compatible_agents": [
    "*"
  ],
  "config": {
    "path": "~/cicy-ai/db/frpc.toml",
    "secret_fields": []
  },
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "FRP \u5ba2\u6237\u7aef",
      "description": "\u7ba1\u7406\u672c\u673a frpc \u8fdb\u7a0b\uff0c\u652f\u6301\u540e\u53f0\u542f\u52a8\u3001\u72b6\u6001\u67e5\u8be2\u3001\u4ee3\u7406\u8fde\u63a5\u3001\u70ed\u91cd\u8f7d\u548c start/stop\uff0c\u53ef\u901a\u8fc7 ssh \u7ba1\u7406\u8fdc\u7a0b\u673a\u5668\u3002"
    }
  },
  "tools": [
    {
      "name": "frp-client start",
      "example": "frp-client start",
      "description": "Start frpc (FRP client) in background"
    },
    {
      "name": "frp-client status",
      "example": "frp-client status",
      "description": "Show frpc status and proxy connections"
    },
    {
      "name": "frp-client stop",
      "example": "frp-client stop",
      "description": "Stop frpc"
    },
    {
      "name": "frp-client reload",
      "example": "frp-client reload",
      "description": "Hot-reload frpc config without restart"
    }
  ]
}
