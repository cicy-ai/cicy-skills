#!/usr/bin/env node
// feishu-cli — wrapper for the official Feishu/Lark CLI.
//   npm package: @larksuite/cli   ·   binary: lark-cli
// Commands: install / config / auth / status / run.
//   install/config/auth/status bootstrap & inspect the CLI.
//   run forwards ANY lark-cli command through, with the *.feishu.cn proxy
//   bypass handled automatically (see larkEnv) so callers never need the
//   `env -u HTTP_PROXY ... lark-cli` dance.
// Zero npm dependencies. Pure ESM. Node 18+.

import { readFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';

const NPM_PKG = '@larksuite/cli';
const BIN = 'lark-cli';

const argv = process.argv.slice(2);
const cmd = argv[0];
const rest = argv.slice(1);

if (!cmd || cmd === '--help' || cmd === '-h' || cmd === 'help') {
  printHelp();
  process.exit(0);
}

try {
  switch (cmd) {
    case 'install': cmdInstall(rest); break;
    case 'config':  cmdPassthrough(['config', 'init'], [], rest); break;
    case 'auth':    cmdPassthrough(['auth', 'login'], ['--recommend'], rest); break;
    case 'status':  cmdStatus(rest.includes('--json')); break;
    case 'run': case 'x': cmdRun(rest); break;
    default: bail(`unknown command: ${cmd}. Try feishu-cli --help.`, 2);
  }
} catch (e) {
  bail(e.message, e.exitCode || 1);
}

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  process.stderr.write(`feishu-cli: ${msg}\n`);
  process.exit(code);
}

function printHelp() {
  try {
    process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8'));
  } catch {
    process.stdout.write(`Usage:
  feishu-cli install [--force]    Install the official lark-cli via ${NPM_PKG}
  feishu-cli config [-- ...]      Configure app credentials (lark-cli config init)
  feishu-cli auth   [-- ...]      OAuth login, prints an authorization URL
  feishu-cli status [--json]      Show install + auth state
  feishu-cli run <lark args...>   Run any lark-cli command (proxy bypass auto-handled)
  feishu-cli --help / -h / help   Print this help

Examples:
  feishu-cli run sheets +create --title "T" --headers '["A","B"]' --data '[["1","2"]]'
  feishu-cli run im +messages-send --chat-id oc_xxx --text Hello
  feishu-cli run calendar +agenda
`);
  }
}

// Environment for invoking lark-cli. lark-cli only ever talks to *.feishu.cn /
// *.larksuite.com; on hosts whose proxy exits outside mainland China those
// endpoints reset the connection (EOF). So by default we strip the proxy env
// vars and add the feishu/lark domains to NO_PROXY, forcing lark-cli onto the
// host's direct egress. Set FEISHU_CLI_KEEP_PROXY=1 to opt out (e.g. a host
// that can only reach the internet through a proxy).
function larkEnv() {
  if (process.env.FEISHU_CLI_KEEP_PROXY) return process.env;
  const e = { ...process.env };
  for (const k of ['HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'http_proxy', 'https_proxy', 'all_proxy']) {
    delete e[k];
  }
  const extra = 'feishu.cn,larksuite.com,feishu.com,larkoffice.com';
  e.NO_PROXY = e.NO_PROXY ? `${e.NO_PROXY},${extra}` : extra;
  e.no_proxy = e.NO_PROXY;
  return e;
}

// Spawn an npm-installed bin cross-platform. On Windows npm exposes bins as
// .cmd shims, which node refuses to spawn without shell:true (and CreateProcess
// won't resolve them bare) — on ENOENT, retry via `<name>.cmd` + shell with the
// args quoted so cmd.exe's re-parse keeps them intact. POSIX path unchanged.
function spawnNpmBin(name, args, opts) {
  const r = spawnSync(name, args, opts);
  if (r.error?.code === 'ENOENT' && process.platform === 'win32') {
    const q = (a) => (/[\s"^&|<>]/.test(a) ? `"${String(a).replace(/"/g, '\\"')}"` : a);
    return spawnSync(`${name}.cmd`, args.map(q), { ...opts, shell: true });
  }
  return r;
}

// Return the lark-cli version string, or null if the binary is not on PATH.
function larkVersion() {
  const r = spawnNpmBin(BIN, ['--version'], { encoding: 'utf8', timeout: 8000, env: larkEnv() });
  if (r.error) {
    if (r.error.code === 'ENOENT') return null;
    return '(unknown)';
  }
  return ((r.stdout || '') + (r.stderr || '')).trim() || '(unknown)';
}

function requireInstalled() {
  if (larkVersion() === null) {
    throw Object.assign(new Error('lark-cli not installed — run `feishu-cli install` first'), { exitCode: 3 });
  }
}

// ── install ───────────────────────────────────────────────────────────────

function cmdInstall(extra) {
  const force = extra.includes('--force');
  const before = larkVersion();
  if (before !== null && !force) {
    console.log(`✓ lark-cli already installed (${before})`);
    console.log('  use --force to reinstall');
    return;
  }
  // npm registry + the feishu CDN binary download work fine through a proxy, so
  // install keeps the ambient environment (unlike the feishu.cn API calls).
  console.log(`→ installing ${NPM_PKG} (downloads the lark-cli binary) ...`);
  const r = spawnNpmBin("npx", ["-y", `${NPM_PKG}@latest`, "install"], { stdio: "inherit" });
  if (r.error) {
    if (r.error.code === 'ENOENT') {
      throw Object.assign(new Error('npx not found — install Node.js (npm) first'), { exitCode: 4 });
    }
    throw Object.assign(new Error(`npx failed: ${r.error.message}`), { exitCode: 1 });
  }
  if (r.status !== 0) {
    throw Object.assign(new Error(`installer exited ${r.status}`), { exitCode: r.status || 1 });
  }
  const after = larkVersion();
  if (after !== null) {
    console.log(`✓ lark-cli installed (${after})`);
    console.log('  next: feishu-cli config   then   feishu-cli auth');
  } else {
    console.log('⚠ installer finished but `lark-cli` is not on PATH.');
    console.log('  Open a new shell, or ensure the npm global bin dir is on PATH, then re-run `feishu-cli status`.');
  }
}

// ── config / auth (thin passthrough to lark-cli) ────────────────────────────

// `base` is the always-present subcommand path (e.g. ['config','init'] or
// ['auth','login']) — never dropped, since lark-cli requires that positional
// subcommand. `defaultExtra` is used only when the caller passes none; any
// caller-supplied flags (after an optional literal `--`) append AFTER base.
function cmdPassthrough(base, defaultExtra, extra) {
  requireInstalled();
  const passed = extra[0] === '--' ? extra.slice(1) : extra;
  const args = [...base, ...(passed.length ? passed : defaultExtra)];
  const label = base.join(' ');
  const r = spawnNpmBin(BIN, args, { stdio: 'inherit', env: larkEnv() });
  if (r.error) {
    throw Object.assign(new Error(`lark-cli ${label} failed: ${r.error.message}`), { exitCode: 1 });
  }
  if (r.status !== 0) {
    throw Object.assign(new Error(`lark-cli ${label} exited ${r.status}`), { exitCode: r.status || 1 });
  }
}

// ── run (generic proxy-aware passthrough) ───────────────────────────────────

// Forward an arbitrary lark-cli command line, with the proxy bypass applied so
// callers (and novices) never type the env-var dance:
//   feishu-cli run sheets +create --title ...
//   feishu-cli run calendar +agenda
// Exit code and stdio are passed through transparently.
function cmdRun(extra) {
  requireInstalled();
  const args = extra[0] === '--' ? extra.slice(1) : extra;
  if (args.length === 0) {
    throw Object.assign(new Error('usage: feishu-cli run <lark-cli args...>  (e.g. feishu-cli run calendar +agenda)'), { exitCode: 2 });
  }
  const r = spawnNpmBin(BIN, args, { stdio: 'inherit', env: larkEnv() });
  if (r.error) {
    throw Object.assign(new Error(`lark-cli failed: ${r.error.message}`), { exitCode: 1 });
  }
  process.exit(r.status == null ? 1 : r.status);
}

// ── status ──────────────────────────────────────────────────────────────────

function cmdStatus(json) {
  const version = larkVersion();
  const out = {
    npm_package: NPM_PKG,
    binary: BIN,
    installed: version !== null,
    version: version || '',
    authenticated: null,   // null = could not determine (not installed)
    auth_status: '',
  };

  if (out.installed) {
    const r = spawnNpmBin(BIN, ['auth', 'status'], { encoding: 'utf8', timeout: 10000, env: larkEnv() });
    if (!r.error) {
      out.authenticated = r.status === 0;
      out.auth_status = ((r.stdout || '') + (r.stderr || '')).trim().split('\n').slice(0, 6).join('\n');
    }
  }

  if (json) {
    console.log(JSON.stringify({ ok: true, data: out }));
    return;
  }
  console.log(`npm package:   ${out.npm_package}`);
  console.log(`binary:        ${out.binary}`);
  console.log(`installed:     ${out.installed}${out.version ? ' [' + out.version + ']' : ''}`);
  if (!out.installed) {
    console.log('               run `feishu-cli install`');
    return;
  }
  console.log(`authenticated: ${out.authenticated === null ? '(unknown)' : out.authenticated}`);
  if (out.auth_status) console.log(`auth status:\n${out.auth_status.split('\n').map((l) => '  ' + l).join('\n')}`);
  if (!out.authenticated) console.log('               run `feishu-cli config` then `feishu-cli auth`');
}
