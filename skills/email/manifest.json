{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "email",
  "version": "2.1.0",
  "title": "Email (SMTP/IMAP/POP3)",
  "description": "Self-hosted email over standard protocols: send via SMTP, receive via IMAP or POP3. Subcommands: config / status / send / list / read.",
  "category": "productivity",
  "tags": [
    "email",
    "smtp",
    "imap",
    "pop3"
  ],
  "author": "cicy-ai",
  "homepage": "https://github.com/cicy-ai/cicy-skills/tree/main/skills/email",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": [],
  "npm_dependencies": false,
  "entry": "bin/email",
  "config": {
    "path": "~/cicy-ai/db/email.json",
    "permissions": "0600",
    "secret_fields": [
      "smtp.pass",
      "imap.pass",
      "pop3.pass"
    ]
  },
  "permissions": [
    "network",
    "filesystem:db"
  ],
  "compatible_agents": [
    "*"
  ],
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "Email (SMTP/IMAP/POP3)",
      "description": "用标准协议自托管邮件:SMTP 发信,IMAP/POP3 收信。子命令:config / status / send / list / read。"
    }
  },
  "tools": [
    {
      "name": "email send",
      "example": "email send --to user@example.com --subject 'Hello' --body 'hi'",
      "description": "Send an email via configured SMTP"
    },
    {
      "name": "email list",
      "example": "email list --n 10",
      "description": "List recent inbox messages via IMAP or POP3"
    },
    {
      "name": "email read",
      "example": "email read 1",
      "description": "Read a message by index via IMAP or POP3"
    },
    {
      "name": "email config",
      "example": "email config",
      "description": "Create/open the email configuration in $EDITOR"
    },
    {
      "name": "email status",
      "example": "email status --json",
      "description": "Show config state (passwords masked)"
    }
  ]
}
