#!/usr/bin/env node
// cicy-agent — tmux pane/window operations via cicy-code's /api/tmux/* endpoints.
// Subcommands: list / ls / tree / windows / capture / reply / msg / msgs /
//              broadcast / get_online_agents / get_offline_agents /
//              get_all_agents / send-keys / restart / clear / fork / create /
//              whoami / cloud

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const globalArgs = extractGlobalArgs(argv);
const json = globalArgs.json;
const cmd = globalArgs.args[0];
const rest = globalArgs.args.slice(1);

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const CLOUD_DEVICE_JSON = process.env.CICY_CLOUD_DEVICE_JSON || join(homedir(), 'cicy-ai', 'db', 'cloud-device.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const API_BASE = `http://127.0.0.1:${API_PORT}`;

(async () => {
  try {
    const r2 = rest;
    const node = '';
    switch (cmd) {
      case 'tools':              printTools(); return;
      case 'list':               await cmdList(r2, node); break;
      case 'ls':                 await cmdLs(r2, node); break;
      case 'tree':               await cmdTree(r2, node); break;
      case 'windows':            await cmdWindows(r2, node); break;
      case 'capture':            await cmdCapture(r2, node); break;
      case 'reply':              await cmdReply(r2, node); break;
      case 'msg':                await cmdMsg(r2, node); break;
      case 'msgs':               await cmdMsgs(r2, node); break;
      case 'broadcast':          await cmdBroadcast(r2, node); break;
      case 'get_online_agents': case 'get-online-agents':   await cmdAgents('online', node); break;
      case 'get_offline_agents': case 'get-offline-agents': await cmdAgents('offline', node); break;
      case 'get_all_agents': case 'get-all-agents':         await cmdAgents('all', node); break;
      case 'send-keys':          await cmdSendKeys(r2, node); break;
      case 'restart':            await cmdRestart(r2, node); break;
      case 'clear':               await cmdClear(r2, node); break;
      case 'fork':               await cmdFork(r2, node); break;
      case 'create': case 'new':  await cmdCreate(r2, node); break;
      case 'whoami': case 'identity': case 'self': await cmdWhoami(r2, node); break;
      case 'cloud':              await cmdCloud(r2); break;
      default: bail(`unknown command: ${cmd}. Try cicy-agent --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`cicy-agent: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: cicy-agent <list|ls|tree|windows|capture|reply|msg|msgs|send-keys|restart|clear|fork|create|whoami|cloud> [args...]\n'); }
}
function printTools() {
  try { process.stdout.write(readFileSync(new URL('../references/tools.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('# cicy-agent tools\n'); }
}

function extractGlobalArgs(args) {
  let jsonMode = false;
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--json') { jsonMode = true; continue; }
    rest.push(args[i]);
  }
  return { args: rest, json: jsonMode };
}

function loadLocalToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) {
    throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON}`), { exitCode: 3 });
  }
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

function loadCloudCredential() {
  if (!existsSync(CLOUD_DEVICE_JSON)) {
    throw Object.assign(new Error(`CiCy Cloud login not found: ${CLOUD_DEVICE_JSON}. Add your Cloud account first.`), { exitCode: 3 });
  }
  let cfg;
  try { cfg = JSON.parse(readFileSync(CLOUD_DEVICE_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${CLOUD_DEVICE_JSON}: ${e.message}`), { exitCode: 3 }); }
  const token = String(cfg.token || '').trim();
  const origin = String(cfg.cloud_origin || cfg.origin || 'https://cicy-ai.com').replace(/\/+$/, '');
  if (!token) throw Object.assign(new Error(`Cloud session token missing in ${CLOUD_DEVICE_JSON}`), { exitCode: 3 });
  return { token, origin, instanceId: String(cfg.instance_id || '').trim() };
}

async function cloudAPI(method, path, payload) {
  const { token, origin } = loadCloudCredential();
  const headers = { Authorization: `Bearer ${token}`, Accept: 'application/json' };
  const init = { method, headers, signal: AbortSignal.timeout(15000) };
  if (payload !== undefined) {
    headers['Content-Type'] = 'application/json';
    init.body = JSON.stringify(payload);
  }
  let res;
  try { res = await fetch(origin + path, init); }
  catch (e) { throw Object.assign(new Error(`cannot reach CiCy Cloud at ${origin} (${e.message})`), { exitCode: 3 }); }
  const text = await res.text();
  let body; try { body = JSON.parse(text); } catch { body = { error: text }; }
  if (res.status === 401 || res.status === 403) throw Object.assign(new Error(`Cloud login expired (${res.status}); sign in again`), { exitCode: 3 });
  if (!res.ok) throw Object.assign(new Error(`Cloud API error (${res.status}): ${body?.error || body?.message || text}`), { exitCode: 4 });
  return body;
}

function resolveTarget() {
  return { api: API_BASE, token: loadLocalToken() };
}

async function api(method, path, payload, node, timeoutMs) {
  const { api: base, token } = resolveTarget(node);
  const headers = { 'Authorization': `Bearer ${token}` };
  let body;
  if (payload !== undefined) {
    headers['Content-Type'] = 'application/json';
    body = JSON.stringify(payload);
  }
  let status, text;
  {
    const init = { method, headers };
    if (body !== undefined) init.body = body;
    // Per-call timeout (broadcast uses it so one dead pane can't stall the run).
    if (timeoutMs > 0) init.signal = AbortSignal.timeout(timeoutMs);
    let res;
    try { res = await fetch(base + path, init); }
    catch (e) { throw Object.assign(new Error(`cannot reach cicy-code at ${base} — is it running? (${e.message})`), { exitCode: 3 }); }
    status = res.status;
    text = await res.text();
  }
  if (status === 401 || status === 403) throw Object.assign(new Error(`auth failed (${status})`), { exitCode: 3 });
  if (status >= 400) {
    let errBody; try { errBody = JSON.parse(text); } catch { errBody = { error: text }; }
    throw Object.assign(new Error(`api error (${status}): ${errBody?.error || errBody?.message || text}`), { exitCode: 4 });
  }
  try { return JSON.parse(text); } catch { return text; }
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdList(_args, node) {
  const data = await api('GET', '/api/tmux/panes', undefined, node);
  const panes = data?.panes || data?.data?.panes || [];
  if (json) return ok({ panes });
  console.log('id      \tagent_type\ttitle\tworkspace');
  console.log('--------\t----------\t-----\t---------');
  for (const p of panes) {
    const id = String(p.pane_id || '').slice(0, 7);
    console.log(`${id}\t${p.agent_type || ''}\t${p.title || ''}\t${p.workspace || ''}`);
  }
}

async function cmdLs(_args, node) {
  const data = await api('GET', '/api/tmux/panes', undefined, node);
  const panes = data?.panes || data?.data?.panes || [];
  if (json) return ok({ panes });
  console.log('pane_id\tagent_type\ttitle');
  console.log('-------\t----------\t-----');
  for (const p of panes) console.log(`${p.pane_id}\t${p.agent_type || ''}\t${p.title || ''}`);
}

async function cmdTree(_args, node) {
  const data = await api('GET', '/api/tmux/tree', undefined, node);
  if (json) return ok(data);
  console.log(JSON.stringify(data, null, 2));
}

async function cmdWindows(_args, node) {
  const data = await api('GET', '/api/tmux/windows', undefined, node);
  if (json) return ok(data);
  console.log(JSON.stringify(data, null, 2));
}

async function cmdCapture(args, node) {
  if (args.length < 1) throw Object.assign(new Error('Usage: cicy-agent capture <pane>'), { exitCode: 2 });
  const pane = args[0];
  const data = await api('POST', '/api/tmux/capture_pane', { pane_id: pane }, node);
  // backend (/api/tmux/capture_pane) returns { pane_id, output }; keep `content`
  // as a legacy fallback so we print the TEXT, not a JSON blob.
  const out = typeof data === 'string' ? data : (data?.output ?? data?.content ?? '');
  // A cicy chat agent runs a TUI in its tmux pane, so `capture` only shows the
  // static chat frame ("● CiCy … 已就绪"), NOT the conversation. Detect it
  // (authoritatively by agent_type, else by the frame text) and steer to `reply`,
  // which reads the parsed history — messages + tool_use — the real work log.
  let agentType = '';
  try { const p = await api('GET', `/api/panes/${pane}`, undefined, node); agentType = (p && p.agent_type) || ''; } catch { /* best-effort */ }
  const isChat = agentType === 'cicy' || /[●•]\s*CiCy\b|直接输入需求/.test(out);
  if (json) return ok(typeof data === 'object' ? { ...data, agent_type: agentType, chat_agent: isChat } : { output: out, chat_agent: isChat });
  if (isChat) process.stderr.write(`⚠️  ${pane} is a cicy chat agent — its tmux pane shows only the chat frame, not the conversation.\n    Use \`cicy-agent reply ${pane} --full\` to see its messages + tool calls.\n\n`);
  console.log(out.trimEnd() || JSON.stringify(data, null, 2));
}

async function cmdReply(args, node) {
  let full = false;
  const filtered = [];
  for (const a of args) {
    if (a === '--full' || a === '-f') full = true;
    else filtered.push(a);
  }
  if (filtered.length < 1) throw Object.assign(new Error('Usage: cicy-agent reply <pane> [--full]'), { exitCode: 2 });
  const data = await api('POST', '/api/tmux/reply_text', { pane_id: filtered[0], full }, node);
  if (json) return ok(data);
  if (typeof data === 'string') console.log(data);
  else console.log(data?.text || JSON.stringify(data, null, 2));
}

// Stamp the sender id (set inside cicy panes) so the receiver can skim who
// messaged in a busy pane. Format: `📮 [w-10029] hello`.
// Idempotent: leaves the text alone if it already carries either marker
// (the receiver may forward the stamped text back to us). The 📨 check stays
// so text stamped by older installs is still recognized during the rollover.
function currentAgentID() {
  const direct = String(process.env.X_AGENT_SHORT_ID || process.env.CICY_PANE_ID || '').trim();
  if (direct) return direct;
  return String(process.env.X_AGENT_ID || '').trim().split(':')[0];
}

function stampSender(text, teamId) {
  const raw = currentAgentID();
  if (!raw) return { text, senderID: '' };
  // In team mode (the local node has an --id), the sender is team-qualified so a
  // cross-team recipient sees the full address: [teamA.w-1001]. Otherwise plain.
  const senderID = teamId ? `${teamId}.${raw}` : raw;
  if (text.startsWith('📮 ') || text.startsWith('📨 ') || text.startsWith(`[${senderID}]`)) return { text, senderID };
  return { text: `📮 [${senderID}] ${text}`, senderID };
}

// localTeamId returns THIS node's cicy-hub team id (from /api/health.team_id),
// or '' when not in team mode. Cached for the process.
var _localTeamId;
async function localTeamId() {
  if (_localTeamId !== undefined) return _localTeamId;
  _localTeamId = '';
  try {
    const { api: base, token } = resolveTarget('');
    const res = await fetch(base + '/api/health', { headers: { Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(3000) });
    if (res.ok) { const d = await res.json(); _localTeamId = (d.team_id || '').trim(); }
  } catch { /* not in team mode / unreachable */ }
  return _localTeamId;
}

async function cmdMsg(args, node) {
  // Default: callback ON (the message is tracked in the agent_messages store and
  // its status is followed back to done/failed) + a 📮 [sender] prefix so the
  // recipient knows who messaged. By default NO completion chat line is pushed —
  // status lives in the queryable store (cicy-agent msgs), not the chat. Pass
  // --notify to also get a one-line status wake-up when the receiver's turn ends
  // (e.g. "🔔 [w-x] msg <id> → done"; suppressed if they already replied in-band).
  // --no-callback is full fire-and-forget: no tracking, no push.
  let callback = true;
  let notify = false;
  let waitForReply = true;
  let waitSeconds = 180;
  const filtered = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--callback' || a === '-c') callback = true;
    else if (a === '--no-callback' || a === '--no-cb') callback = false;
    else if (a === '--notify') notify = true;
    else if (a === '--no-wait') waitForReply = false;
    else if (a === '--timeout') waitSeconds = Math.max(1, Math.min(3600, Number(args[++i] || 180) || 180));
    else filtered.push(a);
  }
  if (filtered.length < 2) throw Object.assign(new Error('Usage: cicy-agent msg <pane|team.agent> <text> [--no-callback] [--notify]'), { exitCode: 2 });
  // A team-qualified address routes exclusively through CiCy Cloud.
  let pane = filtered[0];
  let target = node;
  if (!target && pane.includes('.') && !pane.startsWith('w-')) {
    const cloudTarget = await resolveCloudAgent(pane);
    if (cloudTarget) {
      const text = filtered.slice(1).join(' ');
      const result = await sendCloudMessage(cloudTarget, text, {
        waitForReply,
        waitSeconds,
        onSent: json ? null : (messageId) => console.log(`sent → ${pane}  msg_id=${messageId}  status=pending`),
      });
      if (json) return ok(result);
      if (result.reply) {
        console.log(`🔔 [${pane}] msg ${result.messageId} → done`);
        console.log(`${pane}: ${result.reply.text}`);
      }
      else if (result.status === 'failed') {
        console.log(`⚠️ [${pane}] msg ${result.messageId} → failed${result.error ? `: ${result.error}` : ''}`);
      }
      else if (waitForReply) console.log(`(no reply within ${waitSeconds}s; use --no-wait to send asynchronously)`);
      return;
    }
  }
  if (/^\d+$/.test(pane)) pane = 'w-' + pane; // bare agent number → w-<n>
  const teamId = await localTeamId(); // team mode → sender stamp is [teamId.me]
  const { text, senderID } = stampSender(filtered.slice(1).join(' '), teamId);
  const payload = { pane_id: pane, text };
  if (callback && senderID) payload.callback_to = senderID;
  if (callback && senderID && notify) payload.notify = true;
  const data = await api('POST', '/api/tmux/send', payload, target);
  const messageId = data && typeof data === 'object' ? String(data.msg_id || '') : '';
  if (messageId && !json) console.log(`sent → ${filtered[0]}  msg_id=${messageId}  status=sent`);
  if (messageId && callback && waitForReply) {
    const result = await waitForLocalMessage(messageId, waitSeconds, node);
    if (json) return ok({ messageId, address: filtered[0], ...result });
    if (result.message?.status === 'done') {
      console.log(`🔔 [${filtered[0]}] msg ${messageId} → done`);
      let replyText = result.message.turn?.a || '';
      // The compact /api/agent/messages response may only carry the linked
      // reply turn id. Resolve the parsed reply explicitly so local and Cloud
      // `msg` both print the correlated answer before returning.
      if (!replyText && result.message.reply_turn_id) {
        try {
          const reply = await api('POST', '/api/tmux/reply_text', { pane_id: pane, full: false }, target);
          replyText = typeof reply === 'string' ? reply : (reply?.text || '');
        } catch { /* completion is still valid when reply retrieval fails */ }
      }
      replyText = String(replyText || '').replace(/^\[text\]\s*/i, '').trim();
      if (replyText) console.log(`${filtered[0]}: ${replyText}`);
    } else if (result.message?.status === 'failed') {
      console.log(`⚠️ [${filtered[0]}] msg ${messageId} → failed${result.message.error ? `: ${result.message.error}` : ''}`);
    } else {
      console.log(`(no reply within ${waitSeconds}s; use --no-wait to send asynchronously)`);
    }
    return;
  }
  if (json) return ok({ messageId, address: filtered[0], status: messageId ? 'sent' : 'accepted', raw: data });
  // Echo the message id (when the send was recorded in the agent_messages store)
  // so the sender can later `cicy-agent msgs` it by id. Falls back to the raw
  // response for non-agent sends that carry no msg_id.
  if (!messageId) {
    console.log(typeof data === 'string' ? data : JSON.stringify(data));
  }
}

async function waitForLocalMessage(messageId, waitSeconds, node) {
  const deadline = Date.now() + waitSeconds * 1000;
  while (Date.now() < deadline) {
    const data = await api('GET', '/api/agent/messages', undefined, node, 15000);
    const messages = data?.messages || data?.data?.messages || [];
    const message = messages.find((item) => String(item?.id || '') === messageId);
    if (message && ['done', 'failed'].includes(String(message.status || ''))) {
      return { status: message.status, message };
    }
    await new Promise((resolve) => setTimeout(resolve, 1000));
  }
  return { status: 'timeout', message: null };
}

// cicy-agent msgs [--from PANE] [--to PANE] [--status sent|done|failed] [--open]
// Lists the cross-agent message link: who → who, status, and a one-line summary
// of what the receiver actually did (q ⟶ answer, JOINed from history_turns).
async function cmdMsgs(args, node) {
  const q = new URLSearchParams();
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--from') q.set('from', args[++i] || '');
    else if (a === '--to') q.set('to', args[++i] || '');
    else if (a === '--status') q.set('status', args[++i] || '');
    else if (a === '--open') q.set('open', '1');
  }
  const path = '/api/agent/messages' + (q.toString() ? `?${q.toString()}` : '');
  const data = await api('GET', path, undefined, node);
  if (json) return ok(data);
  const msgs = data?.messages || data?.data?.messages || [];
  if (!msgs.length) { console.log('(no messages)'); return; }
  const trunc = (s, n) => String(s || '').replace(/\s+/g, ' ').trim().slice(0, n);
  const shortP = (p) => String(p || '?').replace(':main.0', '');
  for (const m of msgs) {
    const head = `${shortP(m.from_pane)} → ${shortP(m.to_pane)}  [${m.status}]${m.replied ? ' replied' : ''}  id=${m.id}`;
    const when = m.completed_at || m.created_at || '';
    console.log(`${head}  ${when}`);
    const body = trunc(m.text, 70);
    if (body) console.log(`  msg: ${body}`);
    // from-side: what the sender was doing when it dispatched (their turn).
    if (m.from_turn && (m.from_turn.q || m.from_turn.a)) {
      console.log(`  from-turn: ${trunc(m.from_turn.q, 50)} ⟶ ${trunc(m.from_turn.a, 60)}`);
    } else if (m.from_turn_id) {
      console.log(`  from-turn: ${m.from_conversation_id || '?'}/${m.from_turn_id}`);
    }
    // to-side: what the receiver actually did this turn.
    if (m.turn && (m.turn.q || m.turn.a)) {
      console.log(`  to-turn: ${trunc(m.turn.q, 50)} ⟶ ${trunc(m.turn.a, 60)}`);
    }
  }
}

// ── online / offline / broadcast (todo #81) ─────────────────────────────
//
// Online judgment: the master semantics is "managed under the w-1001 cluster",
// but the real tmux topology is one session per agent (sessions are NOT nested
// under w-1001). The executable criterion — equivalent in meaning — is:
//   online  = the agent's session exists in the live tmux tree
//   offline = present in the panes db but its session is gone from the tree
//   all     = the panes db, verbatim
// online ∪ offline = all by construction (both sides filter the same db list).

function sessionOf(paneId) { return String(paneId || '').split(':')[0]; }

async function fetchAgentSets(node) {
  const [panesData, treeData] = await Promise.all([
    api('GET', '/api/tmux/panes', undefined, node),
    api('GET', '/api/tmux/tree', undefined, node),
  ]);
  const panes = panesData?.panes || panesData?.data?.panes || [];
  const tree = treeData?.tree || treeData?.data?.tree || [];
  const live = new Set(tree.map((s) => s.session));
  const online = panes.filter((p) => live.has(sessionOf(p.pane_id)));
  const offline = panes.filter((p) => !live.has(sessionOf(p.pane_id)));
  return { panes, online, offline };
}

// Runtime enrichment (todo #91) — read straight from the agent's gateway
// history dir (~/cicy-ai/workers/<id>/.cicy/history/):
//   reply.json   → idle ("thinking" = in-turn) + exact model id
//   context.json → context_usage (used_pct, written by the claude statusline)
//   usage.jsonl  → cumulative cost (Σ cost_credit) + provider
// Runtime files are local-only; Cloud listings use their own reported fields.
function runtimeOf(id, isRemote) {
  const out = { model: null, provider: null, context_usage: null, cost: null, idle: null };
  if (isRemote) return out;
  const dir = join(homedir(), 'cicy-ai', 'workers', id, '.cicy', 'history');
  try {
    const r = JSON.parse(readFileSync(join(dir, 'reply.json'), 'utf8'));
    // reply.json flips per gateway REQUEST, not per logical turn — between a
    // turn's requests (tool execution windows) it briefly reads "completed".
    // Heuristic: "thinking" OR any request activity in the last 45s = busy.
    // Known gap: a turn stuck >45s in one long tool call reads idle.
    if (r.status) {
      const recentMs = Date.now() - Date.parse(r.updated_at || 0);
      out.idle = r.status !== 'thinking' && !(recentMs >= 0 && recentMs < 45_000);
    }
    if (r.model) out.model = r.model;
  } catch { /* no gateway snapshot — official-login or never ran */ }
  try {
    const c = JSON.parse(readFileSync(join(dir, 'context.json'), 'utf8'));
    if (c.used_pct != null) out.context_usage = `${c.used_pct}%`;
    if (!out.model && c.model) out.model = c.model;
  } catch { /* statusline never wrote it */ }
  try {
    let cost = 0, seen = 0, provider = '';
    for (const line of readFileSync(join(dir, 'usage.jsonl'), 'utf8').split('\n')) {
      if (!line.trim()) continue;
      try {
        const u = JSON.parse(line);
        if (typeof u.cost_credit === 'number') { cost += u.cost_credit; seen++; }
        if (u.provider) provider = u.provider;
      } catch { /* skip torn line */ }
    }
    if (seen) out.cost = Math.round(cost * 1e4) / 1e4;
    if (provider) out.provider = provider;
  } catch { /* no usage log */ }
  return out;
}

function rosterRow(p, liveSet, isRemote) {
  const id = sessionOf(p.pane_id);
  const rt = runtimeOf(id, isRemote);
  return {
    id,
    title: p.title || '',
    agent_type: p.agent_type || '',
    online: liveSet.has(id),
    model: rt.model || p.default_model || null,
    provider: rt.provider,
    local_gateway: !!p.use_custom_gateway,
    context_usage: rt.context_usage,
    cost: rt.cost,
    idle: rt.idle,
    pane_id: p.pane_id,
    workspace: p.workspace || '',
  };
}

const na = (v) => (v === null || v === undefined || v === '' ? 'n/a' : v);

async function cmdAgents(kind, node) {
  const { panes, online, offline } = await fetchAgentSets(node);
  const liveSet = new Set(online.map((p) => sessionOf(p.pane_id)));
  const sel = kind === 'online' ? online : kind === 'offline' ? offline : panes;
  const agents = sel.map((p) => rosterRow(p, liveSet, !!node));
  if (json) return ok({ kind, count: agents.length, online: online.length, offline: offline.length, all: panes.length, agents });
  console.log(`${kind}: ${agents.length}  (online ${online.length} + offline ${offline.length} = all ${panes.length})`);
  console.log('id      \ton\tidle\tctx\tcost\tmodel\tgw\ttitle');
  console.log('--------\t--\t----\t---\t----\t-----\t--\t-----');
  for (const a of agents) {
    const idle = a.idle === null ? 'n/a' : (a.idle ? '✓' : 'busy');
    console.log(`${a.id}\t${a.online ? '✓' : '✗'}\t${idle}\t${na(a.context_usage)}\t${na(a.cost)}\t${na(a.model)}\t${a.local_gateway ? '✓' : '✗'}\t${a.title}`);
  }
}

// broadcast [--timeout <ms>] <text> — online-only by definition (主人定:
// offline agents can't receive, broadcasting to them is meaningless; there is
// deliberately no --all). Per-send timeout so a stuck pane can't stall the
// run. Skips the sender itself. No callback_to on purpose — N agents replying
// to one pane is spam. (--online is accepted as a no-op for compatibility.)
async function cmdBroadcast(args, node) {
  let timeoutMs = 8000;
  const pos = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--online')  continue; // always online — flag kept as no-op
    if (args[i] === '--timeout') { timeoutMs = parseInt(args[++i], 10) || 8000; continue; }
    pos.push(args[i]);
  }
  if (pos.length < 1) throw Object.assign(new Error('Usage: cicy-agent broadcast [--timeout <ms>] <text>'), { exitCode: 2 });
  const { text } = stampSender(pos.join(' '));
  const { online, offline } = await fetchAgentSets(node);
  const self = (process.env.X_AGENT_SHORT_ID || '').trim();
  const targets = online.filter((p) => sessionOf(p.pane_id) !== self);

  // /api/tmux/send answers 200 even when tmux send fails ({"detail":"failed
  // to send text: ..."}); success is {"success":true}. Surface both shapes.
  const results = await Promise.allSettled(targets.map((p) =>
    api('POST', '/api/tmux/send', { pane_id: p.pane_id, text }, node, timeoutMs)
      .then((r) => {
        if (!r || r.success !== true) throw new Error(r?.detail || r?.error || 'send failed');
        return r;
      })
  ));
  const failed = [];
  results.forEach((r, i) => {
    if (r.status === 'rejected') failed.push({ pane_id: targets[i].pane_id, error: String(r.reason?.message || r.reason) });
  });
  const stats = {
    timeout_ms: timeoutMs,
    targets: targets.length,
    delivered: targets.length - failed.length,
    failed,
    skipped_offline: offline.length,
  };
  if (json) return ok(stats);
  console.log(`delivered ${stats.delivered}/${stats.targets} (online-only, skipped ${stats.skipped_offline} offline, timeout ${timeoutMs}ms)`);
  for (const f of failed) console.log(`  ✗ ${f.pane_id}: ${f.error}`);
}

async function cmdSendKeys(args, node) {
  if (args.length < 2) throw Object.assign(new Error('Usage: cicy-agent send-keys <pane> <keys...>'), { exitCode: 2 });
  const data = await api('POST', '/api/tmux/send-keys', { pane_id: args[0], keys: args.slice(1).join(' ') }, node);
  if (json) return ok(data);
  console.log(typeof data === 'string' ? data : JSON.stringify(data));
}

async function cmdRestart(_args, node) {
  const data = await api('POST', '/api/tmux/restart_all', {}, node);
  if (json) return ok(data);
  console.log(typeof data === 'string' ? data : JSON.stringify(data));
}

async function cmdClear(args, node) {
  if (args.length < 1) throw Object.assign(new Error('Usage: cicy-agent clear <pane>'), { exitCode: 2 });
  const data = await api('POST', '/api/tmux/clear', { pane: args[0] }, node);
  if (json) return ok(data);
  console.log(typeof data === 'string' ? data : JSON.stringify(data));
}

// fork — replicate an existing agent: the server dumps the source agent's
// conversation (agent-summary) and spawns a NEW agent that copies the source's
// config (agent_type, model, role, allow_all, reply_in_chinese, use_custom_gateway,
// proxy_enable) and is prompted to INHERIT that context and continue. POSTs
// /api/tmux/fork.
// create a BRAND-NEW agent (POST /api/panes/create). Unlike `fork` (which clones
// an existing agent's context), create spins up a fresh agent from scratch.
//   cicy-agent create <title...> [--type cicy] [--model M] [--role R]
//                                [--role-template RT] [--master PANE]
// agent_type defaults to `cicy`; the title can be positional or via --title.
// --role is NOT the persona: it sets agent_config.role, a roster label whose
// magic values "worker" (default) / "master" also mark master/worker topology
// and worker-completion tracking — free-form text silently drops the "worker"
// marker. The PERSONA comes from --role-template (default `assistant`): its
// template dir's system.md is the system prompt, its role.md seeds AGENTS.md,
// and its meta.yaml `tools:` decides the tool set (a chat-only template
// degrades the agent to chat-only).
async function cmdCreate(args, node) {
  let title = '', type = 'cicy', model = '', role = 'worker', roleTemplate = 'assistant', master = '';
  const pos = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--title' || a === '-t') title = args[++i] || '';
    else if (a === '--type') type = args[++i] || '';
    else if (a === '--model') model = args[++i] || '';
    else if (a === '--role') role = args[++i] || '';
    else if (a === '--role-template' || a === '--rt') roleTemplate = args[++i] || '';
    else if (a === '--master') master = args[++i] || '';
    else pos.push(a);
  }
  if (!title && pos.length) title = pos.join(' ');
  if (!title) {
    throw Object.assign(new Error('Usage: cicy-agent create <title> [--type cicy] [--model M] [--role-template RT] [--master PANE]'), { exitCode: 2 });
  }
  const payload = { title, agent_type: type };
  if (model) payload.default_model = model;
  if (role) payload.role = role;
  if (roleTemplate) payload.role_template = roleTemplate;
  if (master) payload.master_pane_id = master;
  const data = await api('POST', '/api/panes/create', payload, node);
  if (json) return ok(data);
  if (data && data.success === false) throw Object.assign(new Error(`create failed: ${data.error || 'unknown'}`), { exitCode: 4 });
  const pid = data?.pane_id || data?.data?.pane_id || '';
  console.log(pid ? `created ${type} agent "${title}" -> ${pid}` : (typeof data === 'string' ? data : JSON.stringify(data)));
}

// Resolve this running node against the authenticated Cloud directory. The
// Cloud row is authoritative for the fixed proxy host; never guess a domain
// from team_id because the slug also contains owner/hash material.
async function cmdWhoami(args, node) {
  if (args.length) throw Object.assign(new Error('Usage: cicy-agent whoami'), { exitCode: 2 });
  let health = {};
  try { health = await api('GET', '/api/health', undefined, node); } catch { /* Cloud identity can still resolve */ }
  const localTeamID = String(health?.team_id || health?.teamId || '').trim();
  const agentID = currentAgentID();
  let credential = { instanceId: '' };
  let instance = null;
  let cloudError = '';
  try {
    credential = loadCloudCredential();
    const { instances } = await loadCloudDirectory();
    instance = instances.find((i) => credential.instanceId && i.instanceId === credential.instanceId)
      || instances.find((i) => localTeamID && i.teamId === localTeamID)
      || null;
  } catch (e) {
    cloudError = e.message || String(e);
  }
  const teamId = String(instance?.teamId || localTeamID || '').trim();
  const instanceId = String(instance?.instanceId || credential.instanceId || '').trim();
  const proxyHost = String(instance?.proxyHost || '').trim().toLowerCase();
  const identity = {
    agentId: agentID,
    teamId,
    instanceId,
    proxyHost,
    url: proxyHost ? `https://${proxyHost}/` : '',
    proxyAvailable: Boolean(instance?.proxyAvailable),
    status: String(instance?.status || ''),
  };
  if (json) return ok({ ...identity, ...(cloudError ? { cloudError } : {}) });
  console.log(`agent_id\t${identity.agentId || '(not in an Agent pane)'}`);
  console.log(`team_id\t${identity.teamId || '(not registered)'}`);
  console.log(`instance_id\t${identity.instanceId || '(not registered)'}`);
  console.log(`domain\t${identity.proxyHost || '(not available)'}`);
  console.log(`url\t${identity.url || '(not available)'}`);
  if (cloudError) console.error(`warning: ${cloudError}`);
}

// ── CiCy Cloud instance messaging ──────────────────────────────────────
// Uses the existing Cloud device session. The target instance's local API
// token never leaves the server and is not needed for message routing.
async function cmdCloud(args) {
  const sub = args[0] || 'ls';
  const showAll = args.includes('--all');
  const loadDirectory = loadCloudDirectory;

  const isOnline = (instance) => {
    const seen = Date.parse(String(instance.lastSeenAt || '').replace(' ', 'T') + 'Z');
    return instance.status === 'online' && Number.isFinite(seen) && Date.now() - seen < 90000;
  };

  if (sub === 'agents') {
    const { instances, agents } = await loadDirectory();
    const byID = new Map(instances.map((i) => [i.instanceId, i]));
    const rows = agents.filter((a) => showAll || isOnline(byID.get(a.instanceId) || {})).map((a) => {
      const instance = byID.get(a.instanceId) || {};
      return { address: `${instance.teamId || a.instanceId}.${a.agentId}`, teamId: instance.teamId || '',
        instanceId: a.instanceId, agentId: a.agentId, title: a.title || '', status: a.status || '',
        instanceStatus: instance.status || a.instanceStatus || '' };
    });
    if (json) return ok({ agents: rows });
    console.log('address\tstatus\ttitle');
    console.log('-------\t------\t-----');
    for (const row of rows) console.log(`${row.address}\t${row.instanceStatus || row.status}\t${row.title}`);
    return;
  }

  if (sub === 'ls' || sub === 'list' || sub === 'instances') {
    const { instances: allInstances, agents } = await loadDirectory();
    const instances = allInstances.filter((i) => showAll || isOnline(i)).map((i) => ({
      ...i, online: isOnline(i), agents: agents.filter((a) => a.instanceId === i.instanceId),
    }));
    if (json) return ok({ teams: instances });
    if (!instances.length) { console.log(showAll ? '(no Cloud teams)' : '(no online Cloud teams; use --all)'); return; }
    for (const i of instances) {
      const environment = [i.platform, i.arch, i.runtime].filter(Boolean).join('/');
      console.log(`${i.teamId}\t${i.online ? 'online' : 'offline'}\t${environment}\t${i.lastSeenAt || ''}`);
      if (!i.agents.length) console.log('  └─ (no agents)');
      for (let index = 0; index < i.agents.length; index++) {
        const a = i.agents[index];
        console.log(`  ${index === i.agents.length - 1 ? '└─' : '├─'} ${i.teamId}.${a.agentId}\t${a.status || ''}\t${a.title || ''}`);
      }
    }
    return;
  }

  throw Object.assign(new Error('Usage: cicy-agent cloud <ls|agents> [--all]'), { exitCode: 2 });
}

async function loadCloudDirectory() {
  const [instanceData, agentData] = await Promise.all([
    cloudAPI('GET', '/api/code/instances'), cloudAPI('GET', '/api/code/agents'),
  ]);
  return { instances: instanceData.instances || [], agents: agentData.agents || [] };
}

async function resolveCloudAgent(address) {
  const { instances, agents } = await loadCloudDirectory();
  const instance = instances.filter((i) => address.startsWith(`${i.teamId}.`))
    .sort((a, b) => String(b.teamId).length - String(a.teamId).length)[0];
  if (!instance) return null;
  const agentID = address.slice(String(instance.teamId).length + 1);
  const agent = agents.find((a) => a.instanceId === instance.instanceId && a.agentId === agentID);
  if (!agent) throw Object.assign(new Error(`Cloud agent not found: ${address}`), { exitCode: 4 });
  const credential = loadCloudCredential();
  const senderInstance = instances.find((i) => i.instanceId === credential.instanceId);
  const senderAgentID = currentAgentID();
  const senderAgentRegistered = senderAgentID && agents.some((a) => a.instanceId === credential.instanceId && a.agentId === senderAgentID);
  const senderID = [senderInstance?.teamId || credential.instanceId, senderAgentID].filter(Boolean).join('.');
  return { address, instanceId: instance.instanceId, agentId: agentID,
    senderID, senderAgentId: senderAgentRegistered ? senderAgentID : '' };
}

async function sendCloudMessage(target, text, { waitForReply, waitSeconds, onSent }) {
  const stamped = target.senderID && !/^📮\s/.test(text) ? `📮 [${target.senderID}] ${text}` : text;
  const payload = { targetInstanceId: target.instanceId, targetAgentId: target.agentId, text: stamped };
  if (target.senderAgentId) payload.senderAgentId = target.senderAgentId;
  const data = await cloudAPI('POST', '/api/code/messages', payload);
  const messageId = data?.message?.id || '';
  if (messageId && typeof onSent === 'function') onSent(messageId);
  if (!messageId || !waitForReply) return { messageId, address: target.address, reply: null };
  const deadline = Date.now() + waitSeconds * 1000;
  while (Date.now() < deadline) {
    const status = await cloudAPI('GET', `/api/code/messages/status?id=${encodeURIComponent(messageId)}`);
    if (status.reply) return { messageId, address: target.address, status: status.status, reply: status.reply };
	if (status.status === 'failed') return { messageId, address: target.address, status: 'failed', error: status.error || status.message || '', reply: null };
    await new Promise((resolve) => setTimeout(resolve, 2000));
  }
  return { messageId, address: target.address, status: 'timeout', reply: null };
}

async function cmdFork(args, node) {
  let title = '', master = '';
  const pos = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--title' || args[i] === '-t') title = args[++i] || '';
    else if (args[i] === '--master' || args[i] === '-m') master = args[++i] || '';
    else pos.push(args[i]);
  }
  if (pos.length < 1) {
    throw Object.assign(new Error('Usage: cicy-agent fork <source-pane> [--title T] [--master PANE]'), { exitCode: 2 });
  }
  const payload = { source_pane_id: pos[0] };
  if (title) payload.title = title;
  if (master) payload.master_pane_id = master;
  const data = await api('POST', '/api/tmux/fork', payload, node);
  if (json) return ok(data);
  const pid = data?.pane_id || data?.data?.pane_id || '';
  if (!pid) { console.log(typeof data === 'string' ? data : JSON.stringify(data)); return; }
  let line = `forked ${pos[0]} -> ${pid}`;
  if (data?.prompt_sent === false) line += ' (context prompt NOT sent — new agent not ready in time)';
  console.log(line);
}
