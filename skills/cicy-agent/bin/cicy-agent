#!/usr/bin/env node
// cicy-agent — tmux pane/window operations via cicy-code's /api/tmux/* endpoints.
// Subcommands: list / ls / tree / windows / capture / reply / msg / broadcast /
//              get_online_agents / get_offline_agents / get_all_agents /
//              send-keys / restart / clear / fork

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const json = argv.includes('--json');
const cmd = argv[0];
const rest = argv.slice(1).filter((a) => a !== '--json');

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const NODES_JSON = process.env.CICY_AGENT_JSON || join(homedir(), 'cicy-ai', 'db', 'cicy-agent.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const API_BASE = `http://127.0.0.1:${API_PORT}`;

(async () => {
  try {
    const { rest: r2, node } = extractNode(rest);
    switch (cmd) {
      case 'tools':              printTools(); return;
      case 'list':               await cmdList(r2, node); break;
      case 'ls':                 await cmdLs(r2, node); break;
      case 'tree':               await cmdTree(r2, node); break;
      case 'windows':            await cmdWindows(r2, node); break;
      case 'capture':            await cmdCapture(r2, node); break;
      case 'reply':              await cmdReply(r2, node); break;
      case 'msg':                await cmdMsg(r2, node); break;
      case 'broadcast':          await cmdBroadcast(r2, node); break;
      case 'get_online_agents': case 'get-online-agents':   await cmdAgents('online', node); break;
      case 'get_offline_agents': case 'get-offline-agents': await cmdAgents('offline', node); break;
      case 'get_all_agents': case 'get-all-agents':         await cmdAgents('all', node); break;
      case 'send-keys':          await cmdSendKeys(r2, node); break;
      case 'restart':            await cmdRestart(r2, node); break;
      case 'clear':               await cmdClear(r2, node); break;
      case 'fork':               await cmdFork(r2, node); break;
      default: bail(`unknown command: ${cmd}. Try cicy-agent --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`cicy-agent: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: cicy-agent <list|ls|tree|windows|capture|reply|msg|send-keys|restart|clear|fork> [args...] [--node NAME]\n'); }
}
function printTools() {
  try { process.stdout.write(readFileSync(new URL('../references/tools.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('# cicy-agent tools\n'); }
}

function extractNode(args) {
  let node = '';
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--node' || args[i] === '-n') { node = args[++i] || ''; continue; }
    rest.push(args[i]);
  }
  return { rest, node };
}

function loadLocalToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) {
    throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON}`), { exitCode: 3 });
  }
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

// resolve { api, token } for a named remote node, or the local cicy-code by default
function resolveTarget(node) {
  if (!node) return { api: API_BASE, token: loadLocalToken() };
  if (!existsSync(NODES_JSON)) {
    throw Object.assign(new Error(`--node ${node} requested but ${NODES_JSON} does not exist. Create it with [{name,api,api_token}, ...]`), { exitCode: 3 });
  }
  let nodes;
  try { nodes = JSON.parse(readFileSync(NODES_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${NODES_JSON}: ${e.message}`), { exitCode: 3 }); }
  const arr = Array.isArray(nodes) ? nodes : (nodes.nodes || []);
  const found = arr.find((n) => n.name === node);
  if (!found) throw Object.assign(new Error(`node ${node} not found in ${NODES_JSON}`), { exitCode: 4 });
  if (!found.api || !found.api_token) throw Object.assign(new Error(`node ${node} missing api or api_token`), { exitCode: 3 });
  return { api: found.api.replace(/\/+$/, ''), token: found.api_token };
}

async function api(method, path, payload, node, timeoutMs) {
  const { api: base, token } = resolveTarget(node);
  const headers = { 'Authorization': `Bearer ${token}` };
  const init = { method, headers };
  if (payload !== undefined) {
    headers['Content-Type'] = 'application/json';
    init.body = JSON.stringify(payload);
  }
  // Per-call timeout (broadcast uses it so one dead pane can't stall the run).
  if (timeoutMs > 0) init.signal = AbortSignal.timeout(timeoutMs);
  let res;
  try { res = await fetch(base + path, init); }
  catch (e) { throw Object.assign(new Error(`cannot reach cicy-code at ${base} — is it running? (${e.message})`), { exitCode: 3 }); }
  const text = await res.text();
  if (res.status === 401 || res.status === 403) throw Object.assign(new Error(`auth failed (${res.status})`), { exitCode: 3 });
  if (res.status >= 400) {
    let body; try { body = JSON.parse(text); } catch { body = { error: text }; }
    throw Object.assign(new Error(`api error (${res.status}): ${body?.error || body?.message || text}`), { exitCode: 4 });
  }
  try { return JSON.parse(text); } catch { return text; }
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdList(_args, node) {
  const data = await api('GET', '/api/tmux/panes', undefined, node);
  const panes = data?.panes || data?.data?.panes || [];
  if (json) return ok({ panes });
  console.log('id      \tagent_type\ttitle\tworkspace');
  console.log('--------\t----------\t-----\t---------');
  for (const p of panes) {
    const id = String(p.pane_id || '').slice(0, 7);
    console.log(`${id}\t${p.agent_type || ''}\t${p.title || ''}\t${p.workspace || ''}`);
  }
}

async function cmdLs(_args, node) {
  const data = await api('GET', '/api/tmux/panes', undefined, node);
  const panes = data?.panes || data?.data?.panes || [];
  if (json) return ok({ panes });
  console.log('pane_id\tagent_type\ttitle');
  console.log('-------\t----------\t-----');
  for (const p of panes) console.log(`${p.pane_id}\t${p.agent_type || ''}\t${p.title || ''}`);
}

async function cmdTree(_args, node) {
  const data = await api('GET', '/api/tmux/tree', undefined, node);
  if (json) return ok(data);
  console.log(JSON.stringify(data, null, 2));
}

async function cmdWindows(_args, node) {
  const data = await api('GET', '/api/tmux/windows', undefined, node);
  if (json) return ok(data);
  console.log(JSON.stringify(data, null, 2));
}

async function cmdCapture(args, node) {
  if (args.length < 1) throw Object.assign(new Error('Usage: cicy-agent capture <pane>'), { exitCode: 2 });
  const data = await api('POST', '/api/tmux/capture_pane', { pane_id: args[0] }, node);
  if (json) return ok(data);
  if (typeof data === 'string') console.log(data);
  else if (data?.content) console.log(data.content);
  else console.log(JSON.stringify(data, null, 2));
}

async function cmdReply(args, node) {
  let full = false;
  const filtered = [];
  for (const a of args) {
    if (a === '--full' || a === '-f') full = true;
    else filtered.push(a);
  }
  if (filtered.length < 1) throw Object.assign(new Error('Usage: cicy-agent reply <pane> [--full]'), { exitCode: 2 });
  const data = await api('POST', '/api/tmux/reply_text', { pane_id: filtered[0], full }, node);
  if (json) return ok(data);
  if (typeof data === 'string') console.log(data);
  else console.log(data?.text || JSON.stringify(data, null, 2));
}

// Stamp the sender id (set inside cicy panes) so the receiver can skim who
// messaged in a busy pane. Format: `📮 [w-10029] hello`.
// Idempotent: leaves the text alone if it already carries either marker
// (the receiver may forward the stamped text back to us). The 📨 check stays
// so text stamped by older installs is still recognized during the rollover.
function stampSender(text) {
  const senderID = (process.env.X_AGENT_SHORT_ID || '').trim();
  if (!senderID) return { text, senderID: '' };
  if (text.startsWith('📮 ') || text.startsWith('📨 ') || text.startsWith(`[${senderID}]`)) return { text, senderID };
  return { text: `📮 [${senderID}] ${text}`, senderID };
}

async function cmdMsg(args, node) {
  // Default ON: callback (reply routes back to the sender) + a 📮 [sender]
  // prefix so the recipient knows who messaged. Disable callback with
  // --no-callback.
  let callback = true;
  const filtered = [];
  for (const a of args) {
    if (a === '--callback' || a === '-c') callback = true;
    else if (a === '--no-callback' || a === '--no-cb') callback = false;
    else filtered.push(a);
  }
  if (filtered.length < 2) throw Object.assign(new Error('Usage: cicy-agent msg <pane> <text> [--no-callback]'), { exitCode: 2 });
  const { text, senderID } = stampSender(filtered.slice(1).join(' '));
  const payload = { pane_id: filtered[0], text };
  // callback_to only works with a sender id; outside a pane (no env) it's skipped.
  if (callback && senderID) payload.callback_to = senderID;
  const data = await api('POST', '/api/tmux/send', payload, node);
  if (json) return ok(data);
  console.log(typeof data === 'string' ? data : JSON.stringify(data));
}

// ── online / offline / broadcast (todo #81) ─────────────────────────────
//
// Online judgment: the master semantics is "managed under the w-10001 cluster",
// but the real tmux topology is one session per agent (sessions are NOT nested
// under w-10001). The executable criterion — equivalent in meaning — is:
//   online  = the agent's session exists in the live tmux tree
//   offline = present in the panes db but its session is gone from the tree
//   all     = the panes db, verbatim
// online ∪ offline = all by construction (both sides filter the same db list).

function sessionOf(paneId) { return String(paneId || '').split(':')[0]; }

async function fetchAgentSets(node) {
  const [panesData, treeData] = await Promise.all([
    api('GET', '/api/tmux/panes', undefined, node),
    api('GET', '/api/tmux/tree', undefined, node),
  ]);
  const panes = panesData?.panes || panesData?.data?.panes || [];
  const tree = treeData?.tree || treeData?.data?.tree || [];
  const live = new Set(tree.map((s) => s.session));
  const online = panes.filter((p) => live.has(sessionOf(p.pane_id)));
  const offline = panes.filter((p) => !live.has(sessionOf(p.pane_id)));
  return { panes, online, offline };
}

async function cmdAgents(kind, node) {
  const { panes, online, offline } = await fetchAgentSets(node);
  const sel = kind === 'online' ? online : kind === 'offline' ? offline : panes;
  if (json) return ok({ kind, count: sel.length, online: online.length, offline: offline.length, all: panes.length, agents: sel });
  console.log(`${kind}: ${sel.length}  (online ${online.length} + offline ${offline.length} = all ${panes.length})`);
  console.log('pane_id\tagent_type\ttitle');
  console.log('-------\t----------\t-----');
  for (const p of sel) console.log(`${p.pane_id}\t${p.agent_type || ''}\t${p.title || ''}`);
}

// broadcast [--online|--all] [--timeout <ms>] <text>
// Default --online: only live agents get the message, so the run never stalls
// on dead panes. --all targets the whole db (each send still has the timeout,
// so dead panes fail fast and land in `failed`). Skips the sender itself.
// No callback_to on purpose — N agents replying to one pane is spam.
async function cmdBroadcast(args, node) {
  let mode = 'online', timeoutMs = 8000;
  const pos = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--online')  { mode = 'online'; continue; }
    if (args[i] === '--all')     { mode = 'all'; continue; }
    if (args[i] === '--timeout') { timeoutMs = parseInt(args[++i], 10) || 8000; continue; }
    pos.push(args[i]);
  }
  if (pos.length < 1) throw Object.assign(new Error('Usage: cicy-agent broadcast [--online|--all] [--timeout <ms>] <text>'), { exitCode: 2 });
  const { text } = stampSender(pos.join(' '));
  const { panes, online, offline } = await fetchAgentSets(node);
  const self = (process.env.X_AGENT_SHORT_ID || '').trim();
  const targets = (mode === 'online' ? online : panes).filter((p) => sessionOf(p.pane_id) !== self);

  // /api/tmux/send answers 200 even when tmux send fails ({"detail":"failed
  // to send text: ..."}); success is {"success":true}. Surface both shapes.
  const results = await Promise.allSettled(targets.map((p) =>
    api('POST', '/api/tmux/send', { pane_id: p.pane_id, text }, node, timeoutMs)
      .then((r) => {
        if (!r || r.success !== true) throw new Error(r?.detail || r?.error || 'send failed');
        return r;
      })
  ));
  const failed = [];
  results.forEach((r, i) => {
    if (r.status === 'rejected') failed.push({ pane_id: targets[i].pane_id, error: String(r.reason?.message || r.reason) });
  });
  const stats = {
    mode, timeout_ms: timeoutMs,
    targets: targets.length,
    delivered: targets.length - failed.length,
    failed,
    skipped_offline: mode === 'online' ? offline.length : 0,
  };
  if (json) return ok(stats);
  console.log(`delivered ${stats.delivered}/${stats.targets} (${mode}${mode === 'online' ? `, skipped ${stats.skipped_offline} offline` : ''}, timeout ${timeoutMs}ms)`);
  for (const f of failed) console.log(`  ✗ ${f.pane_id}: ${f.error}`);
}

async function cmdSendKeys(args, node) {
  if (args.length < 2) throw Object.assign(new Error('Usage: cicy-agent send-keys <pane> <keys...>'), { exitCode: 2 });
  const data = await api('POST', '/api/tmux/send-keys', { pane_id: args[0], keys: args.slice(1).join(' ') }, node);
  if (json) return ok(data);
  console.log(typeof data === 'string' ? data : JSON.stringify(data));
}

async function cmdRestart(_args, node) {
  const data = await api('POST', '/api/tmux/restart_all', {}, node);
  if (json) return ok(data);
  console.log(typeof data === 'string' ? data : JSON.stringify(data));
}

async function cmdClear(args, node) {
  if (args.length < 1) throw Object.assign(new Error('Usage: cicy-agent clear <pane>'), { exitCode: 2 });
  const data = await api('POST', '/api/tmux/clear', { pane: args[0] }, node);
  if (json) return ok(data);
  console.log(typeof data === 'string' ? data : JSON.stringify(data));
}

// fork — replicate an existing agent: the server dumps the source agent's
// conversation (agent-summary) and spawns a NEW agent that copies the source's
// config (agent_type, model, role, allow_all, reply_in_chinese, use_custom_gateway,
// proxy_enable) and is prompted to INHERIT that context and continue. POSTs
// /api/tmux/fork.
async function cmdFork(args, node) {
  let title = '', master = '';
  const pos = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--title' || args[i] === '-t') title = args[++i] || '';
    else if (args[i] === '--master' || args[i] === '-m') master = args[++i] || '';
    else pos.push(args[i]);
  }
  if (pos.length < 1) {
    throw Object.assign(new Error('Usage: cicy-agent fork <source-pane> [--title T] [--master PANE]'), { exitCode: 2 });
  }
  const payload = { source_pane_id: pos[0] };
  if (title) payload.title = title;
  if (master) payload.master_pane_id = master;
  const data = await api('POST', '/api/tmux/fork', payload, node);
  if (json) return ok(data);
  const pid = data?.pane_id || data?.data?.pane_id || '';
  if (!pid) { console.log(typeof data === 'string' ? data : JSON.stringify(data)); return; }
  let line = `forked ${pos[0]} -> ${pid}`;
  if (data?.prompt_sent === false) line += ' (context prompt NOT sent — new agent not ready in time)';
  console.log(line);
}
