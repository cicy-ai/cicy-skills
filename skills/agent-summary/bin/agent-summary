#!/usr/bin/env node
// agent-summary — Node wrapper that delegates to agent-summary.py
import { execFileSync } from 'node:child_process';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dir = dirname(fileURLToPath(import.meta.url));
const script = join(__dir, 'agent-summary.py');

if (process.argv.slice(2).some(a => a === '--help' || a === '-h' || a === 'help')) {
  process.stdout.write(`agent-summary — Dump the raw basic conversation of an agent session.

Writes the basic conversation (text + thinking, no system prompt / tools) to
<history>/summary/<conversation_id>.md, repoints a current.md symlink at it,
and prints that path. Hand the file to a fork ("分身") or replay it to restore.

Usage:
  agent-summary <agent-id>                    # write the file, print its path
  agent-summary <path/to/current.json>        # explicit snapshot file
`);
  process.exit(0);
}

try {
  execFileSync('python3', [script, ...process.argv.slice(2)], { stdio: 'inherit' });
} catch (e) {
  process.exit(e.status ?? 1);
}
