#!/usr/bin/env node
// tg-autojoin — 把 Telegram Web 的自动 JOIN 注入脚本按版本同步到矩阵机。
//
// 脚本本体是 assets/telegram.org.js(带 UserScript 头,`@version` 就是版本号)。
// 机器上它落在 ~/cicy-ai/electron/extension/inject/telegram.org.js,cicy-desktop
// 的注入器按 `<域名>.js` 命名匹配,所以文件名不能改。
//
// 下发走 wsd(车队唯一的机器执行通道),不自己拼 hub 请求。
import { readFileSync, existsSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { homedir } from 'node:os';
import { join, dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const NAME = 'tg-autojoin';
const HERE = dirname(fileURLToPath(import.meta.url));
const ASSET = resolve(HERE, '..', 'assets', 'telegram.org.js');
// 机器上的落点。注入器按域名匹配文件名,改名 = 不再注入。
const REMOTE_REL = ['cicy-ai', 'electron', 'extension', 'inject'];
const REMOTE_FILE = 'telegram.org.js';

const die = (msg, code = 1) => { process.stderr.write(NAME + ': ' + msg + '\n'); process.exit(code); };
const versionOf = (src) => (/@version\s+([0-9][0-9A-Za-z.\-+]*)/.exec(src || '') || [])[1] || '';

function localScript() {
  if (!existsSync(ASSET)) die('找不到 assets/telegram.org.js');
  const src = readFileSync(ASSET, 'utf8');
  const v = versionOf(src);
  if (!v) die('assets/telegram.org.js 里没有 // @version,拒绝下发无版本的脚本');
  return { src, v };
}

// wsd 解析顺序和 dsh-fleet 保持一致,别各写各的
function wsdPath() {
  const cands = [
    process.env.CICY_WSD,
    join(HERE, 'wsd'),
    join(homedir(), 'projects', 'cicy-desktop', 'tools', 'wsd'),
  ].filter(Boolean);
  for (const c of cands) if (existsSync(c)) return c;
  die('找不到 wsd(设 CICY_WSD 或装 ~/projects/cicy-desktop/tools/wsd)', 3);
}

// 在目标机主进程里跑一段 JS,返回 {host -> 解析后的结果}
// 车队里有机器会不应答。把 all 塞进一次 wsd 调用时,一台卡住会吃掉整批的时间预算,
// 而且不应答的那台返回的是字符串 "timeout" —— 调用方很容易把它当成「查到了,结果是空」。
// 所以 all 拆成一台一台跑,并且把「没应答」和「查到了但是空」分开返回。
function fleetNodes() {
  const wsd = wsdPath();
  const r = spawnSync(wsd, ['nodes'], { encoding: 'utf8', timeout: 60000 });
  const set = new Set();
  for (const m of (r.stdout || '').matchAll(/desktop-([A-Za-z0-9_-]+)/g)) set.add(m[1]);
  return [...set];
}

function runOnFleet(target, code) {
  if (target === 'all') {
    const out = {};
    for (const n of fleetNodes()) Object.assign(out, runOnFleet(n, code));
    return out;
  }
  const wsd = wsdPath();
  const r = spawnSync(wsd, ['main', target, code, '--json'], { encoding: 'utf8', timeout: 180000 });
  let j = null;
  try { j = JSON.parse(r.stdout); } catch { die('wsd 返回的不是 JSON:\n' + (r.stdout || r.stderr || '').slice(0, 400)); }
  const out = {};
  for (const row of j.results || []) {
    const host = String(row.host || '?').replace(/^desktop-/, '');
    let val = row.out;
    if (typeof val === 'string') { try { val = JSON.parse(val); } catch { /* 原样留着,便于看错误 */ } }
    if (row.ok === false) out[host] = { error: String(val).slice(0, 120) };
    else if (val === 'timeout' || val == null) out[host] = { noReply: true };
    else out[host] = val;
  }
  return out;
}

const jsHeader = `const r=process.mainModule.require.bind(process.mainModule);const fs=r('fs'),path=r('path'),os=r('os');
const dir=path.join(os.homedir(),${REMOTE_REL.map((s) => JSON.stringify(s)).join(',')});const f=path.join(dir,${JSON.stringify(REMOTE_FILE)});
const ver=(s)=>{const m=/@version\\s+([0-9][0-9A-Za-z.\\-+]*)/.exec(s||'');return m?m[1]:'';};`;

const CODE = {
  status: `(()=>{${jsHeader}
    try{const s=fs.readFileSync(f,'utf8');return JSON.stringify({installed:true,version:ver(s),bytes:Buffer.byteLength(s)});}
    catch(e){return JSON.stringify({installed:false});}})()`,
  remove: `(()=>{${jsHeader}
    try{fs.unlinkSync(f);return JSON.stringify({removed:true});}catch(e){return JSON.stringify({removed:false,why:String(e.code||e.message)});}})()`,
  // sync 是覆盖操作。默认**拒绝盖掉不是本 skill 产物的文件**:
  // 2026-09-13 我在警告过自己之后仍然 sync all,把 19 台机器上原有的 telegram.org.js
  // 覆盖掉了,其中 xs-3002 那份 10492B 的独有版本无法恢复。之后一律:
  //   · 先备份成 telegram.org.js.bak-<时间戳>
  //   · 旧文件没有 @version(= 不是本 skill 装的)时,除非 --force 否则跳过
  sync: (src, force) => `(()=>{${jsHeader}
    const body=${JSON.stringify(src)};
    const FORCE=${force ? "true" : "false"};
    let old='',before='',had=false;
    try{ old=fs.readFileSync(f,'utf8'); had=true; before=ver(old); }catch(e){}
    if(had && !before && !FORCE){
      return JSON.stringify({skipped:true,reason:'现有文件不是本 skill 装的(没有 @version)',bytes:Buffer.byteLength(old)});
    }
    if(had){ try{ fs.writeFileSync(f+'.bak-'+Date.now(), old, 'utf8'); }catch(e){} }
    try{fs.mkdirSync(dir,{recursive:true});}catch(e){}
    fs.writeFileSync(f,body,'utf8');
    const after=ver(fs.readFileSync(f,'utf8'));
    return JSON.stringify({from:before||(had?'(无版本的旧文件)':'(未安装)'),to:after,bytes:Buffer.byteLength(body),backed:had});})()`,
};

function printTable(rows, cols) {
  const names = Object.keys(rows).sort();
  if (!names.length) { process.stdout.write('(没有机器应答)\n'); return; }
  const w = Math.max(...names.map((n) => n.length), 8);
  for (const n of names) process.stdout.write('  ' + n.padEnd(w) + '  ' + cols(rows[n]) + '\n');
}

const argv = process.argv.slice(2);
const cmd = argv[0];
const target = argv[1] || 'all';

if (!cmd || cmd === '--help' || cmd === '-h' || cmd === 'help') {
  process.stdout.write(`${NAME} — Telegram Web 自动 JOIN 注入脚本的车队分发

  ${NAME} show                    打印内置脚本的版本与大小
  ${NAME} status [target|all]     看各机装的是哪个版本
  ${NAME} sync   [target|all] [--force]
                                  下发到机器。会先备份;现有文件不是本 skill 装的会跳过,
                                  确认无误再加 --force
  ${NAME} apply  [target|all]     把脚本注进当前活着的 Telegram 页面(立即生效,刷新后失效)
  ${NAME} remove <target|all>     从机器上删掉
  ${NAME} watchdog [target|all] [--limit MB] [--dry]
                                  内存看门狗:只管矩阵面板里的格子(别的页面嵌的 webview 不碰)。
                                  超过上限(默认 1200MB)且系统剩余 <2GB、或格子 >3500MB 才重载;
                                  系统剩余 <600MB 时回收最大的那个。同一格子重载后冷却 60 分钟。
                                  给 cron 用,一次最多回收一台机器上的 1 个格子。

target 同 wsd:机器名(xs-3002)、主机名、cid 或 all。
脚本落点:~/cicy-ai/electron/extension/inject/${REMOTE_FILE}
改版本就改 assets/telegram.org.js 顶部的 // @version,再 sync。
`);
  process.exit(0);
}

if (cmd === 'show') {
  const { src, v } = localScript();
  process.stdout.write(JSON.stringify({ version: v, bytes: Buffer.byteLength(src), asset: ASSET }, null, 2) + '\n');
  process.exit(0);
}

if (cmd === 'status') {
  const { v } = localScript();
  const rows = runOnFleet(target, CODE.status);
  process.stdout.write('内置版本 ' + v + ',各机:\n');
  let same = 0, stale = 0, missing = 0;
  printTable(rows, (r) => {
    if (!r || r.error) return '探测失败 ' + ((r && r.error) || '');
    if (!r.installed) { missing++; return '未安装'; }
    if (r.version === v) { same++; return 'v' + r.version + '  ✓ 一致'; }
    stale++; return 'v' + (r.version || '?') + '  ← 旧版,需要 sync';
  });
  process.stdout.write(`\n一致 ${same} · 旧版 ${stale} · 未安装 ${missing}\n`);
  process.exit(stale + missing > 0 ? 1 : 0);
}

if (cmd === 'sync') {
  const { src, v } = localScript();
  const force = argv.includes('--force');
  const rows = runOnFleet(target, CODE.sync(src, force));
  process.stdout.write('下发 v' + v + (force ? ' (--force:强制覆盖)' : '') + ':\n');
  let ok = 0, bad = 0, skip = 0;
  printTable(rows, (r) => {
    if (r && r.skipped) { skip++; return '跳过 — ' + r.reason + ' (' + r.bytes + 'B),要覆盖加 --force'; }
    if (!r || r.error || !r.to) { bad++; return '失败 ' + ((r && r.error) || JSON.stringify(r)); }
    ok++; return r.from + ' → v' + r.to + ' (' + r.bytes + 'B)' + (r.backed ? ' · 已备份' : '');
  });
  process.stdout.write(`\n成功 ${ok} · 跳过 ${skip} · 失败 ${bad}\n`);
  if (skip) process.stdout.write('跳过的是「现有文件不是本 skill 装的」——先看清楚那是什么再决定要不要 --force。\n');
  process.exit(bad ? 1 : 0);
}

// apply:把脚本直接注进目标机上**当前活着的** Telegram webview。
// 为什么需要它:面板格子(BrowserView)历史上没接域名注入钩子,inject 目录里的
// 脚本在矩阵面板里不会自动生效;补钩子要发桌面端版本,而这条命令不用等 ——
// 代价是只作用于当前这些页面,刷新/重开后要再 apply(或等发版后自动注入)。
if (cmd === 'apply') {
  const { src, v } = localScript();
  const code = `(async()=>{const r=process.mainModule.require.bind(process.mainModule);
const {webContents}=r('electron');const body=${JSON.stringify(src)};const out=[];
for (const wc of webContents.getAllWebContents()) {
  let u=''; try{u=wc.getURL();}catch(e){continue;}
  if (!/web\\.telegram\\.org/.test(u)) continue;
  try { await wc.executeJavaScript(body, true);
        const got = await wc.executeJavaScript('(window.__cicyTgAutojoin&&window.__cicyTgAutojoin.version)||null', true);
        out.push({wc: wc.id, version: got}); }
  catch(e){ out.push({wc: wc.id, error: String(e.message).slice(0,80)}); }
}
return JSON.stringify({applied: out});})()`;
  const rows = runOnFleet(target, code);
  process.stdout.write('注入 v' + v + ' 到活着的 Telegram 页面:\n');
  let ok = 0, none = 0, dead = 0;
  printTable(rows, (r) => {
    // 「没应答」≠「没有 Telegram 页面」。以前这两种混成一句,表面上全绿,
    // 实际上那台机器根本没查过 —— 格子没脚本也看不出来。
    if (!r || r.noReply || r.error) { dead++; return '无应答' + (r && r.error ? '(' + r.error + ')' : '') + ' ← 没查到,不代表没问题'; }
    const list = Array.isArray(r.applied) ? r.applied : null;
    if (!list) { dead++; return '返回异常 ' + String(JSON.stringify(r)).slice(0, 60); }
    if (!list.length) { none++; return '没有打开的 Telegram 页面'; }
    const good = list.filter((x) => x.version === v).length;
    ok += good;
    return list.map((x) => 'wc' + x.wc + (x.version ? ' → v' + x.version : ' 失败 ' + (x.error || ''))).join(', ');
  });
  process.stdout.write(`\n注入成功 ${ok} 个页面 · ${none} 台没有打开 Telegram · ${dead} 台无应答(需要单独看)\n`);
  process.exit(0);
}

if (cmd === 'watchdog') {
  // 为什么放主进程而不是注入脚本:格子一旦卡死,页面里的 JS 就再也跑不了,
  // 自己救不了自己。只有主进程还能 reload 它。实测 8GB 的矩阵机上单个 Telegram
  // 格子能涨到 2.5GB(会话数据常驻内存,加的群越多越大且永不回落),
  // 涨满 → 渲染进程卡死 → 整个 app 被杀重启。
  const limit = Number((argv.find((a) => a.startsWith('--limit=')) || '').split('=')[1])
             || Number(argv[argv.indexOf('--limit') + 1]) || 1200;
  const dry = argv.includes('--dry');
  const code = `(()=>{const r=process.mainModule.require.bind(process.mainModule);
const {app,webContents}=r('electron');const os=r('os');
const LIMIT=${limit}, DRY=${dry ? 'true' : 'false'};
const byPid={}; for(const m of app.getAppMetrics()) byPid[m.pid]=Math.round(((m.memory&&m.memory.workingSetSize)||0)/1024);
const cells=[], skipped=[];
// 同一个格子重载后 60 分钟内不再动:否则一个"刚加载完就超上限"的大号(比如在 400+ 个群里)
// 会被每 10 分钟重载一次,永远在初始化 —— 2026-09-24 xs-master 上 tgsou 群库预览窗就是这么被刷的。
const G=globalThis.__tgWatchdog=globalThis.__tgWatchdog||{};
const COOLDOWN=3600000, now=Date.now();
for(const wc of webContents.getAllWebContents()){
  let u=''; try{u=wc.getURL();}catch(e){continue;}
  if(!/web\\.telegram\\.org/.test(u)) continue;
  // 只管矩阵面板里的格子。别的页面里嵌的 <webview>(tgsou 群库右侧预览窗等)是人在看的,不归看门狗。
  if(wc.getType()==='webview'){ let hu=''; try{const h=wc.hostWebContents; hu=h&&!h.isDestroyed()?h.getURL():'';}catch(e){}
    if(!/\\/panel\\/(telegram-matrix|matrix\\.html)|preset=telegram-matrix/.test(hu)){ skipped.push('wc'+wc.id+'(非面板)'); continue; } }
  let pid=0; try{pid=wc.getOSProcessId();}catch(e){}
  let part=''; try{part=(wc.session.storagePath||'').split(/[\\\\/]/).pop();}catch(e){}
  const cool=G[part] && now-G[part]<COOLDOWN;
  cells.push({id:wc.id, mb:byPid[pid]||0, loading:wc.isLoading(), wc, part, cool});
}
const freeMB=Math.round(os.freemem()/1048576);
// 一次只回收一个:同时重载多个格子会把代理和 CPU 一起冲垮,而且都在加载中时
// 这台机器等于全停。下一次 cron 再收下一个。
// 超上限本身不是重载理由:内存宽裕时重载只会让它从头再长回去。只有系统内存偏紧(<2GB),
// 或者格子逼近渲染进程上限(3500MB,再涨就卡死)时才动。
const HARD=3500, ROOMY=freeMB>=2000;
const over=cells.filter((c)=>!c.loading && !c.cool && (c.mb>HARD || (c.mb>LIMIT && !ROOMY))).sort((a,b)=>b.mb-a.mb);
const tight=(freeMB<600) ? cells.filter((c)=>!c.loading && !c.cool).sort((a,b)=>b.mb-a.mb) : [];
const pick=over[0]||tight[0]||null;
let acted='';
if(pick){
  acted='wc'+pick.id+' '+pick.mb+'MB → '+(over[0]?'超上限':'系统内存吃紧');
  if(!DRY){ try{ pick.wc.stop(); pick.wc.loadURL('https://web.telegram.org/k/'); G[pick.part]=now; acted+=' 已重载'; }
            catch(e){ acted+=' 重载失败 '+String(e&&e.message).slice(0,40); } }
  else acted+=' (dry,没动)';
}
return JSON.stringify({free:freeMB, limit:LIMIT, cells:cells.map((c)=>'wc'+c.id+' '+c.mb+'MB'+(c.loading?'(加载中)':'')+(c.cool?'(冷却)':'')).concat(skipped), acted});})()`;
  const rows = runOnFleet(target, code);
  let n = 0;
  printTable(rows, (r) => {
    if (!r || r.noReply || r.error) return '无应答' + (r && r.error ? '(' + r.error + ')' : '');
    if (typeof r !== 'object' || !Array.isArray(r.cells)) return '返回异常 ' + String(JSON.stringify(r)).slice(0, 60);
    if (!r.cells.length) return '没有 Telegram 格子';
    if (r.acted) n++;
    return '剩余' + r.free + 'MB · ' + r.cells.join(' ') + (r.acted ? ('  ← ' + r.acted) : '');
  });
  process.stdout.write(`\n上限 ${limit}MB · 本轮回收 ${n} 个格子\n`);
  process.exit(0);
}

if (cmd === 'remove') {
  if (!argv[1]) die('remove 必须显式给 target(要全删就写 all)');
  const rows = runOnFleet(argv[1], CODE.remove);
  printTable(rows, (r) => (r && r.removed ? '已删除' : '未删除 ' + ((r && (r.why || r.error)) || '')));
  process.exit(0);
}

die('未知命令 ' + cmd + '(看 ' + NAME + ' --help)');
