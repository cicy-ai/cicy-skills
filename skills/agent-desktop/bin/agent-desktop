#!/usr/bin/env node
// agent-desktop — control a connected cicy-desktop (Electron) client.
// Pushes desktop_event { rpc_call, tool, args, requestId } and awaits
// rpc_result over the chat WebSocket. Requires Node 22+.

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { randomBytes } from 'node:crypto';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

if (typeof globalThis.WebSocket !== 'function') {
  process.stderr.write('agent-desktop: native WebSocket missing — Node 22+ required\n');
  process.exit(1);
}

// extract --client/-c flag
let clientID = '';
const args = [];
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === '--client' || argv[i] === '-c') { clientID = argv[++i] || ''; continue; }
  args.push(argv[i]);
}

const json = args.includes('--json');
const cmd = args[0];
const rest = args.slice(1).filter((a) => a !== '--json');

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const HTTP_BASE = `http://127.0.0.1:${API_PORT}`;
const WS_BASE   = `ws://127.0.0.1:${API_PORT}`;
const RPC_TIMEOUT_MS = Number(process.env.CICY_AGENT_TIMEOUT_MS || 30000);

(async () => {
  try {
    switch (cmd) {
      case 'tools':       await cmdTools(rest); return;
      case 'clients':     await cmdClients(); return;
      case 'ping':        await cmdPing(); return;
      case 'exec':        await cmdExec(rest); return;
      case 'exec-file':   await cmdExecFile(rest); return;
      case 'sysinfo':     await cmdSysinfo(); return;
      case 'rpc':         await cmdRPC(rest); return;
      case 'fleet':       await cmdFleet(rest); return;
      default: bail(`unknown command: ${cmd}. Try agent-desktop --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();


// ── fleet: the whole cicy-desktop fleet over the homepage control channel ──
// Unlike the commands above (which drive THIS host's local desktop via local
// cicy-code), 'fleet' reaches EVERY desktop through desktop.cicy-ai.com. Each
// desktop holds a ws socket there and reports a short id shown in its top bar.
// Operator token: ~/cicy-ai/db/desktop-ctrl.json.
function fleetCfg() {
  const f = join(homedir(), 'cicy-ai', 'db', 'desktop-ctrl.json');
  let c;
  try { c = JSON.parse(readFileSync(f, 'utf8')); }
  catch (e) { bail(`cannot read ${f}: ${e.message}`); }
  if (!c.base || !c.token) bail(`${f} needs { base, token }`);
  return { base: String(c.base).replace(/\/+$/, ''), token: c.token };
}
async function fleetCall(pathname, payload) {
  const { base, token } = fleetCfg();
  const res = await fetch(base + pathname, {
    method: payload != null ? 'POST' : 'GET',
    headers: {
      'x-cicy-ctrl': token,
      'content-type': 'application/json',
      'user-agent': 'Mozilla/5.0 (X11; Linux x86_64) agent-desktop-fleet/1',
    },
    body: payload != null ? JSON.stringify(payload) : undefined,
  });
  const txt = await res.text();
  let j = null; try { j = JSON.parse(txt); } catch {}
  if (!res.ok) bail(`HTTP ${res.status} ${txt.slice(0, 300)}`);
  return j != null ? j : txt;
}
function fleetBody(a) {
  if (a === '-') return readFileSync(0, 'utf8');
  try { if (existsSync(a)) return readFileSync(a, 'utf8'); } catch {}
  return a;
}
function fleetMainWrap(code) {
  return "const g=await window.electronRPC('get_windows',{});" +
    "const gt=((g&&g.content)||[]).map(c=>c&&c.text).join('');" +
    "let wid=1;try{const ws=JSON.parse(gt);if(ws&&ws.length)wid=ws[0].id}catch(e){}" +
    "const r=await window.electronRPC('control_electron_BrowserWindow',{win_id:wid,code:" +
    JSON.stringify(code) + "});return ((r&&r.content)||[]).map(c=>c&&c.text).join('');";
}
function fleetShow(res) {
  if (json) { process.stdout.write(JSON.stringify(res, null, 2) + '\n'); return; }
  for (const r of (res.results || [])) {
    let out = r.out;
    if (typeof out === 'string' && out && '{['.includes(out[0])) { try { out = JSON.stringify(JSON.parse(out)); } catch {} }
    process.stdout.write(`${r.ok ? 'ok ' : 'ERR'} ${String(r.host || '?').padEnd(18)} ${out ?? ''}\n`);
  }
}
async function cmdFleet(a) {
  const sub = a[0];
  const t = a.slice(1);
  if (!sub || sub === 'ls' || sub === 'nodes') {
    const d = await fleetCall('/api/fleet');
    const peers = d.peers || [];
    if (json) { process.stdout.write(JSON.stringify(peers, null, 2) + '\n'); return; }
    process.stdout.write(`build=${d.build}  peers=${peers.length}\n`);
    for (const p of peers.sort((x, y) => String(x.team || x.host).localeCompare(String(y.team || y.host)))) {
      const who = p.team || (p.host + ' (no team)');
      process.stdout.write(`  ${String(p.short || '-----').padEnd(6)} ${String(who).padEnd(22)} v=${String(p.v || '?').padEnd(9)} ${String(p.plat || '?').padEnd(6)} login=${p.authed} idle=${p.idleSec}s\n`);
    }
    return;
  }
  if (sub === 'exec') { if (t.length < 2) bail('usage: agent-desktop fleet exec <target> <shell...>'); return fleetShow(await fleetCall('/api/rpc', { target: t[0], tool: 'exec_shell', args: { command: t.slice(1).join(' ') } })); }
  if (sub === 'rpc')  { if (t.length < 2) bail('usage: agent-desktop fleet rpc <target> <tool> [json]'); return fleetShow(await fleetCall('/api/rpc', { target: t[0], tool: t[1], args: t[2] ? JSON.parse(t[2]) : {} })); }
  if (sub === 'js')   { if (t.length < 2) bail('usage: agent-desktop fleet js <target> <file|-|code>'); return fleetShow(await fleetCall('/api/rpc', { target: t[0], js: fleetBody(t[1]) })); }
  if (sub === 'main') { if (t.length < 2) bail('usage: agent-desktop fleet main <target> <file|-|code>'); return fleetShow(await fleetCall('/api/rpc', { target: t[0], js: fleetMainWrap(fleetBody(t[1])) })); }
  if (sub === 'ipc')  { if (t.length < 2) bail('usage: agent-desktop fleet ipc <target> <channel> [json]'); return fleetShow(await fleetCall('/api/rpc', { target: t[0], ipc: t[1], args: t[2] ? JSON.parse(t[2]) : [] })); }
  if (sub === 'team') {
    if (t.length < 2) bail('usage: agent-desktop fleet team <target> <name>');
    const name = t[1].startsWith('desktop-') ? t[1] : 'desktop-' + t[1];
    const code = "(()=>{const r=process.mainModule.require.bind(process.mainModule);const os=r('os'),fs=r('fs'),path=r('path');" +
      "const p=path.join(os.homedir(),'cicy-ai','global.json');let c={};try{c=JSON.parse(fs.readFileSync(p,'utf8'))}catch(e){}" +
      "c.desktopTeam=" + JSON.stringify(name) + ";fs.writeFileSync(p,JSON.stringify(c,null,2));" +
      "try{fs.writeFileSync(path.join(os.homedir(),'cicy-ai','team.txt')," + JSON.stringify(name.replace(/^desktop-/, '')) + ")}catch(e){}" +
      "return JSON.stringify({host:os.hostname(),team:c.desktopTeam})})()";
    return fleetShow(await fleetCall('/api/rpc', { target: t[0], js: fleetMainWrap(code) }));
  }
  bail(`unknown fleet subcommand '${sub}'. Try: ls exec rpc js main ipc team`, 2);
}

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`agent-desktop: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: agent-desktop <ping|exec|exec-file|sysinfo|rpc|clients|tools> [...] [--client ID]\n'); }
}
function printTools() {
  try { process.stdout.write(readFileSync(new URL('../references/tools.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('# agent-desktop tools\n'); }
}

function loadToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON}`), { exitCode: 3 });
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

function currentAgentID() {
  if (process.env.CICY_PANE_ID) return process.env.CICY_PANE_ID;
  const m = /(w-\d+)/.exec(process.cwd());
  return m ? m[1] : 'w-1001';
}

function randomID(prefix) { return `${prefix}-${Date.now()}-${randomBytes(4).toString('hex')}`; }

async function api(method, path, payload) {
  const token = loadToken();
  const headers = { 'Authorization': `Bearer ${token}` };
  const init = { method, headers };
  if (payload !== undefined) { headers['Content-Type'] = 'application/json'; init.body = JSON.stringify(payload); }
  let res;
  try { res = await fetch(HTTP_BASE + path, init); }
  catch (e) { throw Object.assign(new Error(`cannot reach cicy-code at ${HTTP_BASE} (${e.message})`), { exitCode: 3 }); }
  const text = await res.text();
  if (res.status === 401 || res.status === 403) throw Object.assign(new Error(`auth failed (${res.status})`), { exitCode: 3 });
  if (res.status >= 400) {
    let body; try { body = JSON.parse(text); } catch { body = { error: text }; }
    throw Object.assign(new Error(`api error (${res.status}): ${body?.error || body?.message || text}`), { exitCode: 4 });
  }
  try { return JSON.parse(text); } catch { return text; }
}

async function chatClients() {
  const data = await api('GET', '/api/chat/clients');
  // Server returns an array of client records: { client_id, isElectron,
  // platform, user_agent, ..., non_routing_*_agent_id_display_only }.
  // Older payloads used a nested { agentID: { clientID: info } } shape —
  // flatten so the rest of the code treats one shape only. The
  // non_routing_*_agent_id_display_only fields are metadata; routing is by
  // client_id alone.
  let raw = data?.clients || data?.data?.clients || data?.data || data || [];
  if (!Array.isArray(raw)) {
    const flat = [];
    for (const [aid, m] of Object.entries(raw)) {
      for (const [cid, info] of Object.entries(m || {})) {
        flat.push({ client_id: cid, non_routing_master_agent_id_display_only: aid, ...info });
      }
    }
    raw = flat;
  }
  return raw.filter((c) => c?.client_id);
}

// probe: does this client's page actually expose window.electronRPC?
// isElectron only means the UA contains "electron" — preload-less sandbox
// windows (agent-electron open_window pages) carry it too but cannot serve
// rpc_call. A quick exec_js typeof check separates the real bridge windows.
async function hasElectronRPC(cid) {
  try {
    const resp = await api('POST', '/api/chat/push', {
      client_id: cid,
      type: 'exec_js',
      wait_ack: true,
      timeout_ms: 5000,
      data: { code: 'typeof window.electronRPC' },
    });
    return resp?.data?.result === 'function';
  } catch { return false; }
}

// auto-select the single rpc-capable cicy-desktop client; explicit --client wins
async function resolveDesktop() {
  const clients = await chatClients();
  if (clientID) {
    const c = clients.find((x) => x?.client_id === clientID);
    if (!c) throw Object.assign(new Error(`client_id ${clientID} not found`), { exitCode: 4 });
    return { clientID: c.client_id };
  }
  const matches = clients.filter((c) => {
    const ua = String(c?.user_agent || '').toLowerCase();
    return c?.isElectron === true || ua.includes('electronmcp') || ua.includes('cicydesktop');
  });
  if (matches.length === 0) throw Object.assign(new Error('no cicy-desktop client connected'), { exitCode: 3 });
  const flags = await Promise.all(matches.map((c) => hasElectronRPC(c.client_id)));
  const capable = matches.filter((_, i) => flags[i]);
  if (capable.length === 0) {
    const ids = matches.map((c) => c.client_id).join(', ');
    throw Object.assign(new Error(`cicy-desktop window(s) connected (${ids}) but none exposes electronRPC — open the cicy-desktop main window, or pass --client <id>`), { exitCode: 3 });
  }
  if (capable.length > 1) {
    const ids = capable.map((c) => c.client_id).join(', ');
    throw Object.assign(new Error(`multiple rpc-capable cicy-desktop clients (${ids}); pass --client <id>`), { exitCode: 2 });
  }
  return { clientID: capable[0].client_id };
}

// rpc: HTTP push with wait_ack=true; the server's sync mode keys solely on
// client_id and returns the rpc_result as the HTTP response.
async function rpc(tool, toolArgs) {
  const target = await resolveDesktop();
  const rid = randomID('drpc');
  const resp = await api('POST', '/api/chat/push', {
    client_id: target.clientID,
    type: 'desktop_event',
    wait_ack: true,
    timeout_ms: RPC_TIMEOUT_MS,
    data: { type: 'rpc_call', tool, args: toolArgs ?? {}, requestId: rid },
  });
  const data = resp?.data || {};
  if (data.error) throw Object.assign(new Error(String(data.error)), { exitCode: 4 });
  return { result: data.result, target };
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdClients() {
  const clients = await chatClients();
  const rows = clients.map((c) => {
    const ua = String(c?.user_agent || '');
    return {
      client_id: c.client_id,
      non_routing_master_agent_id_display_only: c?.non_routing_master_agent_id_display_only || '',
      non_routing_active_agent_id_display_only: c?.non_routing_active_agent_id_display_only || '',
      platform: c?.platform || '',
      user_agent: ua,
      is_cicy_desktop: c?.isElectron === true || ua.toLowerCase().includes('electronmcp') || ua.toLowerCase().includes('cicydesktop'),
    };
  });
  if (json) return ok(rows);
  if (rows.length === 0) { console.log('no clients connected'); return; }
  for (const r of rows) {
    const tag = r.is_cicy_desktop ? 'cicy-desktop' : 'browser';
    const m = r.non_routing_master_agent_id_display_only;
    const a = r.non_routing_active_agent_id_display_only;
    console.log(`[${tag}] ${r.client_id} (master=${m} active=${a} platform=${r.platform})  [agent fields are display only — route by client_id]`);
  }
}

async function cmdPing() {
  // Simple: send rpc_call to a no-op tool ('get_system_info'); if it returns,
  // the desktop side is fully responsive.
  const t0 = Date.now();
  const { target } = await rpc('get_system_info', {});
  const ms = Date.now() - t0;
  if (json) return ok({ ok: true, target, latency_ms: ms });
  console.log(`✅ cicy-desktop online (client=${target.clientID}, latency=${ms}ms)`);
}

async function cmdExec(args) {
  if (args.length < 1) throw Object.assign(new Error('Usage: agent-desktop exec <shell_cmd>'), { exitCode: 2 });
  const command = args.join(' ');
  const { result } = await rpc('exec_shell', { command });
  if (json) return ok(result);
  if (typeof result === 'string') console.log(result);
  else console.log(JSON.stringify(result, null, 2));
}

// Upload a local script and execute it on the desktop. Runner is picked by
// extension (.py → exec_python_file, .js/.mjs/.cjs → exec_node_file,
// anything else → exec_shell_file); the desktop saves `content` to a temp
// file and runs it.
async function cmdExecFile(args) {
  let cwd = '';
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--cwd') { cwd = args[++i] || ''; continue; }
    rest.push(args[i]);
  }
  if (rest.length < 1) throw Object.assign(new Error('Usage: agent-desktop exec-file <local_script> [--cwd DIR]'), { exitCode: 2 });
  const file = rest[0];
  if (!existsSync(file)) throw Object.assign(new Error(`local file not found: ${file}`), { exitCode: 2 });
  const content = readFileSync(file, 'utf8');
  const ext = (file.match(/\.([a-z0-9]+)$/i) || [])[1]?.toLowerCase() || '';
  const tool = ext === 'py' ? 'exec_python_file'
    : ['js', 'mjs', 'cjs'].includes(ext) ? 'exec_node_file'
    : 'exec_shell_file';
  const { result } = await rpc(tool, cwd ? { content, cwd } : { content });
  if (json) return ok(result);
  if (typeof result === 'string') console.log(result);
  else console.log(JSON.stringify(result, null, 2));
}

// sysinfo = get_system_info + gap fill. The desktop tool lacks `os version`
// everywhere and `disk` / `cpu.usage` outside Linux, so one extra exec_shell
// fills those in client-side — works against already-deployed desktops.
async function cmdSysinfo() {
  let { result } = await rpc('get_system_info', {});
  if (typeof result === 'string') { try { result = JSON.parse(result); } catch { /* keep raw */ } }
  const info = (result && typeof result === 'object') ? result : { raw: result };

  const plat = info.platform || '';
  const needDisk = !(info.disk && info.disk.total);
  if ((plat === 'darwin' || plat === 'linux') && (!info.os_version || needDisk)) {
    try {
      const script = plat === 'darwin'
        ? `echo "OSV:$(sw_vers -productName) $(sw_vers -productVersion) ($(uname -r))"; df -h / | tail -1`
        : `echo "OSV:$(. /etc/os-release 2>/dev/null; echo "$PRETTY_NAME") ($(uname -r))"; df -h / | tail -1`;
      const { result: out } = await rpc('exec_shell', { command: script });
      // exec_shell output may arrive with newlines as literal \n escapes —
      // normalize before line-based parsing.
      const text = (typeof out === 'string' ? out : JSON.stringify(out)).replace(/\\n/g, '\n');
      const osv = text.match(/OSV:([^\n]+)/);
      if (osv) info.os_version = osv[1].replace(/[\\",]+\s*$/, '').trim();
      if (needDisk) {
        const dfLine = text.split('\n').find((l) => /^\/|^\S+\s+\d/.test(l) && /%/.test(l));
        if (dfLine) {
          const p = dfLine.trim().split(/\s+/);
          if (p.length >= 5) info.disk = { total: p[1], used: p[2], available: p[3], usePercent: p[4] };
        }
      }
    } catch { /* enrichment is best-effort; base info still printed */ }
  }

  if (json) return ok(info);
  console.log(JSON.stringify(info, null, 2));
}

async function cmdTools(rest) {
  // Live tool discovery via the `list_tools` meta-tool on the connected
  // cicy-desktop. Falls back to the bundled static references/tools.md when no
  // client is connected or the client is too old to have list_tools.
  //   agent-desktop tools [--schema] [--names] [--tag <Tag>] [--static]
  if (rest.includes('--static')) { printTools(); return; }
  const toolArgs = {};
  if (rest.includes('--schema')) toolArgs.schema = true;
  if (rest.includes('--names'))  toolArgs.names_only = true;
  const ti = rest.indexOf('--tag');
  if (ti !== -1 && rest[ti + 1]) toolArgs.tag = rest[ti + 1];

  let payload;
  try {
    const { result } = await rpc('list_tools', toolArgs);
    // The desktop_event bridge already unwraps {content:[{text}]} to the raw
    // text string; tolerate both shapes.
    const text = typeof result === 'string'
      ? result
      : (result?.content || []).map((c) => c.text).filter(Boolean).join('');
    if (!text) throw new Error('empty list_tools result (client may predate list_tools)');
    payload = JSON.parse(text);
  } catch (e) {
    if (json) { ok({ live: false, error: e.message }); return; }
    process.stderr.write(`agent-desktop: live list_tools unavailable (${e.message}); showing static reference\n`);
    printTools();
    return;
  }

  if (json) { ok(payload); return; }
  if (Array.isArray(payload.tools) && typeof payload.tools[0] === 'string') {
    console.log(`${payload.count} tools:`);
    console.log(payload.tools.join('\n'));
    return;
  }
  console.log(`${payload.count} tools${payload.tags ? ` · ${payload.tags.length} tags` : ''}:`);
  let lastTag = null;
  for (const t of payload.tools || []) {
    if (t.tag !== lastTag) { console.log(`\n[${t.tag}]`); lastTag = t.tag; }
    console.log(`  ${t.name}${t.description ? ' — ' + t.description : ''}`);
    if (t.inputSchema) console.log(`      ${JSON.stringify(t.inputSchema)}`);
  }
}

async function cmdRPC(args) {
  if (args.length < 1) throw Object.assign(new Error("Usage: agent-desktop rpc <tool> [json_args]"), { exitCode: 2 });
  const tool = args[0];
  let toolArgs = {};
  if (args[1]) {
    try { toolArgs = JSON.parse(args[1]); }
    catch (e) { throw Object.assign(new Error(`invalid json_args: ${e.message}`), { exitCode: 2 }); }
  }
  const { result } = await rpc(tool, toolArgs);
  if (json) return ok(result);
  if (typeof result === 'string') console.log(result);
  else console.log(JSON.stringify(result, null, 2));
}
