#!/usr/bin/env node
import os from 'node:os';
import path from 'node:path';
import { parseArgs } from '../lib/args.js';
import { TelegramWebError } from '../lib/errors.js';
import { requireApply } from '../lib/safety.js';
import { createTransport, decodeCdpValue } from '../lib/transport.js';
import { discoverTarget } from '../lib/targets.js';
import { clearSession, loadSession } from '../lib/session.js';
import { createBackendA } from '../lib/backend-a.js';
import { createBackendK } from '../lib/backend-k.js';
import { defaultPoll, login } from '../lib/login.js';

const SESSION_PATH = process.env.CICY_TELEGRAM_WEB_SESSION || path.join(os.homedir(), 'cicy-ai', 'db', 'telegram-web.json');

function help() {
  return `Usage: telegram-web [shared options] <command> [command options]

Commands: login status patch account chats dialogs users messages open send eval close
Shared: --client ID --target winId|wc:id --win N --backend a|k --json --apply
Run references/help.cn.md for the full command reference.`;
}

function emitSuccess(data, json) {
  const envelope = { ok: true, data };
  process.stdout.write(`${JSON.stringify(envelope, null, json ? 0 : 2)}\n`);
}

function emitError(error, json) {
  const normalized = error instanceof TelegramWebError
    ? error
    : new TelegramWebError('INTERNAL_ERROR', error?.message || String(error), 1);
  const envelope = { ok: false, error: { code: normalized.code, message: normalized.message } };
  if (json) process.stdout.write(`${JSON.stringify(envelope)}\n`);
  else process.stderr.write(`telegram-web: ${normalized.code}: ${normalized.message}\n`);
  process.exitCode = normalized.exitCode || 1;
}

function evaluator(transport, target) {
  return async (expression) => {
    const params = JSON.stringify({ expression, awaitPromise: true, returnByValue: true });
    return decodeCdpValue(transport.electron(['cdp', target, 'Runtime.evaluate', params]));
  };
}

function conditionPoll(check) {
  return defaultPoll(check, 40, 250);
}

function backendFor(transport, selected) {
  const evaluate = evaluator(transport, selected.target);
  if (selected.backend === 'a') return createBackendA({ evaluate, poll: conditionPoll });
  return createBackendK({ evaluate, mirror: (args) => transport.mirror(args), target: selected.target });
}

function optionalSession() {
  try { return loadSession(SESSION_PATH); }
  catch (error) {
    if (error.code === 'INVALID_SESSION') throw error;
    return null;
  }
}

async function main(argv) {
  if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
    process.stdout.write(`${help()}\n`);
    return;
  }
  let parsed;
  try { parsed = parseArgs(argv); }
  catch (error) { emitError(error, argv.includes('--json')); return; }
  try {
    const evalText = parsed.command === 'eval' ? parsed.positional.join(' ') : '';
    requireApply(parsed.command, parsed.apply, evalText);
    const transport = createTransport({ client: parsed.client });

    if (parsed.command === 'login') {
      const data = await login({
        transport,
        options: parsed.options,
        sessionPath: SESSION_PATH,
        poll: conditionPoll,
        patchBackend: async (selected) => backendFor(transport, selected).patch(),
      });
      emitSuccess(data, parsed.json);
      return;
    }

    const selected = discoverTarget(transport, parsed, optionalSession());
    if (parsed.command === 'close') {
      transport.electron(['close', selected.target]);
      clearSession(SESSION_PATH, selected.target);
      emitSuccess({ backend: selected.backend, closed: true, target: selected.target }, parsed.json);
      return;
    }

    const backend = backendFor(transport, selected);
    let data;
    if (parsed.command === 'status') data = await backend.status();
    else if (parsed.command === 'patch') data = await backend.patch();
    else if (parsed.command === 'account') data = await backend.account();
    else if (parsed.command === 'chats') data = await backend.chats();
    else if (parsed.command === 'dialogs') data = await backend.dialogs(parsed.options);
    else if (parsed.command === 'users') data = await backend.users();
    else if (parsed.command === 'messages') {
      if (!parsed.positional[0]) throw new TelegramWebError('USAGE', 'messages requires <chatId>', 2);
      data = await backend.messages(parsed.positional[0], parsed.options);
    } else if (parsed.command === 'open') {
      if (!parsed.positional[0]) throw new TelegramWebError('USAGE', 'open requires <chatId>', 2);
      data = await backend.open(parsed.positional[0]);
    } else if (parsed.command === 'send') {
      if (parsed.positional.length < 2) throw new TelegramWebError('USAGE', 'send requires <chatId> <text...>', 2);
      data = await backend.send(parsed.positional[0], parsed.positional.slice(1).join(' '));
    } else if (parsed.command === 'eval') {
      if (!evalText) throw new TelegramWebError('USAGE', 'eval requires <expression>', 2);
      data = await backend.evaluate(evalText, { applied: parsed.apply });
    }
    emitSuccess({ backend: selected.backend, ...((data && typeof data === 'object' && !Array.isArray(data)) ? data : { value: data }) }, parsed.json);
  } catch (error) {
    emitError(error, parsed.json);
  }
}

main(process.argv.slice(2));
