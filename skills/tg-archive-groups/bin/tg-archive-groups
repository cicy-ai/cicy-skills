#!/usr/bin/env node
// tg-archive-groups — move every group (and optionally every channel) of a Telegram Web K
// session into the Archive folder, or bring them back. Drives the page through agent-electron
// (CDP Runtime.evaluate) + Telegram Web K's native window.rootScope.managers. Zero deps, Node 18+,
// also runs inside dsh on Windows (cicy-skill-spec §4).
import { execFileSync } from 'node:child_process';

const NAME = 'tg-archive-groups';
const VERSION = '0.3.1';

const HELP = `${NAME} ${VERSION} — archive all groups and channels of a Telegram Web K session

Usage:
  ${NAME} targets  [--client <id>] [--json]                       list Telegram Web K webContents
  ${NAME} scan     [--target wc:<id>] [--groups-only|--bots|--all] [--json]     what would move (not yet archived)
  ${NAME} archive  [--target wc:<id>] [--groups-only|--bots|--all] [--yes] [--limit N] [--batch N] [--delay ms] [--json]
  ${NAME} unarchive [--target wc:<id>] [--groups-only|--bots|--all] [--yes] [--limit N] [--batch N] [--delay ms] [--json]

By default every group (basic + supergroup) AND every broadcast channel moves; chats with people are left alone
unless you pass --all.
  --all              archive EVERYTHING: groups, channels, bots and private chats with people (the whole main list)
  --drop-service     delete the official "Telegram" service chat (777000) — it cannot be archived; deleting its
                     history removes it from the list until the next service notification arrives
  --drop-saved       delete Saved Messages (clears everything saved!) — likewise not archivable
  --clear-drafts     discard unsent drafts: a chat that exists only because of a draft has no server-side
                     dialog to archive, so clearing the draft is the only way to get it off the main list
  --groups-only      leave broadcast channels where they are
  --bots             also move chats with bots (never people). The official "Telegram" service chat (777000) cannot
                     be archived: the server accepts folders.editPeerFolders for it but returns no update
  --no-keep          don't touch the account's "keep archived" settings (by default archive turns on
                     keep_archived_unmuted + keep_archived_folders, otherwise Telegram un-archives a chat
                     as soon as a new message arrives and the work silently undoes itself)
  --channels         (accepted for compatibility; channels are already included)
  --target wc:<id>   Telegram Web K webContents id (from "targets"); auto-picked when exactly one exists
  --client <id>      cicy-desktop client id (agent-electron --client)
  --yes              actually move (without it "archive"/"unarchive" only print what they would do)
  --limit N          move at most N chats this run
  --batch N          peers per folders.editPeerFolders call (default 20)
  --delay ms         pause between batches (default 500)
  --json             machine-readable output

Exit codes: 0 ok · 1 usage · 2 agent-electron / page error or a batch failed
`;

function parseArgs(argv) {
  const o = { cmd: argv[0] || '', target: '', client: '', json: false, yes: false, channels: true, bots: false, all: false, keep: true, dropService: false, dropSaved: false, clearDrafts: false, limit: 0, batch: 20, delay: 500 };
  for (let i = 1; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--target') o.target = argv[++i] || '';
    else if (a === '--client') o.client = argv[++i] || '';
    else if (a === '--json') o.json = true;
    else if (a === '--yes') o.yes = true;
    else if (a === '--dry-run') o.yes = false;
    else if (a === '--channels') o.channels = true;
    else if (a === '--groups-only') o.channels = false;
    else if (a === '--no-keep') o.keep = false;
    else if (a === '--bots') o.bots = true;
    else if (a === '--all') { o.all = true; o.bots = true; o.channels = true; }
    else if (a === '--drop-service') o.dropService = true;
    else if (a === '--drop-saved') o.dropSaved = true;
    else if (a === '--clear-drafts') o.clearDrafts = true;
    else if (a === '--limit') o.limit = Number(argv[++i] || 0) || 0;
    else if (a === '--batch') o.batch = Math.max(1, Number(argv[++i] || 20) || 20);
    else if (a === '--delay') o.delay = Number(argv[++i] || 500) || 0;
    else if (a === '--help' || a === '-h') o.cmd = 'help';
    else { process.stderr.write(`${NAME}: unknown option ${a}\n`); process.exit(1); }
  }
  if (o.target && /^\d+$/.test(o.target)) o.target = 'wc:' + o.target;
  return o;
}

// ── agent-electron transport ─────────────────────────────────────────────
function runAgent(o, args) {
  const bin = process.env.AGENT_ELECTRON_BIN || 'agent-electron';
  const full = o.client ? ['--client', o.client, ...args] : args;
  let out;
  try { out = execFileSync(bin, full, { encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 }); }
  catch (e) { throw new Error('agent-electron failed: ' + (e.stderr ? String(e.stderr).trim() : e.message)); }
  try { return JSON.parse(out); } catch { throw new Error('agent-electron returned invalid JSON: ' + out.slice(0, 200)); }
}
function listTargets(o) {
  const r = runAgent(o, ['webcontents', '--json']);
  if (!r.ok || !Array.isArray(r.data)) throw new Error('could not list Electron webContents');
  return r.data.filter((w) => /^https:\/\/web\.telegram\.org\/k\//.test(w.url || ''))
    .map((w) => ({ target: 'wc:' + w.webContentsId, webContentsId: w.webContentsId, url: w.url, title: w.title || '' }));
}
function pickTarget(o) {
  if (o.target) return o.target;
  const t = listTargets(o);
  if (!t.length) throw new Error('no Telegram Web K target found (open web.telegram.org/k in a cicy-desktop window first)');
  if (t.length > 1) throw new Error(`multiple Telegram Web targets (${t.map((x) => x.target).join(', ')}); pass --target wc:<id>`);
  return t[0].target;
}
function evaluate(o, target, expression) {
  const r = runAgent(o, ['cdp', target, 'Runtime.evaluate', JSON.stringify({ expression, awaitPromise: true, returnByValue: true })]);
  const res = r && r.result && r.result.result;
  if (!r.success || !res) throw new Error('CDP Runtime.evaluate returned no result');
  if (r.result.exceptionDetails) throw new Error(res.description || r.result.exceptionDetails.text || 'page evaluation failed');
  return res.value;
}

// ── page-side scripts (Telegram Web K) ───────────────────────────────────
// folder_id: 0 = main list, 1 = Archive. Groups = basic "chat" + "channel" with pFlags.megagroup; channels = the rest.
const scanJs = (includeChannels, includeBots, includeUsers) => `(async () => {
  const M = window.rootScope && window.rootScope.managers;
  if (!M) return JSON.stringify({ ok: false, err: 'rootScope.managers not available (page not logged in / not Telegram Web K?)' });
  const me = await M.appUsersManager.getSelf().catch(() => null);
  // filterId 0 = main list, 1 = Archive folder; read both so "already archived" and unarchive are exact
  const ds = [];
  for (const fid of [0, 1]) { const r = await M.dialogsStorage.getDialogs({ query: '', offsetIndex: 0, limit: 20000, filterId: fid }).catch(() => ({ dialogs: [] })); for (const d of (r.dialogs || [])) ds.push(d); }
  const out = []; let groups = 0, channels = 0, users = 0, bots = 0;
  for (const d of ds) {
    const pid = d.peerId;
    if (pid > 0) {
      const u = await M.appUsersManager.getUser(pid).catch(() => null);
      if (pid === 777000) continue;   // 官方「Telegram」通知号:服务端接受 editPeerFolders 但不动它(返回空 updates),归不了档,直接跳过
      const isBot = !!(u && u.pFlags && u.pFlags.bot);
      const title = String((u && ([u.first_name, u.last_name].filter(Boolean).join(' ') || u.username)) || '').slice(0, 60);
      if (isBot) { bots++; if (${includeBots ? 'true' : 'false'}) out.push({ peerId: String(pid), title, kind: 'bot', folder: d.folder_id || 0, unread: d.unread_count || 0 }); }
      else { users++; if (${includeUsers ? 'true' : 'false'}) out.push({ peerId: String(pid), title, kind: 'user', folder: d.folder_id || 0, unread: d.unread_count || 0 }); }
      continue;
    }
    const ch = await M.appChatsManager.getChat(-pid).catch(() => null); if (!ch) continue;
    if (ch.pFlags && (ch.pFlags.left || ch.pFlags.kicked || ch.pFlags.deactivated)) continue;
    const isChannel = ch._ === 'channel' && !(ch.pFlags && ch.pFlags.megagroup);
    if (isChannel) channels++; else groups++;
    if (isChannel && !${includeChannels ? 'true' : 'false'}) continue;
    out.push({ peerId: String(pid), title: String(ch.title || '').slice(0, 60), kind: isChannel ? 'channel' : 'group', folder: d.folder_id || 0, unread: d.unread_count || 0 });
  }
  return JSON.stringify({ ok: true, self: me ? { id: String(me.id), phone: me.phone || '', username: me.username || '' } : null, total: ds.length, users, groups, channels, bots, items: out });
})()`;
// folders.editPeerFolders: one call per batch. The local dialog cache catches up asynchronously (updateFolderPeers),
// so we only report the API error here; the final rescan is the source of truth for moved / failed.
const moveJs = (peerIds, folderId) => `(async () => {
  const M = window.rootScope.managers; const ids = ${JSON.stringify(peerIds.map(Number))}; const f = ${Number(folderId)};
  try { await M.appMessagesManager.editPeerFolders(ids, f); return JSON.stringify({ ok: true }); }
  catch (e) { return JSON.stringify({ ok: false, err: String(e && (e.type || e.message) || e).slice(0, 200) }); }
})()`;

// account.getGlobalPrivacySettings / setGlobalPrivacySettings: keep_archived_unmuted + keep_archived_folders.
// Without them Telegram moves an archived, unmuted chat back to the main list on the next incoming message.
const KEEP_JS = `(async () => {
  const M = window.rootScope.managers;
  try {
    const gp = await M.apiManager.invokeApi('account.getGlobalPrivacySettings', {}); const f = gp.pFlags || {};
    if (f.keep_archived_unmuted && f.keep_archived_folders) return JSON.stringify({ ok: true, changed: false });
    await M.apiManager.invokeApi('account.setGlobalPrivacySettings', { settings: { _: 'globalPrivacySettings', pFlags: { ...f, keep_archived_unmuted: true, keep_archived_folders: true } } });
    return JSON.stringify({ ok: true, changed: true });
  } catch (e) { return JSON.stringify({ ok: false, err: String(e && (e.type || e.message) || e).slice(0, 200) }); }
})()`;

// 服务端核对:本地 dialogsStorage 有时收不到 updateFolderPeers(folder 一直显示 0),不能只信它;
// 用 messages.getPeerDialogs 直接问服务器每个会话现在在哪个文件夹(≤100 个一批)。
const verifyJs = (peerIds) => `(async () => {
  const M = window.rootScope.managers; const ids = ${JSON.stringify(peerIds.map(Number))}; const out = {};
  for (let i = 0; i < ids.length; i += 100) {
    const chunk = ids.slice(i, i + 100); const peers = [];
    for (const id of chunk) { try { const ip = await M.appPeersManager.getInputPeerById(id); if (ip) peers.push({ id, ip }); } catch (e) {} }
    try {
      const r = await M.apiManager.invokeApi('messages.getPeerDialogs', { peers: peers.map((p) => ({ _: 'inputDialogPeer', peer: p.ip })) });
      const ds = (r && r.dialogs) || [];
      ds.forEach((d, k) => { const p = d.peer || {}; const id = p.user_id != null ? Number(p.user_id) : p.chat_id != null ? -Number(p.chat_id) : p.channel_id != null ? -Number(p.channel_id) : null; if (id != null) out[String(id)] = d.folder_id || 0; });
    } catch (e) { for (const p of peers) out[String(p.id)] = 'err:' + String(e && (e.type || e.message) || e).slice(0, 60); }
  }
  return JSON.stringify(out);
})()`;

// 服务端扫尾:本地 dialogsStorage 刚启动时可能还没把会话全拉下来,按它扫会漏。最后直接翻服务器主列表
// (messages.getDialogs folder_id=0),把还留在主列表、且属于本次范围的会话逐个归档(用服务器给的 access_hash)。
const serverSweepJs = (includeChannels, includeBots, includeUsers, folderId) => `(async () => { /*server-sweep*/
  const M = window.rootScope.managers; const me = window.rootScope.myId; const want = ${Number(folderId)};
  let od = 0, oi = 0, op = { _: 'inputPeerEmpty' }, rounds = 0, moved = 0, failed = [], seen = 0;
  const srcFolder = want === 1 ? 0 : 1;
  const todo = [];
  while (rounds++ < 60) {
    const r = await M.apiManager.invokeApi('messages.getDialogs', { folder_id: srcFolder, offset_date: od, offset_id: oi, offset_peer: op, limit: 100, hash: 0 });
    const ds = r.dialogs || []; if (!ds.length) break;
    const users = new Map((r.users || []).map((u) => [String(u.id), u])), chats = new Map((r.chats || []).map((c) => [String(c.id), c]));
    for (const d of ds) {
      seen++; const p = d.peer; let ip = null, ok = false, title = '';
      if (p._ === 'peerUser') {
        if (String(p.user_id) === '777000' || String(p.user_id) === String(me)) continue;
        const u = users.get(String(p.user_id)); if (!u) continue;
        const isBot = !!(u.pFlags && u.pFlags.bot);
        ok = isBot ? ${includeBots ? 'true' : 'false'} : ${includeUsers ? 'true' : 'false'};
        ip = { _: 'inputPeerUser', user_id: p.user_id, access_hash: u.access_hash || 0 }; title = u.first_name || u.username || '';
      } else if (p._ === 'peerChat') { const c = chats.get(String(p.chat_id)); if (!c) continue; ok = true; ip = { _: 'inputPeerChat', chat_id: p.chat_id }; title = c.title || ''; }
      else { const c = chats.get(String(p.channel_id)); if (!c) continue; const isChannel = !(c.pFlags && c.pFlags.megagroup); ok = isChannel ? ${includeChannels ? 'true' : 'false'} : true; ip = { _: 'inputPeerChannel', channel_id: p.channel_id, access_hash: c.access_hash || 0 }; title = c.title || ''; }
      if (ok && ip) todo.push({ ip, title: String(title).slice(0, 40), key: String(p.user_id || p.chat_id || p.channel_id) });
    }
    if (r._ === 'messages.dialogs' || ds.length < 100) break;
    const last = ds[ds.length - 1]; const m = (r.messages || []).find((x) => x.id === last.top_message);
    od = m ? m.date : 0; oi = last.top_message;
    op = last.peer._ === 'peerUser' ? { _: 'inputPeerUser', user_id: last.peer.user_id, access_hash: (users.get(String(last.peer.user_id)) || {}).access_hash || 0 } : last.peer._ === 'peerChat' ? { _: 'inputPeerChat', chat_id: last.peer.chat_id } : { _: 'inputPeerChannel', channel_id: last.peer.channel_id, access_hash: (chats.get(String(last.peer.channel_id)) || {}).access_hash || 0 };
    if (!od) break;
  }
  for (const t of todo) {
    try { await M.apiManager.invokeApi('folders.editPeerFolders', { folder_peers: [{ _: 'inputFolderPeer', peer: t.ip, folder_id: want }] }); } catch (e) { failed.push(t.title + ' (' + String(e && (e.type || e.message) || e).slice(0, 40) + ')'); continue; }
    await new Promise((r) => setTimeout(r, 250));
    try { const v = await M.apiManager.invokeApi('messages.getPeerDialogs', { peers: [{ _: 'inputDialogPeer', peer: t.ip }] }); const f = (v.dialogs && v.dialogs[0] && v.dialogs[0].folder_id) || 0; if (f === want) moved++; else failed.push(t.title + ' (server keeps it in folder ' + f + ')'); } catch (e) { failed.push(t.title + ' (verify: ' + String(e && (e.type || e.message) || e).slice(0, 40) + ')'); }
  }
  return JSON.stringify({ seen, todo: todo.length, moved, failed });
})()`;

// 官方 Telegram 通知号 / Saved Messages 归不了档(服务端拒绝),要从主列表拿掉只能删会话历史
const dropJs = (service, saved) => `(async () => { /*drop-fixed*/
  const M = window.rootScope.managers; const out = {};
  const del = async (label, peer) => {
    try { await M.apiManager.invokeApi('messages.deleteHistory', { peer, max_id: 0, just_clear: false, revoke: false }); }
    catch (e) { out[label] = 'err: ' + String(e && (e.type || e.message) || e).slice(0, 60); return; }
    await new Promise((r) => setTimeout(r, 800));
    try { const v = await M.apiManager.invokeApi('messages.getPeerDialogs', { peers: [{ _: 'inputDialogPeer', peer }] }); const d = v.dialogs && v.dialogs[0]; out[label] = !d || !d.top_message ? 'gone' : 'still there (top ' + d.top_message + ')'; }
    catch (e) { out[label] = 'gone'; }
  };
  if (${service ? 'true' : 'false'}) { let ip = null; try { ip = await M.appPeersManager.getInputPeerById(777000); } catch (e) {} if (ip) await del('service', ip); else out.service = 'no dialog'; }
  if (${saved ? 'true' : 'false'}) await del('saved', { _: 'inputPeerSelf' });
  return JSON.stringify(out);
})()`;

// 清草稿:只有草稿、没有消息的会话在服务器上没有 dialog,归不了档;把草稿清掉它就从主列表消失
const DRAFTS_JS = `(async () => { /*clear-drafts*/
  const M = window.rootScope.managers; let cleared = 0, failed = 0;
  let upd; try { upd = await M.apiManager.invokeApi('messages.getAllDrafts', {}); } catch (e) { return JSON.stringify({ err: String(e && (e.type || e.message) || e).slice(0, 80) }); }
  const peers = ((upd && upd.updates) || []).filter((u) => u._ === 'updateDraftMessage' && u.draft && u.draft._ === 'draftMessage').map((u) => u.peer);
  for (const p of peers) {
    const id = p.user_id != null ? Number(p.user_id) : p.chat_id != null ? -Number(p.chat_id) : -Number(p.channel_id);
    let ip = null; try { ip = await M.appPeersManager.getInputPeerById(id); } catch (e) {}
    if (!ip) { failed++; continue; }
    try { await M.apiManager.invokeApi('messages.saveDraft', { peer: ip, message: '' }); cleared++; } catch (e) { failed++; }
  }
  return JSON.stringify({ drafts: peers.length, cleared, failed });
})()`;

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function main() {
  const o = parseArgs(process.argv.slice(2));
  if (!o.cmd || o.cmd === 'help' || o.cmd === '--help' || o.cmd === '-h') { process.stdout.write(HELP); return 0; }
  if (o.cmd === 'targets') {
    const t = listTargets(o);
    if (o.json) process.stdout.write(JSON.stringify({ ok: true, targets: t }) + '\n');
    else if (!t.length) process.stdout.write('no Telegram Web K webContents found\n');
    else for (const x of t) process.stdout.write(`${x.target.padEnd(8)} ${x.title}\n`);
    return 0;
  }
  if (!['scan', 'archive', 'unarchive'].includes(o.cmd)) { process.stderr.write(`${NAME}: unknown command "${o.cmd}"\n\n` + HELP); return 1; }

  const target = pickTarget(o);
  const scan = JSON.parse(evaluate(o, target, scanJs(o.channels, o.bots, o.all)));
  if (!scan.ok) throw new Error(scan.err);
  const who = scan.self ? `+${scan.self.phone || '?'}${scan.self.username ? ' @' + scan.self.username : ''}` : 'unknown account';
  const wantFolder = o.cmd === 'unarchive' ? 0 : 1;
  const already = scan.items.filter((x) => x.folder === wantFolder).length;
  let todo = scan.items.filter((x) => x.folder !== wantFolder);
  const label = o.cmd === 'unarchive' ? 'unarchive' : 'archive';

  if (o.cmd === 'scan') {
    if (o.json) { process.stdout.write(JSON.stringify({ ok: true, target, self: scan.self, total: scan.total, users: scan.users, groups: scan.groups, channels: scan.channels, included: scan.items.length, archived: scan.items.filter((x) => x.folder === 1).length, not_archived: todo.length, items: scan.items }) + '\n'); return 0; }
    process.stdout.write(`${target} ${who}: ${scan.total} chats — ${scan.groups} groups, ${scan.channels} channels, ${scan.bots} bots, ${scan.users} people\n`);
    process.stdout.write(`${o.all ? 'everything (groups + channels + bots + people)' : (o.channels ? 'groups + channels' : 'groups') + (o.bots ? ' + bots' : '')}: ${scan.items.length}, already archived ${scan.items.filter((x) => x.folder === 1).length}, to archive ${todo.length}\n`);
    for (const x of todo.slice(0, 50)) process.stdout.write(`  ${x.kind.padEnd(7)} ${x.peerId.padEnd(15)} ${x.title}\n`);
    if (todo.length > 50) process.stdout.write(`  … ${todo.length - 50} more\n`);
    return 0;
  }

  if (o.limit > 0) todo = todo.slice(0, o.limit);
  // keep-archived settings first, even when nothing needs moving (an account archived earlier may still have it off)
  let keep = null;
  if (o.cmd === 'archive' && o.keep && o.yes) {
    keep = JSON.parse(evaluate(o, target, KEEP_JS));
    if (!o.json) process.stdout.write(keep.ok ? (keep.changed ? '  keep-archived settings: turned on\n' : '  keep-archived settings: already on\n') : `  keep-archived settings: FAILED (${keep.err})\n`);
  }
  let drop = null;
  if (o.yes && o.cmd === 'archive' && o.clearDrafts) {
    let d = null; try { d = JSON.parse(evaluate(o, target, DRAFTS_JS)); } catch (e) { d = { err: String(e.message).slice(0, 80) }; }
    if (!o.json) process.stdout.write(`  drafts: ${d.err ? 'failed: ' + d.err : d.drafts + ' found, ' + d.cleared + ' cleared' + (d.failed ? ', ' + d.failed + ' failed' : '')}\n`);
    drop = { ...(drop || {}), drafts: d.err ? 'err' : `${d.cleared}/${d.drafts}` };
  }
  if (o.yes && o.cmd === 'archive' && (o.dropService || o.dropSaved)) {
    try { drop = { ...(drop || {}), ...JSON.parse(evaluate(o, target, dropJs(o.dropService, o.dropSaved))) }; } catch (e) { drop = { ...(drop || {}), err: String(e.message).slice(0, 80) }; }
    if (!o.json) process.stdout.write(`  drop: ${Object.entries(drop).map(([k, v]) => k + '=' + v).join(', ')}\n`);
  }
  if (!todo.length && o.yes) {
    // 本地缓存没东西可动,但服务器主列表可能还有(只有草稿的会话、缓存没拉到的会话):直接跑服务端扫尾
    let sweep = null;
    try { sweep = JSON.parse(evaluate(o, target, serverSweepJs(o.channels, o.bots, o.all, wantFolder))); } catch (e) { sweep = { err: String(e.message).slice(0, 120) }; }
    const moved = sweep && sweep.moved || 0, failedList = (sweep && sweep.failed) || [];
    if (o.json) process.stdout.write(JSON.stringify({ ok: !sweep.err && failedList.length === 0, target, self: scan.self, moved, failed: failedList.length, remaining: failedList.length, already, keep, sweep, drop, errors: failedList.map((f) => ({ peers: [], err: 'server sweep: ' + f })) }) + '\n');
    else process.stdout.write(`${target} ${who}: nothing to ${label} in the local list (${already} already there)${sweep.err ? `; server sweep failed: ${sweep.err}` : sweep.todo ? `; server sweep: ${sweep.todo} more on the server → ${label}d ${moved}${failedList.length ? ', refused: ' + failedList.join('; ') : ''}` : '; server agrees'}\n`);
    return failedList.length || sweep.err ? 2 : 0;
  }
  if (!todo.length) { process.stdout.write(o.json ? JSON.stringify({ ok: true, target, moved: 0, failed: 0, already, keep }) + '\n' : `${target} ${who}: nothing to ${label} (${already} already there)\n`); return 0; }
  if (!o.yes) {
    if (o.json) process.stdout.write(JSON.stringify({ ok: true, dryRun: true, target, self: scan.self, would_move: todo, already }) + '\n');
    else process.stdout.write(`${target} ${who}: would ${label} ${todo.length} chat(s) (dry run; add --yes)\n` + todo.slice(0, 50).map((x) => `  ${x.kind.padEnd(7)} ${x.title}`).join('\n') + (todo.length > 50 ? `\n  … ${todo.length - 50} more` : '') + '\n');
    return 0;
  }
  const errors = [];
  for (let i = 0; i < todo.length; i += o.batch) {
    const batch = todo.slice(i, i + o.batch);
    const r = JSON.parse(evaluate(o, target, moveJs(batch.map((x) => x.peerId), wantFolder)));
    if (!r.ok) errors.push({ peers: batch.map((x) => x.peerId), err: r.err });
    if (!o.json) process.stdout.write(`  ${label} ${Math.min(i + batch.length, todo.length)}/${todo.length}${r.ok ? '' : '  (batch failed: ' + r.err + ')'}\n`);
    if (o.delay > 0 && i + o.batch < todo.length) await sleep(o.delay);
  }
  // the local dialog cache catches up through server updates; poll the rescan until every attempted peer
  // is in the target folder or nothing changes for a while (up to ~20s)
  const attempted = todo.map((x) => x.peerId);
  let after = null, moved = 0, lastMoved = -1, stable = 0;
  for (let k = 0; k < 10; k++) {
    await sleep(k === 0 ? Math.max(800, o.delay) : 2000);
    after = JSON.parse(evaluate(o, target, scanJs(o.channels, o.bots, o.all)));
    const folderOf = new Map(after.ok ? after.items.map((x) => [x.peerId, x.folder]) : []);
    moved = attempted.filter((id) => folderOf.get(id) === wantFolder).length;
    if (moved === attempted.length) break;
    if (moved === lastMoved) { if (++stable >= 3) break; } else { stable = 0; lastMoved = moved; }
  }
  // 本地缓存说没到位的,问服务器;服务器也说没到位的,逐个再试一次(整批里混进一个坏 peer 时服务端会把整批丢掉)
  let stubborn = [];
  if (moved < attempted.length) {
    const folderOfLocal = new Map(after && after.ok ? after.items.map((x) => [x.peerId, x.folder]) : []);
    const unsure = attempted.filter((id) => folderOfLocal.get(id) !== wantFolder);
    let srv = JSON.parse(evaluate(o, target, verifyJs(unsure)));
    stubborn = unsure.filter((id) => srv[id] !== wantFolder);
    moved = attempted.length - stubborn.length;
    if (stubborn.length) {
      if (!o.json) process.stdout.write(`  ${stubborn.length} not moved on the server, retrying one by one…\n`);
      for (const id of stubborn) { const r = JSON.parse(evaluate(o, target, moveJs([id], wantFolder))); if (!r.ok) errors.push({ peers: [id], err: r.err }); await sleep(300); }
      await sleep(1000);
      srv = JSON.parse(evaluate(o, target, verifyJs(stubborn)));
      stubborn = stubborn.filter((id) => srv[id] !== wantFolder);
      moved = attempted.length - stubborn.length;
      if (stubborn.length) errors.push({ peers: stubborn, err: 'server still reports old folder after individual retry' });
    }
  }
  // 服务端扫尾:本地缓存没见到、但服务器主列表里还有的,补一遍
  let sweep = null;
  try { sweep = JSON.parse(evaluate(o, target, serverSweepJs(o.channels, o.bots, o.all, wantFolder))); } catch (e) { sweep = { err: String(e.message).slice(0, 120) }; }
  if (sweep && !sweep.err) {
    if (sweep.todo && !o.json) process.stdout.write(`  server sweep: ${sweep.todo} chat(s) still in the ${o.cmd === 'unarchive' ? 'archive' : 'main list'} on the server → moved ${sweep.moved}${sweep.failed.length ? ', refused: ' + sweep.failed.join('; ') : ''}\n`);
    moved += sweep.moved; for (const f of sweep.failed) errors.push({ peers: [], err: 'server sweep: ' + f });
    stubborn = stubborn.concat(sweep.failed);
  } else if (sweep && sweep.err) errors.push({ peers: [], err: 'server sweep failed: ' + sweep.err });
  const failed = stubborn.length;
  const remaining = after && after.ok ? Math.max(0, after.items.filter((x) => x.folder !== wantFolder).length - (attempted.length - failed - attempted.filter((id) => (new Map(after.items.map((x) => [x.peerId, x.folder]))).get(id) === wantFolder).length)) : null;
  if (o.json) process.stdout.write(JSON.stringify({ ok: failed === 0, target, self: scan.self, moved, failed, remaining, keep, sweep, drop, errors }) + '\n');
  else process.stdout.write(`${target} ${who}: ${label}d ${moved}, failed ${failed}, remaining ${remaining ?? '?'}\n`);
  return failed ? 2 : 0;
}

main().then((code) => process.exit(code)).catch((e) => { process.stderr.write(`${NAME}: ${e.message}\n`); process.exit(2); });
