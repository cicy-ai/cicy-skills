#!/usr/bin/env node
// tg-set-username — show / check / set / clear the @username of the account logged in to a
// Telegram Web K page. Talks to the page through agent-electron (CDP Runtime.evaluate) and
// Telegram Web K's own window.rootScope.managers API, so no patch is needed.
// Zero deps, pure ESM, Node 18+. Runs on Linux cicy-code and inside dsh on Windows (cicy-skill-spec §4).
import { execFileSync } from 'node:child_process';

const NAME = 'tg-set-username';
const VERSION = '0.1.0';

const HELP = `${NAME} ${VERSION} — show / check / set / clear the @username of a Telegram Web K account

Usage:
  ${NAME} targets [--client <id>] [--json]                 list Telegram Web K webContents to operate on
  ${NAME} show  [--target wc:<id>] [--client <id>] [--json]
                                                           which account is logged in + its current @username
  ${NAME} check <username> [--target wc:<id>] [--client <id>] [--json]
                                                           validate locally, then ask Telegram if it is available
  ${NAME} set   <username> [--target wc:<id>] [--client <id>] [--yes] [--json]
                                                           set the username (dry run without --yes)
  ${NAME} clear [--target wc:<id>] [--client <id>] [--yes] [--json]
                                                           remove the current username (dry run without --yes)

Options:
  --target wc:<id>   Telegram Web K webContents id (from "targets"); auto-picked when exactly one exists
  --client <id>      cicy-desktop client id (agent-electron --client)
  --yes              actually change the username (set / clear are dry runs without it)
  --json             machine-readable output

Username rules (checked before any request): 5–32 chars, a-z 0-9 _, starts with a letter,
no trailing "_" and no "__". A leading "@" is accepted and stripped.

Exit codes: 0 ok · 1 usage / invalid username · 2 agent-electron / page error · 3 username not available or refused by Telegram
`;

function parseArgs(argv) {
  const o = { cmd: argv[0] || '', username: '', target: '', client: '', json: false, yes: false };
  for (let i = 1; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--target') o.target = argv[++i] || '';
    else if (a === '--client') o.client = argv[++i] || '';
    else if (a === '--json') o.json = true;
    else if (a === '--yes') o.yes = true;
    else if (a === '--dry-run') o.yes = false;
    else if (a === '--help' || a === '-h') o.cmd = 'help';
    else if (a.startsWith('--')) { process.stderr.write(`${NAME}: unknown option ${a}\n`); process.exit(1); }
    else if (!o.username) o.username = a;
    else { process.stderr.write(`${NAME}: unexpected argument ${a}\n`); process.exit(1); }
  }
  if (o.target && /^\d+$/.test(o.target)) o.target = 'wc:' + o.target;
  o.username = o.username.replace(/^@/, '');
  return o;
}

// Telegram's username rules (same as the "Username" settings screen).
function validateUsername(u) {
  if (!u) return 'username is empty';
  if (u.length < 5) return 'too short (min 5 characters)';
  if (u.length > 32) return 'too long (max 32 characters)';
  if (!/^[A-Za-z][A-Za-z0-9_]*$/.test(u)) return 'only a-z, 0-9 and "_" are allowed, and it must start with a letter';
  if (u.endsWith('_')) return 'must not end with "_"';
  if (u.includes('__')) return 'must not contain "__"';
  return '';
}

// ── agent-electron transport ─────────────────────────────────────────────
function runAgent(o, args) {
  const bin = process.env.AGENT_ELECTRON_BIN || 'agent-electron';
  const full = o.client ? ['--client', o.client, ...args] : args;
  let out;
  try { out = execFileSync(bin, full, { encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 }); }
  catch (e) { throw new Error('agent-electron failed: ' + (e.stderr ? String(e.stderr).trim() : e.message)); }
  try { return JSON.parse(out); } catch { throw new Error('agent-electron returned invalid JSON: ' + out.slice(0, 200)); }
}
function listTargets(o) {
  const r = runAgent(o, ['webcontents', '--json']);
  if (!r.ok || !Array.isArray(r.data)) throw new Error('could not list Electron webContents');
  return r.data.filter((w) => /^https:\/\/web\.telegram\.org\/k\//.test(w.url || ''))
    .map((w) => ({ target: 'wc:' + w.webContentsId, webContentsId: w.webContentsId, url: w.url, title: w.title || '', profile: w.profileId ?? w.accountIdx ?? null }));
}
function pickTarget(o) {
  if (o.target) return o.target;
  const t = listTargets(o);
  if (!t.length) throw new Error('no Telegram Web K target found (open web.telegram.org/k in a cicy-desktop window first)');
  if (t.length > 1) throw new Error(`multiple Telegram Web targets (${t.map((x) => x.target).join(', ')}); pass --target wc:<id>`);
  return t[0].target;
}
function evaluate(o, target, expression) {
  const r = runAgent(o, ['cdp', target, 'Runtime.evaluate', JSON.stringify({ expression, awaitPromise: true, returnByValue: true })]);
  const res = r && r.result && r.result.result;
  if (!r.success || !res) throw new Error('CDP Runtime.evaluate returned no result');
  if (r.result.exceptionDetails) throw new Error(res.description || r.result.exceptionDetails.text || 'page evaluation failed');
  return res.value;
}

// ── page-side scripts (run inside Telegram Web K) ────────────────────────
// Who am I: appUsersManager.getSelf() is the cached self user (id / phone / username / name).
const SHOW_JS = `(async () => {
  const R = window.rootScope, M = R && R.managers;
  if (!M) return JSON.stringify({ ok: false, err: 'rootScope.managers not available (page not logged in / not Telegram Web K?)' });
  if (!R.myId) return JSON.stringify({ ok: false, err: 'page is still starting or not logged in (rootScope.myId is empty)' });
  const me = await M.appUsersManager.getSelf();
  return JSON.stringify({ ok: true, self: { id: String(me.id), phone: me.phone || '', username: me.username || '',
    name: [me.first_name, me.last_name].filter(Boolean).join(' ') } });
})()`;
// account.checkUsername → true when free. Telegram answers errors (USERNAME_INVALID / USERNAME_OCCUPIED /
// USERNAME_PURCHASE_AVAILABLE / FLOOD_WAIT_n) as RPC errors; we pass the error type through.
const checkJs = (u) => `(async () => {
  const M = window.rootScope.managers; const u = ${JSON.stringify(u)};
  try {
    const me = await M.appUsersManager.getSelf();
    if ((me.username || '').toLowerCase() === u.toLowerCase()) return JSON.stringify({ ok: true, available: true, own: true });
    const r = await M.apiManager.invokeApi('account.checkUsername', { username: u });
    return JSON.stringify({ ok: true, available: r === true, own: false });
  } catch (e) { return JSON.stringify({ ok: false, err: String(e && (e.type || e.message) || e).slice(0, 200) }); }
})()`;
// account.updateUsername returns the updated User; saveApiUser keeps the page's own cache in sync
// so the settings screen / chat header show the new name without a reload.
const setJs = (u) => `(async () => {
  const M = window.rootScope.managers; const u = ${JSON.stringify(u)};
  try {
    const user = await M.apiManager.invokeApi('account.updateUsername', { username: u });
    try { if (user && typeof M.appUsersManager.saveApiUser === 'function') await M.appUsersManager.saveApiUser(user, true); } catch (e) {}
    const me = await M.appUsersManager.getSelf();
    const now = (user && user.username) || me.username || '';
    return JSON.stringify({ ok: now.toLowerCase() === u.toLowerCase(), username: now, err: now.toLowerCase() === u.toLowerCase() ? '' : 'server returned a different username: ' + now });
  } catch (e) { return JSON.stringify({ ok: false, err: String(e && (e.type || e.message) || e).slice(0, 200) }); }
})()`;

const ERR_HINT = {
  USERNAME_OCCUPIED: 'already taken by someone else',
  USERNAME_INVALID: 'Telegram rejected the username as invalid',
  USERNAME_NOT_MODIFIED: 'the account already has this username',
  USERNAME_PURCHASE_AVAILABLE: 'this is a collectible username sold on Fragment, it cannot be set here',
  USERNAMES_ACTIVE_TOO_MUCH: 'too many active usernames on this account',
};
const explain = (err) => { const k = String(err || '').split(/[^A-Z_]/)[0]; const fw = /^FLOOD_WAIT_(\d+)/.exec(err || ''); return fw ? `rate-limited by Telegram, wait ${fw[1]}s` : (ERR_HINT[k] || err); };
const who = (s) => s ? `${s.name || '?'} +${s.phone || '?'} (id ${s.id})${s.username ? ' @' + s.username : ' (no username)'}` : 'unknown account';

async function main() {
  const o = parseArgs(process.argv.slice(2));
  if (!o.cmd || o.cmd === 'help' || o.cmd === '--help' || o.cmd === '-h') { process.stdout.write(HELP); return 0; }

  if (o.cmd === 'targets') {
    const t = listTargets(o);
    if (o.json) process.stdout.write(JSON.stringify({ ok: true, targets: t }) + '\n');
    else if (!t.length) process.stdout.write('no Telegram Web K webContents found\n');
    else for (const x of t) process.stdout.write(`${x.target.padEnd(8)} ${x.title}\n`);
    return 0;
  }
  if (!['show', 'check', 'set', 'clear'].includes(o.cmd)) { process.stderr.write(`${NAME}: unknown command "${o.cmd}"\n\n` + HELP); return 1; }
  if ((o.cmd === 'check' || o.cmd === 'set') && !o.username) { process.stderr.write(`${NAME}: ${o.cmd} needs a <username>\n`); return 1; }
  if (o.cmd === 'check' || o.cmd === 'set') {
    const bad = validateUsername(o.username);
    if (bad) {
      if (o.json) process.stdout.write(JSON.stringify({ ok: false, username: o.username, valid: false, reason: bad }) + '\n');
      else process.stderr.write(`${NAME}: "${o.username}" is not a valid username: ${bad}\n`);
      return 1;
    }
  }

  const target = pickTarget(o);
  const show = JSON.parse(evaluate(o, target, SHOW_JS));
  if (!show.ok) throw new Error(show.err);
  const self = show.self;

  if (o.cmd === 'show') {
    if (o.json) process.stdout.write(JSON.stringify({ ok: true, target, self }) + '\n');
    else process.stdout.write(`${target} ${who(self)}\n`);
    return 0;
  }

  if (o.cmd === 'check' || o.cmd === 'set') {
    const c = JSON.parse(evaluate(o, target, checkJs(o.username)));
    if (!c.ok) {
      if (o.json) process.stdout.write(JSON.stringify({ ok: false, target, self, username: o.username, valid: true, available: false, err: c.err, hint: explain(c.err) }) + '\n');
      else process.stdout.write(`${target} ${who(self)}\n  @${o.username}: ${explain(c.err)} (${c.err})\n`);
      return 3;
    }
    if (o.cmd === 'check') {
      if (o.json) process.stdout.write(JSON.stringify({ ok: true, target, self, username: o.username, valid: true, available: c.available, own: c.own }) + '\n');
      else process.stdout.write(`${target} ${who(self)}\n  @${o.username}: ${c.own ? 'already this account\'s username' : c.available ? 'available' : 'taken'}\n`);
      return c.available ? 0 : 3;
    }
    if (c.own) {
      if (o.json) process.stdout.write(JSON.stringify({ ok: true, target, self, username: o.username, unchanged: true }) + '\n');
      else process.stdout.write(`${target} ${who(self)}\n  already @${o.username}, nothing to do\n`);
      return 0;
    }
    if (!c.available) {
      if (o.json) process.stdout.write(JSON.stringify({ ok: false, target, self, username: o.username, valid: true, available: false, err: 'USERNAME_OCCUPIED', hint: ERR_HINT.USERNAME_OCCUPIED }) + '\n');
      else process.stdout.write(`${target} ${who(self)}\n  @${o.username}: ${ERR_HINT.USERNAME_OCCUPIED}\n`);
      return 3;
    }
    if (!o.yes) {
      if (o.json) process.stdout.write(JSON.stringify({ ok: true, dryRun: true, target, self, username: o.username, available: true }) + '\n');
      else process.stdout.write(`${target} ${who(self)}\n  @${o.username} is available — would set it (dry run; add --yes to apply)\n`);
      return 0;
    }
    const r = JSON.parse(evaluate(o, target, setJs(o.username)));
    if (!r.ok) {
      if (o.json) process.stdout.write(JSON.stringify({ ok: false, target, self, username: o.username, err: r.err, hint: explain(r.err) }) + '\n');
      else process.stdout.write(`${target} ${who(self)}\n  FAILED to set @${o.username}: ${explain(r.err)} (${r.err})\n`);
      return 3;
    }
    if (o.json) process.stdout.write(JSON.stringify({ ok: true, target, self: { ...self, username: r.username }, username: r.username, previous: self.username }) + '\n');
    else process.stdout.write(`${target} ${who(self)}\n  username set: @${r.username}${self.username ? ` (was @${self.username})` : ''}\n`);
    return 0;
  }

  // clear
  if (!self.username) {
    if (o.json) process.stdout.write(JSON.stringify({ ok: true, target, self, unchanged: true }) + '\n');
    else process.stdout.write(`${target} ${who(self)}\n  no username set, nothing to clear\n`);
    return 0;
  }
  if (!o.yes) {
    if (o.json) process.stdout.write(JSON.stringify({ ok: true, dryRun: true, target, self, would_clear: self.username }) + '\n');
    else process.stdout.write(`${target} ${who(self)}\n  would remove @${self.username} (dry run; add --yes to apply)\n`);
    return 0;
  }
  const r = JSON.parse(evaluate(o, target, setJs('')));
  if (!r.ok) {
    if (o.json) process.stdout.write(JSON.stringify({ ok: false, target, self, err: r.err, hint: explain(r.err) }) + '\n');
    else process.stdout.write(`${target} ${who(self)}\n  FAILED to clear: ${explain(r.err)} (${r.err})\n`);
    return 3;
  }
  if (o.json) process.stdout.write(JSON.stringify({ ok: true, target, self: { ...self, username: '' }, previous: self.username }) + '\n');
  else process.stdout.write(`${target} ${who(self)}\n  username removed (was @${self.username})\n`);
  return 0;
}

main().then((code) => process.exit(code)).catch((e) => { process.stderr.write(`${NAME}: ${e.message}\n`); process.exit(2); });
