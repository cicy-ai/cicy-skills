#!/usr/bin/env node
// gemini-ask — push gemini_ask desktop_event to a connected cicy-desktop client
// (window = win_id, default 4) and await gemini_ask_result over the chat WS.
// Requires Node 22+.

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { randomBytes } from 'node:crypto';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

if (typeof globalThis.WebSocket !== 'function') {
  process.stderr.write('gemini-ask: native WebSocket missing — Node 22+ required\n');
  process.exit(1);
}

const json = argv.includes('--json');
const rest = argv.filter((a) => a !== '--json');

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const HTTP_BASE = `http://127.0.0.1:${API_PORT}`;
const WS_BASE   = `ws://127.0.0.1:${API_PORT}`;
const TIMEOUT_MS = Number(process.env.CICY_AGENT_TIMEOUT_MS || 60000);

(async () => {
  try {
    const prompt = rest[0];
    const winID = rest[1] ? parseInt(rest[1], 10) : 4;
    if (!prompt) bail('Usage: gemini-ask <prompt> [win_id]', 2);

    const result = await rpcGeminiAsk(prompt, winID);
    if (json) console.log(JSON.stringify({ ok: true, data: { result, win_id: winID } }));
    else process.stdout.write(String(result) + '\n');
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`gemini-ask: ${msg}\n`);
  process.exit(code);
}

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: gemini-ask <prompt> [win_id]\n'); }
}

function loadToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON}`), { exitCode: 3 });
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

function currentAgentID() {
  if (process.env.CICY_PANE_ID) return process.env.CICY_PANE_ID;
  const m = /(w-\d+)/.exec(process.cwd());
  return m ? m[1] : 'w-1001';
}

function randomID(prefix) { return `${prefix}-${Date.now()}-${randomBytes(4).toString('hex')}`; }

async function api(method, path, payload) {
  const token = loadToken();
  const headers = { 'Authorization': `Bearer ${token}` };
  const init = { method, headers };
  if (payload !== undefined) { headers['Content-Type'] = 'application/json'; init.body = JSON.stringify(payload); }
  let res;
  try { res = await fetch(HTTP_BASE + path, init); }
  catch (e) { throw Object.assign(new Error(`cannot reach cicy-code at ${HTTP_BASE} (${e.message})`), { exitCode: 3 }); }
  const text = await res.text();
  if (res.status === 401 || res.status === 403) throw Object.assign(new Error(`auth failed (${res.status})`), { exitCode: 3 });
  if (res.status >= 400) throw Object.assign(new Error(`api error (${res.status}): ${text.slice(0, 200)}`), { exitCode: 4 });
  try { return JSON.parse(text); } catch { return text; }
}

async function rpcGeminiAsk(prompt, winID) {
  const agentID = currentAgentID();
  const token = loadToken();
  const url = `${WS_BASE}/api/chat/ws?agent_id=${encodeURIComponent(agentID)}&token=${encodeURIComponent(token)}`;
  const ws = new WebSocket(url);
  const opened = new Promise((res, rej) => {
    ws.addEventListener('open', () => res());
    ws.addEventListener('error', (e) => rej(Object.assign(new Error(`websocket error: ${e.message || e.type}`), { exitCode: 4 })));
  });
  const rid = randomID('gemini');
  const matched = new Promise((resolve, reject) => {
    const timer = setTimeout(() => { try { ws.close(); } catch {} reject(Object.assign(new Error('timeout waiting for gemini_ask_result'), { exitCode: 4 })); }, TIMEOUT_MS);
    ws.addEventListener('message', (ev) => {
      let msg;
      try { msg = JSON.parse(typeof ev.data === 'string' ? ev.data : ev.data.toString()); } catch { return; }
      if (msg?.type === 'gemini_ask_result' && msg?.data?.requestId === rid) {
        clearTimeout(timer);
        try { ws.close(); } catch {}
        if (msg.data.error) reject(Object.assign(new Error(msg.data.error), { exitCode: 4 }));
        else resolve(msg.data.result);
      }
    });
  });
  await opened;
  await api('POST', '/api/chat/push', {
    agent_id: agentID,
    type: 'desktop_event',
    data: { type: 'gemini_ask', prompt, win_id: winID, requestId: rid },
  });
  return await matched;
}
