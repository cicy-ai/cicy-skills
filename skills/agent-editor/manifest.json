{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "agent-editor",
  "version": "2.0.3",
  "title": "Agent Editor",
  "description": "Open files in the page-bound native editor on this host. Bridges to the live :code-ext extension via cicy-code's chat push channel.",
  "category": "dev",
  "tags": [
    "editor",
    "files",
    "agent-bridge",
    "rpc"
  ],
  "author": "cicy-ai",
  "homepage": "https://github.com/cicy-ai/cicy-skills/tree/main/skills/agent-editor",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": [],
  "npm_dependencies": false,
  "entry": "bin/agent-editor",
  "bin_aliases": [
    "agent-code-server"
  ],
  "permissions": [
    "network",
    "filesystem:home"
  ],
  "compatible_agents": [
    "*"
  ],
  "config": {
    "path": "~/cicy-ai/global.json",
    "secret_fields": [
      "api_token"
    ]
  },
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md",
    "help_en_md": "references/help.en.md",
    "help_cn_md": "references/help.cn.md",
    "tools_en_md": "references/tools.en.md",
    "tools_cn_md": "references/tools.cn.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "Agent Editor",
      "description": "通过 cicy-code 聊天推送通道向页面绑定的 :code-ext 扩展发送打开文件等指令。"
    }
  },
  "tools": [
    {
      "name": "open",
      "example": "agent-editor open /path/to/file",
      "description": "Open a file in the editor"
    },
    {
      "name": "ping",
      "example": "agent-editor ping",
      "description": "Check if the editor extension is alive"
    }
  ]
}
