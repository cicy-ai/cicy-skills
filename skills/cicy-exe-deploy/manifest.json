  "author": "cicy-ai",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": ["ssh", "scp"],
  "npm_dependencies": false,
  "entry": "bin/cicy-exe-deploy",
  "permissions": ["network", "filesystem:home"],
  "compatible_agents": [
    "*"
  ],
