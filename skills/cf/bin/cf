#!/usr/bin/env node
// cf — Cloudflare API wrapper. Subcommands: config / status / curl / exec.
// Zero npm dependencies. Pure ESM. Node 18+.

import { readFileSync, writeFileSync, existsSync, statSync, chmodSync, mkdirSync } from 'node:fs';
import { homedir } from 'node:os';
import { join, dirname } from 'node:path';
import { spawn } from 'node:child_process';

const CONFIG_PATH = process.env.CICY_CF_CONFIG || join(homedir(), 'cicy-ai', 'db', 'cf.json');
const CF_API = 'https://api.cloudflare.com/client/v4';

const argv = process.argv.slice(2);

// short-circuit help BEFORE we open any file
if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const cmd = argv[0];

try {
  switch (cmd) {
    case 'config':  await cmdConfig();  break;
    case 'status':  await cmdStatus();  break;
    case 'curl':    await cmdCurl(argv.slice(1));  break;
    case 'exec':    await cmdExec(argv.slice(1));  break;
    default:
      bail(`unknown command: ${cmd}. Try cf --help.`, 2);
  }
} catch (e) {
  bail(e.message, e.exitCode || 1);
}

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  process.stderr.write(`cf: ${msg}\n`);
  process.exit(code);
}

function printHelp() {
  try {
    process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8'));
  } catch {
    process.stdout.write(`Usage:
  cf config                    Open ~/cicy-ai/db/cf.json in $EDITOR
  cf status                    Show config state (api_token masked)
  cf curl <METHOD> <PATH> [body]  Call Cloudflare API — token injected
  cf exec <command> [args...]  Run a command with CLOUDFLARE_API_TOKEN+ACCOUNT_ID env injected
`);
  }
}

function readConfig() {
  if (!existsSync(CONFIG_PATH)) {
    const e = new Error(`config missing: ${CONFIG_PATH} — run 'cf config'`);
    e.exitCode = 3;
    throw e;
  }
  let content;
  try {
    content = readFileSync(CONFIG_PATH, 'utf8');
  } catch (e) {
    const err = new Error(`read ${CONFIG_PATH}: ${e.message}`);
    err.exitCode = 5;
    throw err;
  }
  let cfg;
  try {
    cfg = JSON.parse(content);
  } catch (e) {
    const err = new Error(`parse ${CONFIG_PATH}: ${e.message}`);
    err.exitCode = 1;
    throw err;
  }
  if (!cfg.api_token || cfg.api_token.startsWith('<paste')) {
    const err = new Error(`api_token missing or placeholder in ${CONFIG_PATH} — run 'cf config'`);
    err.exitCode = 3;
    throw err;
  }
  return cfg;
}

function writePlaceholder() {
  mkdirSync(dirname(CONFIG_PATH), { recursive: true, mode: 0o700 });
  const tmpl = {
    api_token:  '<paste-your-cloudflare-api-token-here>',
    account_id: '<paste-your-cloudflare-account-id-here>',
  };
  writeFileSync(CONFIG_PATH, JSON.stringify(tmpl, null, 2) + '\n', { mode: 0o600 });
  try { chmodSync(CONFIG_PATH, 0o600); } catch {}
}

function maskToken(t) {
  if (!t) return '';
  if (t.length <= 8) return '***';
  return t.slice(0, 4) + '***' + t.slice(-4);
}

// ── config ──────────────────────────────────────────────────────────────

async function cmdConfig() {
  if (!existsSync(CONFIG_PATH)) {
    writePlaceholder();
    console.log(`created placeholder: ${CONFIG_PATH}`);
  }
  const editor = process.env.EDITOR || process.env.VISUAL || 'nano';
  console.log(`opening ${CONFIG_PATH} in ${editor} ...`);
  await runChild(editor, [CONFIG_PATH]);
}

// ── status ──────────────────────────────────────────────────────────────

async function cmdStatus() {
  const status = {
    config_path: CONFIG_PATH,
    exists: existsSync(CONFIG_PATH),
    permissions: null,
    api_token_set: false,
    account_id_set: false,
    api_token_masked: '',
  };
  if (status.exists) {
    try {
      const m = statSync(CONFIG_PATH).mode & 0o777;
      status.permissions = '0' + m.toString(8);
    } catch {}
    try {
      const cfg = JSON.parse(readFileSync(CONFIG_PATH, 'utf8'));
      const isPlaceholder = (v) => typeof v === 'string' && v.startsWith('<paste');
      status.api_token_set = !!(cfg.api_token && !isPlaceholder(cfg.api_token));
      status.account_id_set = !!(cfg.account_id && !isPlaceholder(cfg.account_id));
      if (status.api_token_set) status.api_token_masked = maskToken(cfg.api_token);
    } catch (e) {
      status.error = e.message;
    }
  }
  if (argv.includes('--json')) {
    console.log(JSON.stringify({ ok: true, data: status }));
  } else {
    console.log(`config:      ${status.config_path}`);
    console.log(`exists:      ${status.exists}`);
    console.log(`permissions: ${status.permissions || '(n/a)'}`);
    console.log(`api_token:   ${status.api_token_set ? status.api_token_masked : '(missing)'}`);
    console.log(`account_id:  ${status.account_id_set ? 'set' : '(missing)'}`);
    if (status.error) console.log(`error:       ${status.error}`);
  }
}

// ── curl ────────────────────────────────────────────────────────────────

async function cmdCurl(args) {
  if (args.length < 2) bail('usage: cf curl <METHOD> <PATH> [body]', 2);
  const method = args[0].toUpperCase();
  let path = args[1];
  if (!path.startsWith('/')) path = '/' + path;
  const body = args[2];

  const cfg = readConfig();
  const url = CF_API + path;

  const headers = {
    'Authorization': `Bearer ${cfg.api_token}`,
    'Content-Type': 'application/json',
  };

  let init = { method, headers };
  if (body !== undefined && body !== '') {
    init.body = body;
  }

  const res = await fetch(url, init);
  const text = await res.text();
  // Print raw response body so jq/tools can pipe it.
  process.stdout.write(text);
  if (!text.endsWith('\n')) process.stdout.write('\n');
  if (!res.ok) {
    process.exit(4);
  }
}

// ── exec ────────────────────────────────────────────────────────────────

async function cmdExec(args) {
  if (args.length === 0) bail('usage: cf exec <command> [args...]', 2);
  const cfg = readConfig();
  const env = {
    ...process.env,
    CLOUDFLARE_API_TOKEN: cfg.api_token,
  };
  if (cfg.account_id && !env.CLOUDFLARE_ACCOUNT_ID) {
    env.CLOUDFLARE_ACCOUNT_ID = cfg.account_id;
  }
  await runChild(args[0], args.slice(1), { env });
}

// ── runChild ─────────────────────────────────────────────────────────────

function runChild(cmd, args, opts = {}) {
  return new Promise((resolve, reject) => {
    const child = spawn(cmd, args, { stdio: 'inherit', ...opts });
    child.on('error', (e) => reject(new Error(`spawn ${cmd}: ${e.message}`)));
    child.on('exit', (code, signal) => {
      if (signal) reject(new Error(`${cmd} killed by ${signal}`));
      else if (code !== 0) {
        const e = new Error(`${cmd} exited ${code}`);
        e.exitCode = code;
        reject(e);
      } else resolve();
    });
  });
}
