#!/usr/bin/env node
// cicy-keystore — list keys in the cicy-code keystore and run commands with
// secrets injected. Zero npm dependencies. Node 18+. Runs on Linux/macOS/Windows.
//
// Security contract:
//   * Values are entered ONLY in the cicy-code UI (Keystore tab). This tool has
//     no `set`/`get` and never prints a value.
//   * `exec` passes values to the child through its ENVIRONMENT (never argv)
//     and replaces every occurrence of a value in the child's stdout/stderr
//     with *** before it reaches the terminal / conversation.

import { readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { spawn } from 'node:child_process';

const NAME = 'cicy-keystore';
const KEY_RE = /^[A-Za-z_][A-Za-z0-9_]{0,63}$/;
const MASK = '***';
// Values shorter than this are not masked (masking "1" would shred output).
const MIN_MASK_LEN = 3;

function fail(msg, code = 1) {
  process.stderr.write(`${NAME}: ${msg}\n`);
  process.exit(code);
}

function cicyApi() {
  const base = (process.env.CICY_API_BASE || 'http://127.0.0.1:' + (process.env.CICY_API_PORT || '8008')).replace(/\/+$/, '');
  let token = process.env.CICY_API_TOKEN || '';
  if (!token) {
    try { token = JSON.parse(readFileSync(process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json'), 'utf8')).api_token || ''; } catch {}
  }
  if (!token) fail('no cicy-code token (set CICY_API_TOKEN or log in)', 3);
  return { base, headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' } };
}

async function request(method, path, body) {
  const { base, headers } = cicyApi();
  let res;
  try {
    res = await fetch(base + path, { method, headers, body: body === undefined ? undefined : JSON.stringify(body) });
  } catch (e) {
    fail(`cannot reach cicy-code at ${base} — is it running? (${e.message})`, 3);
  }
  const text = await res.text();
  let data = {};
  try { data = text ? JSON.parse(text) : {}; } catch { data = {}; }
  if (res.status === 401 || res.status === 403) fail(`auth failed (HTTP ${res.status})`, 3);
  if (res.status === 404 && path.startsWith('/api/keystore') && !data.detail) {
    fail('this cicy-code has no keystore yet — update cicy-code', 3);
  }
  if (!res.ok) fail(data.detail || `HTTP ${res.status}`, res.status === 404 ? 2 : 1);
  return data;
}

async function listKeys() {
  const data = await request('GET', '/api/keystore');
  // Defence in depth: keep only the public fields even if a server ever sent more.
  return (Array.isArray(data.keys) ? data.keys : []).map((k) => ({
    key: String(k.key || ''),
    note: String(k.note || ''),
    has_value: !!k.has_value,
    updated_at: String(k.updated_at || ''),
  }));
}

// ── output masking ────────────────────────────────────────────────────────
// Streaming replace: complete occurrences are masked, and the last (L-1)
// chars are held back so a value split across two chunks is still caught.
export function makeMasker(secrets) {
  const list = [...new Set(secrets.filter((s) => typeof s === 'string' && s.length >= MIN_MASK_LEN))]
    .sort((a, b) => b.length - a.length);
  const hold = list.length ? list[0].length - 1 : 0;
  let buf = '';
  const maskAll = (s) => {
    for (const v of list) s = s.split(v).join(MASK);
    return s;
  };
  return {
    push(chunk) {
      if (!list.length) return chunk;
      buf = maskAll(buf + chunk);
      if (buf.length <= hold) return '';
      const out = buf.slice(0, buf.length - hold);
      buf = buf.slice(buf.length - hold);
      return out;
    },
    end() {
      const out = maskAll(buf);
      buf = '';
      return out;
    },
  };
}

// ── commands ──────────────────────────────────────────────────────────────

const HELP = `cicy-keystore — keys and notes from the cicy-code keystore

Usage:
  cicy-keystore list [--json]                 list every key, whether it is set, and its note
  cicy-keystore show <KEY> [--json]           one key's note and status (never the value)
  cicy-keystore exec --env <KEY>[:<VAR>] ... -- <command> [args...]
                                              run <command> with each KEY's value in env var
                                              VAR (default VAR = KEY); occurrences of the
                                              values in its output are replaced with ***

Values are set only in the cicy-code UI (Keystore tab). This tool never prints a
value and has no set/get command — do not ask the user to paste secrets in chat.

Exit codes: 0 ok · 1 error · 2 key not found / not set · 3 cicy-code unreachable or auth failed`;

async function cmdList(args) {
  const keys = await listKeys();
  if (args.includes('--json')) {
    process.stdout.write(JSON.stringify({ ok: true, keys }, null, 2) + '\n');
    return;
  }
  if (!keys.length) {
    process.stdout.write('(no keys — the user adds them in the cicy-code UI: Keystore tab)\n');
    return;
  }
  const w = Math.max(3, ...keys.map((k) => k.key.length));
  process.stdout.write(`${'KEY'.padEnd(w)}  SET  NOTE\n`);
  for (const k of keys) {
    const note = k.note.replace(/\s*\n\s*/g, ' / ');
    process.stdout.write(`${k.key.padEnd(w)}  ${k.has_value ? 'yes' : 'no '}  ${note}\n`);
  }
}

async function cmdShow(args) {
  const key = args.find((a) => !a.startsWith('--'));
  if (!key) fail('usage: cicy-keystore show <KEY>');
  const found = (await listKeys()).find((k) => k.key === key);
  if (!found) fail(`key not found: ${key} (see: cicy-keystore list)`, 2);
  if (args.includes('--json')) {
    process.stdout.write(JSON.stringify({ ok: true, ...found }, null, 2) + '\n');
    return;
  }
  process.stdout.write(`key:     ${found.key}\nset:     ${found.has_value ? 'yes' : 'no'}\nupdated: ${found.updated_at || '-'}\nnote:    ${found.note || '-'}\n`);
}

export function parseExecArgs(args) {
  const sep = args.indexOf('--');
  if (sep < 0) throw new Error('usage: cicy-keystore exec --env KEY[:VAR] ... -- <command> [args...]');
  const opts = args.slice(0, sep);
  const command = args.slice(sep + 1);
  if (!command.length) throw new Error('missing <command> after --');
  const mappings = [];
  for (let i = 0; i < opts.length; i++) {
    const a = opts[i];
    let spec;
    if (a === '--env' || a === '-e') spec = opts[++i];
    else if (a.startsWith('--env=')) spec = a.slice(6);
    else throw new Error(`unknown option: ${a}`);
    if (!spec) throw new Error('--env needs KEY or KEY:VAR');
    const [key, envVar = key] = spec.split(':');
    if (!KEY_RE.test(key) || !KEY_RE.test(envVar)) throw new Error(`invalid --env ${spec} (KEY and VAR must be [A-Za-z_][A-Za-z0-9_]*)`);
    mappings.push({ key, envVar });
  }
  if (!mappings.length) throw new Error('exec needs at least one --env KEY');
  return { mappings, command };
}

async function cmdExec(args) {
  let parsed;
  try { parsed = parseExecArgs(args); } catch (e) { fail(e.message); }
  const { mappings, command } = parsed;
  const data = await request('POST', '/api/keystore/resolve', { keys: [...new Set(mappings.map((m) => m.key))] });
  const values = data.values || {};
  const env = { ...process.env };
  for (const { key, envVar } of mappings) {
    if (typeof values[key] !== 'string') fail(`key not set: ${key}`, 2);
    env[envVar] = values[key];
  }
  const secrets = Object.values(values);
  const child = spawn(command[0], command.slice(1), {
    env,
    stdio: ['inherit', 'pipe', 'pipe'],
    shell: process.platform === 'win32', // resolve .cmd/.bat shims (npx, etc.)
  });
  const pipe = (from, to) => {
    const m = makeMasker(secrets);
    from.setEncoding('utf8');
    from.on('data', (chunk) => { const s = m.push(chunk); if (s) to.write(s); });
    from.on('end', () => { const s = m.end(); if (s) to.write(s); });
  };
  pipe(child.stdout, process.stdout);
  pipe(child.stderr, process.stderr);
  child.on('error', (e) => fail(`cannot run ${command[0]}: ${e.message}`));
  child.on('close', (code, signal) => process.exit(signal ? 1 : (code ?? 1)));
}

async function main() {
  const [cmd, ...args] = process.argv.slice(2);
  switch (cmd) {
    case undefined:
    case '-h':
    case '--help':
    case 'help':
      process.stdout.write(HELP + '\n');
      return;
    case 'list':
    case 'ls':
      return cmdList(args);
    case 'show':
      return cmdShow(args);
    case 'exec':
    case 'run':
      return cmdExec(args);
    case 'set':
    case 'add':
    case 'get':
    case 'value':
      fail('values are set and viewed only in the cicy-code UI (Keystore tab). Use `cicy-keystore exec --env KEY -- <command>` to use one.', 1);
      return;
    default:
      fail(`unknown command: ${cmd} (see: cicy-keystore --help)`);
  }
}

// Run only as a program, not when imported by tests.
const invoked = process.argv[1] && (process.argv[1].endsWith('cicy-keystore') || process.argv[1].endsWith('cicy-keystore.js'));
if (invoked) main();
