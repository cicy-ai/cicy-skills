#!/usr/bin/env node
// tg — send a Telegram message or photo via cicy-code.
// Subcommands: send <message> / photo <url> [caption]

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const json = argv.includes('--json');
const cmd = argv[0];
const rest = argv.slice(1).filter((a) => a !== '--json');

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const API_BASE = `http://127.0.0.1:${API_PORT}`;

(async () => {
  try {
    switch (cmd) {
      case 'send':  await cmdSend(rest);  break;
      case 'photo': await cmdPhoto(rest); break;
      default: bail(`unknown command: ${cmd}. Try tg --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`tg: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: tg send <message>\n  tg photo <url> [caption]\n'); }
}

function loadToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON}`), { exitCode: 3 });
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

async function api(method, path, payload) {
  const token = loadToken();
  const headers = { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' };
  let res;
  try { res = await fetch(API_BASE + path, { method, headers, body: JSON.stringify(payload) }); }
  catch (e) { throw Object.assign(new Error(`cannot reach cicy-code at ${API_BASE} (${e.message})`), { exitCode: 3 }); }
  const text = await res.text();
  if (res.status === 401 || res.status === 403) throw Object.assign(new Error(`auth failed (${res.status})`), { exitCode: 3 });
  if (res.status >= 400) throw Object.assign(new Error(`api error (${res.status}): ${text.slice(0, 200)}`), { exitCode: 4 });
  let parsed; try { parsed = JSON.parse(text); } catch { parsed = null; }
  return parsed ?? text;
}

function reportTelegramResult(result) {
  if (json) return ok(result);
  if (result?.ok) console.log('✓ Sent.');
  else console.log(`✗ ${result?.description || JSON.stringify(result)}`);
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdSend(args) {
  if (args.length < 1) bail('Usage: tg send <message>', 2);
  const text = args.join(' ');
  reportTelegramResult(await api('POST', '/api/tg/send', { text }));
}

async function cmdPhoto(args) {
  if (args.length < 1) bail('Usage: tg photo <url> [caption]', 2);
  const photo = args[0];
  const caption = args.slice(1).join(' ');
  reportTelegramResult(await api('POST', '/api/tg/photo', { photo, caption }));
}
