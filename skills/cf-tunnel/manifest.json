{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "cf-tunnel",
  "version": "1.0.3",
  "title": "Cloudflare Tunnel",
  "description": "Manage Cloudflare Tunnel routes and DNS records on this host. Subcommands: config / status / list / add / del.",
  "category": "cloud",
  "tags": [
    "cloudflare",
    "tunnel",
    "dns"
  ],
  "author": "cicy-ai",
  "homepage": "https://github.com/cicy-ai/cicy-skills/tree/main/skills/cf-tunnel",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": [],
  "npm_dependencies": false,
  "entry": "bin/cf-tunnel",
  "config": {
    "path": "~/cicy-ai/db/cf.json",
    "permissions": "0600",
    "secret_fields": [
      "api_token",
      "account_id",
      "tunnel_id",
      "zone_id"
    ]
  },
  "permissions": [
    "network",
    "filesystem:db"
  ],
  "compatible_agents": [
    "*"
  ],
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "Cloudflare Tunnel",
      "description": "管理本机的 Cloudflare Tunnel 路由和 DNS 记录。子命令：config / status / list / add / del。"
    }
  },
  "tools": [
    {
      "name": "cf-tunnel config",
      "example": "cf-tunnel config",
      "description": "Show current tunnel configuration"
    },
    {
      "name": "cf-tunnel status",
      "example": "cf-tunnel status",
      "description": "Check tunnel daemon status"
    },
    {
      "name": "cf-tunnel list",
      "example": "cf-tunnel list",
      "description": "List all tunnel routes and DNS records"
    },
    {
      "name": "cf-tunnel add",
      "example": "cf-tunnel add 8080 myapp.example.com",
      "description": "Add a new tunnel route with DNS record"
    },
    {
      "name": "cf-tunnel del",
      "example": "cf-tunnel del myapp.example.com",
      "description": "Remove a tunnel route and DNS record"
    }
  ]
}
