#!/usr/bin/env node
// cf-tunnel — manage Cloudflare NAMED tunnels, their routes and DNS records.
// Subcommands: config / status / tunnels / sync / create / rm / list / add / del.
//
// Named-tunnel registry (the source of truth this tool maintains):
//   ~/cicy-ai/db/cf-tunnel.json
//   { "<env>": { api_token, account_id, domain, zone_id,
//                tunnels: { "<name>": { id, token, hostnames: [{hostname, service}] } } } }
// One tunnel = one connector token; its hostnames list is the domains served
// through it. `sync` regenerates the tunnels section from the CF API; `create`
// provisions a new named tunnel (tunnel + ingress + DNS + token) and appends it.
//
// Zero npm dependencies. Pure ESM. Node 18+.

import { readFileSync, writeFileSync, existsSync, statSync, chmodSync, mkdirSync } from 'node:fs';
import { homedir } from 'node:os';
import { join, dirname } from 'node:path';
import { spawn } from 'node:child_process';

const REGISTRY_PATH = join(homedir(), 'cicy-ai', 'db', 'cf-tunnel.json');
const LEGACY_CF_JSON = join(homedir(), 'cicy-ai', 'db', 'cf.json');
// Config default is the registry itself; cf.json is a read-only credential fallback.
const CONFIG_PATH = process.env.CICY_CF_CONFIG ||
  (existsSync(REGISTRY_PATH) || !existsSync(LEGACY_CF_JSON) ? REGISTRY_PATH : LEGACY_CF_JSON);
const CF_API = 'https://api.cloudflare.com/client/v4';
const ENV = process.env.CF_ENV || 'prod';
const ACCOUNT = process.env.CF_ACCOUNT || '';
const CORE_FIELDS = ['api_token', 'account_id', 'domain', 'zone_id'];
const REQUIRED_FIELDS = [...CORE_FIELDS, 'tunnel_id']; // legacy add/del/list only

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const cmd = argv[0];

try {
  switch (cmd) {
    case 'config':  await cmdConfig(); break;
    case 'status':  await cmdStatus(); break;
    case 'tunnels': await cmdTunnels(); break;
    case 'sync':    await cmdSync(); break;
    case 'create':  await cmdCreate(argv.slice(1)); break;
    case 'rm':      await cmdRm(argv.slice(1)); break;
    case 'list':    await cmdList(); break;
    case 'add':     await cmdAdd(argv.slice(1)); break;
    case 'del':     await cmdDel(argv.slice(1)); break;
    default: bail(`unknown command: ${cmd}. Try cf-tunnel --help.`, 2);
  }
} catch (e) {
  bail(e.message, e.exitCode || 1);
}

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  process.stderr.write(`cf-tunnel: ${msg}\n`);
  process.exit(code);
}

function printHelp() {
  try {
    process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8'));
  } catch {
    process.stdout.write(`Usage:
  cf-tunnel config
  cf-tunnel status [--json]
  cf-tunnel list [--json]
  cf-tunnel add <port> [<port> ...]
  cf-tunnel del <port> [<port> ...]
  CF_ENV=dev cf-tunnel ...
`);
  }
}

function readEnvCfg(fields = CORE_FIELDS) {
  if (!existsSync(CONFIG_PATH)) {
    throw Object.assign(new Error(`config missing: ${CONFIG_PATH} — run 'cf-tunnel config'`), { exitCode: 3 });
  }
  let raw;
  try {
    raw = JSON.parse(readFileSync(CONFIG_PATH, 'utf8'));
  } catch (e) {
    throw Object.assign(new Error(`parse ${CONFIG_PATH}: ${e.message}`), { exitCode: 1 });
  }
  // Accept v2 {default,accounts:{name:{...}}}, nested {prod:{...}}, or the
  // legacy flat {api_token,...} form.
  let block;
  if (raw.accounts && typeof raw.accounts === 'object') {
    const accountName = ACCOUNT || raw.default;
    block = raw.accounts[accountName];
    if (!block || typeof block !== 'object') {
      throw Object.assign(new Error(`config has no account '${accountName || '(default)'}'`), { exitCode: 3 });
    }
  } else if (raw[ENV] && typeof raw[ENV] === 'object') {
    block = raw[ENV];
  } else if (ENV === 'prod' && raw.api_token) {
    // flat form (cf skill) — synthesize a prod block from top-level fields
    block = raw;
  } else {
    throw Object.assign(new Error(`config has no '${ENV}' block`), { exitCode: 3 });
  }
  for (const f of fields) {
    const v = block[f];
    if (!v || (typeof v === 'string' && v.startsWith('<paste'))) {
      throw Object.assign(
        new Error(`${ENV}.${f} missing or placeholder in ${CONFIG_PATH}`),
        { exitCode: 3 },
      );
    }
  }
  return block;
}

// ── registry (~/cicy-ai/db/cf-tunnel.json) ─────────────────────────────
// Writes always target the registry file, whatever CONFIG_PATH resolved to.
// Shape per env: { ...credentials, tunnels: { <name>: {id, token, hostnames} } }

function writeRegistryTunnels(cfg, tunnels, { merge = false } = {}) {
  let raw = {};
  if (existsSync(REGISTRY_PATH)) {
    try { raw = JSON.parse(readFileSync(REGISTRY_PATH, 'utf8')); } catch { raw = {}; }
  }
  if (!raw[ENV] || typeof raw[ENV] !== 'object') raw[ENV] = {};
  // seed credentials so the registry is self-contained even when they came from cf.json
  for (const f of CORE_FIELDS) {
    if (raw[ENV][f] === undefined && cfg[f] !== undefined) raw[ENV][f] = cfg[f];
  }
  raw[ENV].tunnels = merge ? { ...(raw[ENV].tunnels || {}), ...tunnels } : tunnels;
  mkdirSync(dirname(REGISTRY_PATH), { recursive: true, mode: 0o700 });
  writeFileSync(REGISTRY_PATH, JSON.stringify(raw, null, 2) + '\n', { mode: 0o600 });
  try { chmodSync(REGISTRY_PATH, 0o600); } catch {}
}

// Fetch all live named tunnels with their hostnames (from ingress config).
async function fetchTunnels(cfg, { withToken = false } = {}) {
  const listPayload = await cfFetch(
    `/accounts/${cfg.account_id}/cfd_tunnel?is_deleted=false&per_page=100`, {}, cfg,
  );
  const out = [];
  for (const t of listPayload.result || []) {
    const entry = { name: t.name, id: t.id, status: t.status, hostnames: [] };
    try {
      const c = await cfFetch(`/accounts/${cfg.account_id}/cfd_tunnel/${t.id}/configurations`, {}, cfg);
      for (const r of c.result?.config?.ingress || []) {
        if (r.hostname) entry.hostnames.push({ hostname: r.hostname, service: r.service });
      }
    } catch { /* locally-managed tunnel: no remote config */ }
    if (withToken) {
      try {
        const tok = await cfFetch(`/accounts/${cfg.account_id}/cfd_tunnel/${t.id}/token`, {}, cfg);
        entry.token = tok.result;
      } catch { entry.token = null; }
    }
    out.push(entry);
  }
  return out;
}

function ensurePlaceholderConfig() {
  if (existsSync(CONFIG_PATH)) {
    // merge: keep existing, ensure prod block has all fields
    let raw;
    try {
      raw = JSON.parse(readFileSync(CONFIG_PATH, 'utf8'));
    } catch {
      raw = {};
    }
    if (!raw.prod || typeof raw.prod !== 'object') {
      // promote flat form to nested if needed
      if (raw.api_token) {
        raw = { prod: { ...raw } };
      } else {
        raw.prod = {};
      }
    }
    for (const f of CORE_FIELDS) {
      if (raw.prod[f] === undefined) raw.prod[f] = `<paste-your-${f.replace(/_/g, '-')}-here>`;
    }
    writeFileSync(CONFIG_PATH, JSON.stringify(raw, null, 2) + '\n', { mode: 0o600 });
    try { chmodSync(CONFIG_PATH, 0o600); } catch {}
    return false; // not fresh
  }
  mkdirSync(dirname(CONFIG_PATH), { recursive: true, mode: 0o700 });
  const tmpl = {
    prod: Object.fromEntries(CORE_FIELDS.map((f) => [f, `<paste-your-${f.replace(/_/g, '-')}-here>`])),
  };
  writeFileSync(CONFIG_PATH, JSON.stringify(tmpl, null, 2) + '\n', { mode: 0o600 });
  try { chmodSync(CONFIG_PATH, 0o600); } catch {}
  return true; // fresh
}

function maskToken(t) {
  if (!t) return '';
  if (t.length <= 8) return '***';
  return t.slice(0, 4) + '***' + t.slice(-4);
}

async function cfFetch(path, init = {}, cfg) {
  const url = CF_API + path;
  const headers = {
    'Authorization': `Bearer ${cfg.api_token}`,
    'Content-Type': 'application/json',
    ...(init.headers || {}),
  };
  const res = await fetch(url, { ...init, headers });
  const text = await res.text();
  let payload;
  try { payload = JSON.parse(text); } catch { payload = { raw: text }; }
  if (!res.ok || payload.success === false) {
    const errMsg = payload.errors?.map((e) => e.message).join('; ') || res.statusText || 'unknown';
    throw Object.assign(new Error(`CF API ${init.method || 'GET'} ${path}: ${errMsg}`), { exitCode: 4, response: payload });
  }
  return payload;
}

// ── config ──────────────────────────────────────────────────────────────

async function cmdConfig() {
  const fresh = ensurePlaceholderConfig();
  console.log(fresh ? `created placeholder: ${CONFIG_PATH}` : `ensured prod block in: ${CONFIG_PATH}`);
  const editor = process.env.EDITOR || process.env.VISUAL || 'nano';
  console.log(`opening ${CONFIG_PATH} in ${editor} ...`);
  await runChild(editor, [CONFIG_PATH]);
}

// ── status ──────────────────────────────────────────────────────────────

async function cmdStatus() {
  const out = {
    env: ENV,
    config_path: CONFIG_PATH,
    exists: existsSync(CONFIG_PATH),
    permissions: null,
    fields: {},
    api_token_masked: '',
  };
  if (out.exists) {
    try {
      const m = statSync(CONFIG_PATH).mode & 0o777;
      out.permissions = '0' + m.toString(8);
    } catch {}
    try {
      const raw = JSON.parse(readFileSync(CONFIG_PATH, 'utf8'));
      const accountName = ACCOUNT || raw.default;
      const block = (raw.accounts && typeof raw.accounts === 'object') ? raw.accounts[accountName] :
                    (raw[ENV] && typeof raw[ENV] === 'object') ? raw[ENV] :
                    (ENV === 'prod' && raw.api_token) ? raw : null;
      if (block) {
        for (const f of CORE_FIELDS) {
          const v = block[f];
          out.fields[f] = !!(v && !(typeof v === 'string' && v.startsWith('<paste')));
        }
        out.tunnels = Object.keys(block.tunnels || {});
        if (out.fields.api_token) out.api_token_masked = maskToken(block.api_token);
      } else {
        out.error = `no '${ENV}' block`;
      }
    } catch (e) {
      out.error = e.message;
    }
  }
  if (argv.includes('--json')) {
    console.log(JSON.stringify({ ok: true, data: out }));
  } else {
    console.log(`env:          ${out.env}`);
    console.log(`config:       ${out.config_path}`);
    console.log(`exists:       ${out.exists}`);
    console.log(`permissions:  ${out.permissions || '(n/a)'}`);
    for (const f of CORE_FIELDS) {
      const masked = f === 'api_token' && out.api_token_masked ? `  [${out.api_token_masked}]` : '';
      console.log(`${(f + ':').padEnd(14)}${out.fields[f] ? '✓' : '(missing)'}${masked}`);
    }
    if (out.tunnels) console.log(`tunnels:      ${out.tunnels.length ? out.tunnels.join(', ') : '(none — run cf-tunnel sync)'}`);
    if (out.error) console.log(`error:        ${out.error}`);
  }
}

// ── tunnels (tree view) ────────────────────────────────────────────────

async function cmdTunnels() {
  const cfg = readEnvCfg();
  const tunnels = await fetchTunnels(cfg);
  if (argv.includes('--json')) {
    console.log(JSON.stringify({ ok: true, data: { env: ENV, tunnels } }));
    return;
  }
  if (tunnels.length === 0) { console.log('(no tunnels)'); return; }
  for (const t of tunnels) {
    const mark = t.status === 'healthy' ? '✓' : '✗';
    console.log(`${mark} ${t.name}  (${t.status}, ${t.id.slice(0, 8)}…)`);
    for (const h of t.hostnames) console.log(`    ${h.hostname} → ${h.service}`);
    if (t.hostnames.length === 0) console.log('    (no hostnames)');
  }
}

// ── sync (regenerate registry tunnels from the CF API) ────────────────

async function cmdSync() {
  const cfg = readEnvCfg();
  const tunnels = await fetchTunnels(cfg, { withToken: true });
  const reg = {};
  for (const t of tunnels) {
    reg[t.name] = { id: t.id, token: t.token, hostnames: t.hostnames };
  }
  writeRegistryTunnels(cfg, reg);
  if (argv.includes('--json')) {
    console.log(JSON.stringify({
      ok: true,
      data: { env: ENV, path: REGISTRY_PATH, tunnels: tunnels.map((t) => ({ name: t.name, id: t.id, status: t.status, hostnames: t.hostnames, token_masked: maskToken(t.token || '') })) },
    }));
    return;
  }
  console.log(`synced ${tunnels.length} tunnel(s) → ${REGISTRY_PATH} (${ENV}.tunnels)`);
  for (const t of tunnels) {
    console.log(`  ${t.name}: token=${maskToken(t.token || '')}, ${t.hostnames.length} hostname(s)`);
  }
}

// ── create (provision a named tunnel end-to-end) ───────────────────────
// tunnel (create or reuse by name) → ingress rule → DNS CNAME → connector
// token → registry entry {id, token, hostnames}.

async function cmdCreate(args) {
  const pos = args.filter((a) => !a.startsWith('--'));
  const name = pos[0];
  if (!name) bail('usage: cf-tunnel create <name> [--host <hostname>] [--service <url>|--port <n>]', 2);
  const cfg = readEnvCfg();

  const hostname = flagValue(args, '--host') || flagValue(args, '--hostname') || `${name}.${cfg.domain}`;
  const port = flagValue(args, '--port');
  const service = flagValue(args, '--service') || (port ? `http://localhost:${port}` : 'http://localhost:8008');
  if (!hostname.endsWith('.' + cfg.domain) && hostname !== cfg.domain) {
    bail(`hostname ${hostname} is outside ${cfg.domain} (zone_id would not match)`, 2);
  }

  // 1. find or create the tunnel
  const found = await cfFetch(
    `/accounts/${cfg.account_id}/cfd_tunnel?is_deleted=false&name=${encodeURIComponent(name)}`, {}, cfg,
  );
  let tunnel = (found.result || []).find((t) => t.name === name);
  let created = false;
  if (!tunnel) {
    const mk = await cfFetch(`/accounts/${cfg.account_id}/cfd_tunnel`, {
      method: 'POST',
      body: JSON.stringify({ name, config_src: 'cloudflare' }),
    }, cfg);
    tunnel = mk.result;
    created = true;
  }

  // 2. ingress: keep existing rules, upsert this hostname, keep catch-all last
  let config = {};
  try {
    const c = await cfFetch(`/accounts/${cfg.account_id}/cfd_tunnel/${tunnel.id}/configurations`, {}, cfg);
    config = c.result?.config || {};
  } catch { config = {}; }
  const rules = (config.ingress || []).filter((r) => r.hostname && r.hostname !== hostname);
  rules.push({ hostname, service });
  const fallback = (config.ingress || []).find((r) => !r.hostname) || { service: 'http_status:404' };
  await cfFetch(`/accounts/${cfg.account_id}/cfd_tunnel/${tunnel.id}/configurations`, {
    method: 'PUT',
    body: JSON.stringify({ config: { ...config, ingress: [...rules, fallback] } }),
  }, cfg);

  // 3. DNS CNAME (proxied) → <id>.cfargotunnel.com
  const cnameTarget = `${tunnel.id}.cfargotunnel.com`;
  const dns = await cfFetch(`/zones/${cfg.zone_id}/dns_records?type=CNAME&per_page=200`, {}, cfg);
  const cur = (dns.result || []).find((r) => r.name === hostname);
  let dnsState;
  if (cur) {
    if (cur.content !== cnameTarget || !cur.proxied) {
      await cfFetch(`/zones/${cfg.zone_id}/dns_records/${cur.id}`, {
        method: 'PATCH',
        body: JSON.stringify({ type: 'CNAME', name: hostname, content: cnameTarget, proxied: true }),
      }, cfg);
      dnsState = 'updated';
    } else dnsState = 'already';
  } else {
    await cfFetch(`/zones/${cfg.zone_id}/dns_records`, {
      method: 'POST',
      body: JSON.stringify({ type: 'CNAME', name: hostname, content: cnameTarget, proxied: true, ttl: 1 }),
    }, cfg);
    dnsState = 'created';
  }

  // 4. connector token + registry entry (merge: keep other tunnels)
  const tok = await cfFetch(`/accounts/${cfg.account_id}/cfd_tunnel/${tunnel.id}/token`, {}, cfg);
  const hostnames = [...rules.filter((r) => r.hostname !== hostname).map((r) => ({ hostname: r.hostname, service: r.service })), { hostname, service }];
  writeRegistryTunnels(cfg, { [name]: { id: tunnel.id, token: tok.result, hostnames } }, { merge: true });

  if (argv.includes('--json')) {
    console.log(JSON.stringify({
      ok: true,
      data: { env: ENV, name, id: tunnel.id, created, hostname, service, dns: dnsState, token_masked: maskToken(tok.result), registry: REGISTRY_PATH },
    }));
    return;
  }
  console.log(`✓ tunnel ${name} ${created ? 'created' : 'reused'} (${tunnel.id.slice(0, 8)}…)`);
  console.log(`✓ ${hostname} → ${service}  (dns: ${dnsState})`);
  console.log(`✓ token saved to ${REGISTRY_PATH} (${ENV}.tunnels.${name}, masked: ${maskToken(tok.result)})`);
  console.log(`run the connector:  cloudflared tunnel run --token <token from registry>`);
}

// ── rm (delete a named tunnel + its DNS + registry entry) ──────────────

async function cmdRm(args) {
  const name = args.filter((a) => !a.startsWith('--'))[0];
  if (!name) bail('usage: cf-tunnel rm <name>', 2);
  const cfg = readEnvCfg();
  const found = await cfFetch(
    `/accounts/${cfg.account_id}/cfd_tunnel?is_deleted=false&name=${encodeURIComponent(name)}`, {}, cfg,
  );
  const tunnel = (found.result || []).find((t) => t.name === name);
  if (!tunnel) bail(`no tunnel named '${name}'`, 3);

  // DNS records pointing at it
  const cnameTarget = `${tunnel.id}.cfargotunnel.com`;
  const dns = await cfFetch(`/zones/${cfg.zone_id}/dns_records?type=CNAME&per_page=200`, {}, cfg);
  const mine = (dns.result || []).filter((r) => r.content === cnameTarget);
  for (const r of mine) {
    await cfFetch(`/zones/${cfg.zone_id}/dns_records/${r.id}`, { method: 'DELETE' }, cfg);
  }
  await cfFetch(`/accounts/${cfg.account_id}/cfd_tunnel/${tunnel.id}?cascade=true`, { method: 'DELETE' }, cfg);

  // drop from registry
  if (existsSync(REGISTRY_PATH)) {
    try {
      const raw = JSON.parse(readFileSync(REGISTRY_PATH, 'utf8'));
      if (raw[ENV]?.tunnels?.[name]) {
        delete raw[ENV].tunnels[name];
        writeFileSync(REGISTRY_PATH, JSON.stringify(raw, null, 2) + '\n', { mode: 0o600 });
      }
    } catch { /* registry unreadable — CF side already cleaned */ }
  }

  if (argv.includes('--json')) {
    console.log(JSON.stringify({ ok: true, data: { env: ENV, name, id: tunnel.id, dns_deleted: mine.map((r) => r.name) } }));
  } else {
    console.log(`✗ tunnel ${name} deleted (${tunnel.id.slice(0, 8)}…), dns removed: ${mine.map((r) => r.name).join(', ') || '(none)'}`);
  }
}

function flagValue(args, flag) {
  const i = args.indexOf(flag);
  if (i >= 0 && i + 1 < args.length) return args[i + 1];
  const pref = args.find((a) => a.startsWith(flag + '='));
  return pref ? pref.slice(flag.length + 1) : undefined;
}

// ── list ────────────────────────────────────────────────────────────────

async function cmdList() {
  const cfg = readEnvCfg(REQUIRED_FIELDS);
  const json = argv.includes('--json');

  // Get tunnel ingress config
  const cfgPayload = await cfFetch(
    `/accounts/${cfg.account_id}/cfd_tunnel/${cfg.tunnel_id}/configurations`,
    {}, cfg,
  );
  const ingress = cfgPayload.result?.config?.ingress || [];

  // DNS CNAMEs pointing at this tunnel
  const dnsPayload = await cfFetch(
    `/zones/${cfg.zone_id}/dns_records?per_page=200`,
    {}, cfg,
  );
  const cnameTarget = `${cfg.tunnel_id}.cfargotunnel.com`;
  const records = (dnsPayload.result || []).filter(
    (r) => r.type === 'CNAME' && r.content === cnameTarget,
  );

  // every hostname route on the tunnel (no naming convention)
  const routes = ingress
    .filter((r) => r.hostname)
    .map((r) => {
      const m = (r.service || '').match(/:(\d+)$/);
      return { port: m ? parseInt(m[1], 10) : null, hostname: r.hostname, service: r.service };
    })
    .sort((a, b) => a.hostname.localeCompare(b.hostname));

  if (json) {
    console.log(JSON.stringify({ ok: true, data: { env: ENV, domain: cfg.domain, routes, dns_count: records.length } }));
    return;
  }
  if (routes.length === 0) {
    console.log(`(no routes on tunnel ${cfg.tunnel_id.slice(0, 8)}…)`);
    return;
  }
  console.log(`HOSTNAME${' '.repeat(40 - 'HOSTNAME'.length)}SERVICE`);
  console.log('-'.repeat(80));
  for (const r of routes) {
    console.log(`${r.hostname.padEnd(40)} ${r.service}`);
  }
  console.log(`\n${routes.length} route(s) in ${ENV}.`);
}

// ── add ────────────────────────────────────────────────────────────────

async function cmdAdd(args) {
  const ports = parsePorts(args);
  if (ports.length === 0) bail('usage: cf-tunnel add <port> [<port> ...]', 2);
  const cfg = readEnvCfg(REQUIRED_FIELDS);

  // 1. fetch current ingress
  const cfgPayload = await cfFetch(
    `/accounts/${cfg.account_id}/cfd_tunnel/${cfg.tunnel_id}/configurations`,
    {}, cfg,
  );
  const config = cfgPayload.result?.config || {};
  const ingress = (config.ingress || []).filter((r) => r.hostname); // preserve typed rules
  const fallback = (cfgPayload.result?.config?.ingress || []).find((r) => !r.hostname) || { service: 'http_status:404' };

  const added = [];
  for (const port of ports) {
    const hostname = `${port}.${cfg.domain}`;
    const service = `http://localhost:${port}`;
    // remove any existing rule for this hostname
    const filtered = ingress.filter((r) => r.hostname !== hostname);
    filtered.push({ hostname, service });
    ingress.length = 0;
    ingress.push(...filtered);
    added.push({ port, hostname, service });
  }

  // PUT updated ingress (must include catch-all)
  const newConfig = { ...config, ingress: [...ingress, fallback] };
  await cfFetch(
    `/accounts/${cfg.account_id}/cfd_tunnel/${cfg.tunnel_id}/configurations`,
    {
      method: 'PUT',
      body: JSON.stringify({ config: newConfig }),
    },
    cfg,
  );

  // 2. ensure DNS CNAMEs (proxied) point to <tunnel_id>.cfargotunnel.com
  const cnameTarget = `${cfg.tunnel_id}.cfargotunnel.com`;
  const dnsPayload = await cfFetch(`/zones/${cfg.zone_id}/dns_records?per_page=200`, {}, cfg);
  const existing = dnsPayload.result || [];

  for (const a of added) {
    const cur = existing.find((r) => r.name === a.hostname);
    if (cur) {
      if (cur.content !== cnameTarget || cur.type !== 'CNAME' || !cur.proxied) {
        await cfFetch(`/zones/${cfg.zone_id}/dns_records/${cur.id}`, {
          method: 'PATCH',
          body: JSON.stringify({ type: 'CNAME', name: a.hostname, content: cnameTarget, proxied: true }),
        }, cfg);
        a.dns = 'updated';
      } else {
        a.dns = 'already';
      }
    } else {
      await cfFetch(`/zones/${cfg.zone_id}/dns_records`, {
        method: 'POST',
        body: JSON.stringify({ type: 'CNAME', name: a.hostname, content: cnameTarget, proxied: true, ttl: 1 }),
      }, cfg);
      a.dns = 'created';
    }
  }

  if (argv.includes('--json')) {
    console.log(JSON.stringify({ ok: true, data: { env: ENV, added } }));
  } else {
    for (const a of added) {
      console.log(`✓ ${a.hostname} → ${a.service}  (dns: ${a.dns})`);
    }
  }
}

// ── del ────────────────────────────────────────────────────────────────

async function cmdDel(args) {
  const ports = parsePorts(args);
  if (ports.length === 0) bail('usage: cf-tunnel del <port> [<port> ...]', 2);
  const cfg = readEnvCfg(REQUIRED_FIELDS);

  const cfgPayload = await cfFetch(
    `/accounts/${cfg.account_id}/cfd_tunnel/${cfg.tunnel_id}/configurations`,
    {}, cfg,
  );
  const config = cfgPayload.result?.config || {};
  const ingress = config.ingress || [];

  const removed = [];
  const fallback = ingress.find((r) => !r.hostname);
  let kept = ingress.filter((r) => r.hostname);
  for (const port of ports) {
    // match `<port>.<domain>` plus the retired `g-<port>.<domain>` form so old
    // routes can still be cleaned up
    const names = [`${port}.${cfg.domain}`, `g-${port}.${cfg.domain}`];
    for (const hostname of names) {
      const before = kept.length;
      kept = kept.filter((r) => r.hostname !== hostname);
      if (before !== kept.length) {
        removed.push({ port, hostname });
      }
    }
  }

  const newConfig = { ...config, ingress: [...kept, fallback || { service: 'http_status:404' }] };
  await cfFetch(
    `/accounts/${cfg.account_id}/cfd_tunnel/${cfg.tunnel_id}/configurations`,
    { method: 'PUT', body: JSON.stringify({ config: newConfig }) },
    cfg,
  );

  // remove DNS records
  const dnsPayload = await cfFetch(`/zones/${cfg.zone_id}/dns_records?per_page=200`, {}, cfg);
  const existing = dnsPayload.result || [];
  for (const r of removed) {
    const cur = existing.find((x) => x.name === r.hostname);
    if (cur) {
      await cfFetch(`/zones/${cfg.zone_id}/dns_records/${cur.id}`, { method: 'DELETE' }, cfg);
      r.dns = 'deleted';
    } else {
      r.dns = 'absent';
    }
  }

  if (argv.includes('--json')) {
    console.log(JSON.stringify({ ok: true, data: { env: ENV, removed } }));
  } else {
    if (removed.length === 0) console.log('(nothing to remove)');
    for (const r of removed) {
      console.log(`✗ ${r.hostname}  (dns: ${r.dns})`);
    }
  }
}

// ── helpers ────────────────────────────────────────────────────────────

function parsePorts(args) {
  const ports = [];
  for (const a of args) {
    if (a.startsWith('--')) continue;
    const n = parseInt(a, 10);
    if (Number.isNaN(n) || n < 1 || n > 65535) bail(`invalid port: ${a}`, 2);
    ports.push(n);
  }
  return ports;
}

function runChild(cmd, args, opts = {}) {
  return new Promise((resolve, reject) => {
    const child = spawn(cmd, args, { stdio: 'inherit', ...opts });
    child.on('error', (e) => reject(new Error(`spawn ${cmd}: ${e.message}`)));
    child.on('exit', (code) => code === 0 ? resolve() : reject(Object.assign(new Error(`${cmd} exited ${code}`), { exitCode: code })));
  });
}
