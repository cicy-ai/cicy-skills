{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "cicy-agent-role",
  "version": "0.1.0",
  "title": "CiCy Agent Role",
  "description": "Create and validate standard CiCy Agent role templates with meta.yaml, role.md, role.zh.md, and system.md. Use when building or checking reusable roles for the Create Agent dialog.",
  "category": "agent",
  "tags": ["agent", "role", "persona", "template"],
  "author": "cicy",
  "license": "MIT",
  "runtime": { "node": ">=18" },
  "system_requirements": [],
  "npm_dependencies": false,
  "entry": "bin/cicy-agent-role",
  "permissions": ["filesystem:home", "filesystem:tmp"],
  "compatible_agents": ["*"],
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md",
    "help_en_md": "references/help.en.md",
    "help_cn_md": "references/help.cn.md",
    "tools_en_md": "references/tools.en.md",
    "tools_cn_md": "references/tools.cn.md"
  }
}
