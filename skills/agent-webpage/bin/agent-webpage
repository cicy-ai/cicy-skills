#!/usr/bin/env node
// agent-webpage — talk to the live webpage client for this agent.
// POST /api/chat/push to send events; WebSocket /api/chat/ws to await replies
// (matched by data.requestId). Requires Node 22+ for native WebSocket.

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { randomBytes } from 'node:crypto';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

if (typeof globalThis.WebSocket !== 'function') {
  process.stderr.write('agent-webpage: native WebSocket missing — Node 22+ required\n');
  process.exit(1);
}

const json = argv.includes('--json');
const cmd = argv[0];
const rest = argv.slice(1).filter((a) => a !== '--json');

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const HTTP_BASE = `http://127.0.0.1:${API_PORT}`;
const WS_BASE   = `ws://127.0.0.1:${API_PORT}`;
const DEFAULT_TIMEOUT = Number(process.env.CICY_AGENT_TIMEOUT_MS || 15000);

(async () => {
  try {
    switch (cmd) {
      case 'tools':                       printTools();                    break;
      case 'clients':                     await cmdClients();              break;
      case 'ping':                        await cmdPing(rest, false);      break;
      case 'ipc-ping': case 'ipc_ping':   await cmdPing(rest, true);       break;
      case 'exec-js':  case 'exec_js':    await cmdExecJS(rest);           break;
      case 'current-active-agent-id':     await cmdReadField(rest, 'activeCliPaneId'); break;
      case 'current-master-agent-id':     await cmdReadField(rest, 'masterAgentId');   break;
      case 'send':                        await cmdSend(rest);             break;
      case 'helper-init': case 'helper_init': await cmdHelperInit(rest);   break;
      default: bail(`unknown command: ${cmd}. Try agent-webpage --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`agent-webpage: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: agent-webpage <ping|ipc-ping|exec-js|clients|send|current-active-agent-id|current-master-agent-id> [...]\n'); }
}
function printTools() {
  try { process.stdout.write(readFileSync(new URL('../references/tools.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('# agent-webpage tools\n'); }
}

function loadToken() {
  const env = process.env.CICY_API_TOKEN;
  if (env) return env;
  if (!existsSync(GLOBAL_JSON)) {
    throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON} with {"api_token": "..."}`), { exitCode: 3 });
  }
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token || typeof cfg.api_token !== 'string') {
    throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  }
  return cfg.api_token;
}

function currentAgentID() {
  if (process.env.CICY_PANE_ID) return process.env.CICY_PANE_ID;
  const m = /(w-\d+)/.exec(process.cwd());
  return m ? m[1] : 'w-1001';
}

function randomID(prefix) { return `${prefix}-${Date.now()}-${randomBytes(4).toString('hex')}`; }

async function api(method, path, payload) {
  const token = loadToken();
  const headers = { 'Authorization': `Bearer ${token}` };
  const init = { method, headers };
  if (payload !== undefined) {
    headers['Content-Type'] = 'application/json';
    init.body = JSON.stringify(payload);
  }
  let res;
  try { res = await fetch(HTTP_BASE + path, init); }
  catch (e) { throw Object.assign(new Error(`cannot reach cicy-code at ${HTTP_BASE} — is it running? (${e.message})`), { exitCode: 3 }); }
  const text = await res.text();
  if (res.status === 401 || res.status === 403) {
    throw Object.assign(new Error(`auth failed (${res.status}): check api_token`), { exitCode: 3 });
  }
  if (res.status >= 400) {
    let body; try { body = JSON.parse(text); } catch { body = { error: text }; }
    throw Object.assign(new Error(`api error (${res.status}): ${body?.error || body?.message || text}`), { exitCode: 4 });
  }
  try { return JSON.parse(text); } catch { return text; }
}

async function chatClients() {
  const data = await api('GET', '/api/chat/clients');
  // Server returns an array: [{ client_id, isElectron, platform, ... }, ...].
  // Tolerate the legacy nested { agentID: { clientID: info } } shape too.
  // Routing is by client_id alone — agent_id fields are display-only metadata.
  let raw = data?.clients || data?.data?.clients || data?.data || data || [];
  if (!Array.isArray(raw)) {
    const flat = [];
    for (const [, m] of Object.entries(raw)) {
      for (const [cid, info] of Object.entries(m || {})) {
        flat.push({ client_id: cid, ...info });
      }
    }
    raw = flat;
  }
  return raw.filter((c) => c?.client_id);
}

// Resolve a target client by client_id alone — agent_id never enters routing.
// If no client_id is given, auto-pick a single non-electron, non-code-ext page client.
async function resolveTarget(clientID) {
  const clients = await chatClients();
  if (clientID) {
    const hit = clients.find((c) => c?.client_id === clientID);
    if (!hit) throw Object.assign(new Error(`client_id ${clientID} not found`), { exitCode: 4 });
    return { clientID };
  }
  const pages = clients.filter((c) =>
    c?.client_id && !c.client_id.endsWith(':code-ext') && !c.isElectron
  );
  if (pages.length === 0) throw Object.assign(new Error('no webpage client connected; pass client_id'), { exitCode: 3 });
  if (pages.length > 1)  throw Object.assign(new Error(`multiple webpage clients connected; pass client_id explicitly (${pages.map((c) => c.client_id).join(', ')})`), { exitCode: 2 });
  return { clientID: pages[0].client_id };
}

// Legacy WS-await — kept only for any caller that still wants raw WS matching.
// New code paths should use wait_ack via api('POST', '/api/chat/push', {...}).
function awaitMatch(agentID, match, timeoutMs = DEFAULT_TIMEOUT) {
  return new Promise((resolve, reject) => {
    const token = loadToken();
    const url = `${WS_BASE}/api/chat/ws?master_agent_id=${encodeURIComponent(agentID)}&token=${encodeURIComponent(token)}`;
    const ws = new WebSocket(url);
    const timer = setTimeout(() => { try { ws.close(); } catch {} reject(Object.assign(new Error('timeout waiting for response'), { exitCode: 4 })); }, timeoutMs);
    ws.addEventListener('error', (e) => { clearTimeout(timer); reject(Object.assign(new Error(`websocket error: ${e.message || e.type}`), { exitCode: 4 })); });
    ws.addEventListener('message', (ev) => {
      let msg;
      try { msg = JSON.parse(typeof ev.data === 'string' ? ev.data : ev.data.toString()); } catch { return; }
      if (match(msg)) {
        clearTimeout(timer);
        try { ws.close(); } catch {}
        resolve(msg);
      }
    });
    // expose .ready promise for the caller to time push correctly
    ws._ready = new Promise((r) => ws.addEventListener('open', () => r()));
    Object.defineProperty(ws, 'ready', { get() { return ws._ready; } });
    Promise.resolve(ws._ready).catch(() => {});
    // attach handle for caller via Promise.race below
    resolve._ws = ws;
  });
}

// rpc: HTTP push with wait_ack=true. Server keys solely on client_id, injects
// its own requestId, registers a waiter, and returns the client's reply as
// the HTTP response — { success, mode:"sync", type, data }. No WebSocket,
// no agent_id, no race conditions.
async function rpc({ clientID, type, data, expectType, timeoutMs = DEFAULT_TIMEOUT }) {
  const resp = await api('POST', '/api/chat/push', {
    client_id: clientID,
    type,
    data: data || {},
    wait_ack: true,
    timeout_ms: timeoutMs,
  });
  if (expectType && resp?.type && resp.type !== expectType) {
    throw Object.assign(new Error(`expected ${expectType} got ${resp.type}`), { exitCode: 4 });
  }
  return resp;
}

// ── clients ─────────────────────────────────────────────────────────────

async function cmdClients() {
  const data = await chatClients();
  if (json) return ok(data);
  console.log(JSON.stringify(data, null, 2));
}

// ── ping ────────────────────────────────────────────────────────────────

async function cmdPing(args, ipc) {
  const target = await resolveTarget(args[0]);
  const sendType = ipc ? 'ipc_ping' : 'webpage_ping';
  const recvType = ipc ? 'ipc_pong' : 'webpage_pong';
  const msg = await rpc({
    clientID: target.clientID,
    type: sendType, data: {},
    expectType: recvType,
  });
  const version = msg?.data?.version || 'unknown';
  if (json) return ok({ connected: true, version, client_id: target.clientID, ipc });
  console.log(`✅ ${recvType} from ${target.clientID} (v${version})`);
}

// ── exec-js ─────────────────────────────────────────────────────────────

async function cmdExecJS(args) {
  if (args.length < 1) throw Object.assign(new Error("Usage: agent-webpage exec-js '<js>' [client_id]"), { exitCode: 2 });
  const target = await resolveTarget(args[1]);
  const msg = await rpc({
    clientID: target.clientID,
    type: 'exec_js', data: { code: args[0] },
    expectType: 'exec_js_result',
  });
  const data = msg?.data || {};
  if (data.error) {
    if (json) return ok({ ok: false, error: data.error });
    bail(`exec_js error: ${data.error}`, 4);
  }
  if (json) return ok(data);
  // print the result value (stringified) for terminal use
  if ('value' in data) {
    if (typeof data.value === 'string') console.log(data.value);
    else console.log(JSON.stringify(data.value));
  } else {
    console.log(JSON.stringify(data));
  }
}

async function cmdReadField(args, field) {
  // small wrapper around exec-js that prints `devStore.Workspace.<field>`
  const code = `(()=>{try{return window.__cicyDevStore?.Workspace?.${field} ?? null;}catch(e){return null;}})()`;
  process.argv = [process.argv[0], process.argv[1], 'exec-js', code, ...(args[0] ? [args[0]] : [])];
  await cmdExecJS([code, ...(args[0] ? [args[0]] : [])]);
}

// ── send ────────────────────────────────────────────────────────────────

// ── helper-init ─────────────────────────────────────────────────────────
//
// One-shot bootstrap for the Team Helper opening protocol. Resolves the
// first connected web-* client (Electron / non-Electron — unlike
// resolveTarget which excludes Electron) and runs ONE exec_js round-trip
// that returns { lang, area, isElectron } in a single payload. Replaces
// the old "clients → exec-js navigator.language → ipinfo" chain which
// Big Pickle Zen kept short-circuiting into a single ipinfo call.
//
// Output is JSON to stdout — the agent reads it programmatically and
// never echoes it to the chat user.
async function cmdHelperInit(args) {
  void args;
  const clients = await chatClients();
  const target = clients.find((c) =>
    c?.client_id?.startsWith('web-') && !c.client_id.endsWith(':code-ext')
  );
  if (!target) throw Object.assign(new Error('no webpage client connected'), { exitCode: 3 });
  const code = `(async () => {
    const ua = navigator.userAgent || '';
    const lang = navigator.language || '';
    const isElectron = !!(window.cicy || /Electron/i.test(ua));
    let os = 'unknown', arch = 'amd64';
    if (/Windows/i.test(ua))      os = 'windows';
    else if (/Mac/i.test(ua))     os = 'darwin';
    else if (/Linux/i.test(ua))   os = 'linux';
    if (/arm64|aarch64/i.test(ua)) arch = 'arm64';
    if (navigator.userAgentData && typeof navigator.userAgentData.getHighEntropyValues === 'function') {
      try {
        const v = await navigator.userAgentData.getHighEntropyValues(['architecture']);
        if (v && v.architecture === 'arm') arch = 'arm64';
      } catch (e) {}
    }
    const ping = async (u, ms) => {
      try {
        const c = new AbortController();
        const t = setTimeout(() => c.abort(), ms);
        const r = await fetch(u, { signal: c.signal, cache: 'no-store' });
        clearTimeout(t);
        return r.ok || r.status === 401;
      } catch (e) { return false; }
    };
    const [ipinfo, github, dockerhub] = await Promise.all([
      (async () => {
        try {
          const c = new AbortController();
          const t = setTimeout(() => c.abort(), 3000);
          const r = await fetch('https://ipinfo.io/json', { signal: c.signal });
          clearTimeout(t);
          return r.ok ? await r.json() : null;
        } catch (e) { return null; }
      })(),
      ping('https://api.github.com/zen', 3000),
      ping('https://hub.docker.com/v2/repositories/library/hello-world/', 3000),
    ]);
    let area = '';
    if (ipinfo) area = [ipinfo.country, ipinfo.region, ipinfo.city].filter(Boolean).join('/');
    return { lang, area, isElectron, os, arch, github, dockerhub };
  })()`;
  const msg = await rpc({
    clientID: target.client_id,
    type: 'exec_js', data: { code },
    expectType: 'exec_js_result',
  });
  const data = msg?.data || {};
  if (data.error) {
    if (json) return ok({ ok: false, error: data.error });
    bail(`helper-init error: ${data.error}`, 4);
  }
  // SPA's exec_js handler returns the result in `data.result` as a string.
  // For helper-init the page-side code returns an object that the handler
  // JSON.stringifies, so we just re-parse here.
  let value = {};
  if (typeof data.result === 'string' && data.result.length > 0) {
    try { value = JSON.parse(data.result); } catch { value = { raw: data.result }; }
  }
  if (json) return ok(value);
  console.log(JSON.stringify(value));
}

async function cmdSend(args) {
  if (args.length < 2) throw Object.assign(new Error("Usage: agent-webpage send <type> '<data_json>' [client_id] [expect_type]"), { exitCode: 2 });
  const sendType = args[0];
  let data;
  try { data = JSON.parse(args[1]); }
  catch (e) { throw Object.assign(new Error(`invalid data_json: ${e.message}`), { exitCode: 2 }); }
  const clientID = args[2] || '';
  const expectType = args[3] || '';
  const target = await resolveTarget(clientID);
  const msg = await rpc({
    clientID: target.clientID,
    type: sendType, data,
    expectType: expectType || undefined,
  });
  if (json) return ok(msg);
  console.log(JSON.stringify(msg, null, 2));
}
