{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "luckgram",
  "version": "1.3.0",
  "title": "Luckgram",
  "description": "Work with the Telegram accounts in Luckgram Desktop through its MCP server, local or cloud: accounts, friends, chats, messages, groups, profile, bots via BotFather. Tokens stay masked.",
  "category": "agent",
  "tags": ["telegram", "luckgram", "mcp", "accounts", "messages", "botfather", "bots"],
  "author": "cicy-ai",
  "homepage": "https://luckgram.cc/skills/",
  "license": "MIT",
  "runtime": { "node": ">=18" },
  "system_requirements": [],
  "npm_dependencies": false,
  "entry": "bin/luckgram",
  "config": {
    "path": "~/cicy-ai/db/luckgram.json",
    "permissions": "0600",
    "secret_fields": ["profiles.*.token"]
  },
  "permissions": ["network", "filesystem:db"],
  "compatible_agents": ["*"],
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md",
    "help_en_md": "references/help.en.md",
    "help_cn_md": "references/help.cn.md",
    "tools_en_md": "references/tools.en.md",
    "tools_cn_md": "references/tools.cn.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "Luckgram",
      "description": "通过 Luckgram 桌面版的 MCP 接口（本机或云端）操作 Telegram 账号：账号、好友、会话、消息、群组、资料、通过 BotFather 管理机器人。令牌全程打码，不会输出。"
    }
  }
}
