#!/usr/bin/env node
// cicy-todo — central todo list, calls cicy-code /api/todo/*.
// Zero npm dependencies. Pure ESM. Node 18+.
//
// All todos live in the master pane (w-10001) workspace. Each todo carries
// a pane_id marking which worker owns it. Workers can only see/mutate
// their own todos; master sees everything and can filter by --pane.

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const MASTER_PANE = 'w-10001';

const args = process.argv.slice(2);

if (args.length === 0 || args.includes('--help') || args.includes('-h') || args[0] === 'help') {
  printHelp();
  process.exit(args.length === 0 ? 2 : 0);
}

// ── identity + flag parsing ─────────────────────────────────────────────
// Self pane (X-Agent-Show-Id) comes from the env var the tmux boot script
// sets. We refuse to run without an explicit identity — defaulting to the
// master pane would silently grant master-level visibility to any shell
// that happens to lack the env var (cron, ad-hoc terminals, scripts).
// Sub-agents spawned *inside* a pane (e.g. cicy-team workers, Task/Agent
// sub-agents) may not inherit X_AGENT_SHORT_ID but still carry the full
// X_AGENT_ID ("w-10029:main.0"). Derive the owning pane from its prefix so a
// sub-agent sees the same todo scope as its pane instead of bailing on "no id".
function derivePane() {
  const direct = (process.env.X_AGENT_SHORT_ID || process.env.CICY_PANE_ID || '').trim();
  if (direct) return direct;
  const full = (process.env.X_AGENT_ID || '').trim();
  if (full) return full.split(':')[0].trim();
  return '';
}
const SELF_PANE_RAW = derivePane();
if (!SELF_PANE_RAW) {
  process.stderr.write(
    'cicy-todo: no agent identity found (X_AGENT_SHORT_ID / CICY_PANE_ID / X_AGENT_ID).\n' +
    '  Inside a cicy-code pane these are set automatically by the tmux boot script.\n' +
    '  To run as the master pane explicitly: CICY_PANE_ID=w-10001 cicy-todo ...\n',
  );
  process.exit(2);
}
const SELF_PANE = SELF_PANE_RAW;

const json = args.includes('--json');
const isMaster = SELF_PANE === MASTER_PANE;

// --pane <filter> (master-only) selects which worker's todos to act on
let paneFilter = '';
const rest = [];
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '--pane') { paneFilter = args[++i] || ''; continue; }
  if (a.startsWith('--pane=')) { paneFilter = a.slice('--pane='.length); continue; }
  rest.push(a);
}
if (paneFilter && !isMaster) {
  bail('--pane is only available from the master pane (w-10001)', 2);
}

const cmd = rest.find((a) => !a.startsWith('--')) || 'list';
const cmdArgs = rest.filter((a) => !a.startsWith('--') && a !== cmd);

// IIFE so module-level `const` declarations below (GLYPH, helpers) are out
// of the temporal dead zone by the time the dispatch runs.
(async () => {
  try {
    switch (cmd) {
      case 'list': case 'ls':  await cmdList(rest); break;
      case 'add':              await cmdAdd(rest); break;
      case 'show':             await cmdShow(cmdArgs); break;
      case 'start':            await cmdSetStatus('doing', cmdArgs); break;
      case 'done':             await cmdSetStatus('done', cmdArgs); break;
      case 'drop':             await cmdSetStatus('dropped', cmdArgs); break;
      case 'back':             await cmdSetStatus('todo', cmdArgs); break;
      case 'edit':             await cmdEdit(cmdArgs); break;
      case 'rm': case 'remove': case 'delete': await cmdRm(cmdArgs); break;
      default: bail(`unknown command: ${cmd}. Try cicy-todo --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  process.stderr.write(`cicy-todo: ${msg}\n`);
  process.exit(code);
}

function printHelp() {
  try {
    process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8'));
  } catch {
    process.stdout.write(`cicy-todo <list|add|show|start|done|drop|back|edit|rm> [--pane <w-xxxxx>] [--json]\n`);
  }
}

function readApiToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) {
    throw Object.assign(new Error(`missing ${GLOBAL_JSON} and CICY_API_TOKEN not set`), { exitCode: 3 });
  }
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 1 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

function baseURL() {
  return `http://127.0.0.1:${API_PORT}/api/todo`;
}

async function api(method, path, body) {
  const url = baseURL() + path;
  const token = readApiToken();
  const init = {
    method,
    headers: {
      'Authorization': `Bearer ${token}`,
      'X-Agent-Show-Id': SELF_PANE,
      'Content-Type': 'application/json',
    },
  };
  if (body !== undefined) init.body = JSON.stringify(body);
  let res;
  try {
    res = await fetch(url, init);
  } catch (e) {
    throw Object.assign(new Error(`cannot reach cicy-code at ${baseURL()} — is it running? (${e.message})`), { exitCode: 3 });
  }
  const text = await res.text();
  let payload;
  try { payload = text ? JSON.parse(text) : {}; } catch { payload = { raw: text }; }
  if (res.status === 401 || res.status === 403) {
    throw Object.assign(new Error(`auth failed (HTTP ${res.status}): ${payload.detail || ''}`.trim()), { exitCode: 3 });
  }
  if (res.status === 404) {
    throw Object.assign(new Error(payload.detail || 'not found'), { exitCode: 2 });
  }
  if (!res.ok) {
    throw Object.assign(new Error(`HTTP ${res.status}: ${payload.detail || text}`), { exitCode: 1 });
  }
  return payload;
}

// ── id resolution ───────────────────────────────────────────────────────
// Two forms are accepted:
//   • #N or N — positional index into the *default active view* (status
//     todo|doing), sorted by created_at ascending. This is the same order
//     `cicy-todo list` prints, so #1/#2/... map directly to the rows the
//     user just saw. Indices shift when the active set changes (add, done,
//     drop, etc.), as is standard for sequential todo refs.
//   • <uuid-prefix> — first-N chars of the UUID, for done/dropped todos
//     that aren't in the active view, or when stability across status
//     transitions matters.

async function fetchActiveTodos() {
  const params = [];
  if (paneFilter) params.push(`pane_id=${encodeURIComponent(paneFilter)}`);
  if (isMaster && !paneFilter) params.push('all_agents=true');
  const qs = params.length ? '?' + params.join('&') : '';
  const resp = await api('GET', '/list' + qs);
  return (resp.todos || [])
    .filter((t) => t.status === 'todo' || t.status === 'doing')
    .sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
}

async function resolveId(prefix) {
  // Inlined to avoid TDZ — this function may be called synchronously from
  // the dispatch IIFE before module-top const declarations resolve.
  const seq = /^#?(\d+)$/.exec(prefix);
  if (seq) {
    const n = parseInt(seq[1], 10);
    const active = await fetchActiveTodos();
    if (n < 1 || n > active.length) {
      throw Object.assign(new Error(`#${n} out of range (1..${active.length}); run 'cicy-todo' to see current numbering`), { exitCode: 2 });
    }
    return active[n - 1];
  }

  const params = [];
  if (paneFilter) params.push(`pane_id=${encodeURIComponent(paneFilter)}`);
  if (isMaster && !paneFilter) params.push('all_agents=true');
  const qs = params.length ? '?' + params.join('&') : '';
  const resp = await api('GET', '/list' + qs);
  const matches = (resp.todos || []).filter(
    (t) => t.id === prefix || t.id.startsWith(prefix),
  );
  if (matches.length === 0) {
    throw Object.assign(new Error(`no todo matches '${prefix}'`), { exitCode: 2 });
  }
  if (matches.length > 1) {
    process.stderr.write('ambiguous prefix, candidates:\n');
    for (const m of matches) process.stderr.write(`  ${m.id}  ${m.title}\n`);
    process.exit(4);
  }
  return matches[0];
}

// ── pretty printing ─────────────────────────────────────────────────────

const GLYPH = { todo: '○', doing: '◐', done: '✓', dropped: '✗' };

function humanTime(iso) {
  if (!iso) return '-';
  const sec = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
  if (Number.isNaN(sec)) return '-';
  if (sec < 60) return '刚刚';
  if (sec < 3600) return `${Math.floor(sec / 60)}m前`;
  if (sec < 86400) return `${Math.floor(sec / 3600)}h前`;
  if (sec < 604800) return `${Math.floor(sec / 86400)}天前`;
  return iso.slice(0, 10);
}

function shortId(id) { return id.slice(0, 10); }

// Active rows (status todo|doing) get a positional `#N` that mirrors what
// `resolveId('#N')` will resolve to. Rows in other statuses get the short
// UUID instead — they're outside the active set, so #N would be ambiguous.
function printTable(todos, { withPane = false } = {}) {
  if (todos.length === 0) {
    console.log('(no todos)');
    return;
  }
  const sorted = [...todos].sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
  let seq = 0;
  const rows = sorted.map((t) => {
    const isActive = t.status === 'todo' || t.status === 'doing';
    const ref = isActive ? `#${++seq}` : shortId(t.id);
    return { t, ref };
  });
  const refWidth = Math.max(4, ...rows.map((r) => r.ref.length));
  const paneCol = withPane ? ` ${'PANE'.padEnd(8)}` : '';
  console.log(`     ${'REF'.padEnd(refWidth)} ${'STATUS'.padEnd(7)} ${'UPDATED'.padEnd(10)}${paneCol} TITLE`);
  for (const { t, ref } of rows) {
    const g = GLYPH[t.status] || '?';
    const paneCell = withPane ? ` ${(t.pane_id || '-').padEnd(8)}` : '';
    console.log(`  ${g}  ${ref.padEnd(refWidth)} ${(t.status || '').padEnd(7)} ${humanTime(t.updated_at).padEnd(10)}${paneCell} ${t.title}`);
  }
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdList(restArgs) {
  let status = '';
  let q = '';
  let all = false;
  for (let i = 0; i < restArgs.length; i++) {
    const a = restArgs[i];
    if (a === '--json') continue;
    if (a === 'list' || a === 'ls') continue;
    if (a === '--status') { status = restArgs[++i] || ''; }
    else if (a.startsWith('--status=')) { status = a.slice('--status='.length); }
    else if (a === '-q' || a === '--query') { q = restArgs[++i] || ''; }
    else if (a === '--all') { all = true; }
  }
  const params = [];
  if (status) params.push(`status=${encodeURIComponent(status)}`);
  if (q) params.push(`q=${encodeURIComponent(q)}`);
  if (paneFilter) params.push(`pane_id=${encodeURIComponent(paneFilter)}`);
  // Master without an explicit pane filter sees every worker by default.
  if (isMaster && !paneFilter) params.push('all_agents=true');
  const qs = params.length ? '?' + params.join('&') : '';

  const resp = await api('GET', '/list' + qs);
  let todos = resp.todos || [];
  if (!all && !status) {
    todos = todos.filter((t) => t.status === 'todo' || t.status === 'doing');
  }
  // Show the pane column whenever results may span multiple workers.
  const withPane = isMaster && !paneFilter;
  if (json) {
    console.log(JSON.stringify({ ok: true, data: { self_pane: SELF_PANE, pane_filter: paneFilter || null, todos } }));
  } else {
    printTable(todos, { withPane });
  }
}

async function cmdAdd(restArgs) {
  const title = restArgs.find((a, i) => i > restArgs.indexOf('add') && !a.startsWith('--'));
  if (!title) bail('usage: cicy-todo add "<title>" [--pane <w-xxxxx>]', 2);
  // Master with --pane creates on behalf of the named worker; everyone else
  // creates for themselves.
  const body = { title };
  if (isMaster && paneFilter) body.pane_id = paneFilter;
  const resp = await api('POST', '/add', body);
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`+ ${resp.todo?.id || '?'}  [${resp.todo?.pane_id || SELF_PANE}]  ${resp.todo?.title || title}`);
}

async function cmdShow(args) {
  const id = args[0];
  if (!id) bail('usage: cicy-todo show <id>', 2);
  const t = await resolveId(id);
  if (json) console.log(JSON.stringify({ ok: true, data: t }));
  else {
    // Show the active-view `#N` alongside the UUID when this todo is
    // currently in the active set — saves the user another `cicy-todo`
    // call to look up its positional ref.
    let ref = '';
    if (t.status === 'todo' || t.status === 'doing') {
      try {
        const active = await fetchActiveTodos();
        const idx = active.findIndex((x) => x.id === t.id);
        if (idx >= 0) ref = ` (#${idx + 1})`;
      } catch {}
    }
    console.log(`id:         ${t.id}${ref}`);
    console.log(`pane:       ${t.pane_id || '-'}`);
    console.log(`status:     ${t.status}`);
    console.log(`created:    ${t.created_at}`);
    console.log(`updated:    ${t.updated_at}`);
    console.log(`title:      ${t.title}`);
  }
}

async function cmdSetStatus(newStatus, args) {
  const id = args[0];
  if (!id) bail(`usage: cicy-todo <start|done|drop|back> <id>`, 2);
  const target = await resolveId(id);
  const resp = await api('PATCH', `/${target.id}`, { status: newStatus });
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`~ ${resp.todo?.id || target.id}  ${resp.todo?.status || newStatus}  ${resp.todo?.title || target.title}`);
}

async function cmdEdit(args) {
  const id = args[0];
  const title = args[1];
  if (!id || !title) bail('usage: cicy-todo edit <id> "<new title>"', 2);
  const target = await resolveId(id);
  const resp = await api('PATCH', `/${target.id}`, { title });
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`~ ${resp.todo?.id || target.id}  ${resp.todo?.title || title}`);
}

async function cmdRm(args) {
  const id = args[0];
  if (!id) bail('usage: cicy-todo rm <id>', 2);
  const target = await resolveId(id);
  const resp = await api('DELETE', `/${target.id}`);
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`- ${target.id}`);
}
