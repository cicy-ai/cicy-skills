#!/usr/bin/env node
// cicy-todo — central todo list, calls cicy-code /api/todo/*.
// Zero npm dependencies. Pure ESM. Node 18+.
//
// All todos live in the master pane (w-1001) workspace. Each todo carries
// a pane_id marking which worker owns it. Workers can only see/mutate
// their own todos; master sees everything and can filter by --pane.

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const MASTER_PANE = 'w-1001';

const args = process.argv.slice(2);

if (args.length === 0 || args.includes('--help') || args.includes('-h') || args[0] === 'help') {
  printHelp();
  process.exit(args.length === 0 ? 2 : 0);
}

// ── identity + flag parsing ─────────────────────────────────────────────
// Self pane (X-Agent-Show-Id) comes from the env var the tmux boot script
// sets. We refuse to run without an explicit identity — defaulting to the
// master pane would silently grant master-level visibility to any shell
// that happens to lack the env var (cron, ad-hoc terminals, scripts).
// Sub-agents spawned *inside* a pane (e.g. cicy-team workers, Task/Agent
// sub-agents) may not inherit X_AGENT_SHORT_ID but still carry the full
// X_AGENT_ID ("w-10029:main.0"). Derive the owning pane from its prefix so a
// sub-agent sees the same todo scope as its pane instead of bailing on "no id".
function derivePane() {
  const direct = (process.env.X_AGENT_SHORT_ID || process.env.CICY_PANE_ID || '').trim();
  if (direct) return direct;
  const full = (process.env.X_AGENT_ID || '').trim();
  if (full) return full.split(':')[0].trim();
  return '';
}
const SELF_PANE_RAW = derivePane();
if (!SELF_PANE_RAW) {
  process.stderr.write(
    'cicy-todo: no agent identity found (X_AGENT_SHORT_ID / CICY_PANE_ID / X_AGENT_ID).\n' +
    '  Inside a cicy-code pane these are set automatically by the tmux boot script.\n' +
    '  To run as the master pane explicitly: CICY_PANE_ID=w-1001 cicy-todo ...\n',
  );
  process.exit(2);
}
const SELF_PANE = SELF_PANE_RAW;

const json = args.includes('--json');
const isMaster = SELF_PANE === MASTER_PANE;

// Every flag this CLI understands. Anything else is a HARD ERROR — an unknown
// flag used to be pushed into `rest`, and its VALUE (which doesn't start with
// `--`) landed there too, silently becoming a positional arg. That is exactly
// how `--body "<brief>"` was accepted-and-discarded for so long: no error, no
// output, the brief just vanished. Fail loudly instead.
const KNOWN_FLAGS = new Set([
  '--json', '--pane', '--all', '--status', '--query', '-q',
  '--body', '--body-file', '--help', '-h',
]);

// Flags that consume the NEXT argv entry as their value.
const VALUE_FLAGS = new Set(['--pane', '--body', '--body-file', '--status', '--query', '-q']);

// --pane <filter> (master-only) selects which worker's todos to act on.
// --body / --body-file carry the task brief (goal, acceptance criteria, files).
let paneFilter = '';
let bodyText = null;      // null = "not supplied"; "" = "explicitly cleared"
let bodyFile = '';
const rest = [];          // flags + their values, for cmdList's own --status/-q parsing
const positionals = [];   // NON-flag args only — a flag's value never lands here
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  const eq = a.startsWith('--') ? a.indexOf('=') : -1;
  const name = eq > 0 ? a.slice(0, eq) : a;

  if (!name.startsWith('-')) { positionals.push(a); rest.push(a); continue; }

  if (!KNOWN_FLAGS.has(name)) {
    bail(`unknown flag: ${name}. Try cicy-todo --help.`, 2);
  }

  const takeValue = () => {
    if (eq > 0) return a.slice(eq + 1);
    if (i + 1 >= args.length) bail(`${name} needs a value`, 2);
    return args[++i];
  };

  if (name === '--pane') { paneFilter = takeValue(); continue; }
  if (name === '--body') { bodyText = takeValue(); continue; }
  if (name === '--body-file') { bodyFile = takeValue(); continue; }

  // --status / -q keep their value in `rest` (cmdList parses them from there),
  // but the value must NOT become a positional — that's how `-q foo` used to
  // get mistaken for the command `foo`.
  if (VALUE_FLAGS.has(name) && eq < 0) { rest.push(a, takeValue()); continue; }
  rest.push(a);
}
if (paneFilter && !isMaster) {
  bail('--pane is only available from the master pane (w-1001)', 2);
}
if (bodyText !== null && bodyFile) {
  bail('use either --body or --body-file, not both', 2);
}

// resolveBody returns the brief to send, or null when none was supplied.
// --body-file - reads stdin, so a long markdown brief can be piped in without
// fighting shell quoting (which is what a multi-paragraph brief always becomes).
function resolveBody() {
  if (bodyFile) {
    try {
      // fd 0 = stdin, so `--body-file -` pipes a brief in.
      return readFileSync(bodyFile === '-' ? 0 : bodyFile, 'utf8').trim();
    } catch (e) {
      bail(`cannot read --body-file ${bodyFile}: ${e.message}`, 2);
    }
  }
  return bodyText;
}

const cmd = positionals[0] || 'list';
const cmdArgs = positionals.slice(1);

// IIFE so module-level `const` declarations below (GLYPH, helpers) are out
// of the temporal dead zone by the time the dispatch runs.
(async () => {
  try {
    switch (cmd) {
      case 'list': case 'ls':  await cmdList(rest); break;
      case 'add':              await cmdAdd(); break;
      case 'show':             await cmdShow(cmdArgs); break;
      case 'test':             await cmdSetStatus('test', cmdArgs); break;
      case 'done':             await cmdSetStatus('done', cmdArgs); break;
      case 'drop':             await cmdSetStatus('dropped', cmdArgs); break;
      case 'back':             await cmdSetStatus('todo', cmdArgs); break;
      case 'edit':             await cmdEdit(cmdArgs); break;
      case 'rm': case 'remove': case 'delete': await cmdRm(cmdArgs); break;
      default: bail(`unknown command: ${cmd}. Try cicy-todo --help.`, 2);
    }
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  process.stderr.write(`cicy-todo: ${msg}\n`);
  process.exit(code);
}

function printHelp() {
  try {
    process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8'));
  } catch {
    process.stdout.write(`cicy-todo <list|add|show|test|done|drop|back|edit|rm> [--pane <w-xxxxx>] [--json]\n`);
  }
}

function readApiToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) {
    throw Object.assign(new Error(`missing ${GLOBAL_JSON} and CICY_API_TOKEN not set`), { exitCode: 3 });
  }
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 1 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

function baseURL() {
  return `http://127.0.0.1:${API_PORT}/api/todo`;
}

async function api(method, path, body) {
  const url = baseURL() + path;
  const token = readApiToken();
  const init = {
    method,
    headers: {
      'Authorization': `Bearer ${token}`,
      'X-Agent-Show-Id': SELF_PANE,
      'Content-Type': 'application/json',
    },
  };
  if (body !== undefined) init.body = JSON.stringify(body);
  let res;
  try {
    res = await fetch(url, init);
  } catch (e) {
    throw Object.assign(new Error(`cannot reach cicy-code at ${baseURL()} — is it running? (${e.message})`), { exitCode: 3 });
  }
  const text = await res.text();
  let payload;
  try { payload = text ? JSON.parse(text) : {}; } catch { payload = { raw: text }; }
  if (res.status === 401 || res.status === 403) {
    throw Object.assign(new Error(`auth failed (HTTP ${res.status}): ${payload.detail || ''}`.trim()), { exitCode: 3 });
  }
  if (res.status === 404) {
    throw Object.assign(new Error(payload.detail || 'not found'), { exitCode: 2 });
  }
  if (!res.ok) {
    throw Object.assign(new Error(`HTTP ${res.status}: ${payload.detail || text}`), { exitCode: 1 });
  }
  return payload;
}

// ── id resolution ───────────────────────────────────────────────────────
// Ids are stable auto-incrementing integers (assigned server-side, shown in
// the ID column of `cicy-todo list` and never reused or shifted). Accepted:
//   • N — the stable todo id. This is the primary form: it's what the list
//     prints, what the UI shows, and what survives status changes. Falls back
//     to a positional index into the active view only when no todo has id N
//     (keeps old muscle-memory working).
//   • #N — explicit positional index into the *active view* (status
//     todo|test), sorted by created_at ascending. Shifts when the active set
//     changes, so prefer the bare id N for anything you want to be stable.
//   • <prefix> — leading chars of the id (rarely needed now ids are short).

async function fetchActiveTodos() {
  const params = [];
  if (paneFilter) params.push(`pane_id=${encodeURIComponent(paneFilter)}`);
  if (isMaster && !paneFilter) params.push('all_agents=true');
  const qs = params.length ? '?' + params.join('&') : '';
  const resp = await api('GET', '/list' + qs);
  return (resp.todos || [])
    .filter((t) => t.status === 'todo' || t.status === 'test')
    .sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
}

async function resolveId(prefix) {
  const explicitPos = /^#(\d+)$/.exec(prefix); // "#N" → always positional
  const bareNum = /^(\d+)$/.exec(prefix); //       "N"  → stable id, positional fallback

  const params = [];
  if (paneFilter) params.push(`pane_id=${encodeURIComponent(paneFilter)}`);
  if (isMaster && !paneFilter) params.push('all_agents=true');
  const qs = params.length ? '?' + params.join('&') : '';
  const resp = await api('GET', '/list' + qs);
  const all = resp.todos || [];
  const activeSorted = () => all
    .filter((t) => t.status === 'todo' || t.status === 'test')
    .sort((a, b) => new Date(a.created_at) - new Date(b.created_at));

  // "#N" — positional index into the active view.
  if (explicitPos) {
    const n = parseInt(explicitPos[1], 10);
    const active = activeSorted();
    if (n < 1 || n > active.length) {
      throw Object.assign(new Error(`#${n} out of range (1..${active.length}); run 'cicy-todo' to see current numbering`), { exitCode: 2 });
    }
    return active[n - 1];
  }

  // "N" — stable stored id (exact). Positional fallback only when no id matches.
  if (bareNum) {
    const exact = all.find((t) => t.id === prefix);
    if (exact) return exact;
    const active = activeSorted();
    const n = parseInt(bareNum[1], 10);
    if (n >= 1 && n <= active.length) return active[n - 1];
    throw Object.assign(new Error(`no todo with id ${prefix} (and #${n} out of range 1..${active.length}); run 'cicy-todo' to see ids`), { exitCode: 2 });
  }

  // Non-numeric → id prefix match.
  const matches = all.filter((t) => t.id === prefix || t.id.startsWith(prefix));
  if (matches.length === 0) {
    throw Object.assign(new Error(`no todo matches '${prefix}'`), { exitCode: 2 });
  }
  if (matches.length > 1) {
    process.stderr.write('ambiguous prefix, candidates:\n');
    for (const m of matches) process.stderr.write(`  ${m.id}  ${m.title}\n`);
    process.exit(4);
  }
  return matches[0];
}

// ── pretty printing ─────────────────────────────────────────────────────

const GLYPH = { todo: '○', test: '◓', done: '✓', dropped: '✗' };

function humanTime(iso) {
  if (!iso) return '-';
  const sec = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
  if (Number.isNaN(sec)) return '-';
  if (sec < 60) return '刚刚';
  if (sec < 3600) return `${Math.floor(sec / 60)}m前`;
  if (sec < 86400) return `${Math.floor(sec / 3600)}h前`;
  if (sec < 604800) return `${Math.floor(sec / 86400)}天前`;
  return iso.slice(0, 10);
}

// The ID column shows the stable, server-assigned integer id. It never shifts
// when todos are completed/dropped, so `cicy-todo done <id>` always refers to
// exactly the row you read — unlike the old positional `#N`.
function printTable(todos, { withPane = false } = {}) {
  if (todos.length === 0) {
    console.log('(no todos)');
    return;
  }
  const sorted = [...todos].sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
  const rows = sorted.map((t) => ({ t, ref: String(t.id) }));
  const refWidth = Math.max(2, ...rows.map((r) => r.ref.length));
  const paneCol = withPane ? ` ${'PANE'.padEnd(8)}` : '';
  console.log(`     ${'ID'.padEnd(refWidth)} ${'STATUS'.padEnd(7)} ${'UPDATED'.padEnd(10)}${paneCol} TITLE`);
  for (const { t, ref } of rows) {
    const g = GLYPH[t.status] || '?';
    const paneCell = withPane ? ` ${(t.pane_id || '-').padEnd(8)}` : '';
    console.log(`  ${g}  ${ref.padEnd(refWidth)} ${(t.status || '').padEnd(7)} ${humanTime(t.updated_at).padEnd(10)}${paneCell} ${t.title}`);
  }
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdList(restArgs) {
  let status = '';
  let q = '';
  let all = false;
  for (let i = 0; i < restArgs.length; i++) {
    const a = restArgs[i];
    if (a === '--json') continue;
    if (a === 'list' || a === 'ls') continue;
    if (a === '--status') { status = restArgs[++i] || ''; }
    else if (a.startsWith('--status=')) { status = a.slice('--status='.length); }
    else if (a === '-q' || a === '--query') { q = restArgs[++i] || ''; }
    else if (a === '--all') { all = true; }
  }
  const params = [];
  if (status) params.push(`status=${encodeURIComponent(status)}`);
  if (q) params.push(`q=${encodeURIComponent(q)}`);
  if (paneFilter) params.push(`pane_id=${encodeURIComponent(paneFilter)}`);
  // Master without an explicit pane filter sees every worker by default.
  if (isMaster && !paneFilter) params.push('all_agents=true');
  const qs = params.length ? '?' + params.join('&') : '';

  const resp = await api('GET', '/list' + qs);
  let todos = resp.todos || [];
  if (!all && !status) {
    todos = todos.filter((t) => t.status === 'todo' || t.status === 'test');
  }
  // Show the pane column whenever results may span multiple workers.
  const withPane = isMaster && !paneFilter;
  if (json) {
    console.log(JSON.stringify({ ok: true, data: { self_pane: SELF_PANE, pane_filter: paneFilter || null, todos } }));
  } else {
    printTable(todos, { withPane });
  }
}

async function cmdAdd() {
  const title = cmdArgs[0];
  if (!title) {
    bail('usage: cicy-todo add "<title>" [--body <brief> | --body-file <path|->] [--pane <w-xxxxx>]', 2);
  }
  // Master with --pane creates on behalf of the named worker; everyone else
  // creates for themselves.
  const payload = { title };
  if (isMaster && paneFilter) payload.pane_id = paneFilter;

  // The brief. The dispatch convention is that `cicy-agent msg` carries only
  // the id + title and ALL the detail lives here.
  const brief = resolveBody();
  if (brief) payload.body = brief;

  const resp = await api('POST', '/add', payload);
  if (json) { console.log(JSON.stringify({ ok: true, data: resp })); return; }

  const t = resp.todo || {};
  console.log(`+ ${t.id || '?'}  [${t.pane_id || SELF_PANE}]  ${t.title || title}`);
  // Confirm the brief actually landed. Silence here is what let the old
  // --body-is-ignored bug hide: you could not tell a stored brief from a
  // discarded one.
  if (brief && !t.body) {
    console.error('! brief was NOT stored — the cicy-code server is too old (needs the todo `body` field)');
    process.exitCode = 1;
  } else if (t.body) {
    console.log(`  brief: ${t.body.split('\n').length} 行`);
  }
}

async function cmdShow(args) {
  const id = args[0];
  if (!id) bail('usage: cicy-todo show <id>', 2);
  const t = await resolveId(id);
  if (json) console.log(JSON.stringify({ ok: true, data: t }));
  else {
    // Show the active-view `#N` alongside the UUID when this todo is
    // currently in the active set — saves the user another `cicy-todo`
    // call to look up its positional ref.
    let ref = '';
    if (t.status === 'todo' || t.status === 'test') {
      try {
        const active = await fetchActiveTodos();
        const idx = active.findIndex((x) => x.id === t.id);
        if (idx >= 0) ref = ` (#${idx + 1})`;
      } catch {}
    }
    console.log(`id:         ${t.id}${ref}`);
    console.log(`pane:       ${t.pane_id || '-'}`);
    console.log(`status:     ${t.status}`);
    console.log(`created:    ${t.created_at}`);
    console.log(`updated:    ${t.updated_at}`);
    console.log(`title:      ${t.title}`);
    // The brief is the whole point of `show` — it carries the goal, the
    // acceptance criteria and the relevant files. Print it in full; truncating
    // it would just push the reader back to guessing.
    if (t.body) {
      console.log('');
      console.log(t.body);
    }
  }
}

async function cmdSetStatus(newStatus, args) {
  const id = args[0];
  if (!id) bail(`usage: cicy-todo <test|done|drop|back> <id>`, 2);
  const target = await resolveId(id);
  const resp = await api('PATCH', `/${target.id}`, { status: newStatus });
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`~ ${resp.todo?.id || target.id}  ${resp.todo?.status || newStatus}  ${resp.todo?.title || target.title}`);
}

async function cmdEdit(args) {
  const id = args[0];
  const title = args[1];
  const brief = resolveBody();
  if (!id || (!title && brief === null)) {
    bail('usage: cicy-todo edit <id> ["<new title>"] [--body <brief> | --body-file <path|->]', 2);
  }
  const target = await resolveId(id);
  const patch = {};
  if (title) patch.title = title;
  if (brief !== null) patch.body = brief;   // "" clears the brief
  const resp = await api('PATCH', `/${target.id}`, patch);
  if (json) { console.log(JSON.stringify({ ok: true, data: resp })); return; }

  const t = resp.todo || {};
  console.log(`~ ${t.id || target.id}  ${t.title || title || target.title}`);
  if (brief && !t.body) {
    console.error('! brief was NOT stored — the cicy-code server is too old (needs the todo `body` field)');
    process.exitCode = 1;
  } else if (brief !== null) {
    console.log(brief ? `  brief: ${t.body.split('\n').length} 行` : '  brief: 已清空');
  }
}

async function cmdRm(args) {
  const id = args[0];
  if (!id) bail('usage: cicy-todo rm <id>', 2);
  const target = await resolveId(id);
  const resp = await api('DELETE', `/${target.id}`);
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`- ${target.id}`);
}
