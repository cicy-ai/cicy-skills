#!/usr/bin/env node
// cicy-todo — per-workspace todo list, calls cicy-code /api/todo/*.
// Zero npm dependencies. Pure ESM. Node 18+.

import { readFileSync, existsSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(homedir(), 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const PANE_RE = /^w-\d+$/;

const args = process.argv.slice(2);

if (args.includes('--help') || args.includes('-h') || args[0] === 'help') {
  printHelp();
  process.exit(0);
}

// ── pane parsing ───────────────────────────────────────────────────────
// First positional matching ^w-\d+$ is the pane override.
let pane = '';
const rest = [];
for (const a of args) {
  if (!pane && PANE_RE.test(a)) pane = a;
  else rest.push(a);
}
if (!pane) pane = process.env.CICY_PANE_ID || 'w-10001';

const json = rest.includes('--json');
const cmd = rest.find((a) => !a.startsWith('--')) || 'list';
const cmdArgs = rest.filter((a, i) => {
  // exclude the cmd word itself + flags + their values
  return a !== cmd && !a.startsWith('--');
});

try {
  switch (cmd) {
    case 'list': case 'ls':  await cmdList(rest); break;
    case 'add':              await cmdAdd(rest); break;
    case 'show':             await cmdShow(cmdArgs); break;
    case 'start':            await cmdSetStatus('doing', cmdArgs); break;
    case 'done':             await cmdSetStatus('done', cmdArgs); break;
    case 'drop':             await cmdSetStatus('dropped', cmdArgs); break;
    case 'back':             await cmdSetStatus('todo', cmdArgs); break;
    case 'edit':             await cmdEdit(cmdArgs); break;
    case 'rm': case 'remove': case 'delete': await cmdRm(cmdArgs); break;
    default: bail(`unknown command: ${cmd}. Try cicy-todo --help.`, 2);
  }
} catch (e) {
  bail(e.message, e.exitCode || 1);
}

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  process.stderr.write(`cicy-todo: ${msg}\n`);
  process.exit(code);
}

function printHelp() {
  try {
    process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8'));
  } catch {
    process.stdout.write(`cicy-todo [pane] <list|add|show|start|done|drop|back|edit|rm> ...\n`);
  }
}

function readApiToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) {
    throw Object.assign(new Error(`missing ${GLOBAL_JSON} and CICY_API_TOKEN not set`), { exitCode: 3 });
  }
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 1 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

function baseURL() {
  return `http://127.0.0.1:${API_PORT}/api/todo`;
}

async function api(method, path, body) {
  const url = baseURL() + path;
  const token = readApiToken();
  const init = {
    method,
    headers: {
      'Authorization': `Bearer ${token}`,
      'X-Agent-Show-Id': pane,
      'Content-Type': 'application/json',
    },
  };
  if (body !== undefined) init.body = JSON.stringify(body);
  let res;
  try {
    res = await fetch(url, init);
  } catch (e) {
    throw Object.assign(new Error(`cannot reach cicy-code at ${baseURL()} — is it running? (${e.message})`), { exitCode: 3 });
  }
  const text = await res.text();
  let payload;
  try { payload = text ? JSON.parse(text) : {}; } catch { payload = { raw: text }; }
  if (res.status === 401 || res.status === 403) {
    throw Object.assign(new Error(`auth failed (HTTP ${res.status}) — check api_token`), { exitCode: 3 });
  }
  if (res.status === 404) {
    throw Object.assign(new Error(payload.detail || 'not found'), { exitCode: 2 });
  }
  if (!res.ok) {
    throw Object.assign(new Error(`HTTP ${res.status}: ${payload.detail || text}`), { exitCode: 1 });
  }
  return payload;
}

// ── id resolution ───────────────────────────────────────────────────────

async function resolveId(prefix) {
  const resp = await api('GET', '/list');
  const matches = (resp.todos || []).filter(
    (t) => t.id === prefix || t.id.startsWith(prefix),
  );
  if (matches.length === 0) {
    throw Object.assign(new Error(`no todo matches '${prefix}'`), { exitCode: 2 });
  }
  if (matches.length > 1) {
    process.stderr.write('ambiguous prefix, candidates:\n');
    for (const m of matches) process.stderr.write(`  ${m.id}  ${m.title}\n`);
    process.exit(4);
  }
  return matches[0];
}

// ── pretty printing ─────────────────────────────────────────────────────

const GLYPH = { todo: '○', doing: '◐', done: '✓', dropped: '✗' };

function humanTime(iso) {
  if (!iso) return '-';
  const sec = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
  if (Number.isNaN(sec)) return '-';
  if (sec < 60) return '刚刚';
  if (sec < 3600) return `${Math.floor(sec / 60)}m前`;
  if (sec < 86400) return `${Math.floor(sec / 3600)}h前`;
  if (sec < 604800) return `${Math.floor(sec / 86400)}天前`;
  return iso.slice(0, 10);
}

function shortId(id) { return id.slice(0, 10); }

function printTable(todos) {
  if (todos.length === 0) {
    console.log('(no todos)');
    return;
  }
  console.log(`     ${'ID'.padEnd(12)} ${'STATUS'.padEnd(7)} ${'UPDATED'.padEnd(10)} TITLE`);
  for (const t of todos) {
    const g = GLYPH[t.status] || '?';
    console.log(`  ${g}  ${shortId(t.id).padEnd(12)} ${(t.status || '').padEnd(7)} ${humanTime(t.updated_at).padEnd(10)} ${t.title}`);
  }
}

// ── commands ────────────────────────────────────────────────────────────

async function cmdList(restArgs) {
  let status = '';
  let q = '';
  let all = false;
  for (let i = 0; i < restArgs.length; i++) {
    const a = restArgs[i];
    if (a === '--json') continue;
    if (a === 'list' || a === 'ls') continue;
    if (a === '--status') { status = restArgs[++i] || ''; }
    else if (a.startsWith('--status=')) { status = a.slice('--status='.length); }
    else if (a === '-q' || a === '--query') { q = restArgs[++i] || ''; }
    else if (a === '--all') { all = true; }
  }
  let path = '/list';
  const params = [];
  if (status) params.push(`status=${encodeURIComponent(status)}`);
  if (q) params.push(`q=${encodeURIComponent(q)}`);
  if (params.length) path += '?' + params.join('&');

  const resp = await api('GET', path);
  let todos = resp.todos || [];
  if (!all && !status) {
    todos = todos.filter((t) => t.status === 'todo' || t.status === 'doing');
  }
  if (json) {
    console.log(JSON.stringify({ ok: true, data: { pane, todos } }));
  } else {
    printTable(todos);
  }
}

async function cmdAdd(restArgs) {
  // pick first non-flag, non-"add" arg as title
  const title = restArgs.find((a, i) => i > restArgs.indexOf('add') && !a.startsWith('--'));
  if (!title) bail('usage: cicy-todo [pane] add "<title>"', 2);
  const resp = await api('POST', '/add', { title });
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`+ ${resp.todo?.id || '?'}  ${resp.todo?.title || title}`);
}

async function cmdShow(args) {
  const id = args[0];
  if (!id) bail('usage: cicy-todo [pane] show <id>', 2);
  const t = await resolveId(id);
  if (json) console.log(JSON.stringify({ ok: true, data: t }));
  else {
    console.log(`id:         ${t.id}`);
    console.log(`status:     ${t.status}`);
    console.log(`created:    ${t.created_at}`);
    console.log(`updated:    ${t.updated_at}`);
    console.log(`title:      ${t.title}`);
  }
}

async function cmdSetStatus(newStatus, args) {
  const id = args[0];
  if (!id) bail(`usage: cicy-todo [pane] <start|done|drop|back> <id>`, 2);
  const target = await resolveId(id);
  const resp = await api('PATCH', `/${target.id}`, { status: newStatus });
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`~ ${resp.todo?.id || target.id}  ${resp.todo?.status || newStatus}  ${resp.todo?.title || target.title}`);
}

async function cmdEdit(args) {
  const id = args[0];
  const title = args[1];
  if (!id || !title) bail('usage: cicy-todo [pane] edit <id> "<new title>"', 2);
  const target = await resolveId(id);
  const resp = await api('PATCH', `/${target.id}`, { title });
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`~ ${resp.todo?.id || target.id}  ${resp.todo?.title || title}`);
}

async function cmdRm(args) {
  const id = args[0];
  if (!id) bail('usage: cicy-todo [pane] rm <id>', 2);
  const target = await resolveId(id);
  const resp = await api('DELETE', `/${target.id}`);
  if (json) console.log(JSON.stringify({ ok: true, data: resp }));
  else console.log(`- ${target.id}`);
}
