{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "cicy-todo",
  "version": "1.2.2",
  "title": "Cicy Todo",
  "description": "Per-workspace todo list (todo/doing/done/dropped) backed by /api/todo on the local cicy-code server.",
  "category": "dev",
  "tags": [
    "todo",
    "task",
    "workspace"
  ],
  "author": "cicy-ai",
  "homepage": "https://github.com/cicy-ai/cicy-skills/tree/main/skills/cicy-todo",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": [],
  "npm_dependencies": false,
  "entry": "bin/cicy-todo",
  "config": {
    "path": "~/cicy-ai/global.json",
    "permissions": "0600",
    "secret_fields": [
      "api_token"
    ]
  },
  "permissions": [
    "network:cicy-code"
  ],
  "compatible_agents": [
    "*"
  ],
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "Cicy Todo",
      "description": "\u901a\u8fc7 /api/todo/* \u7ba1\u7406\u6bcf\u4e2a\u5de5\u4f5c\u533a\u7684\u5f85\u529e\u4e8b\u9879\uff08todo/doing/done/dropped\uff09\u3002\u652f\u6301 list/add/show/start/done/drop/back/edit/rm\u3002"
    }
  },
  "tools": [
    {
      "name": "todo list",
      "example": "cicy-todo list",
      "description": "List all todos for current workspace"
    },
    {
      "name": "todo add",
      "example": "cicy-todo add '\u4efb\u52a1\u63cf\u8ff0'",
      "description": "Add a new todo item"
    },
    {
      "name": "todo done",
      "example": "cicy-todo done <id>",
      "description": "Mark a todo as done"
    },
    {
      "name": "todo doing",
      "example": "cicy-todo doing <id>",
      "description": "Move a todo to in-progress"
    }
  ]
}
