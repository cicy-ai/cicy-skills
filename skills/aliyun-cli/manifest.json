{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "aliyun-cli",
  "version": "1.0.4",
  "title": "Aliyun CLI Bootstrap",
  "description": "Install and configure the official Aliyun CLI on this host. Bootstrap-only wrapper: install / config / status. For real API calls use the native aliyun CLI.",
  "category": "cloud",
  "tags": [
    "aliyun",
    "alibaba-cloud",
    "cli",
    "bootstrap"
  ],
  "author": "cicy-ai",
  "homepage": "https://github.com/cicy-ai/cicy-skills/tree/main/skills/aliyun-cli",
  "license": "MIT",
  "runtime": {
    "node": ">=18"
  },
  "system_requirements": [
    "curl",
    "tar"
  ],
  "npm_dependencies": false,
  "entry": "bin/aliyun-cli",
  "permissions": [
    "network",
    "filesystem:home",
    "process:spawn"
  ],
  "compatible_agents": [
    "*"
  ],
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md"
  },
  "i18n": {
    "zh-CN": {
      "title": "Aliyun CLI",
      "description": "阿里云官方 CLI 安装引导。仅三个子命令：install / config / status。真正的 API 调用请直接用 aliyun 命令。"
    }
  },
  "tools": [
    {
      "name": "aliyun install",
      "example": "aliyun-cli install",
      "description": "Install the official Aliyun CLI"
    },
    {
      "name": "aliyun config",
      "example": "aliyun configure",
      "description": "Configure Aliyun CLI credentials"
    },
    {
      "name": "aliyun status",
      "example": "aliyun-cli status",
      "description": "Check Aliyun CLI installation status"
    }
  ]
}
