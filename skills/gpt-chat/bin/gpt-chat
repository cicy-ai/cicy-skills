#!/usr/bin/env node
// gpt-chat — multi-turn chat with persistent history.
// History  : ~/Private/data/gpt-chat-history.json
// System   : ~/Private/data/gpt-chat-system.txt

import { readFileSync, writeFileSync, existsSync, mkdirSync, unlinkSync } from 'node:fs';
import { homedir } from 'node:os';
import { join, dirname } from 'node:path';

const argv = process.argv.slice(2);

if (argv.length === 0 || argv.includes('--help') || argv[0] === '-h' || argv[0] === 'help') {
  printHelp();
  process.exit(0);
}

const json = argv.includes('--json');
const rest = argv.filter((a) => a !== '--json');

const HOME = homedir();
const HIST_PATH = process.env.GPT_CHAT_HIST   || join(HOME, 'Private', 'data', 'gpt-chat-history.json');
const SYS_PATH  = process.env.GPT_CHAT_SYSTEM || join(HOME, 'Private', 'data', 'gpt-chat-system.txt');
const GLOBAL_JSON = process.env.CICY_GLOBAL_JSON || join(HOME, 'cicy-ai', 'global.json');
const API_PORT = process.env.CICY_API_PORT || '8008';
const API_BASE = `http://127.0.0.1:${API_PORT}`;

(async () => {
  try {
    if (rest[0] === '--clear') return cmdClear();
    if (rest[0] === '--system') return cmdSetSystem(rest.slice(1));
    if (rest[0] === '--show-system') return cmdShowSystem();
    await cmdAsk(rest);
  } catch (e) {
    bail(e.message, e.exitCode || 1);
  }
})();

// ── helpers ─────────────────────────────────────────────────────────────

function bail(msg, code = 1) {
  if (json) process.stdout.write(JSON.stringify({ ok: false, error: { code, message: msg } }) + '\n');
  else process.stderr.write(`gpt-chat: ${msg}\n`);
  process.exit(code);
}
function ok(data) { if (json) console.log(JSON.stringify({ ok: true, data })); }

function printHelp() {
  try { process.stdout.write(readFileSync(new URL('../references/help.md', import.meta.url), 'utf8')); }
  catch { process.stdout.write('Usage: gpt-chat <message>\n  gpt-chat --clear | --system <text> | --show-system\n'); }
}

function loadToken() {
  if (process.env.CICY_API_TOKEN) return process.env.CICY_API_TOKEN;
  if (!existsSync(GLOBAL_JSON)) throw Object.assign(new Error(`api_token not found: set CICY_API_TOKEN or create ${GLOBAL_JSON}`), { exitCode: 3 });
  let cfg;
  try { cfg = JSON.parse(readFileSync(GLOBAL_JSON, 'utf8')); }
  catch (e) { throw Object.assign(new Error(`failed to parse ${GLOBAL_JSON}: ${e.message}`), { exitCode: 3 }); }
  if (!cfg.api_token) throw Object.assign(new Error(`api_token not found in ${GLOBAL_JSON}`), { exitCode: 3 });
  return cfg.api_token;
}

function ensureDir(p) { if (!existsSync(p)) mkdirSync(p, { recursive: true }); }

function loadHistory() {
  if (!existsSync(HIST_PATH)) return [];
  try {
    const arr = JSON.parse(readFileSync(HIST_PATH, 'utf8'));
    return Array.isArray(arr) ? arr : [];
  } catch { return []; }
}

function saveHistory(msgs) {
  ensureDir(dirname(HIST_PATH));
  writeFileSync(HIST_PATH, JSON.stringify(msgs, null, 2) + '\n');
}

function loadSystem() {
  if (!existsSync(SYS_PATH)) return '';
  try { return readFileSync(SYS_PATH, 'utf8').trim(); } catch { return ''; }
}

// ── commands ────────────────────────────────────────────────────────────

function cmdClear() {
  try { unlinkSync(HIST_PATH); } catch {}
  if (json) return ok({ cleared: HIST_PATH });
  console.log('History cleared.');
}

function cmdSetSystem(args) {
  if (args.length === 0) bail('Usage: gpt-chat --system <text>', 2);
  const text = args.join(' ');
  ensureDir(dirname(SYS_PATH));
  writeFileSync(SYS_PATH, text + '\n');
  if (json) return ok({ system: text });
  console.log('System prompt set.');
}

function cmdShowSystem() {
  const sys = loadSystem();
  if (json) return ok({ system: sys });
  if (!sys) console.log('(none)');
  else process.stdout.write(sys.endsWith('\n') ? sys : sys + '\n');
}

async function cmdAsk(args) {
  if (args.length === 0) bail('Usage: gpt-chat <message>', 2);
  const userText = args.join(' ');

  const messages = [];
  const sys = loadSystem();
  if (sys) messages.push({ role: 'system', content: sys });
  for (const m of loadHistory()) messages.push(m);
  messages.push({ role: 'user', content: userText });

  const token = loadToken();
  let res;
  try {
    res = await fetch(API_BASE + '/api/ai/chat', {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages }),
    });
  } catch (e) {
    bail(`cannot reach cicy-code at ${API_BASE} (${e.message})`, 3);
  }
  const body = await res.text();
  if (res.status === 401 || res.status === 403) bail(`auth failed (${res.status})`, 3);
  if (res.status >= 400) bail(`api error (${res.status}): ${body.slice(0, 200)}`, 4);

  let parsed; try { parsed = JSON.parse(body); } catch { parsed = null; }
  const result = (parsed?.result || parsed?.data?.result || '').toString().trim();
  if (!result) bail('empty response from /api/ai/chat', 4);

  // persist (without system prompt — that lives in its own file)
  const persist = [...loadHistory(),
    { role: 'user', content: userText },
    { role: 'assistant', content: result },
  ];
  saveHistory(persist);

  if (json) return ok({ result, turns: persist.length / 2 });
  process.stdout.write(result + '\n');
}
