{
  "$schema": "https://skills.cicy-ai.com/v1/manifest.schema.json",
  "name": "chrome-cli",
  "version": "1.0.0",
  "title": "Chrome CLI",
  "description": "Manage local native Chrome profiles and CDP directly on macOS or Linux without cicy-desktop or Electron RPC. Use agent-chrome instead for remote Chrome on a connected cicy-desktop client.",
  "category": "dev",
  "tags": ["chrome", "cdp", "macos", "linux", "local"],
  "author": "cicy",
  "license": "MIT",
  "runtime": { "node": ">=22" },
  "system_requirements": ["macos", "linux", "chrome"],
  "npm_dependencies": false,
  "entry": "bin/chrome-cli",
  "permissions": ["filesystem:home", "filesystem:db", "process:spawn", "network"],
  "compatible_agents": ["*"],
  "files": {
    "skill_md": "SKILL.md",
    "help_md": "references/help.md",
    "tools_md": "references/tools.md",
    "readme": "README.md",
    "help_en_md": "references/help.en.md",
    "help_cn_md": "references/help.cn.md",
    "tools_en_md": "references/tools.en.md",
    "tools_cn_md": "references/tools.cn.md"
  }
}
